    }
    .references-section__title, .faqs-section__title{
      line-height: clamp(1.2em, 1.5vw, 1.3em);
    }
    .faqs-section details:first-child {
      border-top: none;
    }
    .ghd--block--faq h2{
      padding-bottom: 0;
    }
    .ghd--block--faq {
      padding: 2rem 2rem 5rem;
    }
    .take-their-word-section .take-their-word-section__title,
    .take-their-word-section .take-their-word-tagline {
      padding-left: 20px;
      padding-right: 20px;
    }
