{% comment %} ── COA Section ──────────────────────────────────────── {% endcomment %}
<section class="coa-section section-{{ section.id }}">
  <div class="coa-section__inner">
    <div class="coa-section__content">
      <h2 class="coa-section__title font-proxima">
        Your Health Is<br>
        Worth Everything
      </h2>
      <p class="coa-section__subtitle font-proxima">No Guesswork. Ever.</p>
      <p class="coa-section__body font-proxima">
        Our customer care team is prepared to provide a Certificate of Analysis for every product we make. Contact us
        with a product's lot number and expiration date to review the testing results for that specific batch.
      </p>
      <img
        src="{{ 'carousel-2.jpg' | asset_url }}"
        alt="Hands holding supplement capsules from a bottle"
        loading="lazy"
        width="380"
        height="380"
        class="display-on-mobile"
      >
      <a class="coa-section__btn font-proxima" href="/pages/contact">Contact Customer Service</a>
    </div>
    <div class="coa-section__image-wrap">
      <div class="coa-section__image-circle">
        <img
          src="{{ 'carousel-2.jpg' | asset_url }}"
          alt="Hands holding supplement capsules from a bottle"
          loading="lazy"
          width="380"
          height="380"
          class="display-on-desktop"
        >
      </div>
    </div>
  </div>
</section>

