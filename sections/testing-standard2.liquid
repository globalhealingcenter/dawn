      line-height: 23px;
    }
    .take-their-word-section .rc-carousel {
      padding: 2rem 0 1rem;
    }
    .rc-carousel .rc-track{
      gap: 3rem;
    }
    .rc-card {
      flex: 0 0 75%;
      min-width: 75%;
      padding: 1.5rem 1rem;
    }
    .rc-stars svg { width: 18px; height: 18px; }
    .rc-text { font-size: 14px; line-height: 1.4; }
    .rc-progress { margin-top: 5rem; padding: 0px 30px; }
    .rc-progress-track { width: 70%; }

    .coa-section {
      padding: 6rem 2rem 1rem;
    }
    .coa-section__inner .display-on-desktop{
      display: none;
    }
    .coa-section__inner .display-on-mobile{
      display: block;
    }
  }
</style>

