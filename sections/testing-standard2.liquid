<style type="text/css">
      .references-section {
        padding: 70px 0px;
        max-width: 1000px;
        width: 100%;
        margin: 0 auto;
      }
      .references-section__title,
      .faqs-section__title,
      .take-their-word-section__title,
      .coa-section__title {
        margin: 0 0 3rem;
        font-size: clamp(2.5em, 3vw, 4em);
        line-height: clamp(0.9em, 1.5vw, 1.3em);
        color: #174f33;
        font-weight: 400;
      }
      .references-section__body {
        margin: 0;
        font-size: clamp(1.6rem, 1.4vw, 1.9rem);
        line-height: clamp(1.3em, 2.2vw, 1.3em);
        color: #2f3b34;
        font-weight: 300;
      }

      {% comment %} FAQs {% endcomment %}
       /*
        FAQ
     */
    .ghd--block--faq{
      padding: 9rem 1rem 5rem;
    }
    .ghd--block--faq h2{
      text-align: center;
      padding-bottom: 2rem;
    }
    .ghd--block--faq .mw{
      max-width: 1000px;
      width: 100%;
      margin: 0 auto;
    }
    .ghd--block--faq label{
      font-weight: bold;
      border-bottom: 1px solid var(--gh-color-gray);
      display: block;
      padding: 1rem 1rem;
    }
    .ghd--block--faq label:after{
      content: "+";
      float: right;
    }
    .ghd--block--faq .ghd--details > details:nth-child(n+6){
      display: none;
    }
    .ghd--block--faq [name='view-more']:checked + .ghd--details label{
      display: none;
    }
    .ghd--block--faq [name='view-more']:checked + .ghd--details > details:nth-child(n+6){
      display: block;
    }
    .faqs-section .ghd--details details summary h3 {
      font-weight: 700;
    }
    .faqs-section .ghd--details details[open] summary h3{
      margin-bottom: 5px;
    }
    .faqs-section details{
      font-size: clamp(1.6rem, 1.4vw, 1.9rem);
      line-height: clamp(1.3em, 2.2vw, 1.3em);
      color: #2f3b34;
      font-weight: 400;
      padding: 1.4rem 1rem;
    }
    .faqs-section .ghd--details details summary:after{
      font-size: 3.5rem;
      font-weight: 100;
    }

    {% comment %} Dive Deeper {% endcomment %}
    .dive-deep-section {
      width: 100%;
      max-width: 1000px;
      margin: 0 auto;
      padding: 7rem 1rem 4rem;
    }

    .dive-deep-section__title {
      font-size: clamp(2.5em, 3vw, 4em);
      line-height: clamp(1.2em, 1.5vw, 1.6em);
      color: #174f33;
      font-weight: 400;
      text-align: center;
  }
  .text-grids {
      display: flex;
      gap: 20px;
      justify-content: space-between;
      width: 80%;
      text-align: center;
      margin: 0 auto;
      padding-top: 20px;
  }
  .text-grid-item a {
      font-size: 20px;
      text-align: center;
      display: block;
      line-height: 27px;
  }

  {% comment %} Reviews Carousel {% endcomment %}
  .rc-carousel {
    padding: 5rem 0 4rem;
    overflow: hidden; /* clips the peeking prev/next slides */
  }
  .rc-track {
    display: flex;
    gap: 7rem;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    will-change: transform;
  }
  .rc-track.rc-grabbing { cursor: grabbing; }
  .rc-card {
    flex: 0 0 50%;
    min-width: 50%;
    background: rgb(239 229 217);
    border-radius: 12px;
    padding: 2.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    box-sizing: border-box;
  }
  .rc-stars { display: flex; justify-content: center; gap: 5px; }
  .rc-stars svg { width: 32px; height: 32px; }
  .rc-text,
  .rc-meta {
    margin: 10px 0px 0px;
    text-align: center;
    font-size: clamp(1.6rem, 1.563vw, 2.3rem);
    line-height: clamp(1.3em, 2.2vw, 1.3em);
    color: #2f3b34;
    font-weight: 400;
  }
  .rc-meta {
    margin-top: 3rem;
    text-align: center;
  }
  .rc-progress {
    display: flex;
    justify-content: center;
    margin-top: 6rem;
  }
  .rc-progress-track {
    width: 500px;
    max-width: 100%;
    height: 4px;
    background: #22472d33;
    border-radius: 2px;
    overflow: hidden;
  }
  .rc-progress-fill {
    height: 100%;
    background: var(--gh-color-green, #22472D);
    display: block !important;
    border-radius: 2px;
    transition: width 0.45s cubic-bezier(0.25, 0.1, 0.25, 1);
  }
  .take-their-word-section__title,
  .take-their-word-tagline {
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
    display: block;
  }
  .take-their-word-tagline {
    color: rgb(204 167 15);
    font-weight: 700;
    font-size: 20px;
    padding: 10px 0px;
  }
  .take-their-word-section {
    padding-top: 70px;
  }

  .coa-section {
    background-color: #faf3e7;
    padding: 10rem 2rem 6rem;
  }
  .coa-section__inner {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 5rem;
  }
  .coa-section__content {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .coa-section__subtitle {
    font-size: clamp(1.6rem, 2vw, 3rem);
    color: #2f3b34;
    font-weight: 400;
    margin: 0;
  }
  .coa-section__body {
    font-size: clamp(1.6rem, 1.4vw, 1.9rem);
    line-height: clamp(1.3em, 2.2vw, 1.3em);
    color: #2f3b34;
    font-weight: 400;
  }
  .coa-section__title {
    margin-bottom: 0;
  }
  .coa-section__btn {
    display: inline-block;
    background-color: #1a3d29;
    color: #ffffff;
    font-size: clamp(1.4rem, 1.4vw, 1.7rem);
    font-weight: 500;
    text-decoration: none;
    padding: 1.4rem 2.8rem;
    border-radius: 4px;
    align-self: flex-start;
    letter-spacing: 0.02em;
    transition: background-color 0.2s ease;
    width: 97%;
    text-align: center;
  }
  .coa-section__btn:hover {
    background-color: #22472d;
    color: #ffffff;
  }
  .coa-section__image-wrap {
    flex: 0 0 450px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .coa-section__image-circle {
    width: 430px;
    height: 430px;
    border-radius: 50%;
    overflow: hidden;
    background-color: #d6c4a8;
    flex-shrink: 0;
  }
  .coa-section__image-circle img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .coa-section__inner .display-on-desktop {
    display: block;
  }
  .coa-section__inner .display-on-mobile {
    display: none;
  }

  @media (max-width: 768px){
    .text-grids {
      width: 100%;
      flex-flow: column;
    }
    .text-grid-item a{
      font-size: 16px;
    }
    .text-grid-item a br{
      display: none;
    }
    .references-section {
      padding: 1rem 2rem 8rem;
    }
    .faqs-section .ghd--details details summary:after {
      font-size: 2.5rem;
      font-weight: 300;
    }
    .ghd--details details summary, .ghd--details details summary h3, .ghd--details>span{
