<script>
(function () {
  const root = document.getElementById('gh-');
  const btn  = document.getElementById('StickyATCButton');
  if (!root || !btn) return;

  const sectionId = root.dataset.sectionId || "{{ section.id }}";
  const variantsEl = document.getElementById('gh-sticky-variants-' + sectionId);
  const priceEl  = btn.querySelector('.gh-__price');
  const addLabel = btn.querySelector('.add-to-cart-default-text');
  const subLabel = btn.querySelector('.add-to-cart-subscribe-text');

  let variants = [];
  try { variants = JSON.parse(variantsEl?.textContent || '[]'); } catch (e) {}

  const findVariantById = id => variants.find(v => v.id == id) || null;

  const formatMoney = cents => {
    try {
      const currency = Shopify?.currency?.active || 'USD';
      return new Intl.NumberFormat(undefined, { style: 'currency', currency }).format(cents / 100);
    } catch {
      return `$${(cents / 100).toFixed(2)}`;
    }
  };

  const currentVariantId = () => {
    return (
      document.querySelector('form[action*="/cart/add"] [name="id"]')?.value ||
      document.querySelector('select[name="id"]')?.value ||
      root.getAttribute('data-initial-variant')
    );
  };

  const updatePrice = id => {
    const variant = findVariantById(id);
    if (variant && priceEl) priceEl.textContent = ' | ' + formatMoney(variant.price);
  };

  const updateSubscribeText = () => {
    const sp = document.querySelector('[name^="selling_plan"]');
    const isSub = sp?.tagName === 'SELECT' ? !!sp.value
      : ['radio', 'checkbox'].includes(sp?.type) ? !!document.querySelector(`[name="${sp.name}"]:checked`)?.value
      : !!sp?.value;

    addLabel.style.display = isSub ? 'none' : '';
    subLabel.style.display = isSub ? '' : 'none';
  };

  const triggerMainATC = () => {
    const mainBtn = document.querySelector('form[action*="/cart/add"] button[type="submit"]:not(#StickyATCButton)');
    if (mainBtn) mainBtn.click();
    else {
      const form = document.querySelector('form[action*="/cart/add"]');
      form?.requestSubmit?.() || form?.submit?.();
    }
  };

  const attachListeners = () => {
    document.addEventListener('change', e => {
      const n = e.target?.name || '';
      if (n.includes('selling_plan')) updateSubscribeText();
      if (['id', 'options[', 'option'].some(prefix => n.startsWith(prefix))) updatePrice(currentVariantId());
    });

    ['variant:change', 'product:variant-change', 'product:variant:change'].forEach(evt => {
      document.addEventListener(evt, e => {
        const id = e.detail?.variant?.id || e.detail?.id;
        if (id) updatePrice(id);
      });
    });

    const idInput = document.querySelector('form[action*="/cart/add"] [name="id"]');
    if (idInput) {
      new MutationObserver(() => updatePrice(currentVariantId()))
        .observe(idInput, { attributes: true, attributeFilter: ['value'] });
      idInput.addEventListener('input', () => updatePrice(currentVariantId()));
    }
  };

  // Init
  updateSubscribeText();
  updatePrice(currentVariantId());
  attachListeners();
  btn.addEventListener('click', triggerMainATC);
})();
</script>
