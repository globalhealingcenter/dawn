{% comment %} {{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

<style>
  .careers-hero {
    background: #f8f5f0;
    padding: 60px 20px 40px;
    text-align: center;
  }

  .careers-hero h1 {
    font-size: 48px;
    font-weight: 700;
    color: #2c2c2c;
    margin-bottom: 16px;
    letter-spacing: -1px;
  }

  .careers-hero p {
    font-size: 18px;
    color: #666;
    max-width: 600px;
    margin: 0 auto 40px;
    line-height: 1.6;
  }

  /* ── Filters ── */
  .jobs-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin: 0 auto 40px;
    max-width: 900px;
    padding: 0 20px;
  }

  .jobs-filters input,
  .jobs-filters select {
    padding: 10px 16px;
    border: 1.5px solid #ddd;
    border-radius: 8px;
    font-size: 15px;
    color: #333;
    background: #fff;
    outline: none;
    transition: border-color 0.2s;
    min-width: 200px;
  }

  .jobs-filters input:focus,
  .jobs-filters select:focus {
    border-color: #4a7c59;
  }

  /* ── Job Cards Grid ── */
  .jobs-container {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 20px 60px;
  }

  .jobs-grid {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .job-card {
    background: #fff;
    border: 1.5px solid #e8e8e8;
    border-radius: 12px;
    padding: 28px 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    transition: box-shadow 0.2s, border-color 0.2s;
    text-decoration: none;
    color: inherit;
  }

  .job-card:hover {
    box-shadow: 0 6px 24px rgba(0,0,0,0.08);
    border-color: #4a7c59;
    text-decoration: none;
  }

  .job-info { flex: 1; }

  .job-title {
    font-size: 18px;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0 0 6px;
  }

  .job-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 14px;
    color: #777;
  }

  .job-meta span {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .job-badge {
    display: inline-block;
    background: #eef5f0;
    color: #4a7c59;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 20px;
    margin-top: 8px;
  }

  .job-apply-btn {
    background: #4a7c59;
    color: #fff;
    padding: 10px 22px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    transition: background 0.2s;
    flex-shrink: 0;
  }

  .job-apply-btn:hover {
    background: #3a6347;
    color: #fff;
    text-decoration: none;
  }

  /* ── States ── */
  .jobs-loading,
  .jobs-error,
  .jobs-empty {
    text-align: center;
    padding: 60px 20px;
    color: #888;
    font-size: 16px;
  }

  .jobs-loading .spinner {
    width: 40px;
    height: 40px;
    border: 3px solid #e0e0e0;
    border-top-color: #4a7c59;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin: 0 auto 16px;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  .jobs-count {
    text-align: center;
    font-size: 14px;
    color: #999;
    margin-bottom: 24px;
  }

  @media (max-width: 600px) {
    .job-card {
      flex-direction: column;
      align-items: flex-start;
    }
    .job-apply-btn { width: 100%; text-align: center; }
    .careers-hero h1 { font-size: 32px; }
  }
</style>

<!-- CAREERS HERO (edit this content in Shopify page editor above) -->
<div class="careers-hero">
  {{ page.content }}
</div>

<!-- FILTERS -->
<div class="jobs-filters">
  <input type="text" id="jobs-search" placeholder="🔍 Search job title..." oninput="filterJobs()">
  <select id="jobs-dept" onchange="filterJobs()">
    <option value="">All Departments</option>
  </select>
  <select id="jobs-loc" onchange="filterJobs()">
    <option value="">All Locations</option>
  </select>
</div>

<!-- JOB LISTINGS -->
<div class="jobs-container">
  <div id="jobs-count" class="jobs-count" style="display:none;"></div>
  <div id="jobs-list">
    <div class="jobs-loading">
      <div class="spinner"></div>
      <p>Loading open positions...</p>
    </div>
  </div>
</div>

<script>
  const GUID = '67d4bd01-0e39-418f-9ae8-96a5867061ca';
  const API_URL = `https://recruiting.paylocity.com/recruiting/api/feed/jobs/${GUID}`;
  // Free CORS proxy — no setup needed
  const PROXY_URL = `https://corsproxy.io/?url=${encodeURIComponent(API_URL)}`;

  let allJobs = [];

  async function fetchJobs() {
    try {
      const res = await fetch(PROXY_URL);
      if (!res.ok) throw new Error('Network error');
      const parsed = await res.json();
      allJobs = parsed.jobs || parsed || [];
      populateFilters();
      renderJobs(allJobs);
    } catch (err) {
      document.getElementById('jobs-list').innerHTML = `
        <div class="jobs-error">
          <p>⚠️ Unable to load positions right now. Please try again later or <a href="mailto:careers@globalhealing.com">contact us</a>.</p>
        </div>`;
      console.error('Paylocity API error:', err);
    }
  }

  function populateFilters() {
    const depts = [...new Set(allJobs.map(j => j.hiringDepartment).filter(Boolean))].sort();
    const locs  = [...new Set(allJobs.map(j => j.jobLocation?.city).filter(Boolean))].sort();

    const deptSel = document.getElementById('jobs-dept');
    depts.forEach(d => {
      const o = document.createElement('option');
      o.value = d; o.textContent = d;
      deptSel.appendChild(o);
    });

    const locSel = document.getElementById('jobs-loc');
    locs.forEach(l => {
      const o = document.createElement('option');
      o.value = l; o.textContent = l;
      locSel.appendChild(o);
    });
  }

  function filterJobs() {
    const search = document.getElementById('jobs-search').value.toLowerCase();
    const dept   = document.getElementById('jobs-dept').value;
    const loc    = document.getElementById('jobs-loc').value;

    const filtered = allJobs.filter(j => {
      const matchSearch = !search || j.title?.toLowerCase().includes(search);
      const matchDept   = !dept   || j.hiringDepartment === dept;
      const matchLoc    = !loc    || j.jobLocation?.city === loc;
      return matchSearch && matchDept && matchLoc;
    });

    renderJobs(filtered);
  }

  function renderJobs(jobs) {
    const container = document.getElementById('jobs-list');
    const countEl   = document.getElementById('jobs-count');

    if (!jobs.length) {
      countEl.style.display = 'none';
      container.innerHTML = `<div class="jobs-empty">No open positions found. Check back soon! 🌱</div>`;
      return;
    }

    countEl.style.display = 'block';
    countEl.textContent = `${jobs.length} open position${jobs.length !== 1 ? 's' : ''}`;

    container.innerHTML = `<div class="jobs-grid">${jobs.map(jobCard).join('')}</div>`;
  }

  function jobCard(job) {
    const loc  = job.jobLocation
      ? [job.jobLocation.city, job.jobLocation.state].filter(Boolean).join(', ')
      : 'Location TBD';
    const dept = job.hiringDepartment || '';
    const date = job.publishedDate
      ? new Date(job.publishedDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
      : '';
    const types = job.jobTypes || '';

    return `
      <a class="job-card" href="${job.applyUrl || job.displayUrl || '#'}" target="_blank" rel="noopener">
        <div class="job-info">
          <h3 class="job-title">${job.title || 'Open Position'}</h3>
          <div class="job-meta">
            ${loc  ? `<span>📍 ${loc}</span>` : ''}
            ${dept ? `<span>🏢 ${dept}</span>` : ''}
            ${date ? `<span>📅 ${date}</span>` : ''}
          </div>
          ${types ? `<span class="job-badge">${types}</span>` : ''}
        </div>
        <a class="job-apply-btn" href="${job.applyUrl || '#'}" target="_blank" rel="noopener">Apply Now</a>
      </a>`;
  }

  fetchJobs();
</script> {% endcomment %}


<style>
  .careers-wrapper {
    max-width: 100%;
    padding: 0;
    margin: 0;
  }
  
  .careers-iframe {
    width: 100%;
    height: 900px;
    border: none;
    display: block;
  }

  @media (max-width: 768px) {
    .careers-iframe {
      height: 700px;
    }
  }
</style>

<div class="careers-wrapper">
  {{ page.content }}
  <iframe 
    class="careers-iframe"
    src="https://recruiting.paylocity.com/recruiting/jobs/All/67d4bd01-0e39-418f-9ae8-96a5867061ca/Global-Healing-Center-LP"
    title="Global Healing Careers"
    loading="lazy"
    allowfullscreen>
  </iframe>
</div>