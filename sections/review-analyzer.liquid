{% assign page_title = 'Review Intelligence' %}
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --ink:#1a1a1f;            /* primary text — warm near-black */
    --ink-soft:#3a3a42;        /* secondary text */
    --ink-muted:#6b6b75;       /* tertiary, captions */
    --ink-faint:#9a9aa3;       /* metadata */
    --paper:#ffffff;
    --cream:#faf7f2;           /* warm cream background */
    --cream-deep:#f3ede3;      /* card backgrounds, panels */
    --line:#e8e2d6;            /* borders, dividers */
    --line-soft:#f0ebe1;
    --accent:#a8553a;          /* muted terracotta — primary accent */
    --accent-deep:#8a4530;     /* hover / pressed */
    --accent-soft:#f5e8e1;     /* tinted backgrounds */
    --accent-faint:#fbf3ee;
    --warn:#b8860b;            /* warm amber for warnings */
    --warn-soft:#fdf6e3;
    --danger:#a83a2a;          /* deeper rust for errors */
    --danger-soft:#fbeae5;
    --success:#5a7a3e;         /* muted olive for OK states */
    --success-soft:#eef2e6;
    --radius:6px;
    --radius-lg:10px;
    --shadow-sm:0 1px 2px rgba(26,26,31,0.04);
    --shadow:0 2px 8px rgba(26,26,31,0.06);
    --shadow-md:0 8px 24px rgba(26,26,31,0.08);
    --serif:'Fraunces',Georgia,serif;
    --sans:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
    --mono:'JetBrains Mono',ui-monospace,monospace;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  body{background:var(--cream);font-family:var(--sans);font-size:15px;color:var(--ink);line-height:1.6;-webkit-font-smoothing:antialiased;}

  /* ───── HERO / INTAKE ───── */
  .wrap{max-width:1140px;margin:0 auto;padding:64px 40px 120px;}
  .eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:var(--accent);font-weight:500;margin-bottom:16px;}
  .hero-title{font-family:var(--serif);font-size:56px;line-height:1.05;letter-spacing:-0.02em;font-weight:400;color:var(--ink);margin-bottom:16px;}
  .hero-title em{font-style:italic;color:var(--accent);font-weight:400;}
  .hero-sub{font-size:17px;color:var(--ink-soft);margin-bottom:56px;max-width:580px;line-height:1.6;}

  .step-num{font-family:var(--mono);font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-faint);margin-bottom:14px;font-weight:500;}
  .step-label{font-family:var(--mono);font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-muted);font-weight:600;margin-bottom:12px;display:block;}
  .step-block{margin-bottom:40px;}

  .upload-zone{border:1.5px dashed var(--line);background:var(--paper);border-radius:var(--radius-lg);padding:48px 32px;text-align:center;cursor:pointer;transition:all 0.2s ease;position:relative;}
  .upload-zone:hover,.upload-zone.drag-over{border-color:var(--accent);background:var(--accent-faint);}
  .upload-zone input[type="file"]{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;}
  .upload-icon{width:36px;height:36px;margin:0 auto 14px;color:var(--accent);}
  .upload-title{font-family:var(--serif);font-size:22px;color:var(--ink);margin-bottom:6px;font-weight:500;}
  .upload-sub{font-size:13px;color:var(--ink-muted);}

  .file-loaded{display:flex;align-items:center;gap:14px;background:var(--ink);color:var(--cream);padding:18px 24px;border-radius:var(--radius);font-size:14px;}
  .file-loaded .dot{width:7px;height:7px;background:var(--accent);border-radius:50%;flex-shrink:0;}
  .file-loaded strong{color:white;font-weight:600;}

  .ra-select{width:100%;padding:14px 16px;border:1px solid var(--line);background:var(--paper);font-size:15px;color:var(--ink);border-radius:var(--radius);appearance:none;outline:none;transition:border-color 0.15s;font-family:var(--sans);background-image:url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='%236b6b75' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'/%3e%3c/svg%3e");background-repeat:no-repeat;background-position:right 16px center;padding-right:44px;}
  .ra-select:focus{border-color:var(--accent);}
  .ra-select:disabled{background-color:var(--cream-deep);color:var(--ink-faint);cursor:not-allowed;}

  .ra-textarea{width:100%;padding:16px 18px;border:1px solid var(--line);background:var(--paper);font-size:14px;color:var(--ink);border-radius:var(--radius);outline:none;transition:border-color 0.15s;font-family:var(--sans);resize:vertical;min-height:140px;line-height:1.6;}
  .ra-textarea:focus{border-color:var(--accent);}

  .required-tag{display:inline-block;font-family:var(--mono);font-size:10px;color:var(--accent);letter-spacing:0.08em;text-transform:uppercase;background:var(--accent-soft);padding:3px 8px;border-radius:3px;margin-left:8px;font-weight:500;}
  .field-help{font-size:13px;color:var(--ink-muted);margin-top:10px;line-height:1.5;}

  .btn-analyze{padding:18px 40px;background:var(--ink);color:white;font-weight:600;font-size:15px;border:none;border-radius:var(--radius);cursor:pointer;transition:all 0.2s ease;font-family:var(--sans);width:100%;letter-spacing:0.01em;}
  .btn-analyze:hover{background:var(--accent);transform:translateY(-1px);box-shadow:var(--shadow-md);}
  .btn-analyze:disabled{background:var(--cream-deep);color:var(--ink-faint);cursor:not-allowed;transform:none;box-shadow:none;}

  .collapsible-toggle{display:inline-flex;align-items:center;gap:8px;cursor:pointer;font-family:var(--mono);font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-muted);font-weight:500;user-select:none;transition:color 0.15s;}
  .collapsible-toggle:hover{color:var(--accent);}
  .collapsible-arrow{font-size:10px;transition:transform 0.2s;}
  .collapsible-arrow.open{transform:rotate(180deg);}
  .collapsible-panel{display:none;margin-top:14px;}
  .collapsible-panel.open{display:block;}

  .settings-panel-inner{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:24px;}
  .settings-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;}
  .settings-field label{display:block;font-family:var(--mono);font-size:10px;letter-spacing:0.08em;text-transform:uppercase;color:var(--ink-muted);margin-bottom:8px;font-weight:500;}
  .settings-field input{width:100%;padding:10px 12px;border:1px solid var(--line);background:var(--cream);font-size:14px;color:var(--ink);border-radius:4px;outline:none;font-family:var(--mono);}
  .settings-field input:focus{border-color:var(--accent);}

  /* ───── LOADING ───── */
  .ra-loading{display:none;text-align:center;padding:80px 0;}
  .ra-loading.active{display:block;}
  .loading-ring{width:42px;height:42px;border:2px solid var(--line);border-top-color:var(--accent);border-radius:50%;animation:raspin 0.9s linear infinite;margin:0 auto 24px;}
  @keyframes raspin{to{transform:rotate(360deg);}}
  .loading-text{font-family:var(--serif);font-size:20px;color:var(--ink);font-weight:500;margin-bottom:8px;}
  .loading-text-meta{font-family:var(--mono);font-size:12px;color:var(--ink-muted);margin-bottom:24px;}
  .loading-bar-track{background:var(--cream-deep);border-radius:100px;height:3px;width:320px;margin:0 auto 12px;overflow:hidden;}
  .loading-bar{height:100%;width:0%;background:var(--accent);border-radius:100px;transition:width 0.8s ease;}
  .loading-timer{font-family:var(--mono);font-size:12px;color:var(--ink-faint);margin-bottom:28px;}
  .loading-step{font-size:13px;color:var(--ink-faint);transition:color 0.3s;margin:5px 0;font-family:var(--mono);letter-spacing:0.02em;}
  .loading-step.active{color:var(--accent);}
  .loading-step.done{color:var(--success);}

  /* ───── REPORT HEADER ───── */
  .ra-results{display:none;}
  .ra-results.active{display:block;}

  .report-masthead{margin-bottom:64px;padding-bottom:36px;border-bottom:1px solid var(--line);}
  .report-eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:var(--accent);font-weight:500;margin-bottom:14px;}
  .report-title{font-family:var(--serif);font-size:48px;line-height:1.05;letter-spacing:-0.02em;color:var(--ink);font-weight:400;margin-bottom:18px;}
  .report-meta{display:flex;flex-wrap:wrap;gap:28px;font-family:var(--mono);font-size:12px;color:var(--ink-muted);letter-spacing:0.02em;}
  .report-meta-item{display:flex;align-items:center;gap:8px;}
  .report-meta-item strong{color:var(--ink);font-weight:600;}

  /* ───── SECTIONS ───── */
  .ra-section{margin-bottom:88px;scroll-margin-top:32px;}
  .section-eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:var(--accent);font-weight:500;margin-bottom:10px;}
  .section-heading{font-family:var(--serif);font-size:36px;color:var(--ink);font-weight:400;letter-spacing:-0.015em;line-height:1.15;margin-bottom:12px;}
  .section-deck{font-size:16px;color:var(--ink-soft);max-width:680px;line-height:1.6;margin-bottom:32px;}

  /* Collapsible "how this works" — restrained, sits beneath section header */
  .how-this-works{margin-bottom:32px;}
  .how-toggle{display:inline-flex;align-items:center;gap:6px;cursor:pointer;font-family:var(--mono);font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:var(--ink-muted);font-weight:500;user-select:none;padding:6px 0;border:none;background:none;transition:color 0.15s;}
  .how-toggle:hover{color:var(--accent);}
  .how-arrow{font-size:9px;transition:transform 0.2s;}
  .how-arrow.open{transform:rotate(180deg);}
  .how-content{display:none;margin-top:14px;padding:20px 24px;background:var(--accent-faint);border-left:2px solid var(--accent);border-radius:0 var(--radius) var(--radius) 0;}
  .how-content.open{display:block;}
  .how-content ul{list-style:none;padding:0;margin:0;}
  .how-content ul li{position:relative;padding-left:18px;margin-bottom:8px;font-size:14px;color:var(--ink-soft);line-height:1.6;}
  .how-content ul li:before{content:"";position:absolute;left:0;top:9px;width:6px;height:1px;background:var(--accent);}
  .how-content ul li:last-child{margin-bottom:0;}
  .how-constraints{margin-top:14px;padding-top:14px;border-top:1px dashed rgba(168,85,58,0.3);}
  .how-constraints-label{font-family:var(--mono);font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:var(--accent);font-weight:600;margin-bottom:8px;}

  /* ───── COPY BUTTON ───── */
  .btn-copy{flex-shrink:0;padding:7px 14px;background:transparent;border:1px solid var(--line);color:var(--ink-muted);font-family:var(--mono);font-size:11px;border-radius:4px;cursor:pointer;transition:all 0.15s;letter-spacing:0.02em;}
  .btn-copy:hover{border-color:var(--accent);color:var(--accent);background:var(--accent-faint);}
  .btn-copy.copied{border-color:var(--success);color:var(--success);background:var(--success-soft);}

  /* ───── ABOUT CARDS ───── */
  .choice-list{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
  .choice-card{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:28px;transition:border-color 0.15s, box-shadow 0.15s;display:flex;align-items:flex-start;justify-content:space-between;gap:16px;}
  .choice-card:hover{border-color:var(--ink-faint);box-shadow:var(--shadow);}
  .choice-body{flex:1;}
  .choice-num{font-family:var(--mono);font-size:11px;color:var(--ink-faint);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:14px;font-weight:500;}
  .choice-num strong{color:var(--ink);font-weight:600;}
  .choice-text{font-size:16px;color:var(--ink);line-height:1.65;font-family:var(--serif);font-weight:400;letter-spacing:-0.005em;}
  .choice-desc{font-size:14px;color:var(--ink-soft);line-height:1.6;margin-top:8px;}
  .choice-meta{font-family:var(--mono);font-size:10px;color:var(--ink-faint);margin-top:14px;letter-spacing:0.04em;}
  .choice-meta.over{color:var(--danger);}

  .about-tags{display:flex;gap:6px;margin-bottom:12px;flex-wrap:wrap;}
  .about-tag{font-family:var(--mono);font-size:10px;padding:3px 9px;border-radius:3px;letter-spacing:0.03em;font-weight:500;}
  .about-tag-pain{background:var(--danger-soft);color:var(--danger);}
  .about-tag-benefit{background:var(--success-soft);color:var(--success);}
  .about-tag-diff{background:var(--accent-soft);color:var(--accent-deep);}

  .diff-explanation{margin-top:16px;padding:14px 16px;background:var(--cream);border-radius:4px;border-left:2px solid var(--accent);}
  .diff-explanation-label{font-family:var(--mono);font-size:10px;color:var(--accent);letter-spacing:0.1em;text-transform:uppercase;font-weight:600;margin-bottom:8px;}
  .diff-explanation-text{font-size:13px;color:var(--ink-soft);line-height:1.6;}

  /* ───── PAIN POINTS COLLAPSIBLE NEAR ABOUT ───── */
  .pain-ref-panel{margin-bottom:28px;border:1px solid var(--line);border-radius:var(--radius);background:var(--paper);overflow:hidden;}
  .pain-ref-header{padding:14px 20px;display:flex;align-items:center;justify-content:space-between;cursor:pointer;user-select:none;transition:background 0.15s;}
  .pain-ref-header:hover{background:var(--cream);}
  .pain-ref-label{font-family:var(--mono);font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-muted);font-weight:500;}
  .pain-ref-toggle{font-size:11px;color:var(--ink-faint);transition:transform 0.2s;}
  .pain-ref-toggle.open{transform:rotate(180deg);}
  .pain-ref-body{display:none;padding:6px 20px 18px;}
  .pain-ref-body.open{display:block;}
  .pain-ref-item{padding:12px 0;border-bottom:1px solid var(--line-soft);font-size:13px;color:var(--ink-soft);line-height:1.6;}
  .pain-ref-item:last-child{border-bottom:none;}
  .pain-ref-item strong{color:var(--ink);font-weight:600;}

  /* ───── MWP — wiki/v1 comparison ───── */
  .with-wiki-source{display:grid;grid-template-columns:1fr 280px;gap:0;background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);margin-bottom:14px;overflow:hidden;transition:border-color 0.15s;}
  .with-wiki-source:hover{border-color:var(--ink-faint);}
  .wiki-source-col{background:var(--cream);border-left:1px solid var(--line);padding:22px 20px;display:flex;flex-direction:column;gap:10px;}
  .wiki-source-label{font-family:var(--mono);font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-muted);margin-bottom:4px;font-weight:500;}
  .wiki-source-quote{font-size:12px;color:var(--ink-soft);line-height:1.65;font-style:italic;border-left:2px solid var(--accent);padding-left:12px;font-family:var(--serif);}

  .choice-title{font-size:17px;font-weight:600;color:var(--ink);margin-bottom:8px;line-height:1.4;font-family:var(--sans);letter-spacing:-0.005em;}

  /* Source comparison table */
  .source-compare-wrap{margin-bottom:24px;border:1px solid var(--line);border-radius:var(--radius);background:var(--paper);overflow:hidden;}
  .source-compare-header{padding:14px 20px;background:var(--cream);border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;cursor:pointer;user-select:none;transition:background 0.15s;}
  .source-compare-header:hover{background:var(--cream-deep);}
  .source-compare-title{font-family:var(--mono);font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-muted);font-weight:500;}
  .source-compare-toggle{font-size:11px;color:var(--ink-faint);transition:transform 0.2s;}
  .source-compare-toggle.open{transform:rotate(180deg);}
  .source-compare-body{display:none;}
  .source-compare-table{width:100%;border-collapse:collapse;}
  .source-compare-table th{background:var(--cream);color:var(--ink-muted);font-family:var(--mono);font-size:10px;text-transform:uppercase;letter-spacing:0.1em;padding:14px 18px;text-align:left;border-bottom:1px solid var(--line);font-weight:600;}
  .source-compare-table td{padding:16px 18px;font-size:14px;color:var(--ink);border-bottom:1px solid var(--line-soft);vertical-align:top;}
  .source-compare-table tr:last-child td{border-bottom:none;}
  .source-compare-row{cursor:pointer;transition:background 0.15s;}
  .source-compare-row:hover{background:var(--cream);}
  .source-compare-detail{display:none;}
  .source-compare-detail.open{display:table-row;}
  .source-compare-detail td{background:var(--cream);font-size:13px;color:var(--ink-soft);font-style:italic;line-height:1.65;padding:12px 18px;font-family:var(--serif);}

  .mismatch-callout{background:var(--warn-soft);border:1px solid #f0d785;border-radius:var(--radius);padding:18px 22px;margin-bottom:24px;border-left:3px solid var(--warn);}
  .mismatch-title{font-family:var(--mono);font-size:11px;color:#7a5b08;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:10px;}
  .mismatch-text{font-size:14px;color:var(--ink-soft);line-height:1.6;margin-bottom:10px;}
  .mismatch-list{margin:8px 0 0 0;padding-left:18px;font-size:13px;color:var(--ink-soft);line-height:1.8;}

  /* ───── STATS ───── */
  .stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;margin-bottom:14px;}
  .stat-card{padding:36px 28px;background:var(--paper);display:flex;flex-direction:column;gap:10px;}
  .stat-pct{font-family:var(--serif);font-size:64px;line-height:1;color:var(--ink);font-weight:400;letter-spacing:-0.03em;}
  .stat-label{font-size:14px;font-weight:600;color:var(--ink);line-height:1.4;}
  .stat-detail{font-size:12px;color:var(--ink-muted);font-family:var(--mono);}
  .stat-copy-row{display:flex;justify-content:flex-end;margin-top:6px;}

  .stats-footnote{font-family:var(--mono);font-size:11px;color:var(--ink-muted);font-style:italic;margin-bottom:18px;letter-spacing:0.02em;}

  .warn-yellow{background:var(--warn-soft);border:1px solid #f0d785;border-radius:var(--radius);padding:16px 20px;margin-bottom:16px;border-left:3px solid var(--warn);}
  .warn-yellow-title{font-family:var(--mono);font-size:11px;color:#7a5b08;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:6px;}
  .warn-red{background:var(--danger-soft);border:1px solid #e8b5a8;border-radius:var(--radius);padding:16px 20px;margin-bottom:16px;border-left:3px solid var(--danger);}
  .warn-red-title{font-family:var(--mono);font-size:11px;color:var(--danger);font-weight:600;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:6px;}
  .warn-text{font-size:14px;color:var(--ink-soft);line-height:1.6;}

  .transform-card{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:28px;margin-top:18px;display:flex;align-items:flex-start;justify-content:space-between;gap:18px;}
  .transform-inner{flex:1;}
  .transform-label{font-family:var(--mono);font-size:11px;color:var(--accent);letter-spacing:0.1em;text-transform:uppercase;margin-bottom:12px;font-weight:600;}
  .transform-stat{font-family:var(--serif);font-size:28px;color:var(--ink);font-weight:400;line-height:1.25;margin-bottom:6px;letter-spacing:-0.01em;}
  .transform-sub{font-size:13px;color:var(--ink-muted);font-family:var(--mono);}

  /* Substantiation block — refined as editorial footnote */
  .verification-block{margin-top:20px;padding-top:18px;border-top:1px solid var(--line-soft);}
  .verification-title{font-family:var(--mono);font-size:10px;letter-spacing:0.12em;text-transform:uppercase;color:var(--ink-muted);font-weight:600;margin-bottom:12px;}
  .verification-row{font-family:var(--mono);font-size:12px;color:var(--ink-soft);line-height:1.7;margin-bottom:6px;}
  .v-label{color:var(--ink-muted);font-weight:600;}
  .v-quotes-label{margin-top:10px;margin-bottom:6px;}
  .verification-quote{font-size:13px;color:var(--ink);font-style:italic;line-height:1.65;padding:10px 14px;background:var(--cream);border-left:2px solid var(--accent);margin-bottom:6px;border-radius:0 4px 4px 0;font-family:var(--serif);}
  .v-note{font-size:11px;color:var(--ink-faint);margin-top:8px;margin-bottom:4px;font-style:italic;}

  .alt-stat-card{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:24px 28px;margin-bottom:12px;display:flex;align-items:flex-start;justify-content:space-between;gap:18px;}
  .alt-stat-inner{flex:1;}
  .alt-stat-label{font-family:var(--mono);font-size:11px;color:var(--accent);letter-spacing:0.1em;text-transform:uppercase;margin-bottom:10px;font-weight:600;}
  .alt-stat-text{font-family:var(--serif);font-size:22px;color:var(--ink);font-weight:400;line-height:1.3;margin-bottom:6px;letter-spacing:-0.01em;}
  .alt-stat-sub{font-size:13px;color:var(--ink-muted);font-family:var(--mono);}

  /* ───── BENEFITS ───── */
  .benefits-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:14px;}
