function parseEnvelope(rawText){
  var envelope;try{envelope=JSON.parse(rawText);}catch(e){envelope=null;}
  var inner=envelope&&envelope.content&&envelope.content[0]&&envelope.content[0].text||rawText;
  var jm=inner.replace(/```json|```/g,'').trim().match(/\{[\s\S]*\}/);
  if(!jm)return null;
  try{return JSON.parse(jm[0]);}catch(e){return null;}
}

async function enforceCharLimits(analysis,settings){
