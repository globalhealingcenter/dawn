document.getElementById('uploadZone').addEventListener('dragover',function(e){e.preventDefault();this.classList.add('drag-over');});
document.getElementById('uploadZone').addEventListener('dragleave',function(){this.classList.remove('drag-over');});
document.getElementById('uploadZone').addEventListener('drop',function(e){e.preventDefault();this.classList.remove('drag-over');if(e.dataTransfer.files[0])processFile(e.dataTransfer.files[0]);});
document.getElementById('csvFile').addEventListener('change',function(e){if(e.target.files[0])processFile(e.target.files[0]);});

function getStatusCol(reviews){var keys=['Review Status','review status','review_status','Status','status'];for(var i=0;i<keys.length;i++){if(reviews[0]&&reviews[0][keys[i]]!==undefined)return keys[i];}return null;}
function isPublishedStatus(value){if(!value)return false;var v=String(value).toLowerCase().trim();return v==='published'||v==='true'||v==='1';}

function processFile(file){
  Papa.parse(file,{header:true,skipEmptyLines:true,complete:function(r){
    allReviews=r.data;
    var statusCol=getStatusCol(allReviews);
    if(statusCol){
      publishedReviews=allReviews.filter(function(row){return isPublishedStatus(row[statusCol]);});
    } else {
      publishedReviews=allReviews;
    }
    var products=getProducts(publishedReviews),counts=getProductCounts(publishedReviews);
    var sel=document.getElementById('productSelect');
    sel.innerHTML='<option value="">— choose a product —</option>';
    products.forEach(function(p){var o=document.createElement('option');o.value=p;o.textContent=p+' ('+(counts[p]||0).toLocaleString()+' published)';sel.appendChild(o);});
    sel.disabled=false;document.getElementById('analyzeBtn').disabled=false;
    document.getElementById('uploadZone').style.display='none';
    document.getElementById('fileLoaded').style.display='flex';
    document.getElementById('fileName').textContent=file.name;
    document.getElementById('reviewCount').textContent=allReviews.length.toLocaleString();
    document.getElementById('publishedCount').textContent=publishedReviews.length.toLocaleString();
    document.getElementById('productCount').textContent=products.length.toLocaleString();
  },error:function(){showError("Couldn't parse CSV.");}});
}

function getProductCol(reviews){var keys=['product_title','Product Title','product_name','Product Name','title','name'];for(var i=0;i<keys.length;i++){if(reviews[0]&&reviews[0][keys[i]]!==undefined)return keys[i];}return null;}
function getProducts(reviews){var col=getProductCol(reviews);if(!col)return['All Reviews'];var set=new Set(reviews.map(function(r){return r[col];}).filter(Boolean));return Array.from(set).sort();}
function getProductCounts(reviews){var col=getProductCol(reviews);if(!col)return{};var c={};reviews.forEach(function(r){var p=r[col];if(p)c[p]=(c[p]||0)+1;});return c;}
function getReviewsForProduct(p){if(p==='All Reviews')return publishedReviews;var col=getProductCol(publishedReviews);if(!col)return publishedReviews;return publishedReviews.filter(function(r){return r[col]===p;});}
function getDateCol(r){var keys=['Review Creation Date','review creation date','created_at','Created At','date','Date','review_date'];for(var i=0;i<keys.length;i++){if(r&&r[keys[i]]!==undefined)return keys[i];}return null;}
function sortByDateDesc(reviews){var dc=getDateCol(reviews[0]);if(!dc)return reviews;return reviews.slice().sort(function(a,b){return new Date(b[dc]||0)-new Date(a[dc]||0);});}
function getDateRange(reviews){var dc=getDateCol(reviews[0]);if(!dc)return null;var dates=reviews.map(function(r){return new Date(r[dc]);}).filter(function(d){return !isNaN(d);});if(!dates.length)return null;dates.sort(function(a,b){return a-b;});var fmt=function(d){return d.toLocaleDateString('en-US',{month:'short',year:'numeric'});};return fmt(dates[0])+' \u2013 '+fmt(dates[dates.length-1]);}
function getAuthorCol(r){var keys=['Reviewer Display Name','reviewer display name','display name','Display Name','reviewer_name','Reviewer Name','author','Author'];for(var i=0;i<keys.length;i++){if(r&&r[keys[i]]!==undefined)return keys[i];}return null;}
function getReviewText(r){var keys=['Review Content','review_content','body','Body','content','Content','review','Review','comment','Comment'];for(var i=0;i<keys.length;i++){if(r[keys[i]]&&r[keys[i]].trim())return r[keys[i]].trim();}return Object.values(r).find(function(v){return v&&v.length>40;})||'';}

var GENERIC_TERMS=['plant-based','plant based','made in usa','pharmaceutical free','pharmaceutical-free','non-gmo','gluten free','gluten-free','vegan','soy free','soy-free','dairy free','dairy-free','organic certified','certified organic','no fillers','no additives','inner leaf only','freeze-dried potency','freeze dried','purity-tested','purity tested','made in the usa','cgmp','third-party tested'];
