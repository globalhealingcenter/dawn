{% assign page_title = 'Review Intelligence' %}

<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Mono:wght@400;500&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">

<style>
  :root {
    --ink: #1a1208;
    --paper: #faf7f2;
    --cream: #f2ede4;
    --gold: #c8952a;
    --gold-light: #e8b84b;
    --sage: #4a6741;
    --sage-light: #6a8f60;
    --rust: #b84c2a;
    --mist: #e8e2d9;
    --radius: 12px;
    --shadow: 0 2px 8px rgba(26,18,8,0.08), 0 1px 2px rgba(26,18,8,0.04);
    --shadow-md: 0 4px 16px rgba(26,18,8,0.10), 0 2px 4px rgba(26,18,8,0.06);
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--paper); font-family: 'Instrument Sans', sans-serif; }

  .upload-zone { border: 2px dashed var(--mist); background: var(--cream); border-radius: var(--radius); padding: 52px 40px; text-align: center; cursor: pointer; transition: all 0.2s ease; position: relative; margin-bottom: 32px; }
  .upload-zone:hover, .upload-zone.drag-over { border-color: var(--gold); background: #f5ede0; }
  .upload-zone input[type="file"] { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; }
  .upload-icon { width: 48px; height: 48px; margin: 0 auto 16px; color: var(--gold); }
  .upload-title { font-family: 'DM Serif Display', serif; font-size: 20px; margin-bottom: 6px; color: var(--ink); }
  .upload-sub { font-size: 13px; color: #8a7a68; font-family: 'DM Mono', monospace; }
  .file-loaded { display: flex; align-items: center; gap: 14px; background: var(--ink); color: var(--paper); padding: 16px 24px; border-radius: var(--radius); margin-bottom: 32px; font-family: 'DM Mono', monospace; font-size: 13px; box-shadow: var(--shadow); }
  .file-loaded .dot { width: 8px; height: 8px; background: var(--gold-light); border-radius: 50%; flex-shrink: 0; }
  .file-loaded strong { color: var(--gold-light); }

  .ra-controls { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; align-items: end; }
  .ra-label { display: block; font-family: 'DM Mono', monospace; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: #8a7a68; margin-bottom: 8px; }
  .ra-select { width: 100%; padding: 12px 16px; border: 1px solid var(--mist); background: white; font-size: 14px; color: var(--ink); border-radius: 8px; appearance: none; outline: none; transition: border-color 0.2s; font-family: 'Instrument Sans', sans-serif; box-shadow: var(--shadow); }
  .ra-select:focus { border-color: var(--gold); }
  .ra-textarea { width: 100%; padding: 12px 16px; border: 1px solid var(--mist); background: white; font-size: 13px; color: var(--ink); border-radius: 8px; outline: none; transition: border-color 0.2s; font-family: 'Instrument Sans', sans-serif; box-shadow: var(--shadow); resize: vertical; min-height: 90px; line-height: 1.5; }
  .ra-textarea:focus { border-color: var(--gold); }

  .collapsible-toggle { display: flex; align-items: center; gap: 8px; cursor: pointer; width: fit-content; font-family: 'DM Mono', monospace; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: #8a7a68; margin-bottom: 0; }
  .collapsible-arrow { font-size: 11px; transition: transform 0.2s; }
  .collapsible-arrow.open { transform: rotate(180deg); }
  .collapsible-panel { display: none; margin-top: 10px; }
  .collapsible-panel.open { display: block; }
  .panel-note { font-family: 'DM Mono', monospace; font-size: 11px; color: #8a7a68; margin-top: 6px; line-height: 1.5; }

  .settings-panel-inner { background: var(--cream); border: 1px solid var(--mist); border-radius: var(--radius); padding: 24px; }
  .settings-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .settings-field label { display: block; font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: #8a7a68; margin-bottom: 6px; line-height: 1.4; }
  .settings-field input { width: 100%; padding: 8px 12px; border: 1px solid var(--mist); background: white; font-size: 13px; color: var(--ink); border-radius: 6px; outline: none; font-family: 'DM Mono', monospace; }
  .settings-field input:focus { border-color: var(--gold); }

  .btn-analyze { padding: 13px 32px; background: var(--gold); color: var(--ink); font-weight: 600; font-size: 14px; border: none; border-radius: 8px; cursor: pointer; transition: background 0.2s; white-space: nowrap; font-family: 'Instrument Sans', sans-serif; box-shadow: var(--shadow); width: 100%; }
  .btn-analyze:hover { background: var(--gold-light); }
  .btn-analyze:disabled { background: var(--mist); color: #aaa; cursor: not-allowed; box-shadow: none; }

  .ra-loading { display: none; text-align: center; padding: 64px 0; }
  .ra-loading.active { display: block; }
  .loading-ring { width: 48px; height: 48px; border: 3px solid var(--mist); border-top-color: var(--gold); border-radius: 50%; animation: raspin 0.8s linear infinite; margin: 0 auto 20px; }
  @keyframes raspin { to { transform: rotate(360deg); } }
  .loading-text { font-family: 'DM Mono', monospace; font-size: 13px; color: #8a7a68; }
  .loading-step { font-size: 12px; color: #aaa; transition: color 0.3s; margin: 4px 0; }
  .loading-step.active { color: var(--gold); }
  .loading-step.done { color: var(--sage); }

  .ra-results { display: none; }
  .ra-results.active { display: block; }
  .results-header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 24px; padding-bottom: 20px; border-bottom: 1px solid var(--mist); }
  .results-title { font-family: 'DM Serif Display', serif; font-size: 32px; color: var(--ink); }
  .results-meta { font-family: 'DM Mono', monospace; font-size: 12px; color: #8a7a68; text-align: right; line-height: 1.6; }

  .section-nav { display: flex; gap: 6px; flex-wrap: wrap; background: white; border: 1px solid var(--mist); border-radius: var(--radius); padding: 12px 16px; margin-bottom: 40px; box-shadow: var(--shadow); }
  .nav-btn { font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; padding: 5px 10px; border-radius: 6px; border: 1px solid var(--mist); background: transparent; color: #8a7a68; cursor: pointer; transition: all 0.15s; white-space: nowrap; }
  .nav-btn:hover { background: var(--cream); color: var(--ink); border-color: var(--gold); }

  .ra-section { margin-bottom: 48px; scroll-margin-top: 20px; }
  .section-label { display: inline-block; font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: white; background: var(--ink); padding: 4px 10px; border-radius: 20px; margin-bottom: 10px; }
  .section-heading { font-family: 'DM Serif Display', serif; font-size: 28px; color: var(--ink); margin-bottom: 6px; }
  .section-sub { font-size: 13px; color: #6b5e4a; margin-bottom: 24px; line-height: 1.6; max-width: 720px; }
  .jane-note { background: #1a2e1a; color: #a8c4a8; font-size: 13px; line-height: 1.7; padding: 14px 18px; border-radius: var(--radius); margin-bottom: 20px; }
  .jane-note strong { color: var(--gold-light); }

  .btn-copy, .btn-copy-sm { flex-shrink: 0; padding: 6px 14px; background: transparent; border: 1px solid var(--mist); color: #8a7a68; font-family: 'DM Mono', monospace; font-size: 11px; border-radius: 6px; cursor: pointer; transition: all 0.2s; }
  .btn-copy-sm { padding: 4px 10px; font-size: 10px; }
  .btn-copy:hover, .btn-copy-sm:hover { border-color: var(--gold); color: var(--gold); }
  .btn-copy.copied, .btn-copy-sm.copied { border-color: var(--sage); color: var(--sage-light); }

  /* SENTIMENT */
  .sentiment-wrap { padding: 32px; margin-bottom: 48px; }
  .sentiment-explainer { font-size: 13px; color: #6b5e4a; line-height: 1.6; margin-bottom: 24px; max-width: 680px; }
  .sentiment-explainer strong { color: var(--ink); }
  .sentiment-divider { height: 1px; background: var(--mist); margin-bottom: 24px; }
  .sentiment-stats-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 20px; }
  .sentiment-stat { background: var(--cream); border-radius: 10px; padding: 24px 20px; text-align: center; }
  .sentiment-stat-pct { font-family: 'DM Serif Display', serif; font-size: 48px; line-height: 1; color: var(--ink); margin-bottom: 6px; }
  .sentiment-stat-label { font-size: 13px; color: #6b5e4a; margin-bottom: 8px; }
  .sentiment-bar { height: 10px; background: var(--mist); border-radius: 100px; overflow: hidden; display: flex; margin-bottom: 10px; }
  .sentiment-fill { height: 100%; transition: width 1s ease; }
  .s-positive { background: var(--ink); }
  .s-neutral { background: #8a7a68; }
  .s-negative { background: var(--rust); }
  .sentiment-note { font-family: 'DM Mono', monospace; font-size: 11px; color: #8a7a68; line-height: 1.6; background: var(--cream); padding: 12px 16px; border-radius: 8px; }

  /* OUTCOME STATS */
  .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 12px; }
  .stat-card { background: white; padding: 28px 24px; position: relative; border-radius: var(--radius); box-shadow: var(--shadow); border: 1px solid rgba(232,226,217,0.6); overflow: hidden; }
  .stat-card-accent { position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--ink); border-radius: var(--radius) var(--radius) 0 0; }
  .stat-pct { font-family: 'DM Serif Display', serif; font-size: 56px; line-height: 1; color: var(--ink); margin-bottom: 8px; }
  .stat-label { font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 4px; line-height: 1.3; }
  .stat-detail { font-size: 12px; color: #8a7a68; }
  .stats-footnote { font-family: 'DM Mono', monospace; font-size: 11px; color: #8a7a68; font-style: italic; margin-bottom: 12px; }
  .stats-warning { background: #fffbf0; border: 1px solid #f0d080; border-radius: 10px; padding: 16px 20px; margin-top: 12px; }
  .stats-warning-title { font-family: 'DM Mono', monospace; font-size: 11px; color: var(--gold); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px; }
  .stats-warning-text { font-size: 13px; color: #6b5040; line-height: 1.6; }
  .transformation-card { background: white; border-radius: var(--radius); box-shadow: var(--shadow); border: 1px solid rgba(232,226,217,0.6); padding: 24px; margin-top: 12px; }
  .transformation-label { font-family: 'DM Mono', monospace; font-size: 10px; color: var(--sage); letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 8px; }
  .transformation-stat { font-family: 'DM Serif Display', serif; font-size: 22px; color: var(--ink); margin-bottom: 4px; }
  .transformation-sub { font-size: 12px; color: #8a7a68; }

  /* ABOUT */
  .about-card { background: white; border: 1px solid rgba(232,226,217,0.6); border-radius: var(--radius); padding: 32px; box-shadow: var(--shadow); }
  .about-field { background: var(--cream); border-radius: 10px; padding: 18px 20px; }
  .about-field-label { font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: #8a7a68; margin-bottom: 8px; }
  .about-field-text { font-size: 14px; color: var(--ink); line-height: 1.7; flex: 1; }
  .about-field-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-top: 6px; }
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 12px 0; }

  /* PAIN POINTS */
  .pain-wrap { background: #fff8f6; border: 1px solid #f5ddd8; border-radius: var(--radius); padding: 32px; margin-bottom: 48px; box-shadow: var(--shadow); }
  .pain-heading { font-family: 'DM Serif Display', serif; font-size: 28px; color: var(--rust); margin-bottom: 6px; }
  .pain-sub { font-size: 13px; color: #8a6a60; margin-bottom: 24px; line-height: 1.6; }
  .pain-card { border-left: 3px solid var(--rust); background: white; padding: 20px 24px; margin-bottom: 12px; border-radius: 0 var(--radius) var(--radius) 0; box-shadow: var(--shadow); display: flex; flex-direction: column; gap: 8px; }
  .pain-rank { font-family: 'DM Mono', monospace; font-size: 10px; color: var(--rust); letter-spacing: 0.08em; text-transform: uppercase; }
  .pain-label { font-size: 16px; font-weight: 600; color: var(--ink); }
  .pain-language { font-size: 13px; color: #5a4a38; line-height: 1.7; font-style: italic; }
  .pain-hook-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .pain-copy-hook { font-family: 'DM Mono', monospace; font-size: 11px; color: #8a7a68; flex: 1; }
  .pain-copy-hook span { color: var(--rust); }

  /* MADE WITH PURPOSE */
  .mwp-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 16px; }
  .mwp-card { background: white; border: 1px solid rgba(232,226,217,0.6); border-radius: var(--radius); padding: 22px 20px; box-shadow: var(--shadow); display: flex; flex-direction: column; gap: 8px; }
  .mwp-num { font-family: 'DM Mono', monospace; font-size: 10px; color: #8a7a68; }
  .mwp-title { font-size: 15px; font-weight: 600; color: var(--ink); line-height: 1.3; }
  .mwp-desc { font-size: 13px; color: #6b5e4a; line-height: 1.6; }
  .mwp-proof { font-size: 12px; color: #8a7a68; font-style: italic; line-height: 1.5; padding-top: 8px; border-top: 1px dashed var(--mist); }
  .mwp-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 4px; }
  .mwp-charcount { font-family: 'DM Mono', monospace; font-size: 10px; color: #8a7a68; }
  .badge-wiki { font-family: 'DM Mono', monospace; font-size: 10px; color: var(--sage); background: #f0f5ee; border: 1px solid #c8ddc4; padding: 3px 8px; border-radius: 20px; margin-top: 4px; display: inline-block; }
  .badge-verify { font-family: 'DM Mono', monospace; font-size: 10px; color: var(--gold); background: #fffbf0; border: 1px solid #f0d080; padding: 3px 8px; border-radius: 20px; margin-top: 4px; display: inline-block; }

  /* BENEFITS */
  .benefits-wrap { margin-bottom: 48px; }
  .benefit-source-tabs { display: flex; gap: 0; margin-bottom: 24px; border-bottom: 1px solid var(--mist); }
  .benefit-tab { font-family: 'DM Mono', monospace; font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; padding: 8px 16px; color: #8a7a68; cursor: default; border-bottom: 2px solid transparent; margin-bottom: -1px; }
  .benefit-tab.active { color: var(--ink); border-bottom-color: var(--ink); }
  .benefits-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 12px; }
  .benefit-card { background: white; border: 1px solid rgba(232,226,217,0.6); border-radius: var(--radius); padding: 20px; box-shadow: var(--shadow); display: flex; flex-direction: column; gap: 6px; }
  .benefit-card.placeholder { background: var(--cream); border: 1px dashed var(--mist); box-shadow: none; }
  .benefit-num { font-family: 'DM Mono', monospace; font-size: 10px; color: #8a7a68; }
  .benefit-title { font-size: 14px; font-weight: 600; color: var(--ink); line-height: 1.3; }
  .benefit-proof { font-size: 12px; color: #6b5e4a; line-height: 1.6; flex: 1; }
  .benefit-footer { display: flex; justify-content: flex-end; margin-top: 8px; }
  .fold-label { font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: #8a7a68; margin-bottom: 10px; padding-top: 16px; border-top: 1px dashed var(--mist); }

  /* COPY STATS */
  .copy-wrap { background: var(--ink); border-radius: var(--radius); padding: 36px; margin-bottom: 48px; box-shadow: var(--shadow-md); }
  .copy-heading { font-family: 'DM Serif Display', serif; font-size: 28px; color: var(--gold-light); margin-bottom: 6px; }
  .copy-sub { font-family: 'DM Mono', monospace; font-size: 11px; color: #7a6e5e; margin-bottom: 24px; letter-spacing: 0.06em; text-transform: uppercase; }
  .copy-snippet { background: rgba(255,255,255,0.05); border-left: 3px solid var(--gold); padding: 16px 20px; margin-bottom: 12px; display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; border-radius: 0 8px 8px 0; }
  .copy-snippet p { font-size: 14px; color: var(--paper); line-height: 1.6; flex: 1; }
  .copy-snippet p strong { color: var(--gold-light); }
  .copy-placement { font-family: 'DM Mono', monospace; font-size: 10px; color: #4a3e2e; display: block; margin-top: 4px; }

  /* REVIEWS */
  .reviews-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-bottom: 12px; }
  .review-card { background: #1a2e1a; border-radius: var(--radius); padding: 28px 24px; display: flex; flex-direction: column; box-shadow: var(--shadow-md); }
  .review-card-title { font-size: 14px; font-weight: 600; color: #e8d8a8; margin-bottom: 10px; line-height: 1.4; }
  .review-stars { color: var(--gold-light); font-size: 14px; letter-spacing: 2px; margin-bottom: 12px; }
  .review-text { font-size: 14px; color: #c8d8c8; line-height: 1.8; font-style: italic; flex: 1; margin-bottom: 20px; }
  .review-author-block { padding-top: 16px; border-top: 1px solid #2a4a2a; display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .review-author-name { font-family: 'DM Mono', monospace; font-size: 12px; color: #a8c4a8; font-weight: 600; margin-bottom: 2px; }
  .review-author-label { font-family: 'DM Mono', monospace; font-size: 11px; color: #7a9e7a; margin-bottom: 6px; }
  .review-theme-tag { display: inline-block; font-size: 10px; background: #2a4a2a; color: #7a9e7a; padding: 3px 8px; border-radius: 20px; }

  /* INGREDIENTS */
  .ing-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 12px; }
  .ing-card { background: white; border: 1px solid rgba(232,226,217,0.6); border-radius: var(--radius); padding: 22px 20px; box-shadow: var(--shadow); display: flex; flex-direction: column; gap: 8px; }
  .ing-card.placeholder { background: var(--cream); border: 1px dashed var(--mist); box-shadow: none; }
  .ing-num { font-family: 'DM Mono', monospace; font-size: 10px; color: #8a7a68; }
  .ing-title { font-size: 15px; font-weight: 600; color: var(--ink); line-height: 1.3; }
  .ing-desc { font-size: 13px; color: #6b5e4a; line-height: 1.6; flex: 1; }
  .ing-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 4px; }
  .ing-charcount { font-family: 'DM Mono', monospace; font-size: 10px; color: #8a7a68; }

  /* THEMES */
  .theme-pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .theme-pill { padding: 7px 14px; background: white; border: 1px solid var(--mist); border-radius: 100px; font-size: 12px; color: var(--ink); display: flex; align-items: center; gap: 8px; box-shadow: var(--shadow); }
  .theme-pill .pill-count { font-family: 'DM Mono', monospace; font-size: 10px; background: var(--ink); color: var(--gold-light); padding: 2px 7px; border-radius: 100px; }

  /* CURATED */
  .curated-wrap { background: var(--cream); border: 1px solid var(--mist); border-radius: var(--radius); padding: 32px; margin-bottom: 48px; box-shadow: var(--shadow); }
  .curated-suggestion { background: white; border: 1px solid var(--mist); border-radius: var(--radius); padding: 18px 20px; margin-bottom: 10px; box-shadow: var(--shadow); }
  .curated-num { font-family: 'DM Mono', monospace; font-size: 10px; color: var(--gold); letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 4px; }
  .curated-title { font-size: 15px; font-weight: 600; color: var(--ink); margin-bottom: 4px; }
  .curated-subhead { font-size: 13px; color: #6b5e4a; line-height: 1.6; margin-bottom: 4px; }
  .curated-context { font-size: 11px; color: #8a7a68; font-style: italic; font-family: 'DM Mono', monospace; }
  .curated-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }

  /* FAQ */
  .faq-wrap { margin-bottom: 48px; }
  .faq-instructions { background: #1a2e1a; color: #a8c4a8; font-size: 13px; line-height: 1.7; padding: 16px 20px; border-radius: var(--radius); margin-bottom: 24px; }
  .faq-instructions strong { color: var(--gold-light); }
  .faq-card { background: white; border: 1px solid rgba(232,226,217,0.6); border-radius: var(--radius); margin-bottom: 10px; overflow: hidden; box-shadow: var(--shadow); }
  .faq-card-header { padding: 18px 20px; display: flex; align-items: flex-start; gap: 14px; cursor: pointer; user-select: none; }
  .faq-card-header:hover { background: #faf8f4; }
  .faq-rank-badge { font-family: 'DM Mono', monospace; font-size: 10px; background: var(--rust); color: white; padding: 3px 8px; border-radius: 20px; flex-shrink: 0; margin-top: 2px; }
  .faq-question { font-size: 14px; font-weight: 600; color: var(--ink); line-height: 1.4; flex: 1; }
  .faq-toggle { font-size: 16px; color: #8a7a68; flex-shrink: 0; transition: transform 0.2s; }
  .faq-toggle.open { transform: rotate(180deg); }
  .faq-card-body { padding: 16px 20px 18px; border-top: 1px solid var(--mist); display: none; }
  .faq-card-body.open { display: block; }
  .faq-source { font-family: 'DM Mono', monospace; font-size: 11px; color: var(--rust); margin-bottom: 6px; }
  .faq-source-quote { font-size: 13px; color: #5a4a38; font-style: italic; line-height: 1.6; margin-bottom: 12px; }
  .faq-suggested-answer { background: var(--cream); border-radius: 8px; padding: 14px 16px; margin-bottom: 10px; }
  .faq-suggested-label { font-family: 'DM Mono', monospace; font-size: 10px; color: var(--sage); letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 6px; }
  .faq-answer-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .faq-suggested-text { font-size: 13px; color: var(--ink); line-height: 1.6; flex: 1; }
