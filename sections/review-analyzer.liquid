function exportTxt(){
  if(!lastAnalysis)return;
  var a=lastAnalysis.analysis,out='PDP INTELLIGENCE REPORT\n'+lastAnalysis.product+'\n'+lastAnalysis.analyzed.toLocaleString()+' of '+lastAnalysis.count.toLocaleString()+' reviews\n';
  if(lastAnalysis.dateRange)out+='Date range: '+lastAnalysis.dateRange+'\n';
  out+='\n=== S1 \u2014 ABOUT ===\n';
  (a.about_options||[]).forEach(function(o){out+='Option '+o.num+(o.pain_point_tag?' [Pain: '+o.pain_point_tag+']':'')+(o.benefit_tag?' [Benefit: '+o.benefit_tag+']':'')+(o.differentiator_tag?' [Diff: '+o.differentiator_tag+']':'')+'\n'+o.text+'\n\n';});
  out+='\n=== S2 \u2014 MADE WITH PURPOSE (BENEFITS) ===\n';
  (a.made_with_purpose||[]).forEach(function(m){out+='Option '+m.num+': '+m.title+'\n'+m.description+'\nWiki source: '+m.wiki_source+'\n\n';});
  out+='\n=== KEY BENEFITS ===\n';
  (a.benefits||[]).forEach(function(b){out+='Benefit '+b.rank+': '+b.title+': '+b.proof+(b.pct?' ('+b.pct+'%)':'')+'\n';});
  out+='\n=== S3 \u2014 OUTCOME STATS ===\n';
  (a.outcome_stats||[]).forEach(function(s){out+='\u2022 '+s.percentage+'% '+s.detail+'\n';});
  if(a.transformation){
    out+='\nTRANSFORMATION TIMELINE:\n';
    out+='Claim: '+a.transformation.stat+'\n';
    if(a.transformation.mention_count)out+='Mentions: '+a.transformation.mention_count+' reviews\n';
    if(a.transformation.keywords_matched)out+='Keywords: '+a.transformation.keywords_matched.join(', ')+'\n';
    if(a.transformation.sample_quotes)a.transformation.sample_quotes.forEach(function(q){out+='Quote: "'+q+'"\n';});
    out+='\n';
  }
  (a.alt_stats||[]).forEach(function(s){
    out+='ALT FRAMING:\n';
    out+='Claim: '+s.text+'\n';
    if(s.mention_count)out+='Mentions: '+s.mention_count+' reviews\n';
    if(s.keywords_matched)out+='Keywords: '+s.keywords_matched.join(', ')+'\n';
    if(s.sample_quotes)s.sample_quotes.forEach(function(q){out+='Quote: "'+q+'"\n';});
    out+='\n';
  });
  out+='\n=== S4 \u2014 REVIEWS ===\n';
  (a.reviews||[]).forEach(function(v){out+='Option '+v.num+': '+v.title+'\nPDP: "'+v.rephrased_text+'"\nOriginal: "'+v.original_text+'"\n\u2014 '+(v.original_author||'Verified Buyer')+'\n\n';});
  out+='\n=== S5 \u2014 INGREDIENTS ===\n';
  (a.ingredients||[]).forEach(function(ing){out+='Option '+ing.num+':\n'+ing.headline+'\n'+ing.subline+'\nWiki source: '+ing.wiki_source+'\n\n';});
  out+='\n=== S6 \u2014 CURATE YOUR COLLECTION ===\n';
  (a.curated_collection||[]).forEach(function(c){out+='Option '+c.num+': '+c.title+'\n'+c.subhead+'\n\n';});
  out+='\n=== S7 \u2014 FAQS ===\n';
  (a.faqs||[]).forEach(function(o){out+='#'+o.rank+' '+o.question+'\nAnswer: '+o.suggested_answer+'\n\n';});
  out+='\n=== PAIN POINTS ===\n';
  (a.pain_points||[]).forEach(function(p){out+='#'+p.rank+' '+p.label+'\n"'+p.customer_language+'"\n\n';});
  var blob=new Blob([out],{type:'text/plain'}),url=URL.createObjectURL(blob),link=document.createElement('a');
  link.href=url;link.download=lastAnalysis.product.replace(/\s+/g,'-')+'-pdp-intel.txt';link.click();
}

var _loadTimer=null,_loadStart=0;
function showLoading(c){
  document.getElementById('raLoading').classList.add('active');
  document.getElementById('loadingCount').textContent=c.toLocaleString();
  ['step1','step2','step3','step4'].forEach(function(s){document.getElementById(s).className='loading-step';});
  _loadStart=Date.now();document.getElementById('loadingBar').style.width='0%';document.getElementById('loadingTimer').textContent='0s elapsed';
  if(_loadTimer)clearInterval(_loadTimer);
  _loadTimer=setInterval(function(){
    var elapsed=Math.round((Date.now()-_loadStart)/1000);
    document.getElementById('loadingTimer').textContent=elapsed+'s elapsed';
    document.getElementById('loadingBar').style.width=Math.min(90,elapsed*3)+'%';
  },1000);
}
function hideLoading(){document.getElementById('raLoading').classList.remove('active');if(_loadTimer){clearInterval(_loadTimer);_loadTimer=null;}document.getElementById('loadingBar').style.width='100%';}
function showResults(){document.getElementById('raResults').classList.add('active');}
function hideResults(){document.getElementById('raResults').classList.remove('active');}
function showError(m){var b=document.getElementById('errorBox');b.textContent=m;b.classList.add('active');}
function hideError(){document.getElementById('errorBox').classList.remove('active');}
function stepActive(id){document.getElementById(id).classList.add('active');}
function stepDone(id){document.getElementById(id).classList.remove('active');document.getElementById(id).classList.add('done');}
</script>

