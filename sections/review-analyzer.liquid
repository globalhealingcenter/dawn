<script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
<script>
var allReviews=[],lastAnalysis=null;
var THRESHOLD=72;
var DEFAULTS={about_chars:204,mwp_chars:73,review_chars:200,ing_chars:120,stat_chars:20,faq_count:8};

function getSettings(){
  return {
    about_chars:parseInt(document.getElementById('set_about_chars').value)||DEFAULTS.about_chars,
    mwp_chars:parseInt(document.getElementById('set_mwp_chars').value)||DEFAULTS.mwp_chars,
    review_chars:parseInt(document.getElementById('set_review_chars').value)||DEFAULTS.review_chars,
    ing_chars:parseInt(document.getElementById('set_ing_chars').value)||DEFAULTS.ing_chars,
    stat_chars:parseInt(document.getElementById('set_stat_chars').value)||DEFAULTS.stat_chars,
    faq_count:8
  };
}

function togglePanel(pId,aId){var p=document.getElementById(pId),a=document.getElementById(aId);p.classList.toggle('open');a.classList.toggle('open');}

document.getElementById('uploadZone').addEventListener('dragover',function(e){e.preventDefault();this.classList.add('drag-over');});
document.getElementById('uploadZone').addEventListener('dragleave',function(){this.classList.remove('drag-over');});
document.getElementById('uploadZone').addEventListener('drop',function(e){e.preventDefault();this.classList.remove('drag-over');if(e.dataTransfer.files[0])processFile(e.dataTransfer.files[0]);});
document.getElementById('csvFile').addEventListener('change',function(e){if(e.target.files[0])processFile(e.target.files[0]);});

function processFile(file){
  Papa.parse(file,{header:true,skipEmptyLines:true,complete:function(r){
    allReviews=r.data;
    var products=getProducts(allReviews),counts=getProductCounts(allReviews);
    var sel=document.getElementById('productSelect');
    sel.innerHTML='<option value="">— choose a product —</option>';
    products.forEach(function(p){var o=document.createElement('option');o.value=p;o.textContent=p+' ('+(counts[p]||0).toLocaleString()+' reviews)';sel.appendChild(o);});
    sel.disabled=false;document.getElementById('analyzeBtn').disabled=false;
    document.getElementById('uploadZone').style.display='none';
    document.getElementById('fileLoaded').style.display='flex';
    document.getElementById('fileName').textContent=file.name;
    document.getElementById('reviewCount').textContent=allReviews.length.toLocaleString();
    document.getElementById('productCount').textContent=products.length.toLocaleString();
  },error:function(){showError("Couldn't parse CSV.");}});
}

function getProductCol(reviews){var keys=['product_title','Product Title','product_name','Product Name','title','name'];for(var i=0;i<keys.length;i++){if(reviews[0]&&reviews[0][keys[i]]!==undefined)return keys[i];}return null;}
function getProducts(reviews){var col=getProductCol(reviews);if(!col)return['All Reviews'];var set=new Set(reviews.map(function(r){return r[col];}).filter(Boolean));return Array.from(set).sort();}
function getProductCounts(reviews){var col=getProductCol(reviews);if(!col)return{};var c={};reviews.forEach(function(r){var p=r[col];if(p)c[p]=(c[p]||0)+1;});return c;}
function getReviewsForProduct(p){if(p==='All Reviews')return allReviews;var col=getProductCol(allReviews);if(!col)return allReviews;return allReviews.filter(function(r){return r[col]===p;});}
function getDateCol(r){var keys=['review creation date','Review Creation Date','created_at','Created At','date','Date','review_date'];for(var i=0;i<keys.length;i++){if(r&&r[keys[i]]!==undefined)return keys[i];}return null;}
function sortByDateDesc(reviews){var dc=getDateCol(reviews[0]);if(!dc)return reviews;return reviews.slice().sort(function(a,b){return new Date(b[dc]||0)-new Date(a[dc]||0);});}
function getDateRange(reviews){var dc=getDateCol(reviews[0]);if(!dc)return null;var dates=reviews.map(function(r){return new Date(r[dc]);}).filter(function(d){return !isNaN(d);});if(!dates.length)return null;dates.sort(function(a,b){return a-b;});var fmt=function(d){return d.toLocaleDateString('en-US',{month:'short',year:'numeric'});};return fmt(dates[0])+' \u2013 '+fmt(dates[dates.length-1]);}
function getAuthorCol(r){var keys=['Reviewer Display Name','reviewer display name','display name','Display Name','reviewer_name','Reviewer Name','author','Author'];for(var i=0;i<keys.length;i++){if(r&&r[keys[i]]!==undefined)return keys[i];}return null;}
function getReviewText(r){var keys=['review_content','Review Content','body','Body','content','Content','review','Review','comment','Comment'];for(var i=0;i<keys.length;i++){if(r[keys[i]]&&r[keys[i]].trim())return r[keys[i]].trim();}return Object.values(r).find(function(v){return v&&v.length>40;})||'';}

var GENERIC_TERMS=['plant-based','plant based','made in usa','pharmaceutical free','pharmaceutical-free','non-gmo','gluten free','gluten-free','vegan','soy free','soy-free','dairy free','dairy-free','organic certified','certified organic','no fillers','no additives','inner leaf only','freeze-dried potency','freeze dried','purity-tested','purity tested','made in the usa','cgmp','third-party tested','sourced','source &','source and quality','backed by research'];

function buildPrompt(product,count,wikiSection,s,reviewTexts){
  var schema='{"sentiment":{"positive":0,"neutral":0,"negative":0},'
    +'"pain_points":[{"rank":1,"label":"","customer_language":"","copy_hook":"","main_benefit":""}],'
    +'"about_options":[{"num":1,"text":"max 204 chars","pain_point_tag":"2-4 word label","benefit_tag":"2-4 word label","differentiator_tag":"2-4 word label"}],'
    +'"made_with_purpose":[{"num":1,"title":"2-3 words","description":"","wiki_source":"exact quoted sentence from wiki"}],'
    +'"benefits":[{"rank":1,"title":"","proof":"","pct":0}],'
    +'"outcome_stats":[{"percentage":0,"detail":"max 20 chars","count":0}],'
    +'"transformation":{"stat":"X in Y customers [result] within [timeframe]","timeframe":"within X weeks","fraction":"X in Y","percentage":0,"sub":"Based on [timeframe] language in reviews","mention_count":0,"keywords_matched":["keyword1","keyword2"],"sample_quotes":["verbatim quote 1","verbatim quote 2","verbatim quote 3"]},'
    +'"alt_stats":[{"text":"X in Y customers [outcome] within [timeframe]","sub":"[timeframe] · [count] reviewers","mention_count":0,"keywords_matched":["keyword1","keyword2"],"sample_quotes":["verbatim quote 1","verbatim quote 2","verbatim quote 3"]}],'
    +'"reviews":[{"num":1,"title":"","rephrased_text":"","original_text":"","original_author":"","theme":""}],'
    +'"ingredients":[{"num":1,"headline":"plain text headline","keyword":"word to italicize","subline":"","wiki_source":"exact quoted sentence from wiki"}],'
    +'"curated_collection":[{"num":1,"title":"","subhead":"","context":""}],'
    +'"faqs":[{"rank":1,"question":"","source_language":"","suggested_answer":"","answer_note":""}]}';

  return 'Conversion copywriter for Global Healing supplements. Analyze '+count+' reviews for "'+product+'".'+wikiSection
    +'\nReturn ONLY valid JSON matching this schema:\n'+schema
    +'\nCRITICAL RULES:'
    +'\n- about_options: exactly 5. HARD LIMIT: 204 characters maximum — count every character including spaces and punctuation. If over 204 characters, remove the least essential clause entirely, do not compress. Each option contains exactly TWO elements only: (1) the customer CONDITION as the customer experiences it — what they FEEL, not what is happening clinically and not what competitor products do wrong. Use customer-felt language: constipation, bloating, sluggish digestion, pressure, heaviness. DO NOT open with clinical concepts (microbiome disruption, intestinal inflammation, gut dysbiosis) or competitor problems (stimulant laxatives force contractions, fiber adds bulk) — those belong in the differentiator if anywhere. Stated as a plain declarative fact from review language — NO question marks, NO casual openers; (2) the ingredient mechanism — name the specific ingredient and the chemical or physiological action it takes in the body. After the mechanism, you may add a crisp 2-3 item outcome rhythm (e.g. "loosen impacted waste, soften buildup, promote complete bowel movements") but NO clunky connectors like "that breaks down" or "that reduces that feeling of" — use declarative outcome phrases. Do NOT add product name, stats, or contrast as a third element. Tone: declarative, precise, reads like an expert. BANNED: question marks, casual openers, metaphors, clunky connectors, reset, journey, lighter, balance, harmony, supports, promotes, boosts, enhances, detox, cleanse, natural, powerful. ZERO health claims: no diagnose, treat, cure, prevent, reverses, heals, clinically proven. Add pain_point_tag (2-4 words — must be customer-felt, e.g. "Chronic constipation", "Bloating pressure"; NOT "Stimulant laxative harm" or "Microbiome disruption"), benefit_tag (2-4 words), differentiator_tag (2-4 words naming the mechanism e.g. oxygen-based, methylcobalamin form, ozonated magnesium) for each option.'
    +'\n- pain_points: exactly 4, ranked by frequency'
    +'\n- made_with_purpose: exactly 5, from the "Health Benefits & Function" wiki section only — functional bullets about what ingredients do in the body. NOT Source & Quality, certifications, or manufacturing. Title 2-3 words, desc under '+s.mwp_chars+' chars. wiki_source: copy the exact sentence from the wiki that informed this card.'
    +'\n- benefits: exactly 4 (rank 1-2 primary, 3-4 additional). No disease treatment claims.'
    +'\n- outcome_stats: 4-6 items. detail field max 20 chars, distinct non-redundant outcomes. No disease claims.'
    +'\n- transformation: fraction (e.g. "3 in 4") AND specific timeframe (e.g. "within 2 weeks"). Mine time-to-result language. REQUIRED for substantiation: mention_count (exact count of reviews containing the timeframe language), keywords_matched (array of 3-6 exact phrases searched for, e.g. ["within 2 weeks", "after 2 weeks", "by week 2"]), sample_quotes (3 verbatim quotes from reviews containing this timeframe, copied EXACTLY as written by the customer — do not paraphrase).'
    +'\n- alt_stats: 2-3 items each with fraction AND timeframe. REQUIRED for substantiation: mention_count, keywords_matched (3-6 exact phrases), sample_quotes (3 verbatim quotes, EXACT customer wording).'
    +'\n- reviews: exactly 8. rephrased_text is the AI-polished version for the PDP. original_text is the verbatim customer review. Prioritize named authors. Under '+s.review_chars+' chars for rephrased_text.'
    +'\n- ingredients: 5 combined editorial headlines treating ALL ingredients as one story. No asterisks in headline. keyword = single word to italicize. subline under '+s.ing_chars+' chars. wiki_source: exact quoted sentence from wiki.'
    +'\n- curated_collection: 3. No disease claims.'
    +'\n- faqs: 8 purchase-blocking hesitations with suggested answers. No disease treatment claims in answers.'
    +'\nReviews:\n'+reviewTexts;
}

async function runAnalysis(){
  var product=document.getElementById('productSelect').value;
  if(!product){showError('Please select a product.');return;}
  var reviews=getReviewsForProduct(product);
  if(!reviews.length){showError('No reviews found.');return;}
  var wiki=document.getElementById('wikiText').value.trim();
  if(!wiki){if(!confirm('Product wiki is empty. Made With Purpose and Ingredients will be less accurate. Continue anyway?')){return;}}
  var settings=getSettings();
  hideError();showLoading(reviews.length);hideResults();

  var sorted=sortByDateDesc(reviews);
  var sample=sorted.slice(0,500);
  var dateRange=getDateRange(sample);
  var authorCol=getAuthorCol(sample[0]);

  var reviewTexts=sample.map(function(r){
    var text=getReviewText(r);
    var author=authorCol&&r[authorCol]?r[authorCol].trim():'';
    var isAnon=!author||author.toLowerCase()==='verified buyer'||author.toLowerCase()==='anonymous'||author.length<2;
    return (isAnon?'[ANON]: ':'['+author+']: ')+text;
  }).filter(function(t){return t.length>20;}).join('\n---\n');

  var wikiSection=wiki?'\n\nPRODUCT WIKI:\n'+wiki.substring(0,4000)+'\n':'';
  stepActive('step1');
  var prompt=buildPrompt(product,sample.length,wikiSection,settings,reviewTexts);
  stepDone('step1');stepActive('step2');

  async function doFetch(p){
    var response=await fetch('https://ecom-claude-proxy.globalhealing.workers.dev',{
      method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({model:'claude-sonnet-4-6',max_tokens:8000,messages:[{role:'user',content:p}]})
    });
    if(!response.ok){var et=await response.text();throw new Error(et||'API error');}
    return await response.text();
  }

  try{
    var rawText;
    try{rawText=await doFetch(prompt);}
    catch(e1){
      if(e1.message.indexOf('524')!==-1||e1.message.indexOf('overloaded')!==-1||e1.message.indexOf('529')!==-1){
        document.getElementById('loadingTimer').textContent='Retrying\u2026';
        await new Promise(function(r){setTimeout(r,3000);});
        rawText=await doFetch(prompt);
      } else {throw e1;}
    }
    stepDone('step2');stepActive('step3');stepDone('step3');stepActive('step4');
    var envelope;try{envelope=JSON.parse(rawText);}catch(e){envelope=null;}
    var inner=envelope&&envelope.content&&envelope.content[0]&&envelope.content[0].text||rawText;
    var jm=inner.replace(/```json|```/g,'').trim().match(/\{[\s\S]*\}/);
    if(!jm){hideLoading();showError('Could not parse response. Try again.');return;}
    var analysis;
    try{analysis=JSON.parse(jm[0]);}catch(e){hideLoading();showError('Parse error. Try again.');return;}
    lastAnalysis={product:product,analysis:analysis,count:reviews.length,analyzed:sample.length,dateRange:dateRange,settings:settings};
    stepDone('step4');
    setTimeout(function(){hideLoading();renderResults(product,reviews.length,sample.length,analysis,dateRange,settings);},400);
  }catch(err){hideLoading();showError('Analysis failed: '+err.message);}
}

function copyText(text){
  var clean=String(text).replace(/<[^>]+>/g,'').replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&quot;/g,'"').replace(/&#39;/g,"'");
  navigator.clipboard.writeText(clean);
}
function makeCopyBtn(text,darkMode){
  var btn=document.createElement('button');
  btn.className=darkMode?'btn-copy-dk':'btn-copy';btn.textContent='Copy';
  btn.addEventListener('click',function(){copyText(text);btn.textContent='Copied!';btn.classList.add('copied');setTimeout(function(){btn.textContent='Copy';btn.classList.remove('copied');},2000);});
  return btn;
}
function isGeneric(text){var lower=(text||'').toLowerCase();return GENERIC_TERMS.some(function(t){return lower.indexOf(t)!==-1;});}
function makeWikiSourceCol(wikiSource){
  var col=document.createElement('div');col.className='wiki-source-col';
  var lbl=document.createElement('div');lbl.className='wiki-source-label';lbl.textContent='From wiki:';
  var quote=document.createElement('div');quote.className='wiki-source-quote';quote.textContent=wikiSource||'\u2014';
  col.appendChild(lbl);col.appendChild(quote);return col;
}

