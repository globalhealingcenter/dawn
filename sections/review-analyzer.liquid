<script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
<script>
var allReviews = [], lastAnalysis = null;
var THRESHOLD = 72;

// ── DEFAULTS (edit these to change output targets) ──
var DEFAULTS = {
  about_words: 30,
  mwp_desc_chars: 73,
  mwp_title_words: 3,
  review_title_words: 10,
  ing_title_chars: 40,
  ing_desc_chars: 120,
  faq_count: 10,
  copy_count: 4,
  review_count: 4
};

function getSettings(){
  return {
    about_words: parseInt(document.getElementById('set_about_words').value)||DEFAULTS.about_words,
    mwp_desc_chars: parseInt(document.getElementById('set_mwp_chars').value)||DEFAULTS.mwp_desc_chars,
    mwp_title_words: parseInt(document.getElementById('set_mwp_title_words').value)||DEFAULTS.mwp_title_words,
    review_title_words: parseInt(document.getElementById('set_review_title_words').value)||DEFAULTS.review_title_words,
    ing_title_chars: parseInt(document.getElementById('set_ing_title_chars').value)||DEFAULTS.ing_title_chars,
    ing_desc_chars: parseInt(document.getElementById('set_ing_desc_chars').value)||DEFAULTS.ing_desc_chars,
    faq_count: parseInt(document.getElementById('set_faq_count').value)||DEFAULTS.faq_count,
    copy_count: parseInt(document.getElementById('set_copy_count').value)||DEFAULTS.copy_count,
    review_count: parseInt(document.getElementById('set_review_count').value)||DEFAULTS.review_count
  };
}

function scrollTo(id){ var el=document.getElementById(id); if(el) el.scrollIntoView({behavior:'smooth',block:'start'}); }

function toggleWiki(){
  var panel=document.getElementById('wikiPanel'), arrow=document.getElementById('wikiArrow');
  panel.classList.toggle('open'); arrow.classList.toggle('open');
}

function toggleSettings(){
  var panel=document.getElementById('settingsPanel'), arrow=document.getElementById('settingsArrow');
  panel.classList.toggle('open'); arrow.classList.toggle('open');
}

document.getElementById('uploadZone').addEventListener('dragover', function(e){ e.preventDefault(); this.classList.add('drag-over'); });
document.getElementById('uploadZone').addEventListener('dragleave', function(){ this.classList.remove('drag-over'); });
document.getElementById('uploadZone').addEventListener('drop', function(e){ e.preventDefault(); this.classList.remove('drag-over'); if(e.dataTransfer.files[0]) processFile(e.dataTransfer.files[0]); });
document.getElementById('csvFile').addEventListener('change', function(e){ if(e.target.files[0]) processFile(e.target.files[0]); });

function processFile(file){
  Papa.parse(file,{ header:true, skipEmptyLines:true, complete:function(r){
    allReviews = r.data;
    var products = getProducts(allReviews);
    var productCounts = getProductCounts(allReviews);
    var sel = document.getElementById('productSelect');
    sel.innerHTML = '<option value="">— choose a product —</option>';
    products.forEach(function(p){
      var o=document.createElement('option'); o.value=p;
      var count=productCounts[p]||0;
      o.textContent=p+' ('+count.toLocaleString()+' reviews)';
      sel.appendChild(o);
    });
    sel.disabled=false; document.getElementById('analyzeBtn').disabled=false;
    document.getElementById('uploadZone').style.display='none';
    document.getElementById('fileLoaded').style.display='flex';
    document.getElementById('fileName').textContent=file.name;
    document.getElementById('reviewCount').textContent=allReviews.length.toLocaleString();
    document.getElementById('productCount').textContent=products.length.toLocaleString();
  }, error:function(){ showError("Couldn't parse CSV."); }});
}

function getProductCol(reviews){
  var keys=['product_title','Product Title','product_name','Product Name','title','name'];
  for(var i=0;i<keys.length;i++){ if(reviews[0]&&reviews[0][keys[i]]!==undefined) return keys[i]; }
  return null;
}
function getProducts(reviews){
  var col=getProductCol(reviews);
  if(!col) return['All Reviews'];
  var set=new Set(reviews.map(function(r){return r[col];}).filter(Boolean));
  return Array.from(set).sort();
}
function getProductCounts(reviews){
  var col=getProductCol(reviews); if(!col) return {};
  var counts={};
  reviews.forEach(function(r){ var p=r[col]; if(p){ counts[p]=(counts[p]||0)+1; } });
  return counts;
}
function getReviewsForProduct(product){
  if(product==='All Reviews') return allReviews;
  var col=getProductCol(allReviews); if(!col) return allReviews;
  return allReviews.filter(function(r){return r[col]===product;});
}
function getDateCol(review){
  var keys=['review creation date','Review Creation Date','created_at','Created At','date','Date','review_date'];
  for(var i=0;i<keys.length;i++){ if(review&&review[keys[i]]!==undefined) return keys[i]; }
  return null;
}
function sortByDateDesc(reviews){
  var dateCol=getDateCol(reviews[0]); if(!dateCol) return reviews;
  return reviews.slice().sort(function(a,b){ return new Date(b[dateCol]||0)-new Date(a[dateCol]||0); });
}
function getDateRange(reviews){
  var dateCol=getDateCol(reviews[0]); if(!dateCol) return null;
  var dates=reviews.map(function(r){return new Date(r[dateCol]);}).filter(function(d){return !isNaN(d);});
  if(!dates.length) return null;
  dates.sort(function(a,b){return a-b;});
  var fmt=function(d){return d.toLocaleDateString('en-US',{month:'short',year:'numeric'});};
  return fmt(dates[0])+' – '+fmt(dates[dates.length-1]);
}
function getAuthorCol(review){
  var keys=['display name','Display Name','reviewer_name','Reviewer Name','author','Author'];
  for(var i=0;i<keys.length;i++){ if(review&&review[keys[i]]!==undefined) return keys[i]; }
  return null;
}
function getReviewText(review){
  var keys=['review_content','Review Content','body','Body','content','Content','review','Review','comment','Comment'];
  for(var i=0;i<keys.length;i++){ if(review[keys[i]]&&review[keys[i]].trim()) return review[keys[i]].trim(); }
  return Object.values(review).find(function(v){return v&&v.length>40;})||'';
}

async function runAnalysis(){
  var product=document.getElementById('productSelect').value;
  if(!product){showError('Please select a product.');return;}
  var reviews=getReviewsForProduct(product);
  if(!reviews.length){showError('No reviews found.');return;}
  var wiki=document.getElementById('wikiText').value.trim();
  var settings=getSettings();
  hideError(); showLoading(reviews.length); hideResults();

  var sorted=sortByDateDesc(reviews);
  var sample=sorted.slice(0,2000);
  var dateRange=getDateRange(sample);

  var authorCol=getAuthorCol(sample[0]);
  var reviewTexts=sample.map(function(r){
    var text=getReviewText(r);
    var author=authorCol&&r[authorCol]?r[authorCol].trim():'';
    return (author?'['+author+']: ':'')+text;
  }).filter(function(t){return t.length>20;}).join('\n---\n');

  var wikiSection=wiki?'\n\nPRODUCT WIKI:\n'+wiki.substring(0,4000)+'\n':'';

  stepActive('step1');

  var prompt='You are a conversion copywriter and VoC analyst for a premium supplement brand. Analyze these '+sample.length+' reviews for "'+product+'".'+wikiSection+'\n\nReturn ONLY valid JSON, no markdown, no preamble:\n{\n  "sentiment": {"positive":number,"neutral":number,"negative":number},\n  "pain_points": [{"label":"short name","customer_language":"verbatim phrase from reviews"}],\n  "about": {\n    "pain_opener": "1-2 sentence opener using customer pain language — the before state. Max 30 words.",\n    "main_benefit": "The single most powerful benefit this product delivers, grounded in review outcomes. 1 sentence.",\n    "description": "Product description leading with transformation not features. Max '+settings.about_words+' words. Present tense, active voice."\n  },\n  "made_with_purpose": [\n    {"title":"2-'+settings.mwp_title_words+' word benefit title","description":"Under '+settings.mwp_desc_chars+' chars. Specific, outcome-focused. No filler.","wiki_informed":true_or_false}\n  ],\n  "outcome_stats": [{"percentage":number,"label":"2-word outcome label","detail":"reported [outcome]","count":number}],\n  "transformation": {"stat":"X% noticed a difference within [timeframe]","timeframe":"e.g. 2 weeks","percentage":number,"sub":"Based on review language about time-to-result"},\n  "copy_snippets": [{"text":"copy-ready sentence with <strong>stat</strong> bolded","placement":"e.g. PDP stat bar, above fold, social ad"}],\n  "reviews": [{"title":"Compelling review title, max '+settings.review_title_words+' words. Active, specific.","rephrased_text":"Rephrased for clarity and copy quality. Preserve the essence and author voice exactly. Max 80 words.","original_author":"verbatim from [author]: prefix or Verified Buyer","theme":"main theme tag"}],\n  "ingredients": [{"title":"Ingredient name, max '+settings.ing_title_chars+' chars","description":"Benefit-led description, max '+settings.ing_desc_chars+' chars. Plain language.","wiki_informed":true_or_false}],\n  "curated_collection": [{"option_num":1,"title":"Collection section title","subhead":"1 sentence — frames the customer journey, not a product list"}],\n  "faqs": [{"rank":1,"question":"Purchase hesitation as a question","source_language":"verbatim phrase from reviews","answer_prompt":"What Jane should address in the answer"}],\n  "themes": [{"label":"theme","count":number}]\n}\n\nRules:\n- pain_points: exactly 3, real verbatim phrases\n- about.description: max '+settings.about_words+' words, count carefully\n- made_with_purpose: exactly 3 cards. wiki_informed=true only if wiki text was provided and informed the card\n- outcome_stats: 4-5 items, real percentages from review language\n- transformation: always include — mine "within X days/weeks" language\n- copy_snippets: exactly '+settings.copy_count+' items\n- reviews: exactly '+settings.review_count+'. Always include original_author verbatim. Rephrase text for copy quality but keep the essence and factual claims.\n- ingredients: exactly 3. If no wiki, extract from review language and set wiki_informed=false\n- curated_collection: exactly 3 options\n- faqs: exactly '+settings.faq_count+' ranked by frequency in reviews. Lead with purchase hesitations not safety questions.\n- themes: 6-8 by frequency\n\nReviews:\n'+reviewTexts;

  stepDone('step1'); stepActive('step2');

  try{
    var response=await fetch('https://ecom-claude-proxy.globalhealing.workers.dev',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({model:'claude-sonnet-4-5',max_tokens:6000,messages:[{role:'user',content:prompt}]})
    });
    stepDone('step2'); stepActive('step3');
    if(!response.ok){var err=await response.text();throw new Error(err||'API error');}
    var data=await response.text();
    stepDone('step3'); stepActive('step4');
    var clean=data.replace(/```json|```/g,'').trim();
    // extract JSON object if wrapped in other text
    var jsonMatch=clean.match(/\{[\s\S]*\}/);
    if(!jsonMatch){hideLoading();showError('Could not find JSON in response.');return;}
    var analysis;
    try{ analysis=JSON.parse(jsonMatch[0]); }
    catch(e){ hideLoading(); showError('Parse error. Try again.'); return; }
    lastAnalysis={product:product,analysis:analysis,count:reviews.length,analyzed:sample.length,dateRange:dateRange,settings:settings,hasWiki:!!wiki};
    stepDone('step4');
    setTimeout(function(){hideLoading();renderResults(product,reviews.length,sample.length,analysis,dateRange,settings,!!wiki);},400);
  }catch(err){hideLoading();showError('Analysis failed: '+err.message);}
}

function renderResults(product,total,analyzed,a,dateRange,settings,hasWiki){
  document.getElementById('resultsTitle').textContent=product;
  document.getElementById('resultsMeta').innerHTML=analyzed.toLocaleString()+' of '+total.toLocaleString()+' reviews analyzed<br>(most recent first)';
  if(dateRange){ document.getElementById('dateRangeBadge').style.display='inline-flex'; document.getElementById('dateRangeText').textContent='Reviews: '+dateRange; }

  // ── S1 ABOUT ──
  var painTags=document.getElementById('painTagsRow'); painTags.innerHTML='';
  (a.pain_points||[]).forEach(function(p){
    var tag=document.createElement('span'); tag.className='pain-tag'; tag.textContent=p.label; painTags.appendChild(tag);
  });

  if(a.about){
    document.getElementById('aboutPainOpener').textContent=a.about.pain_opener||'';
    document.getElementById('aboutMainBenefit').textContent=a.about.main_benefit||'';
    document.getElementById('aboutDescription').textContent=a.about.description||'';
    var wc=(a.about.description||'').split(/\s+/).filter(Boolean).length;
    document.getElementById('aboutWordCount').textContent=wc;
  }

  // ── S2 MADE WITH PURPOSE ──
  document.getElementById('mwpCharLimit').textContent=settings.mwp_desc_chars;
  var mwpGrid=document.getElementById('mwpGrid'); mwpGrid.innerHTML='';
  (a.made_with_purpose||[]).forEach(function(m,i){
    var charCount=(m.description||'').length;
    var overLimit=charCount>settings.mwp_desc_chars;
    var card=document.createElement('div'); card.className='mwp-card';
    var safeTitle=esc(m.title); var safeDesc=esc(m.description);
    card.innerHTML='<div class="mwp-num">Benefit 0'+(i+1)+'</div>'
      +'<div class="mwp-title">'+safeTitle+'</div>'
      +'<div class="mwp-desc">'+safeDesc+'</div>'
      +'<div class="mwp-footer">'
        +'<div>'
          +'<div class="mwp-charcount">'+(overLimit?'<span style="color:var(--rust)">':'')+charCount+' / '+settings.mwp_desc_chars+' chars'+(overLimit?'</span>':'')+'</div>'
          +(m.wiki_informed?'<div class="mwp-verify" style="color:var(--sage);background:#f0f5ee;border-color:#c8ddc4;">✓ Wiki-informed</div>':'<div class="mwp-verify">Verify against wiki</div>')
        +'</div>'
        +'<button class="btn-copy-sm" onclick="copyText(this,\''+safeTitle+': '+safeDesc+'\')">Copy</button>'
      +'</div>';
    mwpGrid.appendChild(card);
  });

  // ── S3 REAL CUSTOMERS ──
  var statsGrid=document.getElementById('rcStatsGrid'); statsGrid.innerHTML='';
  var maxPct=0;
  (a.outcome_stats||[]).forEach(function(s){
    if(s.percentage>maxPct) maxPct=s.percentage;
    var card=document.createElement('div'); card.className='rc-stat-card';
    card.innerHTML='<div class="rc-stat-card-accent"></div>'
      +'<div class="rc-stat-pct">'+s.percentage+'%</div>'
      +'<div class="rc-stat-label">'+esc(s.detail)+'</div>'
      +'<div class="rc-stat-detail">'+s.count+' of '+analyzed.toLocaleString()+' reviewers</div>';
    statsGrid.appendChild(card);
  });
  document.getElementById('rcFootnote').textContent='Based on '+analyzed.toLocaleString()+' Yotpo verified purchase reviews (most recent). Results reflect customer-reported outcomes — individual experiences may vary.';

  var strongStats=(a.outcome_stats||[]).filter(function(s){return s.percentage>=THRESHOLD;});
  var showWarning=strongStats.length<=1;
  if(showWarning){
    document.getElementById('rcWarning').style.display='block';
    document.getElementById('rcWarningText').textContent=maxPct<THRESHOLD
      ?'All outcome stats for this product are below 72%. Jane: avoid leading with raw percentages on the PDP. Use the transformation timeframe framing below instead.'
      :'Only one stat clears 72%. Jane: the transformation timeframe below may be stronger as the lead claim on this PDP.';
  } else {
    document.getElementById('rcWarning').style.display='none';
  }

  if(a.transformation){
    document.getElementById('rcTransformCard').style.display='block';
    document.getElementById('rcTransformStat').textContent=a.transformation.stat;
    document.getElementById('rcTransformSub').textContent=a.transformation.sub+(showWarning?' — Jane: consider using this as the lead stat instead of outcome percentages.':" — Jane: use this as a supporting stat alongside the outcome percentages.");
  }

  var copySnips=document.getElementById('rcCopySnippets'); copySnips.innerHTML='';
  (a.copy_snippets||[]).forEach(function(s){
    var d=document.createElement('div'); d.className='rc-copy-snippet';
    var safeText=esc(s.text.replace(/<[^>]+>/g,''));
    d.innerHTML='<div style="flex:1"><p>'+s.text+'</p><span class="rc-copy-placement">— '+esc(s.placement)+'</span></div>'
      +'<button class="btn-copy" style="border-color:#4a3e2e;color:#8a7a68;" onclick="copyText(this,\''+safeText+'\')">Copy</button>';
    copySnips.appendChild(d);
  });

  // ── S4 REVIEWS ──
  var verbs=document.getElementById('verbatimCards'); verbs.innerHTML='';
  (a.reviews||[]).forEach(function(v){
    var authorName=v.original_author&&v.original_author.toLowerCase()!=='verified buyer'?v.original_author:'';
    var c=document.createElement('div'); c.className='review-card';
    var safeTitle=esc(v.title); var safeText=esc(v.rephrased_text); var safeAuthor=esc(authorName);
    c.innerHTML='<div class="review-card-top">'
        +'<div class="review-title-row">'
          +'<div class="review-title">'+safeTitle+'</div>'
          +'<div class="review-stars">★★★★★</div>'
        +'</div>'
        +'<div class="review-text">&#8220;'+safeText+'&#8221;</div>'
      +'</div>'
      +'<div class="review-author-block">'
        +'<div>'
          +(authorName?'<div class="review-author-name">'+safeAuthor+'</div>':'')
          +'<div class="review-author-label">Verified Buyer</div>'
          +'<span class="review-theme-tag">'+esc(v.theme)+'</span>'
        +'</div>'
        +'<button class="btn-copy-sm" style="border-color:#2a4a2a;color:#7a9e7a;" onclick="copyText(this,\''+safeTitle+': \\u201c'+safeText+'\\u201d — '+safeAuthor+'\')">Copy</button>'
      +'</div>';
    verbs.appendChild(c);
  });

  // ── S5 INGREDIENTS ──
  document.getElementById('ingTitleLimit').textContent=settings.ing_title_chars;
  document.getElementById('ingDescLimit').textContent=settings.ing_desc_chars;
  var ingGrid=document.getElementById('ingGrid'); ingGrid.innerHTML='';
  var ingredients=a.ingredients||[];
  if(!ingredients.length){
    for(var i=0;i<3;i++){
      var pc=document.createElement('div'); pc.className='ing-card placeholder';
      pc.innerHTML='<div class="ing-num">Ingredient 0'+(i+1)+'</div><div class="ing-title">[Ingredient name]</div><div class="ing-desc">Paste the product wiki above and re-run to generate ingredient descriptions.</div><div class="ing-footer"><div class="ing-wiki-badge">Needs wiki</div></div>';
      ingGrid.appendChild(pc);
    }
  } else {
    ingredients.forEach(function(ing,i){
      var titleLen=(ing.title||'').length;
      var descLen=(ing.description||'').length;
      var titleOver=titleLen>settings.ing_title_chars;
      var descOver=descLen>settings.ing_desc_chars;
      var card=document.createElement('div'); card.className='ing-card';
      var safeTitle=esc(ing.title); var safeDesc=esc(ing.description);
      card.innerHTML='<div class="ing-num">Ingredient 0'+(i+1)+'</div>'
        +'<div class="ing-title">'+safeTitle+'</div>'
        +'<div class="ing-desc">'+safeDesc+'</div>'
        +'<div class="ing-footer">'
          +'<div>'
            +'<div class="ing-charcount">'+(titleOver?'<span style="color:var(--rust)">':'')+titleLen+'/'+settings.ing_title_chars+(titleOver?'</span>':'')+' title · '+(descOver?'<span style="color:var(--rust)">':'')+descLen+'/'+settings.ing_desc_chars+(descOver?'</span>':'')+' desc</div>'
            +(ing.wiki_informed?'<div class="ing-wiki-badge">✓ Wiki-informed</div>':'<div class="ing-wiki-badge" style="color:var(--gold);background:#fffbf0;border-color:#f0d080;">Verify wiki</div>')
          +'</div>'
          +'<button class="btn-copy-sm" onclick="copyText(this,\''+safeTitle+': '+safeDesc+'\')">Copy</button>'
        +'</div>';
      ingGrid.appendChild(card);
    });
  }

  // ── S6 CURATE ──
  var curateCards=document.getElementById('curateCards'); curateCards.innerHTML='';
  (a.curated_collection||[]).forEach(function(c){
    var d=document.createElement('div'); d.className='curate-suggestion';
    var safeTitle=esc(c.title); var safeSub=esc(c.subhead);
    d.innerHTML='<div class="curate-row">'
      +'<div>'
        +'<div class="curate-num">Option '+c.option_num+'</div>'
        +'<div class="curate-title">'+safeTitle+'</div>'
        +'<div class="curate-subhead">'+safeSub+'</div>'
      +'</div>'
      +'<button class="btn-copy-sm" onclick="copyText(this,\''+safeTitle+' — '+safeSub+'\')">Copy</button>'
    +'</div>';
    curateCards.appendChild(d);
  });

  // ── S7 FAQS ──
  var faqContainer=document.getElementById('faqCards'); faqContainer.innerHTML='';
  (a.faqs||[]).forEach(function(o){
    var card=document.createElement('div'); card.className='faq-card';
    var bodyId='faq-body-'+o.rank, toggleId='faq-toggle-'+o.rank;
    card.innerHTML='<div class="faq-card-header" onclick="toggleFaq('+o.rank+')">'
        +'<span class="faq-rank-badge">#'+o.rank+'</span>'
        +'<div class="faq-question">'+esc(o.question)+'</div>'
        +'<span class="faq-toggle" id="'+toggleId+'">▾</span>'
      +'</div>'
      +'<div class="faq-card-body" id="'+bodyId+'">'
        +'<div class="faq-source">From review language:</div>'
        +'<div class="faq-source-quote">&#8220;'+esc(o.source_language)+'&#8221;</div>'
        +'<div class="faq-answer-prompt">Jane should address: <span>'+esc(o.answer_prompt)+'</span></div>'
      +'</div>';
    faqContainer.appendChild(card);
  });

  // ── SENTIMENT ──
  var s=a.sentiment||{positive:0,neutral:0,negative:0}, sum=s.positive+s.neutral+s.negative||1;
  var posPct=Math.round(s.positive/sum*100), neuPct=Math.round(s.neutral/sum*100), negPct=Math.round(s.negative/sum*100);
  document.getElementById('posNum').textContent=posPct+'%';
  document.getElementById('neuNum').textContent=neuPct+'%';
  document.getElementById('negNum').textContent=negPct+'%';
  setTimeout(function(){
    document.getElementById('sentimentPos').style.width=posPct+'%';
    document.getElementById('sentimentNeu').style.width=neuPct+'%';
    document.getElementById('sentimentNeg').style.width=negPct+'%';
  },100);

  // ── THEMES ──
  var pills=document.getElementById('themePills'); pills.innerHTML='';
  (a.themes||[]).forEach(function(t){
    var p=document.createElement('div'); p.className='theme-pill';
    p.innerHTML=esc(t.label)+'<span class="pill-count">'+t.count+'</span>';
    pills.appendChild(p);
  });

  showResults();
}

function toggleFaq(rank){
  var body=document.getElementById('faq-body-'+rank), toggle=document.getElementById('faq-toggle-'+rank);
  body.classList.toggle('open'); toggle.classList.toggle('open');
}

function esc(str){
  if(!str) return '';
  return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

function copyText(btn,text){
  var clean=String(text).replace(/<[^>]+>/g,'').replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&quot;/g,'"').replace(/&#39;/g,"'");
  navigator.clipboard.writeText(clean).then(function(){
    var orig=btn.textContent; btn.textContent='Copied!'; btn.classList.add('copied');
    setTimeout(function(){btn.textContent=orig;btn.classList.remove('copied');},2000);
  });
}

function copyFieldText(btn,elId){
  var el=document.getElementById(elId);
  if(!el) return;
  copyText(btn,el.textContent||el.innerText||'');
}

function copyAboutFull(){
  var opener=document.getElementById('aboutPainOpener').textContent||'';
  var benefit=document.getElementById('aboutMainBenefit').textContent||'';
  var desc=document.getElementById('aboutDescription').textContent||'';
  var full=opener+'\n\n'+benefit+'\n\n'+desc;
  navigator.clipboard.writeText(full.trim()).then(function(){
    var btn=event.target; btn.textContent='Copied!';
    setTimeout(function(){btn.textContent='Copy full About section';},2000);
  });
}

function exportTxt(){
  if(!lastAnalysis) return;
  var a=lastAnalysis.analysis, out='REVIEW INTELLIGENCE REPORT\n'+lastAnalysis.product+'\n';
  out+=lastAnalysis.analyzed.toLocaleString()+' of '+lastAnalysis.count.toLocaleString()+' reviews (most recent)\n';
  if(lastAnalysis.dateRange) out+='Date range: '+lastAnalysis.dateRange+'\n';
  out+='\n=== PDP SECTION 1 — ABOUT ===\n';
  if(a.about){
    out+='Pain opener: '+a.about.pain_opener+'\n';
    out+='Main benefit: '+a.about.main_benefit+'\n';
    out+='Description: '+a.about.description+'\n';
  }
  out+='\n=== PDP SECTION 2 — MADE WITH PURPOSE ===\n';
  (a.made_with_purpose||[]).forEach(function(m,i){ out+=(i+1)+'. '+m.title+': '+m.description+'\n'; });
  out+='\n=== PDP SECTION 3 — REAL CUSTOMERS. REAL RESULTS. ===\n';
  (a.outcome_stats||[]).forEach(function(s){ out+='• '+s.percentage+'% '+s.detail+' ('+s.count+' reviewers)\n'; });
  if(a.transformation) out+='\nTransformation: '+a.transformation.stat+'\n';
  out+='\nCopy snippets:\n';
  (a.copy_snippets||[]).forEach(function(s){ out+='• '+s.text.replace(/<[^>]+>/g,'')+' ['+s.placement+']\n'; });
  out+='\n=== PDP SECTION 4 — REVIEWS ===\n';
  (a.reviews||[]).forEach(function(v){ out+=v.title+'\n"'+v.rephrased_text+'"\n— '+v.original_author+'\n\n'; });
  out+='\n=== PDP SECTION 5 — INGREDIENTS ===\n';
  (a.ingredients||[]).forEach(function(ing,i){ out+=(i+1)+'. '+ing.title+': '+ing.description+'\n'; });
  out+='\n=== PDP SECTION 6 — CURATE YOUR COLLECTION ===\n';
  (a.curated_collection||[]).forEach(function(c){ out+='Option '+c.option_num+': '+c.title+' — '+c.subhead+'\n'; });
  out+='\n=== PDP SECTION 7 — FAQS ===\n';
  (a.faqs||[]).forEach(function(o){ out+='#'+o.rank+' '+o.question+'\nSource: "'+o.source_language+'"\nJane should address: '+o.answer_prompt+'\n\n'; });
  out+='\n=== REFERENCE — SENTIMENT ===\n';
  var s=a.sentiment||{positive:0,neutral:0,negative:0}, sum=s.positive+s.neutral+s.negative||1;
  out+='Positive: '+Math.round(s.positive/sum*100)+'% | Neutral: '+Math.round(s.neutral/sum*100)+'% | Negative: '+Math.round(s.negative/sum*100)+'%\n';
  out+='\n=== REFERENCE — THEMES ===\n';
  (a.themes||[]).forEach(function(t){ out+='• '+t.label+' ('+t.count+')\n'; });
  var blob=new Blob([out],{type:'text/plain'}), url=URL.createObjectURL(blob), link=document.createElement('a');
  link.href=url; link.download=lastAnalysis.product.replace(/\s+/g,'-')+'-pdp-intel.txt'; link.click();
}

function showLoading(c){ document.getElementById('raLoading').classList.add('active'); document.getElementById('loadingCount').textContent=c.toLocaleString(); ['step1','step2','step3','step4'].forEach(function(s){document.getElementById(s).className='loading-step';}); }
function hideLoading(){ document.getElementById('raLoading').classList.remove('active'); }
function showResults(){ document.getElementById('raResults').classList.add('active'); }
function hideResults(){ document.getElementById('raResults').classList.remove('active'); }
function showError(m){ var b=document.getElementById('errorBox'); b.textContent=m; b.classList.add('active'); }
function hideError(){ document.getElementById('errorBox').classList.remove('active'); }
function stepActive(id){ document.getElementById(id).classList.add('active'); }
function stepDone(id){ document.getElementById(id).classList.remove('active'); document.getElementById(id).classList.add('done'); }
</script>

{% schema %}
{
  "name": "Review Analyzer",
  "settings": []
}
{% endschema %}
