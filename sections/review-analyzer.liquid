    if(m.source_type){
      var srcBadge=document.createElement('span');
      srcBadge.className='about-tag '+(m.source_type==='v1_pdp'?'about-tag-diff':'about-tag-benefit');
      srcBadge.textContent=(m.source_type==='v1_pdp'?'Conversion angle':'Fresh angle from wiki');
      topRow.appendChild(srcBadge);
    }
    var title=document.createElement('div');title.className='choice-title';title.textContent=m.title||'';
    var desc=document.createElement('div');desc.className='choice-desc';desc.textContent=m.description||'';
    var meta=document.createElement('div');meta.className='choice-meta'+(over?' over':'');meta.textContent=cc+' / '+settings.mwp_chars+' chars'+(over?' — over limit':'');
    body.appendChild(topRow);body.appendChild(title);body.appendChild(desc);body.appendChild(meta);
    main.appendChild(body);main.appendChild(makeCopyBtn((m.title||'')+': '+(m.description||'')));
    var v1Src=(hasV1&&m.source_type==='v1_pdp')?m.v1_pdp_source:null;
    wrap.appendChild(main);wrap.appendChild(makeWikiSourceCol(m.wiki_source,v1Src));mwpList.appendChild(wrap);
  });

  // KEY BENEFITS — 3 max, no pct
  var rb=document.getElementById('reviewBenefitsGrid');rb.innerHTML='';
  (a.benefits||[]).slice(0,3).forEach(function(b){
    var card=document.createElement('div');card.className='benefit-card';
    var num=document.createElement('div');num.className='benefit-num';num.textContent='Benefit 0'+b.rank;
    var title=document.createElement('div');title.className='benefit-title';title.textContent=b.title||'';
    var proof=document.createElement('div');proof.className='benefit-proof';proof.textContent=b.proof||'';
    var footer=document.createElement('div');footer.className='benefit-footer';footer.appendChild(makeCopyBtn((b.title||'')+': '+(b.proof||'')));
    card.appendChild(num);card.appendChild(title);card.appendChild(proof);card.appendChild(footer);rb.appendChild(card);
  });

  // STATS — Transformation Timeline first
  if(a.transformation){
    document.getElementById('transformCard').style.display='flex';
    var tStat=a.transformation.stat||'';
    if(a.transformation.fraction&&a.transformation.timeframe&&tStat.indexOf(a.transformation.fraction)===-1)tStat=a.transformation.fraction+' customers noticed a difference '+a.transformation.timeframe;
    document.getElementById('transformStat').textContent=tStat;
    document.getElementById('transformSub').textContent=a.transformation.sub||'';
    var transformInner=document.querySelector('#transformCard .transform-inner');
    var existingVerif=transformInner.querySelector('.verification-block');
    if(existingVerif)existingVerif.remove();
    appendVerificationBlock(transformInner,a.transformation,analyzed);
    document.getElementById('transformCopyBtn').replaceWith(makeCopyBtn(tStat));
  }

  // ALT STATS
  if((a.alt_stats||[]).length){
    document.getElementById('altStatsWrap').style.display='block';
    var altList=document.getElementById('altStatsList');altList.innerHTML='';
    (a.alt_stats||[]).forEach(function(alt){
      var card=document.createElement('div');card.className='alt-stat-card';
      var inner=document.createElement('div');inner.className='alt-stat-inner';
      var lbl=document.createElement('div');lbl.className='alt-stat-label';lbl.textContent='Alternative framing';
      var txt=document.createElement('div');txt.className='alt-stat-text';txt.textContent=alt.text||'';
      var sub=document.createElement('div');sub.className='alt-stat-sub';sub.textContent=alt.sub||'';
      inner.appendChild(lbl);inner.appendChild(txt);inner.appendChild(sub);
      appendVerificationBlock(inner,alt,analyzed);
      card.appendChild(inner);card.appendChild(makeCopyBtn(alt.text||''));altList.appendChild(card);
    });
  }

  // OUTCOME STATS (collapsed)
  var grid=document.getElementById('statsGrid');grid.innerHTML='';
  var strongStats=(a.outcome_stats||[]).filter(function(s){return s.percentage>=THRESHOLD;});
  var numStrong=strongStats.length;
  var statsStatus='';
  if(numStrong===0){document.getElementById('statsWarnRed').style.display='block';document.getElementById('statsWarnRedText').textContent='No outcome stats reach 72%. Exclude the percentage grid from this PDP.';document.getElementById('statsWarnYellow').style.display='none';statsStatus='No stats reach 72% — exclude from PDP';}
  else if(numStrong<3){document.getElementById('statsWarnYellow').style.display='block';document.getElementById('statsWarnYellowText').textContent='Only '+numStrong+' stat'+(numStrong===1?' clears':'s clear')+' 72%. Consider leading with the transformation timeline instead.';document.getElementById('statsWarnRed').style.display='none';statsStatus=numStrong+' stat(s) clear 72%';}
  else{document.getElementById('statsWarnYellow').style.display='none';document.getElementById('statsWarnRed').style.display='none';statsStatus=numStrong+' stats clear 72%';}
  document.getElementById('outcomeStatsStatus').textContent=statsStatus;
  (a.outcome_stats||[]).forEach(function(s){
    var detail=(s.detail||'');if(detail.length>20)detail=detail.substring(0,20).trim();
    var card=document.createElement('div');card.className='stat-card';
    var pct=document.createElement('div');pct.className='stat-pct';pct.textContent=s.percentage+'%';
    var lbl=document.createElement('div');lbl.className='stat-label';lbl.textContent=detail;
    var det=document.createElement('div');det.className='stat-detail';det.textContent=s.count+' of '+analyzed.toLocaleString()+' reviewers analyzed';
    var row=document.createElement('div');row.className='stat-copy-row';row.appendChild(makeCopyBtn(s.percentage+'% '+detail));
    card.appendChild(pct);card.appendChild(lbl);card.appendChild(det);card.appendChild(row);grid.appendChild(card);
  });
  document.getElementById('statsFootnote').textContent='Based on '+analyzed.toLocaleString()+' Yotpo verified purchase reviews (most recent published). Results reflect customer-reported outcomes — individual experiences may vary.';

  // REVIEWS — only verified shown; dropped count flagged if any
  var revList=document.getElementById('reviewsList');revList.innerHTML='';
  if(a._dropped_count&&a._dropped_count>0){
    var dropNote=document.createElement('div');
    dropNote.style.cssText='grid-column:1 / -1;background:var(--warn-soft);border:1px solid #f0d785;border-left:3px solid var(--warn);border-radius:var(--radius);padding:14px 18px;font-size:13px;color:#7a5b08;font-family:var(--mono);letter-spacing:0.02em;';
    dropNote.textContent=a._dropped_count+' review'+(a._dropped_count===1?'':'s')+' excluded — could not be verified against the source CSV';
    revList.appendChild(dropNote);
  }
  (a.reviews||[]).forEach(function(v){
    if((v.original_text||'').length>settings.review_chars)return;
    var card=document.createElement('div');card.className='review-card';
    var topRow=document.createElement('div');topRow.className='review-top-row';
    var num=document.createElement('div');num.className='review-num';num.textContent='Review '+(v.num||'');
    var stars=document.createElement('div');stars.className='review-stars';stars.textContent='\u2605\u2605\u2605\u2605\u2605';
    var badge=document.createElement('span');
    badge.className='review-verified-badge';badge.textContent='✓ Verified';
    topRow.appendChild(num);topRow.appendChild(badge);topRow.appendChild(stars);
    var title=document.createElement('div');title.className='review-title';title.textContent=v.title||'';
    var text=document.createElement('div');text.className='review-text';text.textContent='\u201c'+(v.original_text||'')+'\u201d';
    var authRow=document.createElement('div');authRow.className='review-author-row';
    var authBlock=document.createElement('div');authBlock.className='review-author-block';
    var authName=document.createElement('div');authName.className='review-author-name';authName.textContent=v.original_author||'Verified Buyer';
    authBlock.appendChild(authName);
    if(v.original_author&&v.original_author!=='Verified Buyer'){var authLbl=document.createElement('div');authLbl.className='review-author-label';authLbl.textContent='Verified Buyer';authBlock.appendChild(authLbl);}
    var themeTag=document.createElement('span');themeTag.className='review-theme-tag';themeTag.textContent=v.theme||'';
    authRow.appendChild(authBlock);authRow.appendChild(themeTag);
    var copyRow=document.createElement('div');copyRow.className='review-copy-row';
    copyRow.appendChild(makeCopyBtn((v.title?v.title+': ':'')+'\u201c'+(v.original_text||'')+'\u201d \u2014 '+(v.original_author||'Verified Buyer')));
    card.appendChild(topRow);card.appendChild(title);card.appendChild(text);card.appendChild(authRow);card.appendChild(copyRow);
    revList.appendChild(card);
  });

  // INGREDIENTS
  var ingList=document.getElementById('ingredientsList');ingList.innerHTML='';
  (a.ingredients||[]).forEach(function(ing){
    var hc=(ing.headline||'').length,hOver=hc>settings.ing_title_chars;
    var sc=(ing.subline||'').length,sOver=sc>settings.ing_chars;
    var wrap=document.createElement('div');wrap.className='with-wiki-source';
    var main=document.createElement('div');main.style.cssText='padding:28px;display:flex;align-items:flex-start;justify-content:space-between;gap:24px;flex:1;';
    var body=document.createElement('div');body.className='ing-option-body';
    var num=document.createElement('div');num.className='ing-option-num';num.textContent='Option '+ing.num;
    var headlineRaw=(ing.headline||'').replace(/\*/g,'');
    var keyword=(ing.keyword||'').replace(/\*/g,'').trim();
    var headlineEl=document.createElement('div');headlineEl.className='ing-headline';
    if(keyword&&headlineRaw.toLowerCase().indexOf(keyword.toLowerCase())!==-1){
      var idx=headlineRaw.toLowerCase().indexOf(keyword.toLowerCase());
      if(idx>0)headlineEl.appendChild(document.createTextNode(headlineRaw.substring(0,idx)));
      var em=document.createElement('em');em.textContent=headlineRaw.substring(idx,idx+keyword.length);headlineEl.appendChild(em);
      if(idx+keyword.length<headlineRaw.length)headlineEl.appendChild(document.createTextNode(headlineRaw.substring(idx+keyword.length)));
    } else {headlineEl.appendChild(document.createTextNode(headlineRaw));}
    var hMeta=document.createElement('div');hMeta.className='choice-meta'+(hOver?' over':'');hMeta.style.marginTop='6px';hMeta.textContent='Headline: '+hc+' / '+settings.ing_title_chars+' chars'+(hOver?' — over limit':'');
    var sub=document.createElement('div');sub.className='ing-subline';sub.textContent=ing.subline||'';
    var sMeta=document.createElement('div');sMeta.className='choice-meta'+(sOver?' over':'');sMeta.style.marginTop='8px';sMeta.textContent='Subline: '+sc+' / '+settings.ing_chars+' chars'+(sOver?' — over limit':'');
    body.appendChild(num);body.appendChild(headlineEl);body.appendChild(hMeta);body.appendChild(sub);body.appendChild(sMeta);
    main.appendChild(body);main.appendChild(makeCopyBtn(headlineRaw+'\n'+(ing.subline||'')));
    wrap.appendChild(main);wrap.appendChild(makeWikiSourceCol(ing.wiki_source));ingList.appendChild(wrap);
  });

  // CURATED — refuse to generate when no wiki pairings
  var curContainer=document.getElementById('curatedContainer');curContainer.innerHTML='';
  var cur=a.curated_collection||{};
  if(cur.has_pairings===false||!cur.options||cur.options.length===0){
    var refusal=document.createElement('div');refusal.className='curated-refusal';
    refusal.innerHTML='<div class="curated-refusal-icon">⊘</div><div class="curated-refusal-title">No content generated</div><div class="curated-refusal-text">The wiki for this product does not include a Recommended Pairings section. To populate this section, add a Recommended Pairings table to the wiki listing companion products, why they pair, and the customer state they\'re for. Then re-run the analysis.</div>';
    curContainer.appendChild(refusal);
  } else {
    var wrap=document.createElement('div');wrap.className='curated-wrap';
    var list=document.createElement('div');list.className='curated-list';
    cur.options.forEach(function(c){
      var sc=(c.subhead||'').length,over=sc>settings.curated_chars;
      var card=document.createElement('div');card.className='curated-card';
      var body=document.createElement('div');body.className='curated-body';
      var num=document.createElement('div');num.className='curated-num';num.textContent='Option '+c.num;
      var title=document.createElement('div');title.className='curated-title';title.textContent=c.title||'';
      var sub=document.createElement('div');sub.className='curated-subhead';sub.textContent=c.subhead||'';
      var meta=document.createElement('div');meta.className='curated-meta'+(over?' over':'');meta.textContent=sc+' / '+settings.curated_chars+' chars'+(over?' — over limit':'');
      body.appendChild(num);body.appendChild(title);body.appendChild(sub);body.appendChild(meta);
      if(c.wiki_source){
        var srcDiv=document.createElement('div');srcDiv.className='curated-context';srcDiv.textContent='Wiki: "'+c.wiki_source+'"';
        body.appendChild(srcDiv);
      }
      card.appendChild(body);card.appendChild(makeCopyBtn((c.title||'')+' — '+(c.subhead||'')));
      list.appendChild(card);
    });
    wrap.appendChild(list);curContainer.appendChild(wrap);
  }

  // FAQs — answered first, manual-answer-needed grouped below
  var faqContainer=document.getElementById('faqCards');faqContainer.innerHTML='';
  var answered=(a.faqs||[]).filter(function(f){return !f.needs_manual_answer;});
  var unanswered=(a.faqs||[]).filter(function(f){return f.needs_manual_answer;});

  if(answered.length){
    var aLbl=document.createElement('div');aLbl.className='faq-group-label';aLbl.textContent='Answered from wiki';
    faqContainer.appendChild(aLbl);
    answered.forEach(function(o){renderFaqCard(o,faqContainer,settings);});
  }
  if(unanswered.length){
    var uLbl=document.createElement('div');uLbl.className='faq-group-label gap';uLbl.textContent='Needs manual answer — wiki gap';
    faqContainer.appendChild(uLbl);
    unanswered.forEach(function(o){renderFaqCard(o,faqContainer,settings);});
  }

  // PAIN POINTS
  var painContainer=document.getElementById('painCards');painContainer.innerHTML='';
  (a.pain_points||[]).forEach(function(p){
    var card=document.createElement('div');card.className='pain-card';
    var body=document.createElement('div');body.className='pain-body';
    var rank=document.createElement('div');rank.className='pain-rank';rank.textContent='Pain Point #'+p.rank;
    var lbl=document.createElement('div');lbl.className='pain-label-txt';lbl.textContent=p.label||'';
    var lang=document.createElement('div');lang.className='pain-language';lang.textContent='\u201c'+(p.customer_language||'')+'\u201d';
    body.appendChild(rank);body.appendChild(lbl);body.appendChild(lang);
    card.appendChild(body);card.appendChild(makeCopyBtn(p.copy_hook||''));painContainer.appendChild(card);
  });

  // SENTIMENT
  var s=a.sentiment||{positive:0,neutral:0,negative:0},sum=s.positive+s.neutral+s.negative||1;
  var pp=Math.round(s.positive/sum*100),np=Math.round(s.neutral/sum*100),ngp=Math.round(s.negative/sum*100);
  document.getElementById('posNum').textContent=pp+'%';
  document.getElementById('neuNum').textContent=np+'%';
  document.getElementById('negNum').textContent=ngp+'%';
  setTimeout(function(){document.getElementById('sentimentPos').style.width=pp+'%';document.getElementById('sentimentNeu').style.width=np+'%';document.getElementById('sentimentNeg').style.width=ngp+'%';},100);

  showResults();
  window.scrollTo({top:0,behavior:'smooth'});
}

function renderFaqCard(o,container,settings){
  var card=document.createElement('div');card.className='faq-card';
  if(o.is_what_to_expect)card.classList.add('faq-card-expect');
  if(o.needs_manual_answer)card.classList.add('faq-card-gap');
  var bid='faq-body-'+o.rank,tid='faq-tog-'+o.rank;
  var header=document.createElement('div');header.className='faq-header';
  header.addEventListener('click',function(){document.getElementById(bid).classList.toggle('open');document.getElementById(tid).classList.toggle('open');});
  var rank=document.createElement('span');rank.className='faq-rank';rank.textContent='#'+o.rank;
  var qWrap=document.createElement('div');qWrap.style.cssText='flex:1;display:flex;flex-direction:column;gap:4px;';
  if(o.is_what_to_expect){
    var expectPill=document.createElement('span');expectPill.className='faq-expect-pill';expectPill.textContent='What to Expect';
    qWrap.appendChild(expectPill);
  }
  if(o.needs_manual_answer){
    var gapPill=document.createElement('span');gapPill.className='faq-gap-pill';gapPill.textContent='Needs manual answer';
    qWrap.appendChild(gapPill);
  }
  var q=document.createElement('div');q.className='faq-question';q.textContent=o.question||'';
  qWrap.appendChild(q);
  var tog=document.createElement('span');tog.className='faq-toggle';tog.id=tid;tog.textContent='\u25be';
  header.appendChild(rank);header.appendChild(qWrap);header.appendChild(tog);
  var body=document.createElement('div');body.className='faq-body';body.id=bid;
  if(o.review_context){
    var srcLbl=document.createElement('div');srcLbl.className='faq-source-label';srcLbl.textContent='Why we\'re asking';
    var srcQ=document.createElement('div');srcQ.className='faq-source-quote';srcQ.textContent=o.review_context;
    body.appendChild(srcLbl);body.appendChild(srcQ);
  }
  var ansWrap=document.createElement('div');ansWrap.className='faq-answer-wrap';
  var ansLbl=document.createElement('div');ansLbl.className='faq-answer-label';
  ansLbl.textContent=o.needs_manual_answer?'Needs manual answer — wiki does not cover this':'Answer from wiki — edit before publishing';
  ansWrap.appendChild(ansLbl);
  if(o.needs_manual_answer){
    var reasonText=document.createElement('div');reasonText.className='faq-answer-empty';reasonText.textContent=o.manual_answer_reason||'Wiki does not cover this topic. Answer needs to be researched and written manually before publishing.';
    ansWrap.appendChild(reasonText);
  } else {
    var ansRow=document.createElement('div');ansRow.className='faq-answer-row';
    var ansTxt=document.createElement('div');ansTxt.className='faq-answer-text';ansTxt.textContent=o.suggested_answer||'';
    ansRow.appendChild(ansTxt);ansRow.appendChild(makeCopyBtn((o.question||'')+'\n\n'+(o.suggested_answer||'')));
    ansWrap.appendChild(ansRow);
    var ansLen=(o.suggested_answer||'').length;
    if(ansLen>0){
      var ansMeta=document.createElement('div');ansMeta.className='faq-answer-meta'+(ansLen>settings.faq_chars?' over':'');ansMeta.textContent=ansLen+' / '+settings.faq_chars+' chars'+(ansLen>settings.faq_chars?' — over limit':'');
      ansWrap.appendChild(ansMeta);
    }
  }
  body.appendChild(ansWrap);
  if(o.wiki_source&&!o.needs_manual_answer){
    var wikiSrc=document.createElement('div');wikiSrc.className='faq-source-quote';wikiSrc.style.fontSize='12px';wikiSrc.style.marginTop='8px';
    wikiSrc.innerHTML='<span style="font-family:var(--mono);font-size:10px;color:var(--accent);text-transform:uppercase;letter-spacing:0.08em;font-weight:600;">Wiki source:</span> "'+o.wiki_source+'"';
    body.appendChild(wikiSrc);
  }
  if(o.is_what_to_expect&&o.expectation_substantiation){
    var sub=o.expectation_substantiation;
    var vBlock=document.createElement('div');vBlock.className='verification-block';
    var vTitle=document.createElement('div');vTitle.className='verification-title';vTitle.textContent='Why we\'re asking — review context';
    vBlock.appendChild(vTitle);
    if(sub.onset_quotes&&sub.onset_quotes.length){
      var lbl1=document.createElement('div');lbl1.className='verification-row v-quotes-label';lbl1.innerHTML='<span class="v-label">Onset timing — what customers ask about:</span>';
      vBlock.appendChild(lbl1);
      sub.onset_quotes.forEach(function(q){var el=document.createElement('div');el.className='verification-quote';el.textContent='\u201c'+q+'\u201d';vBlock.appendChild(el);});
    }
    if(sub.effects_quotes&&sub.effects_quotes.length){
      var lbl2=document.createElement('div');lbl2.className='verification-row v-quotes-label';lbl2.innerHTML='<span class="v-label">Temporary effects — what customers ask about:</span>';
      vBlock.appendChild(lbl2);
      sub.effects_quotes.forEach(function(q){var el=document.createElement('div');el.className='verification-quote';el.textContent='\u201c'+q+'\u201d';vBlock.appendChild(el);});
    }
    body.appendChild(vBlock);
  }
  card.appendChild(header);card.appendChild(body);container.appendChild(card);
}

function exportTxt(){
  if(!lastAnalysis)return;
  var a=lastAnalysis.analysis,out='REVIEW ANALYSIS REPORT\n'+lastAnalysis.product+'\n'+lastAnalysis.analyzed.toLocaleString()+' of '+lastAnalysis.count.toLocaleString()+' published reviews\n';
  if(lastAnalysis.dateRange)out+='Date range: '+lastAnalysis.dateRange+'\n';
  out+='Generated: '+new Date().toISOString()+'\n';
  out+='\n=== ABOUT ===\n';
  (a.about_options||[]).forEach(function(o){
    out+='Option '+o.num+(o.differentiator_type?' ['+o.differentiator_type+']':'')+'\n'+o.text+'\n';
    if(o.why_this_differentiates)out+='Why this differentiates: '+o.why_this_differentiates+'\n';
    out+='\n';
  });
  out+='\n=== MADE WITH PURPOSE ===\n';
  if(a.wiki_v1_alignment&&a.wiki_v1_alignment.has_mismatch){
    out+='[MISMATCH FLAGGED]\n';
    if(a.wiki_v1_alignment.wiki_only_adds&&a.wiki_v1_alignment.wiki_only_adds.length)out+='Wiki adds: '+a.wiki_v1_alignment.wiki_only_adds.join(', ')+'\n';
    if(a.wiki_v1_alignment.v1_only_adds&&a.wiki_v1_alignment.v1_only_adds.length)out+='v1 adds: '+a.wiki_v1_alignment.v1_only_adds.join(', ')+'\n';
    if(a.wiki_v1_alignment.contradictions&&a.wiki_v1_alignment.contradictions.length)out+='Contradictions: '+a.wiki_v1_alignment.contradictions.join('; ')+'\n';
    out+='\n';
  }
  (a.made_with_purpose||[]).forEach(function(m){
    out+='Option '+m.num+': '+m.title+'\n'+m.description+'\n';
    if(m.v1_pdp_source)out+='V1 PDP source: '+m.v1_pdp_source+'\n';
    out+='Wiki source: '+m.wiki_source+'\n\n';
  });
  out+='\n=== KEY BENEFITS ===\n';
  (a.benefits||[]).slice(0,3).forEach(function(b){out+='Benefit '+b.rank+': '+b.title+': '+b.proof+'\n';});
  if(a.transformation){
    out+='\n=== TRANSFORMATION TIMELINE ===\n';
    out+='Claim: '+a.transformation.stat+'\n';
    if(a.transformation.mention_count)out+='Mentions: '+a.transformation.mention_count+' of '+lastAnalysis.analyzed+' reviewers analyzed\n';
    if(a.transformation.timeframe_keywords)out+='Timeframe keywords: '+a.transformation.timeframe_keywords.join(', ')+'\n';
    if(a.transformation.outcome_keywords)out+='Outcome keywords: '+a.transformation.outcome_keywords.join(', ')+'\n';
    if(a.transformation.sample_quotes)a.transformation.sample_quotes.forEach(function(q){out+='Quote: "'+q+'"\n';});
    out+='\n';
  }
  (a.alt_stats||[]).forEach(function(s){
    out+='ALT FRAMING: '+s.text+'\n';
    if(s.mention_count)out+='Mentions: '+s.mention_count+' of '+lastAnalysis.analyzed+' reviewers analyzed\n';
    if(s.sample_quotes)s.sample_quotes.forEach(function(q){out+='Quote: "'+q+'"\n';});
    out+='\n';
  });
  out+='\n=== OUTCOME STATS (collapsed by default) ===\n';
  (a.outcome_stats||[]).forEach(function(s){out+='• '+s.percentage+'% '+s.detail+' ('+s.count+' of '+lastAnalysis.analyzed+' reviewers)\n';});
  out+='\n=== REVIEWS (VERBATIM, VERIFIED IN SOURCE CSV) ===\n';
  if(a._dropped_count&&a._dropped_count>0)out+='Note: '+a._dropped_count+' review(s) excluded — could not be verified against source CSV.\n\n';
  (a.reviews||[]).forEach(function(v){out+='Review '+v.num+': '+v.title+'\n"'+(v.original_text||'')+'"\n— '+(v.original_author||'Verified Buyer')+' [Theme: '+(v.theme||'')+']\n\n';});
  out+='\n=== INGREDIENTS ===\n';
  (a.ingredients||[]).forEach(function(ing){out+='Option '+ing.num+':\n'+ing.headline+'\n'+ing.subline+'\nWiki source: '+ing.wiki_source+'\n\n';});
  out+='\n=== CURATE YOUR COLLECTION ===\n';
  var cur=a.curated_collection||{};
  if(cur.has_pairings&&cur.options){
    cur.options.forEach(function(c){out+='Option '+c.num+': '+c.title+'\n'+c.subhead+'\nWiki source: '+(c.wiki_source||'')+'\n\n';});
  } else {
    out+='No content generated — wiki has no Recommended Pairings section.\n\n';
  }
  out+='\n=== FAQS ===\n';
  out+='-- Answered from wiki --\n';
  (a.faqs||[]).filter(function(f){return !f.needs_manual_answer;}).forEach(function(o){
    out+='#'+o.rank+(o.is_what_to_expect?' [WHAT TO EXPECT]':'')+' '+o.question+'\nAnswer: '+o.suggested_answer+'\n';
    if(o.wiki_source)out+='Wiki source: '+o.wiki_source+'\n';
    if(o.review_context)out+='Why we\'re asking: '+o.review_context+'\n';
    if(o.is_what_to_expect&&o.expectation_substantiation){
      var es=o.expectation_substantiation;
      if(es.onset_quotes&&es.onset_quotes.length){out+='Onset context quotes:\n';es.onset_quotes.forEach(function(q){out+='  "'+q+'"\n';});}
      if(es.effects_quotes&&es.effects_quotes.length){out+='Effects context quotes:\n';es.effects_quotes.forEach(function(q){out+='  "'+q+'"\n';});}
    }
    out+='\n';
  });
  out+='\n-- Needs manual answer --\n';
  (a.faqs||[]).filter(function(f){return f.needs_manual_answer;}).forEach(function(o){
    out+='#'+o.rank+' '+o.question+'\nReason: '+(o.manual_answer_reason||'Wiki does not cover')+'\n';
    if(o.review_context)out+='Why we\'re asking: '+o.review_context+'\n';
    out+='\n';
  });
  out+='\n=== PAIN POINTS ===\n';
  (a.pain_points||[]).forEach(function(p){out+='#'+p.rank+' '+p.label+'\n"'+p.customer_language+'"\n\n';});
  var date=new Date();
  var dateStr=date.getFullYear()+'-'+String(date.getMonth()+1).padStart(2,'0')+'-'+String(date.getDate()).padStart(2,'0');
  var blob=new Blob([out],{type:'text/plain'}),url=URL.createObjectURL(blob),link=document.createElement('a');
  link.href=url;link.download=lastAnalysis.product.replace(/\s+/g,'-').replace(/[®™©]/g,'')+'-review-analysis-'+dateStr+'.txt';link.click();
}

var _loadTimer=null,_loadStart=0;
function showLoading(sampleSize,totalCount){
  document.getElementById('raLoading').classList.add('active');
  document.getElementById('loadingCount').textContent=sampleSize.toLocaleString();
  document.getElementById('loadingTotal').textContent=totalCount.toLocaleString();
  ['step1','step2','step3','step4'].forEach(function(s){document.getElementById(s).className='loading-step';});
  _loadStart=Date.now();document.getElementById('loadingBar').style.width='0%';document.getElementById('loadingTimer').textContent='0s elapsed';
  if(_loadTimer)clearInterval(_loadTimer);
  _loadTimer=setInterval(function(){
    var elapsed=Math.round((Date.now()-_loadStart)/1000);
    document.getElementById('loadingTimer').textContent=elapsed+'s elapsed';
    document.getElementById('loadingBar').style.width=Math.min(90,elapsed*2)+'%';
  },1000);
}
function hideLoading(){document.getElementById('raLoading').classList.remove('active');if(_loadTimer){clearInterval(_loadTimer);_loadTimer=null;}document.getElementById('loadingBar').style.width='100%';}
function showResults(){document.getElementById('raResults').classList.add('active');}
function hideResults(){document.getElementById('raResults').classList.remove('active');}
function showError(m){var b=document.getElementById('errorBox');b.textContent=m;b.classList.add('active');}
function hideError(){document.getElementById('errorBox').classList.remove('active');}
function stepActive(id){document.getElementById(id).classList.add('active');}
function stepDone(id){document.getElementById(id).classList.remove('active');document.getElementById(id).classList.add('done');}
</script>

