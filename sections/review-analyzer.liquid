{% assign page_title = 'Review Intelligence' %}
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Mono:wght@400;500&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --ink:#1a1208;--paper:#faf7f2;--cream:#f2ede4;--gold:#c8952a;--gold-light:#e8b84b;
    --sage:#4a6741;--sage-light:#6a8f60;--rust:#b84c2a;--mist:#e8e2d9;
    --radius:12px;--shadow:0 2px 8px rgba(26,18,8,0.08),0 1px 2px rgba(26,18,8,0.04);
    --shadow-md:0 4px 16px rgba(26,18,8,0.10),0 2px 4px rgba(26,18,8,0.06);
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  body{background:var(--paper);font-family:'Instrument Sans',sans-serif;}

  .upload-zone{border:2px dashed var(--mist);background:var(--cream);border-radius:var(--radius);padding:52px 40px;text-align:center;cursor:pointer;transition:all 0.2s;position:relative;margin-bottom:32px;}
  .upload-zone:hover,.upload-zone.drag-over{border-color:var(--gold);background:#f5ede0;}
  .upload-zone input[type="file"]{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;}
  .upload-icon{width:48px;height:48px;margin:0 auto 16px;color:var(--gold);}
  .upload-title{font-family:'DM Serif Display',serif;font-size:20px;margin-bottom:6px;color:var(--ink);}
  .upload-sub{font-size:13px;color:#8a7a68;font-family:'DM Mono',monospace;}
  .file-loaded{display:flex;align-items:center;gap:14px;background:var(--ink);color:var(--paper);padding:16px 24px;border-radius:var(--radius);margin-bottom:32px;font-family:'DM Mono',monospace;font-size:13px;box-shadow:var(--shadow);}
  .file-loaded .dot{width:8px;height:8px;background:var(--gold-light);border-radius:50%;flex-shrink:0;}
  .file-loaded strong{color:var(--gold-light);}

  .ra-controls{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;align-items:end;}
  .ra-label{display:block;font-family:'DM Mono',monospace;font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:#8a7a68;margin-bottom:8px;}
  .ra-select{width:100%;padding:12px 16px;border:1px solid var(--mist);background:white;font-size:14px;color:var(--ink);border-radius:8px;appearance:none;outline:none;transition:border-color 0.2s;font-family:'Instrument Sans',sans-serif;box-shadow:var(--shadow);}
  .ra-select:focus{border-color:var(--gold);}
  .ra-textarea{width:100%;padding:12px 16px;border:1px solid var(--mist);background:white;font-size:13px;color:var(--ink);border-radius:8px;outline:none;transition:border-color 0.2s;font-family:'Instrument Sans',sans-serif;box-shadow:var(--shadow);resize:vertical;min-height:90px;line-height:1.5;}
  .ra-textarea:focus{border-color:var(--gold);}

  .collapsible-toggle{display:flex;align-items:center;gap:8px;cursor:pointer;width:fit-content;font-family:'DM Mono',monospace;font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:#8a7a68;}
  .collapsible-arrow{font-size:11px;transition:transform 0.2s;}
  .collapsible-arrow.open{transform:rotate(180deg);}
  .collapsible-panel{display:none;margin-top:10px;}
  .collapsible-panel.open{display:block;}
  .panel-note{font-family:'DM Mono',monospace;font-size:11px;color:#8a7a68;margin-top:6px;line-height:1.5;}
  .settings-panel-inner{background:var(--cream);border:1px solid var(--mist);border-radius:var(--radius);padding:24px;}
  .settings-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
  .settings-field label{display:block;font-family:'DM Mono',monospace;font-size:10px;letter-spacing:0.08em;text-transform:uppercase;color:#8a7a68;margin-bottom:6px;line-height:1.4;}
  .settings-field input{width:100%;padding:8px 12px;border:1px solid var(--mist);background:white;font-size:13px;color:var(--ink);border-radius:6px;outline:none;font-family:'DM Mono',monospace;}
  .settings-field input:focus{border-color:var(--gold);}

  .btn-analyze{padding:13px 32px;background:var(--gold);color:var(--ink);font-weight:600;font-size:14px;border:none;border-radius:8px;cursor:pointer;transition:background 0.2s;white-space:nowrap;font-family:'Instrument Sans',sans-serif;box-shadow:var(--shadow);width:100%;}
  .btn-analyze:hover{background:var(--gold-light);}
  .btn-analyze:disabled{background:var(--mist);color:#aaa;cursor:not-allowed;box-shadow:none;}

  .ra-loading{display:none;text-align:center;padding:64px 0;}
  .ra-loading.active{display:block;}
  .loading-ring{width:48px;height:48px;border:3px solid var(--mist);border-top-color:var(--gold);border-radius:50%;animation:raspin 0.8s linear infinite;margin:0 auto 20px;}
  @keyframes raspin{to{transform:rotate(360deg);}}
  .loading-text{font-family:'DM Mono',monospace;font-size:13px;color:#8a7a68;}
  .loading-step{font-size:12px;color:#aaa;transition:color 0.3s;margin:4px 0;}
  .loading-step.active{color:var(--gold);}
  .loading-step.done{color:var(--sage);}

  .ra-results{display:none;}
  .ra-results.active{display:block;}
  .results-header{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:24px;padding-bottom:20px;border-bottom:1px solid var(--mist);}
  .results-title{font-family:'DM Serif Display',serif;font-size:32px;color:var(--ink);}
  .results-meta{font-family:'DM Mono',monospace;font-size:12px;color:#8a7a68;text-align:right;line-height:1.6;}

  .section-nav{display:flex;gap:6px;flex-wrap:wrap;background:white;border:1px solid var(--mist);border-radius:var(--radius);padding:12px 16px;margin-bottom:40px;box-shadow:var(--shadow);}
  .nav-btn{font-family:'DM Mono',monospace;font-size:10px;letter-spacing:0.06em;text-transform:uppercase;padding:5px 10px;border-radius:6px;border:1px solid var(--mist);background:transparent;color:#8a7a68;cursor:pointer;transition:all 0.15s;white-space:nowrap;}
  .nav-btn:hover{background:var(--cream);color:var(--ink);border-color:var(--gold);}

  .ra-section{margin-bottom:56px;scroll-margin-top:20px;}
  .section-label{display:inline-block;font-family:'DM Mono',monospace;font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:white;background:var(--ink);padding:4px 10px;border-radius:20px;margin-bottom:10px;}
  .section-heading{font-family:'DM Serif Display',serif;font-size:28px;color:var(--ink);margin-bottom:6px;}
  .section-sub{font-size:13px;color:#6b5e4a;margin-bottom:24px;line-height:1.6;max-width:720px;}
  .jane-note{background:#1a2e1a;color:#a8c4a8;font-size:13px;line-height:1.7;padding:14px 18px;border-radius:var(--radius);margin-bottom:20px;}
  .jane-note strong{color:var(--gold-light);}

  .btn-copy,.btn-copy-sm{flex-shrink:0;padding:6px 14px;background:transparent;border:1px solid var(--mist);color:#8a7a68;font-family:'DM Mono',monospace;font-size:11px;border-radius:6px;cursor:pointer;transition:all 0.2s;}
  .btn-copy-sm{padding:4px 10px;font-size:10px;}
  .btn-copy:hover,.btn-copy-sm:hover{border-color:var(--gold);color:var(--gold);}
  .btn-copy.copied,.btn-copy-sm.copied{border-color:var(--sage);color:var(--sage-light);}

  /* CHOICE CARDS — used for About, MWP, Ingredients */
  .choice-list{display:flex;flex-direction:column;gap:12px;}
  .choice-card{background:white;border:1px solid rgba(232,226,217,0.6);border-radius:var(--radius);padding:22px 24px;box-shadow:var(--shadow);display:flex;align-items:flex-start;justify-content:space-between;gap:16px;}
  .choice-card-body{flex:1;}
  .choice-num{font-family:'DM Mono',monospace;font-size:10px;color:#8a7a68;margin-bottom:6px;letter-spacing:0.06em;text-transform:uppercase;}
  .choice-title{font-size:15px;font-weight:600;color:var(--ink);margin-bottom:4px;line-height:1.4;}
  .choice-text{font-size:14px;color:#3a2e20;line-height:1.7;}
  .choice-desc{font-size:13px;color:#6b5e4a;line-height:1.6;margin-top:4px;}
  .choice-charcount{font-family:'DM Mono',monospace;font-size:10px;color:#8a7a68;margin-top:6px;}
  .choice-charcount.over{color:var(--rust);}
  .badge-wiki{font-family:'DM Mono',monospace;font-size:10px;color:var(--sage);background:#f0f5ee;border:1px solid #c8ddc4;padding:3px 8px;border-radius:20px;margin-top:6px;display:inline-block;}
  .badge-verify{font-family:'DM Mono',monospace;font-size:10px;color:var(--gold);background:#fffbf0;border:1px solid #f0d080;padding:3px 8px;border-radius:20px;margin-top:6px;display:inline-block;}

  /* REAL CUSTOMERS */
  .stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border:1px solid rgba(232,226,217,0.8);border-radius:var(--radius);overflow:hidden;margin-bottom:12px;}
  .stat-card{background:white;padding:32px 28px;border-right:1px solid rgba(232,226,217,0.8);border-bottom:1px solid rgba(232,226,217,0.8);display:flex;flex-direction:column;gap:8px;}
  .stat-card:nth-child(3n){border-right:none;}
  .stat-card:nth-last-child(-n+3){border-bottom:none;}
  .stat-pct{font-family:'DM Serif Display',serif;font-size:64px;line-height:1;color:var(--ink);}
  .stat-label{font-size:14px;font-weight:600;color:var(--ink);line-height:1.4;}
  .stat-detail{font-size:12px;color:#8a7a68;}
  .stat-copy-row{display:flex;justify-content:flex-end;margin-top:8px;}
  .stats-footnote{font-family:'DM Mono',monospace;font-size:11px;color:#8a7a68;font-style:italic;margin-bottom:16px;}
  .warn-yellow{background:#fffbf0;border:1px solid #f0d080;border-radius:10px;padding:14px 18px;margin-bottom:16px;}
  .warn-yellow-title{font-family:'DM Mono',monospace;font-size:11px;color:var(--gold);font-weight:600;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:4px;}
  .warn-red{background:#fff5f3;border:1px solid #f5c6bb;border-radius:10px;padding:14px 18px;margin-bottom:16px;}
  .warn-red-title{font-family:'DM Mono',monospace;font-size:11px;color:var(--rust);font-weight:600;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:4px;}
  .warn-text{font-size:13px;color:#5a4a38;line-height:1.6;}
  .transform-card{background:white;border-radius:var(--radius);box-shadow:var(--shadow);border:1px solid rgba(232,226,217,0.6);padding:24px;margin-top:12px;display:flex;align-items:flex-start;justify-content:space-between;gap:16px;}
  .transform-inner{flex:1;}
  .transform-label{font-family:'DM Mono',monospace;font-size:10px;color:var(--sage);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:8px;}
  .transform-stat{font-family:'DM Serif Display',serif;font-size:24px;color:var(--ink);margin-bottom:4px;}
  .transform-sub{font-size:12px;color:#8a7a68;}
  .alt-stat-card{background:white;border:1px solid rgba(232,226,217,0.6);border-radius:var(--radius);padding:28px;margin-bottom:12px;box-shadow:var(--shadow);display:flex;align-items:flex-start;justify-content:space-between;gap:16px;}
  .alt-stat-inner{flex:1;}
  .alt-stat-label{font-family:'DM Mono',monospace;font-size:10px;color:var(--sage);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:8px;}
  .alt-stat-text{font-family:'DM Serif Display',serif;font-size:22px;color:var(--ink);margin-bottom:6px;line-height:1.3;}
  .alt-stat-sub{font-size:13px;color:#6b5e4a;line-height:1.5;}

  /* REVIEWS */
  .reviews-list{display:flex;flex-direction:column;gap:12px;}
  .review-card{background:#1a2e1a;border-radius:var(--radius);padding:24px 28px;display:flex;align-items:flex-start;gap:20px;box-shadow:var(--shadow-md);}
  .review-card-body{flex:1;}
  .review-num{font-family:'DM Mono',monospace;font-size:10px;color:#6a9e6a;margin-bottom:8px;letter-spacing:0.06em;text-transform:uppercase;}
  .review-title{font-size:14px;font-weight:600;color:#e8d8a8;margin-bottom:8px;line-height:1.4;}
  .review-stars{color:var(--gold-light);font-size:13px;letter-spacing:2px;margin-bottom:10px;}
  .review-text{font-size:14px;color:#c8d8c8;line-height:1.8;font-style:italic;margin-bottom:14px;}
  .review-author-row{display:flex;align-items:center;gap:10px;padding-top:12px;border-top:1px solid #2a4a2a;}
  .review-author-name{font-family:'DM Mono',monospace;font-size:12px;color:#a8c4a8;font-weight:600;}
  .review-author-label{font-family:'DM Mono',monospace;font-size:11px;color:#7a9e7a;}
  .review-theme-tag{display:inline-block;font-size:10px;background:#2a4a2a;color:#7a9e7a;padding:3px 8px;border-radius:20px;}
  .review-copy-col{display:flex;flex-direction:column;align-items:flex-end;gap:8px;flex-shrink:0;}
  .review-charcount{font-family:'DM Mono',monospace;font-size:10px;color:#6a9e6a;}

  /* KEY BENEFITS (under MWP) */
  .benefits-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:12px;}
  .benefit-card{background:white;border:1px solid rgba(232,226,217,0.6);border-radius:var(--radius);padding:20px;box-shadow:var(--shadow);display:flex;flex-direction:column;gap:6px;}
  .benefit-card.placeholder{background:var(--cream);border:1px dashed var(--mist);box-shadow:none;}
  .benefit-num{font-family:'DM Mono',monospace;font-size:10px;color:#8a7a68;}
  .benefit-title{font-size:14px;font-weight:600;color:var(--ink);line-height:1.3;}
  .benefit-proof{font-size:12px;color:#6b5e4a;line-height:1.6;flex:1;}
  .benefit-footer{display:flex;justify-content:flex-end;margin-top:8px;}
  .fold-label{font-family:'DM Mono',monospace;font-size:10px;letter-spacing:0.08em;text-transform:uppercase;color:#8a7a68;margin-bottom:10px;padding-top:16px;border-top:1px dashed var(--mist);}

  /* CURATED */
  .curated-wrap{background:var(--cream);border:1px solid var(--mist);border-radius:var(--radius);padding:32px;box-shadow:var(--shadow);}
  .curated-card{background:white;border:1px solid var(--mist);border-radius:var(--radius);padding:18px 20px;margin-bottom:10px;box-shadow:var(--shadow);display:flex;align-items:flex-start;justify-content:space-between;gap:16px;}
  .curated-body{flex:1;}
  .curated-num{font-family:'DM Mono',monospace;font-size:10px;color:var(--gold);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:4px;}
  .curated-title{font-size:16px;font-weight:600;color:var(--ink);margin-bottom:4px;}
  .curated-subhead{font-size:13px;color:#6b5e4a;line-height:1.6;margin-bottom:4px;}
  .curated-context{font-size:11px;color:#8a7a68;font-style:italic;font-family:'DM Mono',monospace;}

  /* OBJECTION MAP */
  .objection-card{background:white;border:1px solid rgba(232,226,217,0.6);border-radius:var(--radius);margin-bottom:10px;overflow:hidden;box-shadow:var(--shadow);}
  .objection-header{padding:18px 20px;display:flex;align-items:flex-start;gap:14px;cursor:pointer;user-select:none;}
  .objection-header:hover{background:#faf8f4;}
  .objection-rank{font-family:'DM Mono',monospace;font-size:10px;background:var(--rust);color:white;padding:3px 8px;border-radius:20px;flex-shrink:0;margin-top:2px;}
  .objection-question{font-size:14px;font-weight:600;color:var(--ink);line-height:1.4;flex:1;}
  .objection-toggle{font-size:16px;color:#8a7a68;flex-shrink:0;transition:transform 0.2s;}
  .objection-toggle.open{transform:rotate(180deg);}
  .objection-body{padding:16px 20px 18px;border-top:1px solid var(--mist);display:none;}
  .objection-body.open{display:block;}
  .objection-source-label{font-family:'DM Mono',monospace;font-size:11px;color:var(--rust);margin-bottom:6px;}
  .objection-source-quote{font-size:13px;color:#5a4a38;font-style:italic;line-height:1.6;margin-bottom:14px;}
  .objection-answer-wrap{background:var(--cream);border-radius:8px;padding:14px 16px;margin-bottom:10px;}
  .objection-answer-label{font-family:'DM Mono',monospace;font-size:10px;color:var(--sage);letter-spacing:0.06em;text-transform:uppercase;margin-bottom:6px;}
  .objection-answer-row{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;}
  .objection-answer-text{font-size:13px;color:var(--ink);line-height:1.7;flex:1;}
  .objection-note{font-family:'DM Mono',monospace;font-size:11px;color:#8a7a68;}
  .objection-note span{color:var(--sage);}

  /* REFERENCE SECTIONS */
  .ref-divider{border:none;border-top:2px dashed var(--mist);margin:48px 0 32px;}
  .ref-label{font-family:'DM Mono',monospace;font-size:11px;color:#8a7a68;margin-bottom:32px;letter-spacing:0.06em;text-transform:uppercase;}
  .sentiment-wrap{background:white;border:1px solid rgba(232,226,217,0.6);border-radius:var(--radius);padding:28px 32px;box-shadow:var(--shadow);}
  .sentiment-stats-row{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:16px;}
  .sentiment-stat{background:var(--cream);border-radius:10px;padding:20px;text-align:center;}
  .sentiment-stat-pct{font-family:'DM Serif Display',serif;font-size:40px;line-height:1;color:var(--ink);margin-bottom:6px;}
  .sentiment-stat-label{font-size:13px;color:#6b5e4a;}
  .sentiment-bar{height:8px;background:var(--mist);border-radius:100px;overflow:hidden;display:flex;margin-bottom:8px;}
  .sentiment-fill{height:100%;transition:width 1s ease;}
  .s-positive{background:var(--ink);}
  .s-neutral{background:#8a7a68;}
  .s-negative{background:var(--rust);}
  .pain-card{border-left:3px solid var(--rust);background:white;padding:18px 22px;margin-bottom:10px;border-radius:0 var(--radius) var(--radius) 0;box-shadow:var(--shadow);display:flex;align-items:flex-start;justify-content:space-between;gap:16px;}
  .pain-body{flex:1;}
  .pain-rank{font-family:'DM Mono',monospace;font-size:10px;color:var(--rust);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:4px;}
  .pain-label{font-size:15px;font-weight:600;color:var(--ink);margin-bottom:4px;}
  .pain-language{font-size:13px;color:#5a4a38;line-height:1.7;font-style:italic;}
  .theme-pills{display:flex;flex-wrap:wrap;gap:8px;}
  .theme-pill{padding:7px 14px;background:white;border:1px solid var(--mist);border-radius:100px;font-size:12px;color:var(--ink);display:flex;align-items:center;gap:8px;box-shadow:var(--shadow);}
  .theme-pill .pill-count{font-family:'DM Mono',monospace;font-size:10px;background:var(--ink);color:var(--gold-light);padding:2px 7px;border-radius:100px;}

  .error-box{display:none;background:#fff5f3;border:1px solid #f5c6bb;border-radius:var(--radius);padding:20px 24px;font-size:14px;color:var(--rust);margin-bottom:24px;}
  .error-box.active{display:block;}
  .export-bar{display:flex;gap:12px;padding-top:24px;border-top:1px solid var(--mist);}
  .btn-export{padding:10px 24px;background:white;border:1px solid var(--mist);color:var(--ink);font-size:13px;border-radius:8px;cursor:pointer;transition:all 0.2s;font-family:'Instrument Sans',sans-serif;box-shadow:var(--shadow);}
  .btn-export:hover{border-color:var(--gold);color:var(--gold);}
  .date-range-badge{display:inline-flex;align-items:center;gap:6px;background:var(--cream);border:1px solid var(--mist);border-radius:20px;padding:4px 12px;font-family:'DM Mono',monospace;font-size:11px;color:#8a7a68;margin-top:8px;}

  @media(max-width:700px){
    .ra-controls,.stats-grid,.benefits-grid,.sentiment-stats-row{grid-template-columns:1fr 1fr;}
    .settings-grid{grid-template-columns:1fr 1fr;}
    .section-nav{display:none;}
  }
</style>

<div class="review-analyzer-wrapper" style="max-width:1100px;margin:0 auto;padding:52px 32px;">
  <h1 style="font-family:'DM Serif Display',serif;font-size:48px;line-height:1.1;margin-bottom:10px;color:var(--ink);">Turn reviews into<br><em style="color:var(--gold);">conversion copy.</em></h1>
  <p style="font-size:15px;color:#6b5e4a;margin-bottom:48px;max-width:560px;line-height:1.6;">Upload your Yotpo CSV. Paste the product wiki (optional). Get PDP-ready copy for every section — grounded in real customer language.</p>

  <div class="upload-zone" id="uploadZone">
    <input type="file" id="csvFile" accept=".csv">
    <svg class="upload-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1M12 12V4m0 0L8 8m4-4l4 4"/></svg>
    <div class="upload-title">Drop your Yotpo CSV here</div>
    <div class="upload-sub">or click to browse — .csv files only</div>
  </div>

  <div class="file-loaded" id="fileLoaded" style="display:none">
    <div class="dot"></div>
    <div><strong id="fileName">file.csv</strong> loaded — <span id="reviewCount">0</span> reviews across <span id="productCount">0</span> products</div>
  </div>

  <div class="ra-controls">
    <div><span class="ra-label">Select Product</span><select class="ra-select" id="productSelect" disabled><option value="">— upload a CSV first —</option></select></div>
    <div style="display:flex;align-items:flex-end;"><button class="btn-analyze" id="analyzeBtn" disabled onclick="runAnalysis()">Analyze Reviews</button></div>
  </div>

  <div style="margin-bottom:16px;">
    <span class="collapsible-toggle" onclick="togglePanel('wikiPanel','wikiArrow')">Product Wiki (optional) <span class="collapsible-arrow" id="wikiArrow">▾</span></span>
    <div class="collapsible-panel" id="wikiPanel">
      <textarea class="ra-textarea" id="wikiText" placeholder="Paste product wiki text here — copy from Google Doc. Used for Made With Purpose, Ingredients, and Key Benefits. Leave blank to use review language only."></textarea>
      <div class="panel-note">Plain text only. Formatting doesn't matter. Wiki-informed cards will be marked ✓ Wiki-informed.</div>
    </div>
  </div>

