    var headlineEl=document.createElement('div');headlineEl.className='ing-headline';
    headlineRaw.split('\n').forEach(function(line,li,arr){
      if(keyword&&line.toLowerCase().indexOf(keyword.toLowerCase())!==-1){
        var idx=line.toLowerCase().indexOf(keyword.toLowerCase());
        if(idx>0)headlineEl.appendChild(document.createTextNode(line.substring(0,idx)));
        var em=document.createElement('em');em.textContent=line.substring(idx,idx+keyword.length);headlineEl.appendChild(em);
        if(idx+keyword.length<line.length)headlineEl.appendChild(document.createTextNode(line.substring(idx+keyword.length)));
      } else {headlineEl.appendChild(document.createTextNode(line));}
      if(li<arr.length-1)headlineEl.appendChild(document.createElement('br'));
    });
    var sub=document.createElement('div');sub.className='ing-subline';sub.textContent=ing.subline||'';
    var meta=document.createElement('div');meta.className='choice-meta'+(over?' over':'');meta.style.marginTop='10px';meta.textContent=sc+' / '+settings.ing_chars+' chars'+(over?' — over limit':'');
    body.appendChild(num);body.appendChild(headlineEl);body.appendChild(sub);body.appendChild(meta);
    main.appendChild(body);main.appendChild(makeCopyBtn(headlineRaw+'\n'+(ing.subline||'')));
    wrap.appendChild(main);wrap.appendChild(makeWikiSourceCol(ing.wiki_source));ingList.appendChild(wrap);
  });

  // CURATED
  var curList=document.getElementById('curatedList');curList.innerHTML='';
  (a.curated_collection||[]).forEach(function(c){
    var sc=(c.subhead||'').length,over=sc>settings.curated_chars;
    var card=document.createElement('div');card.className='curated-card';
    var body=document.createElement('div');body.className='curated-body';
    var num=document.createElement('div');num.className='curated-num';num.textContent='Option '+c.num;
    var title=document.createElement('div');title.className='curated-title';title.textContent=c.title||'';
    var sub=document.createElement('div');sub.className='curated-subhead';sub.textContent=c.subhead||'';
    var ctx=document.createElement('div');ctx.className='curated-context';ctx.textContent=c.context||'';
    var meta=document.createElement('div');meta.className='curated-meta'+(over?' over':'');meta.textContent=sc+' / '+settings.curated_chars+' chars'+(over?' — over limit':'');
    body.appendChild(num);body.appendChild(title);body.appendChild(sub);body.appendChild(ctx);body.appendChild(meta);
    card.appendChild(body);card.appendChild(makeCopyBtn((c.title||'')+' \u2014 '+(c.subhead||'')));curList.appendChild(card);
  });

  // FAQS
  var faqContainer=document.getElementById('faqCards');faqContainer.innerHTML='';
  (a.faqs||[]).forEach(function(o){
    var card=document.createElement('div');card.className='faq-card';
    if(o.is_what_to_expect)card.classList.add('faq-card-expect');
    var bid='faq-body-'+o.rank,tid='faq-tog-'+o.rank;
    var header=document.createElement('div');header.className='faq-header';
    header.addEventListener('click',function(){document.getElementById(bid).classList.toggle('open');document.getElementById(tid).classList.toggle('open');});
    var rank=document.createElement('span');rank.className='faq-rank';rank.textContent='#'+o.rank;
    var qWrap=document.createElement('div');qWrap.style.cssText='flex:1;display:flex;flex-direction:column;gap:4px;';
    if(o.is_what_to_expect){
      var expectPill=document.createElement('span');expectPill.className='faq-expect-pill';expectPill.textContent='What to Expect';
      qWrap.appendChild(expectPill);
    }
    var q=document.createElement('div');q.className='faq-question';q.textContent=o.question||'';
    qWrap.appendChild(q);
    var tog=document.createElement('span');tog.className='faq-toggle';tog.id=tid;tog.textContent='\u25be';
    header.appendChild(rank);header.appendChild(qWrap);header.appendChild(tog);
    var body=document.createElement('div');body.className='faq-body';body.id=bid;
    if(o.source_language){
      var srcLbl=document.createElement('div');srcLbl.className='faq-source-label';srcLbl.textContent='From review language';
      var srcQ=document.createElement('div');srcQ.className='faq-source-quote';srcQ.textContent='\u201c'+o.source_language+'\u201d';
      body.appendChild(srcLbl);body.appendChild(srcQ);
    }
    var ansWrap=document.createElement('div');ansWrap.className='faq-answer-wrap';
    var ansLbl=document.createElement('div');ansLbl.className='faq-answer-label';ansLbl.textContent='Suggested answer — edit before publishing';
    var ansRow=document.createElement('div');ansRow.className='faq-answer-row';
    var ansTxt=document.createElement('div');ansTxt.className='faq-answer-text';ansTxt.textContent=o.suggested_answer||'';
    ansRow.appendChild(ansTxt);ansRow.appendChild(makeCopyBtn((o.question||'')+'\n\n'+(o.suggested_answer||'')));
    ansWrap.appendChild(ansLbl);ansWrap.appendChild(ansRow);
    var ansLen=(o.suggested_answer||'').length;
    if(ansLen>0){
      var ansMeta=document.createElement('div');ansMeta.className='faq-answer-meta'+(ansLen>settings.faq_chars?' over':'');ansMeta.textContent=ansLen+' / '+settings.faq_chars+' chars'+(ansLen>settings.faq_chars?' — over limit':'');
      ansWrap.appendChild(ansMeta);
    }
    body.appendChild(ansWrap);
    if(o.is_what_to_expect&&o.expectation_substantiation){
      var sub=o.expectation_substantiation;
      var vBlock=document.createElement('div');vBlock.className='verification-block';
      var vTitle=document.createElement('div');vTitle.className='verification-title';vTitle.textContent='Substantiation — from reviews';
      vBlock.appendChild(vTitle);
      if(sub.onset_quotes&&sub.onset_quotes.length){
        var lbl1=document.createElement('div');lbl1.className='verification-row v-quotes-label';lbl1.innerHTML='<span class="v-label">Onset timing quotes:</span>';
        vBlock.appendChild(lbl1);
        sub.onset_quotes.forEach(function(q){var el=document.createElement('div');el.className='verification-quote';el.textContent='\u201c'+q+'\u201d';vBlock.appendChild(el);});
      }
      if(sub.effects_quotes&&sub.effects_quotes.length){
        var lbl2=document.createElement('div');lbl2.className='verification-row v-quotes-label';lbl2.innerHTML='<span class="v-label">Temporary effects quotes:</span>';
        vBlock.appendChild(lbl2);
        sub.effects_quotes.forEach(function(q){var el=document.createElement('div');el.className='verification-quote';el.textContent='\u201c'+q+'\u201d';vBlock.appendChild(el);});
      }
      body.appendChild(vBlock);
    }
    if(o.answer_note){
      var note=document.createElement('div');note.className='faq-note';note.style.marginTop='14px';
      var noteSpan=document.createElement('span');noteSpan.textContent=o.answer_note;
      note.appendChild(document.createTextNode('Must address: '));note.appendChild(noteSpan);
      body.appendChild(note);
    }
    card.appendChild(header);card.appendChild(body);faqContainer.appendChild(card);
  });

  // PAIN POINTS
  var painContainer=document.getElementById('painCards');painContainer.innerHTML='';
  (a.pain_points||[]).forEach(function(p){
    var card=document.createElement('div');card.className='pain-card';
    var body=document.createElement('div');body.className='pain-body';
    var rank=document.createElement('div');rank.className='pain-rank';rank.textContent='Pain Point #'+p.rank;
    var lbl=document.createElement('div');lbl.className='pain-label-txt';lbl.textContent=p.label||'';
    var lang=document.createElement('div');lang.className='pain-language';lang.textContent='\u201c'+(p.customer_language||'')+'\u201d';
    body.appendChild(rank);body.appendChild(lbl);body.appendChild(lang);
    card.appendChild(body);card.appendChild(makeCopyBtn(p.copy_hook||''));painContainer.appendChild(card);
  });

  // SENTIMENT
  var s=a.sentiment||{positive:0,neutral:0,negative:0},sum=s.positive+s.neutral+s.negative||1;
  var pp=Math.round(s.positive/sum*100),np=Math.round(s.neutral/sum*100),ngp=Math.round(s.negative/sum*100);
  document.getElementById('posNum').textContent=pp+'%';
  document.getElementById('neuNum').textContent=np+'%';
  document.getElementById('negNum').textContent=ngp+'%';
  setTimeout(function(){document.getElementById('sentimentPos').style.width=pp+'%';document.getElementById('sentimentNeu').style.width=np+'%';document.getElementById('sentimentNeg').style.width=ngp+'%';},100);

  showResults();
  window.scrollTo({top:0,behavior:'smooth'});
}

function exportTxt(){
  if(!lastAnalysis)return;
  var a=lastAnalysis.analysis,out='REVIEW ANALYSIS REPORT\n'+lastAnalysis.product+'\n'+lastAnalysis.analyzed.toLocaleString()+' of '+lastAnalysis.count.toLocaleString()+' reviews\n';
  if(lastAnalysis.dateRange)out+='Date range: '+lastAnalysis.dateRange+'\n';
  out+='Generated: '+new Date().toISOString()+'\n';
  out+='\n=== ABOUT ===\n';
  (a.about_options||[]).forEach(function(o){
    out+='Option '+o.num+(o.differentiator_type?' ['+o.differentiator_type+']':'')+(o.pain_point_tag?' [Pain: '+o.pain_point_tag+']':'')+(o.benefit_tag?' [Benefit: '+o.benefit_tag+']':'')+(o.differentiator_tag?' [Diff: '+o.differentiator_tag+']':'')+'\n'+o.text+'\n';
    if(o.why_this_differentiates)out+='Why this differentiates: '+o.why_this_differentiates+'\n';
    out+='\n';
  });
  out+='\n=== MADE WITH PURPOSE ===\n';
  if(a.wiki_v1_alignment&&a.wiki_v1_alignment.has_mismatch){
    out+='[MISMATCH FLAGGED]\n';
    if(a.wiki_v1_alignment.wiki_only_adds&&a.wiki_v1_alignment.wiki_only_adds.length)out+='Wiki adds: '+a.wiki_v1_alignment.wiki_only_adds.join(', ')+'\n';
    if(a.wiki_v1_alignment.v1_only_adds&&a.wiki_v1_alignment.v1_only_adds.length)out+='v1 adds: '+a.wiki_v1_alignment.v1_only_adds.join(', ')+'\n';
    if(a.wiki_v1_alignment.contradictions&&a.wiki_v1_alignment.contradictions.length)out+='Contradictions: '+a.wiki_v1_alignment.contradictions.join('; ')+'\n';
    out+='\n';
  }
  (a.made_with_purpose||[]).forEach(function(m){
    out+='Option '+m.num+': '+m.title+'\n'+m.description+'\n';
    if(m.v1_pdp_source)out+='V1 PDP source: '+m.v1_pdp_source+'\n';
    out+='Wiki source: '+m.wiki_source+'\n\n';
  });
  out+='\n=== KEY BENEFITS ===\n';
  (a.benefits||[]).forEach(function(b){out+='Benefit '+b.rank+': '+b.title+': '+b.proof+(b.pct?' ('+b.pct+'%)':'')+'\n';});
  out+='\n=== OUTCOME STATS ===\n';
  (a.outcome_stats||[]).forEach(function(s){out+='• '+s.percentage+'% '+s.detail+' ('+s.count+' of '+lastAnalysis.analyzed+' reviewers analyzed)\n';});
  if(a.transformation){
    out+='\nTRANSFORMATION TIMELINE:\n';
    out+='Claim: '+a.transformation.stat+'\n';
    if(a.transformation.mention_count)out+='Mentions (BOTH timeframe AND outcome): '+a.transformation.mention_count+' of '+lastAnalysis.analyzed+' reviewers analyzed\n';
    if(a.transformation.timeframe_keywords)out+='Timeframe keywords: '+a.transformation.timeframe_keywords.join(', ')+'\n';
    if(a.transformation.outcome_keywords)out+='Outcome keywords: '+a.transformation.outcome_keywords.join(', ')+'\n';
    if(a.transformation.sample_quotes)a.transformation.sample_quotes.forEach(function(q){out+='Quote: "'+q+'"\n';});
    out+='\n';
  }
  (a.alt_stats||[]).forEach(function(s){
    out+='ALT FRAMING:\n';
    out+='Claim: '+s.text+'\n';
    if(s.mention_count)out+='Mentions (BOTH timeframe AND outcome): '+s.mention_count+' of '+lastAnalysis.analyzed+' reviewers analyzed\n';
    if(s.timeframe_keywords)out+='Timeframe keywords: '+s.timeframe_keywords.join(', ')+'\n';
    if(s.outcome_keywords)out+='Outcome keywords: '+s.outcome_keywords.join(', ')+'\n';
    if(s.sample_quotes)s.sample_quotes.forEach(function(q){out+='Quote: "'+q+'"\n';});
    out+='\n';
  });
  out+='\n=== REVIEWS (VERBATIM) ===\n';
  (a.reviews||[]).forEach(function(v){out+='Review '+v.num+': '+v.title+'\n"'+(v.original_text||'')+'"\n— '+(v.original_author||'Verified Buyer')+' [Theme: '+(v.theme||'')+']\n\n';});
  out+='\n=== INGREDIENTS ===\n';
  (a.ingredients||[]).forEach(function(ing){out+='Option '+ing.num+':\n'+ing.headline+'\n'+ing.subline+'\nWiki source: '+ing.wiki_source+'\n\n';});
  out+='\n=== CURATE YOUR COLLECTION ===\n';
  (a.curated_collection||[]).forEach(function(c){out+='Option '+c.num+': '+c.title+'\n'+c.subhead+'\n\n';});
  out+='\n=== FAQS ===\n';
  (a.faqs||[]).forEach(function(o){
    out+='#'+o.rank+(o.is_what_to_expect?' [WHAT TO EXPECT]':'')+' '+o.question+'\nAnswer: '+o.suggested_answer+'\n';
    if(o.is_what_to_expect&&o.expectation_substantiation){
      var es=o.expectation_substantiation;
      if(es.onset_quotes&&es.onset_quotes.length){out+='Onset timing quotes:\n';es.onset_quotes.forEach(function(q){out+='  "'+q+'"\n';});}
      if(es.effects_quotes&&es.effects_quotes.length){out+='Temporary effects quotes:\n';es.effects_quotes.forEach(function(q){out+='  "'+q+'"\n';});}
    }
    out+='\n';
  });
  out+='\n=== PAIN POINTS ===\n';
  (a.pain_points||[]).forEach(function(p){out+='#'+p.rank+' '+p.label+'\n"'+p.customer_language+'"\n\n';});
  var date=new Date();
  var dateStr=date.getFullYear()+'-'+String(date.getMonth()+1).padStart(2,'0')+'-'+String(date.getDate()).padStart(2,'0');
  var blob=new Blob([out],{type:'text/plain'}),url=URL.createObjectURL(blob),link=document.createElement('a');
  link.href=url;link.download=lastAnalysis.product.replace(/\s+/g,'-').replace(/[®™©]/g,'')+'-review-analysis-'+dateStr+'.txt';link.click();
}

var _loadTimer=null,_loadStart=0;
function showLoading(sampleSize,totalCount){
  document.getElementById('raLoading').classList.add('active');
  document.getElementById('loadingCount').textContent=sampleSize.toLocaleString();
  document.getElementById('loadingTotal').textContent=totalCount.toLocaleString();
  ['step1','step2','step3','step4'].forEach(function(s){document.getElementById(s).className='loading-step';});
  _loadStart=Date.now();document.getElementById('loadingBar').style.width='0%';document.getElementById('loadingTimer').textContent='0s elapsed';
  if(_loadTimer)clearInterval(_loadTimer);
  _loadTimer=setInterval(function(){
    var elapsed=Math.round((Date.now()-_loadStart)/1000);
    document.getElementById('loadingTimer').textContent=elapsed+'s elapsed';
    document.getElementById('loadingBar').style.width=Math.min(90,elapsed*2)+'%';
  },1000);
}
function hideLoading(){document.getElementById('raLoading').classList.remove('active');if(_loadTimer){clearInterval(_loadTimer);_loadTimer=null;}document.getElementById('loadingBar').style.width='100%';}
function showResults(){document.getElementById('raResults').classList.add('active');}
function hideResults(){document.getElementById('raResults').classList.remove('active');}
function showError(m){var b=document.getElementById('errorBox');b.textContent=m;b.classList.add('active');}
function hideError(){document.getElementById('errorBox').classList.remove('active');}
function stepActive(id){document.getElementById(id).classList.add('active');}
function stepDone(id){document.getElementById(id).classList.remove('active');document.getElementById(id).classList.add('done');}
</script>

