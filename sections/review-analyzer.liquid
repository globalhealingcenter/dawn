  });
  (analysis.made_with_purpose||[]).forEach(function(m,i){
    if((m.description||'').length>settings.mwp_chars){
      items.push({id:'mwp_'+i,max_chars:settings.mwp_chars,current_text:m.description,note:'MWP benefit description'});
    }
  });
  (analysis.ingredients||[]).forEach(function(ing,i){
    if((ing.subline||'').length>settings.ing_chars){
      items.push({id:'ing_'+i,max_chars:settings.ing_chars,current_text:ing.subline,note:'Ingredient subline'});
    }
  });
  (analysis.curated_collection||[]).forEach(function(c,i){
    if((c.subhead||'').length>settings.curated_chars){
      items.push({id:'curated_'+i,max_chars:settings.curated_chars,current_text:c.subhead,note:'Curated collection subhead'});
    }
  });
  (analysis.faqs||[]).forEach(function(f,i){
    if((f.suggested_answer||'').length>settings.faq_chars){
      items.push({id:'faq_'+i,max_chars:settings.faq_chars,current_text:f.suggested_answer,note:'FAQ answer'});
    }
  });
  (analysis.outcome_stats||[]).forEach(function(s,i){
    if((s.detail||'').length>settings.stat_chars){
      items.push({id:'stat_'+i,max_chars:settings.stat_chars,current_text:s.detail,note:'Stat label — punchy outcome'});
    }
  });

  if(items.length===0)return analysis;

  try{
    var rewritePrompt=buildRewritePrompt(items);
    var rawText=await doFetch(rewritePrompt,3000);
    var parsed=parseEnvelope(rawText);
    if(!parsed||!parsed.rewrites)return analysis;

    parsed.rewrites.forEach(function(rw){
      var parts=rw.id.split('_');
      var kind=parts[0];
      var idx=parseInt(parts[1]);
      if(isNaN(idx))return;
      if(kind==='about'&&analysis.about_options&&analysis.about_options[idx])analysis.about_options[idx].text=rw.new_text;
      else if(kind==='mwp'&&analysis.made_with_purpose&&analysis.made_with_purpose[idx])analysis.made_with_purpose[idx].description=rw.new_text;
      else if(kind==='ing'&&analysis.ingredients&&analysis.ingredients[idx])analysis.ingredients[idx].subline=rw.new_text;
      else if(kind==='curated'&&analysis.curated_collection&&analysis.curated_collection[idx])analysis.curated_collection[idx].subhead=rw.new_text;
      else if(kind==='faq'&&analysis.faqs&&analysis.faqs[idx])analysis.faqs[idx].suggested_answer=rw.new_text;
      else if(kind==='stat'&&analysis.outcome_stats&&analysis.outcome_stats[idx])analysis.outcome_stats[idx].detail=rw.new_text;
    });
  }catch(e){
    console.log('Rewrite pass failed:',e.message);
  }
  return analysis;
}

async function runAnalysis(){
  var product=document.getElementById('productSelect').value;
  if(!product){showError('Please select a product.');return;}
  var reviews=getReviewsForProduct(product);
  if(!reviews.length){showError('No reviews found.');return;}
  var wiki=document.getElementById('wikiText').value.trim();
  if(!wiki){if(!confirm('Product wiki is empty. Made With Purpose and Ingredients will be less accurate. Continue anyway?')){return;}}
  var settings=getSettings();
  hideError();hideResults();

  var sorted=sortByDateDesc(reviews);
  var sample=sorted.slice(0,SAMPLE_SIZE);
  showLoading(sample.length,reviews.length);
  var dateRange=getDateRange(sample);
  var authorCol=getAuthorCol(sample[0]);

  lastV1PdpBenefits=null;
  try{lastV1PdpBenefits=await fetchV1PdpBenefits(product);}catch(e){lastV1PdpBenefits=null;}

  var reviewTexts=sample.map(function(r){
    var text=getReviewText(r);
    var author=authorCol&&r[authorCol]?r[authorCol].trim():'';
    var isAnon=!author||author.toLowerCase()==='verified buyer'||author.toLowerCase()==='anonymous'||author.length<2;
    return (isAnon?'[ANON]: ':'['+author+']: ')+text;
  }).filter(function(t){return t.length>20;}).join('\n---\n');

  var wikiSection=wiki?'\n\nPRODUCT WIKI:\n'+wiki.substring(0,4000)+'\n':'';
  var v1Section='';
  if(lastV1PdpBenefits&&lastV1PdpBenefits.length){
    v1Section='\n\nV1 PDP BENEFITS (currently published, use as foundation for conversion-angle rewrites):\n';
    lastV1PdpBenefits.forEach(function(b,i){v1Section+=(i+1)+'. '+b.title+': '+b.description+'\n';});
  } else {
    v1Section='\n\nV1 PDP BENEFITS: none retrieved. Generate all 5 made_with_purpose options from wiki only. Leave v1_pdp_source empty on every card. Label every card source_type="wiki". Do NOT fabricate v1_pdp_source quotes.';
  }
  wikiSection+=v1Section;
  stepActive('step1');
  var prompt=buildPrompt(product,sample.length,wikiSection,settings,reviewTexts);
  stepDone('step1');stepActive('step2');

  try{
    var rawText;
    try{rawText=await doFetch(prompt,20000);}
    catch(e1){
      if(e1.message.indexOf('524')!==-1||e1.message.indexOf('overloaded')!==-1||e1.message.indexOf('529')!==-1){
        document.getElementById('loadingTimer').textContent='Retrying\u2026';
        await new Promise(function(r){setTimeout(r,3000);});
        rawText=await doFetch(prompt,20000);
      } else {throw e1;}
    }
    stepDone('step2');stepActive('step3');
    var analysis=parseEnvelope(rawText);
    if(!analysis){hideLoading();showError('Could not parse response. Try again.');return;}
    stepDone('step3');stepActive('step4');

    analysis=await enforceCharLimits(analysis,settings);

    lastAnalysis={product:product,analysis:analysis,count:reviews.length,analyzed:sample.length,dateRange:dateRange,settings:settings,v1Benefits:lastV1PdpBenefits};
    stepDone('step4');
    setTimeout(function(){hideLoading();renderResults(product,reviews.length,sample.length,analysis,dateRange,settings);},400);
  }catch(err){hideLoading();showError('Analysis failed: '+err.message);}
}

function copyText(text){
  var clean=String(text).replace(/<[^>]+>/g,'').replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&quot;/g,'"').replace(/&#39;/g,"'");
  navigator.clipboard.writeText(clean);
}
function makeCopyBtn(text){
  var btn=document.createElement('button');
  btn.className='btn-copy';btn.textContent='Copy';
  btn.addEventListener('click',function(){copyText(text);btn.textContent='Copied';btn.classList.add('copied');setTimeout(function(){btn.textContent='Copy';btn.classList.remove('copied');},2000);});
  return btn;
}
function isGeneric(text){var lower=(text||'').toLowerCase();return GENERIC_TERMS.some(function(t){return lower.indexOf(t)!==-1;});}
function makeWikiSourceCol(wikiSource,v1Source){
  var col=document.createElement('div');col.className='wiki-source-col';
  if(v1Source){
    var v1Lbl=document.createElement('div');v1Lbl.className='wiki-source-label';v1Lbl.textContent='From v1 PDP';
    var v1Quote=document.createElement('div');v1Quote.className='wiki-source-quote';v1Quote.textContent=v1Source;
    col.appendChild(v1Lbl);col.appendChild(v1Quote);
    var spacer=document.createElement('div');spacer.style.height='8px';col.appendChild(spacer);
  }
  var lbl=document.createElement('div');lbl.className='wiki-source-label';lbl.textContent='From wiki';
  var quote=document.createElement('div');quote.className='wiki-source-quote';quote.textContent=wikiSource||'\u2014';
  col.appendChild(lbl);col.appendChild(quote);return col;
}

