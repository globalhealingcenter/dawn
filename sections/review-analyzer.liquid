<script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
<script>
var allReviews = [], lastAnalysis = null;

function scrollTo(id){ var el=document.getElementById(id); if(el) el.scrollIntoView({behavior:'smooth',block:'start'}); }

document.getElementById('uploadZone').addEventListener('dragover', function(e){ e.preventDefault(); this.classList.add('drag-over'); });
document.getElementById('uploadZone').addEventListener('dragleave', function(){ this.classList.remove('drag-over'); });
document.getElementById('uploadZone').addEventListener('drop', function(e){ e.preventDefault(); this.classList.remove('drag-over'); if(e.dataTransfer.files[0]) processFile(e.dataTransfer.files[0]); });
document.getElementById('csvFile').addEventListener('change', function(e){ if(e.target.files[0]) processFile(e.target.files[0]); });

function processFile(file){
  Papa.parse(file,{ header:true, skipEmptyLines:true, complete:function(r){
    allReviews = r.data;
    var products = getProducts(allReviews);
    var productCounts = getProductCounts(allReviews);
    var sel = document.getElementById('productSelect');
    sel.innerHTML = '<option value="">— choose a product —</option>';
    products.forEach(function(p){
      var o=document.createElement('option');
      o.value=p;
      var count = productCounts[p] || 0;
      o.textContent=p+' ('+count.toLocaleString()+' reviews)';
      sel.appendChild(o);
    });
    sel.disabled=false; document.getElementById('focusTheme').disabled=false; document.getElementById('analyzeBtn').disabled=false;
    document.getElementById('uploadZone').style.display='none';
    document.getElementById('fileLoaded').style.display='flex';
    document.getElementById('fileName').textContent=file.name;
    document.getElementById('reviewCount').textContent=allReviews.length.toLocaleString();
    document.getElementById('productCount').textContent=products.length.toLocaleString();
  }, error:function(){ showError("Couldn't parse CSV."); }});
}

function getProductCol(reviews){
  var keys=['product_title','Product Title','product_name','Product Name','title','name'];
  for(var i=0;i<keys.length;i++){ if(reviews[0]&&reviews[0][keys[i]]!==undefined) return keys[i]; }
  return null;
}

function getProducts(reviews){
  var col=getProductCol(reviews);
  if(!col) return['All Reviews'];
  var set=new Set(reviews.map(function(r){return r[col];}).filter(Boolean));
  return Array.from(set).sort();
}

function getProductCounts(reviews){
  var col=getProductCol(reviews);
  if(!col) return {};
  var counts={};
  reviews.forEach(function(r){ var p=r[col]; if(p){ counts[p]=(counts[p]||0)+1; } });
  return counts;
}

function getReviewsForProduct(product){
  if(product==='All Reviews') return allReviews;
  var col=getProductCol(allReviews);
  if(!col) return allReviews;
  return allReviews.filter(function(r){return r[col]===product;});
}

function getDateCol(review){
  var keys=['review creation date','Review Creation Date','created_at','Created At','date','Date','review_date'];
  for(var i=0;i<keys.length;i++){ if(review[keys[i]]!==undefined) return keys[i]; }
  return null;
}

function sortByDateDesc(reviews){
  var dateCol=getDateCol(reviews[0]);
  if(!dateCol) return reviews;
  return reviews.slice().sort(function(a,b){
    var da=new Date(a[dateCol]||0), db=new Date(b[dateCol]||0);
    return db-da;
  });
}

function getDateRange(reviews){
  var dateCol=getDateCol(reviews[0]);
  if(!dateCol) return null;
  var dates=reviews.map(function(r){ return new Date(r[dateCol]); }).filter(function(d){ return !isNaN(d); });
  if(!dates.length) return null;
  dates.sort(function(a,b){return a-b;});
  var fmt=function(d){ return d.toLocaleDateString('en-US',{month:'short',year:'numeric'}); };
  return fmt(dates[0])+' – '+fmt(dates[dates.length-1]);
}

function getAuthorCol(review){
  var keys=['display name','Display Name','reviewer_name','Reviewer Name','author','Author'];
  for(var i=0;i<keys.length;i++){ if(review[keys[i]]!==undefined) return keys[i]; }
  return null;
}

function getReviewText(review){
  var keys=['review_content','Review Content','body','Body','content','Content','review','Review','comment','Comment'];
  for(var i=0;i<keys.length;i++){ if(review[keys[i]]&&review[keys[i]].trim()) return review[keys[i]].trim(); }
  return Object.values(review).find(function(v){return v&&v.length>40;})||'';
}

async function runAnalysis(){
  var product=document.getElementById('productSelect').value;
  var focus=document.getElementById('focusTheme').value.trim();
  if(!product){showError('Please select a product.');return;}
  var reviews=getReviewsForProduct(product);
  if(!reviews.length){showError('No reviews found.');return;}
  hideError(); showLoading(reviews.length); hideResults();

  var sorted=sortByDateDesc(reviews);
  var sample=sorted.slice(0,2000);
  var dateRange=getDateRange(sample);

  var authorCol=getAuthorCol(sample[0]);
  var reviewTexts=sample.map(function(r){
    var text=getReviewText(r);
    var author=authorCol&&r[authorCol]?r[authorCol].trim():'';
    return (author?'['+author+']: ':'')+text;
  }).filter(function(t){return t.length>20;}).join('\n---\n');

  stepActive('step1');
  var focusLine=focus?'Pay special attention to mentions of: '+focus+'.':'';

  var prompt='You are a conversion copywriter and VoC analyst for a supplement ecommerce brand. Analyze these '+sample.length+' customer reviews for "'+product+'".\n\n'+focusLine+'\n\nReturn ONLY valid JSON, no markdown:\n{\n  "total_analyzed": number,\n  "sentiment": {"positive":number,"neutral":number,"negative":number},\n  "outcome_stats": [{"percentage":number,"theme":"label","detail":"reported [outcome]","count":number}],\n  "transformation": {"stat":"X% noticed a difference within [timeframe]","timeframe":"e.g. 2 weeks","percentage":number,"sub":"Based on review language about time-to-result"},\n  "pain_points": [{"rank":1,"label":"name","customer_language":"exact phrases from reviews","copy_hook":"PDP opener sentence"}],\n  "benefits": [{"rank":1,"title":"title","proof":"customer proof line","pct":number}],\n  "themes": [{"label":"theme","count":number}],\n  "verbatims": [{"quote":"full quote up to 80 words","author":"reviewer name or Verified Buyer","theme":"theme"}],\n  "copy_snippets": [{"text":"copy with <strong>stat</strong>","placement":"location"}],\n  "curated_subtitles": [{"num":1,"text":"subtitle","context":"Best used when: scenario"}],\n  "objections": [{"rank":1,"question":"customer question","source_language":"exact phrase","answer_prompt":"what to address"}]\n}\n\nRules:\n- outcome_stats: 4-6 items, real percentages\n- transformation: always include, mine time-to-result language like "within a week" "after 2 weeks" "by day 3"\n- pain_points: exactly 3, real phrases from reviews\n- benefits: exactly 6 (rank 1-3 primary, 4-6 additional options)\n- themes: 6-8 by count\n- verbatims: exactly 4, full quotes, include author name from [author]: prefix if present\n- copy_snippets: 4-5 items\n- curated_subtitles: exactly 3\n- objections: exactly 10 ranked by frequency\n\nReviews:\n'+reviewTexts;

  stepDone('step1'); stepActive('step2');

  try{
    var response=await fetch('https://ecom-claude-proxy.globalhealing.workers.dev',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({model:'claude-sonnet-4-5',max_tokens:6000,messages:[{role:'user',content:prompt}]})
    });
    stepDone('step2'); stepActive('step3');
    if(!response.ok){var err=await response.json();throw new Error(err.error&&err.error.message||'API error');}
    var data=await response.json();
    var raw=data.content.map(function(b){return b.text||'';}).join('');
    stepDone('step3'); stepActive('step4');
    var clean=raw.replace(/```json|```/g,'').trim();
    var analysis;
    try{ analysis=JSON.parse(clean); }
    catch(e){ hideLoading(); showError('Parse error: '+clean.substring(0,300)); return; }
    lastAnalysis={product:product,analysis:analysis,count:reviews.length,analyzed:sample.length,dateRange:dateRange};
    stepDone('step4');
    setTimeout(function(){hideLoading();renderResults(product,reviews.length,sample.length,analysis,dateRange);},400);
  }catch(err){hideLoading();showError('Analysis failed: '+err.message);}
}

var THRESHOLD = 72;

function renderResults(product,total,analyzed,a,dateRange){
  document.getElementById('resultsTitle').textContent=product;
  document.getElementById('resultsMeta').textContent=analyzed.toLocaleString()+' of '+total.toLocaleString()+' reviews analyzed\n(most recent first)';

  if(dateRange){
    document.getElementById('dateRangeBadge').style.display='inline-flex';
    document.getElementById('dateRangeText').textContent='Reviews: '+dateRange;
  }

  // Sentiment
  var s=a.sentiment||{positive:0,neutral:0,negative:0}, sum=s.positive+s.neutral+s.negative||1;
  var posPct=Math.round(s.positive/sum*100), neuPct=Math.round(s.neutral/sum*100), negPct=Math.round(s.negative/sum*100);
  document.getElementById('posNum').textContent=posPct+'%';
  document.getElementById('neuNum').textContent=neuPct+'%';
  document.getElementById('negNum').textContent=negPct+'%';
  setTimeout(function(){
    document.getElementById('sentimentPos').style.width=posPct+'%';
    document.getElementById('sentimentNeu').style.width=neuPct+'%';
    document.getElementById('sentimentNeg').style.width=negPct+'%';
  },100);

  // Outcome stats
  var grid=document.getElementById('statsGrid'); grid.innerHTML='';
  var maxPct=0;
  (a.outcome_stats||[]).forEach(function(s){
    if(s.percentage>maxPct) maxPct=s.percentage;
    var warn=s.percentage<THRESHOLD;
    var card=document.createElement('div');
    card.className='stat-card'+(warn?' warn':'');
    card.innerHTML='<div class="stat-card-accent"></div><div class="stat-pct">'+s.percentage+'%</div><div class="stat-label">'+s.detail+'</div><div class="stat-detail">'+s.count+' of '+analyzed.toLocaleString()+' reviewers</div>';
    grid.appendChild(card);
  });
  document.getElementById('statsFootnote').textContent='Based on '+analyzed.toLocaleString()+' Yotpo verified purchase reviews (most recent). Results reflect customer-reported outcomes — individual experiences may vary.';

  // Warning + transformation
  var strongStats=(a.outcome_stats||[]).filter(function(s){return s.percentage>=THRESHOLD;});
  var showWarning=strongStats.length<=1;

  if(showWarning){
    var warn=document.getElementById('statsWarning');
    warn.style.display='block';
    if(maxPct<THRESHOLD){
      document.getElementById('statsWarningText').textContent='All outcome stats for this product are below 72%. Jane: avoid leading with raw percentages on the PDP. Use the transformation timeframe framing below instead.';
    } else {
      document.getElementById('statsWarningText').textContent='Only one stat clears 72% — the overall stat picture is weak. Jane: the transformation timeframe below may be stronger as the lead claim on this PDP.';
    }
  } else {
    document.getElementById('statsWarning').style.display='none';
  }

  // Transformation card always shows
  if(a.transformation){
    var tc=document.getElementById('transformationCard');
    tc.style.display='block';
    document.getElementById('transformationStat').textContent=a.transformation.stat;
    document.getElementById('transformationSub').textContent=a.transformation.sub+(showWarning?' — Jane: consider using this as the lead stat instead of outcome percentages.':' — Jane: use this as a supporting stat alongside the outcome percentages.');
  }

  // Pain points
  var painContainer=document.getElementById('painCards'); painContainer.innerHTML='';
  (a.pain_points||[]).forEach(function(p){
    var card=document.createElement('div'); card.className='pain-card';
    var safeHook=p.copy_hook.replace(/'/g,"&#39;");
    card.innerHTML='<div class="pain-rank">Pain Point #'+p.rank+'</div><div class="pain-label">'+p.label+'</div><div class="pain-language">"'+p.customer_language+'"</div><div class="pain-hook-row"><div class="pain-copy-hook">Copy hook → <span>'+p.copy_hook+'</span></div><button class="btn-copy-sm" onclick="copyText(this,\''+safeHook+'\')">Copy</button></div>';
    painContainer.appendChild(card);
  });

  // Benefits
  var reviewBenefits=document.getElementById('reviewBenefitsGrid'); reviewBenefits.innerHTML='';
  var allBenefits=a.benefits||[];
  allBenefits.slice(0,3).forEach(function(b){
    var safeProof=(b.title+': '+b.proof).replace(/'/g,"&#39;");
    var card=document.createElement('div'); card.className='benefit-card';
    card.innerHTML='<div class="benefit-num">Benefit 0'+b.rank+'</div><div class="benefit-title">'+b.title+'</div><div class="benefit-proof">'+b.proof+(b.pct?' ('+b.pct+'% of reviewers)':'')+'</div><div class="benefit-footer"><button class="btn-copy-sm" onclick="copyText(this,\''+safeProof+'\')">Copy</button></div>';
    reviewBenefits.appendChild(card);
  });

  var extraBenefits=document.getElementById('extraBenefitsGrid'); extraBenefits.innerHTML='';
  allBenefits.slice(3,6).forEach(function(b,i){
    var safeProof=(b.title+': '+b.proof).replace(/'/g,"&#39;");
    var card=document.createElement('div'); card.className='benefit-card';
    card.innerHTML='<div class="benefit-num">Option 0'+(i+4)+'</div><div class="benefit-title">'+b.title+'</div><div class="benefit-proof">'+b.proof+(b.pct?' ('+b.pct+'% of reviewers)':'')+'</div><div class="benefit-footer"><button class="btn-copy-sm" onclick="copyText(this,\''+safeProof+'\')">Copy</button></div>';
    extraBenefits.appendChild(card);
  });

  // Themes
  var pills=document.getElementById('themePills'); pills.innerHTML='';
  (a.themes||[]).forEach(function(t){
    var p=document.createElement('div'); p.className='theme-pill';
    p.innerHTML=t.label+'<span class="pill-count">'+t.count+'</span>'; pills.appendChild(p);
  });

  // Verbatims
  var verbs=document.getElementById('verbatimCards'); verbs.innerHTML='';
  (a.verbatims||[]).forEach(function(v){
    var authorName=v.author&&v.author.toLowerCase()!=='verified buyer'?v.author:'';
    var c=document.createElement('div'); c.className='review-card';
    c.innerHTML='<div class="review-stars">★★★★★</div><div class="review-text">"'+v.quote+'"</div><div class="review-author-block">'+(authorName?'<div class="review-author-name">'+authorName+'</div>':'')+'<div class="review-author-label">Verified Buyer</div><span class="review-theme-tag">'+v.theme+'</span></div>';
    verbs.appendChild(c);
  });

  // Copy snippets
  var snips=document.getElementById('copySnippets'); snips.innerHTML='';
  (a.copy_snippets||[]).forEach(function(s){
    var d=document.createElement('div'); d.className='copy-snippet';
    var safeText=s.text.replace(/'/g,"&#39;");
    d.innerHTML='<div style="flex:1"><p>'+s.text+'</p><span class="copy-placement">— '+s.placement+'</span></div><button class="btn-copy" onclick="copyText(this,\''+safeText+'\')">Copy</button>';
    snips.appendChild(d);
  });

  // Curated
  var curated=document.getElementById('curatedSuggestions'); curated.innerHTML='';
  (a.curated_subtitles||[]).forEach(function(s){
    var d=document.createElement('div'); d.className='curated-suggestion';
    var safeText=s.text.replace(/'/g,"&#39;");
    d.innerHTML='<div class="curated-row"><div><div class="curated-suggestion-num">Suggestion '+s.num+'</div><div class="curated-suggestion-text">'+s.text+'</div><div class="curated-suggestion-context">'+s.context+'</div></div><button class="btn-copy-sm" onclick="copyText(this,\''+safeText+'\')">Copy</button></div>';
    curated.appendChild(d);
  });

  // FAQ collapsible
  var faqContainer=document.getElementById('faqCards'); faqContainer.innerHTML='';
  (a.objections||[]).forEach(function(o){
    var card=document.createElement('div'); card.className='faq-card';
    var bodyId='faq-body-'+o.rank;
    var toggleId='faq-toggle-'+o.rank;
    card.innerHTML='<div class="faq-card-header" onclick="toggleFaq('+o.rank+')"><span class="faq-rank-badge">#'+o.rank+'</span><div class="faq-question">'+o.question+'</div><span class="faq-toggle" id="'+toggleId+'">▾</span></div><div class="faq-card-body" id="'+bodyId+'"><div class="faq-source">From review language:</div><div class="faq-source-quote">"'+o.source_language+'"</div><div class="faq-answer-prompt">Jane should address: <span>'+o.answer_prompt+'</span></div></div>';
    faqContainer.appendChild(card);
  });

  showResults();
}

function toggleFaq(rank){
  var body=document.getElementById('faq-body-'+rank);
  var toggle=document.getElementById('faq-toggle-'+rank);
  if(body.classList.contains('open')){
    body.classList.remove('open'); toggle.classList.remove('open');
  } else {
    body.classList.add('open'); toggle.classList.add('open');
  }
}

function copyText(btn,text){
  var clean=text.replace(/<[^>]+>/g,'');
  navigator.clipboard.writeText(clean).then(function(){
    var orig=btn.textContent; btn.textContent='Copied!'; btn.classList.add('copied');
    setTimeout(function(){btn.textContent=orig;btn.classList.remove('copied');},2000);
  });
}

function exportTxt(){
  if(!lastAnalysis)return;
  var a=lastAnalysis.analysis, out='REVIEW INTELLIGENCE REPORT\n'+lastAnalysis.product+'\n';
  out+=lastAnalysis.analyzed.toLocaleString()+' of '+lastAnalysis.count.toLocaleString()+' reviews (most recent)\n';
  if(lastAnalysis.dateRange) out+='Date range: '+lastAnalysis.dateRange+'\n';
  out+='\n=== SECTION 1 — SENTIMENT ===\n';
  var s=a.sentiment||{positive:0,neutral:0,negative:0}, sum=s.positive+s.neutral+s.negative||1;
  out+='Positive: '+Math.round(s.positive/sum*100)+'% | Neutral: '+Math.round(s.neutral/sum*100)+'% | Negative: '+Math.round(s.negative/sum*100)+'%\n';
  out+='\n=== SECTION 2 — OUTCOME STATISTICS ===\n';
  (a.outcome_stats||[]).forEach(function(s){out+='• '+s.percentage+'% '+s.detail+' ('+s.count+' reviewers)\n';});
  if(a.transformation) out+='\nTransformation: '+a.transformation.stat+'\n';
  out+='\n=== SECTION 3 — TOP 3 PAIN POINTS ===\n';
  (a.pain_points||[]).forEach(function(p){out+='#'+p.rank+' '+p.label+'\nLanguage: "'+p.customer_language+'"\nHook: '+p.copy_hook+'\n\n';});
  out+='=== SECTION 4 — BENEFITS (top 3) ===\n';
  (a.benefits||[]).slice(0,3).forEach(function(b){out+='• '+b.title+': '+b.proof+'\n';});
  out+='\n=== SECTION 4 — BENEFIT OPTIONS (4-6) ===\n';
  (a.benefits||[]).slice(3,6).forEach(function(b){out+='• '+b.title+': '+b.proof+'\n';});
  out+='\n=== SECTION 5 — THEMES ===\n';
  (a.themes||[]).forEach(function(t){out+='• '+t.label+' ('+t.count+')\n';});
  out+='\n=== SECTION 6 — STANDOUT QUOTES ===\n';
  (a.verbatims||[]).forEach(function(v){out+='"'+v.quote+'" — '+v.author+' ('+v.theme+')\n\n';});
  out+='=== SECTION 7 — COPY-READY SNIPPETS ===\n';
  (a.copy_snippets||[]).forEach(function(s){out+='• '+s.text.replace(/<[^>]+>/g,'')+' ['+s.placement+']\n';});
  out+='\n=== SECTION 8 — CURATED SUBTITLE SUGGESTIONS ===\n';
  (a.curated_subtitles||[]).forEach(function(s){out+='Option '+s.num+': '+s.text+'\n('+s.context+')\n\n';});
  out+='=== SECTION 9 — FAQ OBJECTION MAP ===\n';
  (a.objections||[]).forEach(function(o){out+='#'+o.rank+' '+o.question+'\nSource: "'+o.source_language+'"\nJane should address: '+o.answer_prompt+'\n\n';});
  var blob=new Blob([out],{type:'text/plain'}), url=URL.createObjectURL(blob), link=document.createElement('a');
  link.href=url; link.download=lastAnalysis.product.replace(/\s+/g,'-')+'-review-intel.txt'; link.click();
}

function showLoading(c){document.getElementById('raLoading').classList.add('active');document.getElementById('loadingCount').textContent=c.toLocaleString();['step1','step2','step3','step4'].forEach(function(s){document.getElementById(s).className='loading-step';});}
function hideLoading(){document.getElementById('raLoading').classList.remove('active');}
function showResults(){document.getElementById('raResults').classList.add('active');}
function hideResults(){document.getElementById('raResults').classList.remove('active');}
function showError(m){var b=document.getElementById('errorBox');b.textContent=m;b.classList.add('active');}
function hideError(){document.getElementById('errorBox').classList.remove('active');}
function stepActive(id){document.getElementById(id).classList.add('active');}
function stepDone(id){document.getElementById(id).classList.remove('active');document.getElementById(id).classList.add('done');}
</script>

