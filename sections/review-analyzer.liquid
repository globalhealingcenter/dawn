<script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
<script>
var allReviews=[], lastAnalysis=null;
var THRESHOLD=72;

var DEFAULTS={
  about_words:30, mwp_desc_chars:73, mwp_title_words:3,
  review_title_words:10, ing_title_chars:40, ing_desc_chars:120,
  faq_count:10, copy_count:4, review_count:4
};

function getSettings(){
  return {
    about_words:parseInt(document.getElementById('set_about_words').value)||DEFAULTS.about_words,
    mwp_desc_chars:parseInt(document.getElementById('set_mwp_chars').value)||DEFAULTS.mwp_desc_chars,
    mwp_title_words:parseInt(document.getElementById('set_mwp_title_words').value)||DEFAULTS.mwp_title_words,
    review_title_words:parseInt(document.getElementById('set_review_title_words').value)||DEFAULTS.review_title_words,
    ing_title_chars:parseInt(document.getElementById('set_ing_title_chars').value)||DEFAULTS.ing_title_chars,
    ing_desc_chars:parseInt(document.getElementById('set_ing_desc_chars').value)||DEFAULTS.ing_desc_chars,
    faq_count:parseInt(document.getElementById('set_faq_count').value)||DEFAULTS.faq_count,
    copy_count:parseInt(document.getElementById('set_copy_count').value)||DEFAULTS.copy_count,
    review_count:parseInt(document.getElementById('set_review_count').value)||DEFAULTS.review_count
  };
}

function scrollTo(id){var el=document.getElementById(id);if(el)el.scrollIntoView({behavior:'smooth',block:'start'});}
function togglePanel(pId,aId){var p=document.getElementById(pId),a=document.getElementById(aId);p.classList.toggle('open');a.classList.toggle('open');}

document.getElementById('uploadZone').addEventListener('dragover',function(e){e.preventDefault();this.classList.add('drag-over');});
document.getElementById('uploadZone').addEventListener('dragleave',function(){this.classList.remove('drag-over');});
document.getElementById('uploadZone').addEventListener('drop',function(e){e.preventDefault();this.classList.remove('drag-over');if(e.dataTransfer.files[0])processFile(e.dataTransfer.files[0]);});
document.getElementById('csvFile').addEventListener('change',function(e){if(e.target.files[0])processFile(e.target.files[0]);});

function processFile(file){
  Papa.parse(file,{header:true,skipEmptyLines:true,complete:function(r){
    allReviews=r.data;
    var products=getProducts(allReviews),counts=getProductCounts(allReviews);
    var sel=document.getElementById('productSelect');
    sel.innerHTML='<option value="">— choose a product —</option>';
    products.forEach(function(p){var o=document.createElement('option');o.value=p;o.textContent=p+' ('+(counts[p]||0).toLocaleString()+' reviews)';sel.appendChild(o);});
    sel.disabled=false;document.getElementById('analyzeBtn').disabled=false;
    document.getElementById('uploadZone').style.display='none';
    document.getElementById('fileLoaded').style.display='flex';
    document.getElementById('fileName').textContent=file.name;
    document.getElementById('reviewCount').textContent=allReviews.length.toLocaleString();
    document.getElementById('productCount').textContent=products.length.toLocaleString();
  },error:function(){showError("Couldn't parse CSV.");}});
}

function getProductCol(reviews){var keys=['product_title','Product Title','product_name','Product Name','title','name'];for(var i=0;i<keys.length;i++){if(reviews[0]&&reviews[0][keys[i]]!==undefined)return keys[i];}return null;}
function getProducts(reviews){var col=getProductCol(reviews);if(!col)return['All Reviews'];var set=new Set(reviews.map(function(r){return r[col];}).filter(Boolean));return Array.from(set).sort();}
function getProductCounts(reviews){var col=getProductCol(reviews);if(!col)return{};var c={};reviews.forEach(function(r){var p=r[col];if(p)c[p]=(c[p]||0)+1;});return c;}
function getReviewsForProduct(p){if(p==='All Reviews')return allReviews;var col=getProductCol(allReviews);if(!col)return allReviews;return allReviews.filter(function(r){return r[col]===p;});}
function getDateCol(r){var keys=['review creation date','Review Creation Date','created_at','Created At','date','Date','review_date'];for(var i=0;i<keys.length;i++){if(r&&r[keys[i]]!==undefined)return keys[i];}return null;}
function sortByDateDesc(reviews){var dc=getDateCol(reviews[0]);if(!dc)return reviews;return reviews.slice().sort(function(a,b){return new Date(b[dc]||0)-new Date(a[dc]||0);});}
function getDateRange(reviews){var dc=getDateCol(reviews[0]);if(!dc)return null;var dates=reviews.map(function(r){return new Date(r[dc]);}).filter(function(d){return !isNaN(d);});if(!dates.length)return null;dates.sort(function(a,b){return a-b;});var fmt=function(d){return d.toLocaleDateString('en-US',{month:'short',year:'numeric'});};return fmt(dates[0])+' – '+fmt(dates[dates.length-1]);}
function getAuthorCol(r){var keys=['display name','Display Name','reviewer_name','Reviewer Name','author','Author'];for(var i=0;i<keys.length;i++){if(r&&r[keys[i]]!==undefined)return keys[i];}return null;}
function getReviewText(r){var keys=['review_content','Review Content','body','Body','content','Content','review','Review','comment','Comment'];for(var i=0;i<keys.length;i++){if(r[keys[i]]&&r[keys[i]].trim())return r[keys[i]].trim();}return Object.values(r).find(function(v){return v&&v.length>40;})||'';}

async function runAnalysis(){
  var product=document.getElementById('productSelect').value;
  if(!product){showError('Please select a product.');return;}
  var reviews=getReviewsForProduct(product);
  if(!reviews.length){showError('No reviews found.');return;}
  var wiki=document.getElementById('wikiText').value.trim();
  var settings=getSettings();
  hideError();showLoading(reviews.length);hideResults();

  var sorted=sortByDateDesc(reviews);
  var sample=sorted.slice(0,2000);
  var dateRange=getDateRange(sample);
  var authorCol=getAuthorCol(sample[0]);
  var reviewTexts=sample.map(function(r){
    var text=getReviewText(r);
    var author=authorCol&&r[authorCol]?r[authorCol].trim():'';
    return (author?'['+author+']: ':'')+text;
  }).filter(function(t){return t.length>20;}).join('\n---\n');

  var wikiSection=wiki?'\n\nPRODUCT WIKI:\n'+wiki.substring(0,4000)+'\n':'';
  stepActive('step1');

  var prompt='You are a conversion copywriter and VoC analyst for a premium supplement brand. Analyze these '+sample.length+' customer reviews for "'+product+'".'+wikiSection+'\n\nReturn ONLY valid JSON, no markdown, no preamble:\n{\n  "sentiment":{"positive":number,"neutral":number,"negative":number},\n  "outcome_stats":[{"percentage":number,"label":"2-word label","detail":"reported [outcome]","count":number}],\n  "transformation":{"stat":"X% noticed a difference within [timeframe]","timeframe":"string","percentage":number,"sub":"string"},\n  "about":{\n    "pain_opener":"1-2 sentences. Customer pain language. The before state. Max '+settings.about_words+' words.",\n    "main_benefit":"Single most powerful benefit from reviews. 1 punchy sentence.",\n    "description":"Transformation-led product description. Max '+settings.about_words+' words. Present tense, active voice."\n  },\n  "pain_points":[{"rank":1,"label":"short name","customer_language":"verbatim phrase from reviews","copy_hook":"ready-to-use PDP opener sentence in customer language"}],\n  "made_with_purpose":[{"title":"2-'+settings.mwp_title_words+' word benefit title","description":"Under '+settings.mwp_desc_chars+' chars. Specific and outcome-focused.","proof_line":"1 near-verbatim quote from reviews supporting this benefit","wiki_informed":false}],\n  "benefits":[{"rank":1,"title":"benefit title","proof":"customer proof line — outcome plus evidence","pct":number}],\n  "copy_snippets":[{"text":"copy-ready sentence with <strong>stat</strong> bolded","placement":"where to use it"}],\n  "reviews":[{"title":"Compelling title max '+settings.review_title_words+' words","rephrased_text":"Lightly rephrased for clarity. Preserve essence and factual claims. Max 80 words.","original_author":"verbatim from [author]: prefix or Verified Buyer","theme":"theme tag"}],\n  "ingredients":[{"title":"Ingredient name max '+settings.ing_title_chars+' chars","description":"Benefit-led, max '+settings.ing_desc_chars+' chars","wiki_informed":false}],\n  "themes":[{"label":"theme","count":number}],\n  "curated_subtitles":[{"num":1,"title":"Section title — frames customer journey","subhead":"1 sentence. Customer journey framing, not a product list.","context":"Best used when: ..."}],\n  "faqs":[{"rank":1,"question":"Purchase hesitation as a question","source_language":"verbatim phrase from reviews","suggested_answer":"Complete 2-3 sentence answer Jane can edit. Specific and reassuring.","answer_prompt":"Key point Jane must address"}]\n}\n\nRules:\n- outcome_stats: 4-6 real percentages\n- transformation: always include, mine time-to-result language\n- about.description: max '+settings.about_words+' words, count carefully\n- pain_points: exactly 3, real verbatim phrases, usable copy hooks\n- made_with_purpose: exactly 3. wiki_informed=true only if wiki text provided\n- benefits: exactly 6 (1-3 primary from reviews, 4-6 additional options)\n- copy_snippets: exactly '+settings.copy_count+'\n- reviews: exactly '+settings.review_count+', original_author verbatim\n- ingredients: exactly 3. wiki_informed=true only if wiki provided\n- themes: 6-8 by frequency\n- curated_subtitles: exactly 3\n- faqs: exactly '+settings.faq_count+', ranked by frequency, lead with purchase hesitations not safety questions, suggested_answer must be complete and usable\n\nReviews:\n'+reviewTexts;

  stepDone('step1');stepActive('step2');

  try{
    var response=await fetch('https://ecom-claude-proxy.globalhealing.workers.dev',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({model:'claude-sonnet-4-5',max_tokens:6000,messages:[{role:'user',content:prompt}]})
    });
    stepDone('step2');stepActive('step3');
    if(!response.ok){var et=await response.text();throw new Error(et||'API error');}
    var rawText=await response.text();
    stepDone('step3');stepActive('step4');
    var jm=rawText.replace(/```json|```/g,'').trim().match(/\{[\s\S]*\}/);
    if(!jm){hideLoading();showError('Could not parse response. Try again.');return;}
    var analysis;
    try{analysis=JSON.parse(jm[0]);}
    catch(e){hideLoading();showError('Parse error. Try again.');return;}
    lastAnalysis={product:product,analysis:analysis,count:reviews.length,analyzed:sample.length,dateRange:dateRange,settings:settings,hasWiki:!!wiki};
    stepDone('step4');
    setTimeout(function(){hideLoading();renderResults(product,reviews.length,sample.length,analysis,dateRange,settings,!!wiki);},400);
  }catch(err){hideLoading();showError('Analysis failed: '+err.message);}
}

function renderResults(product,total,analyzed,a,dateRange,settings,hasWiki){
  document.getElementById('resultsTitle').textContent=product;
  document.getElementById('resultsMeta').innerHTML=analyzed.toLocaleString()+' of '+total.toLocaleString()+' reviews analyzed<br>(most recent first)';
  if(dateRange){document.getElementById('dateRangeBadge').style.display='inline-flex';document.getElementById('dateRangeText').textContent='Reviews: '+dateRange;}

  // SENTIMENT
  var s=a.sentiment||{positive:0,neutral:0,negative:0},sum=s.positive+s.neutral+s.negative||1;
  var pp=Math.round(s.positive/sum*100),np=Math.round(s.neutral/sum*100),ngp=Math.round(s.negative/sum*100);
  document.getElementById('posNum').textContent=pp+'%';
  document.getElementById('neuNum').textContent=np+'%';
  document.getElementById('negNum').textContent=ngp+'%';
  setTimeout(function(){
    document.getElementById('sentimentPos').style.width=pp+'%';
    document.getElementById('sentimentNeu').style.width=np+'%';
    document.getElementById('sentimentNeg').style.width=ngp+'%';
  },100);

  // OUTCOMES
  var grid=document.getElementById('statsGrid');grid.innerHTML='';
  var maxPct=0;
  (a.outcome_stats||[]).forEach(function(s){
    if(s.percentage>maxPct)maxPct=s.percentage;
    var card=document.createElement('div');card.className='stat-card';
    card.innerHTML='<div class="stat-card-accent"></div><div class="stat-pct">'+s.percentage+'%</div><div class="stat-label">'+esc(s.detail)+'</div><div class="stat-detail">'+s.count+' of '+analyzed.toLocaleString()+' reviewers</div>';
    grid.appendChild(card);
  });
  document.getElementById('statsFootnote').textContent='Based on '+analyzed.toLocaleString()+' Yotpo verified purchase reviews (most recent). Results reflect customer-reported outcomes — individual experiences may vary.';
  var strong=(a.outcome_stats||[]).filter(function(s){return s.percentage>=THRESHOLD;});
  var showWarn=strong.length<=1;
  document.getElementById('statsWarning').style.display=showWarn?'block':'none';
  if(showWarn)document.getElementById('statsWarningText').textContent=maxPct<THRESHOLD?'All outcome stats are below 72%. Jane: avoid leading with raw percentages. Use the transformation timeframe below instead.':'Only one stat clears 72%. Jane: the transformation timeframe below may be stronger as the lead claim.';
  if(a.transformation){
    document.getElementById('transformationCard').style.display='block';
    document.getElementById('transformationStat').textContent=a.transformation.stat;
    document.getElementById('transformationSub').textContent=a.transformation.sub+(showWarn?' — Jane: consider using this as the lead stat instead of outcome percentages.':' — Jane: use this as a supporting stat alongside the outcome percentages.');
  }

  // ABOUT
  if(a.about){
    setText('aboutPainOpener',a.about.pain_opener);
    setText('aboutMainBenefit',a.about.main_benefit);
    setText('aboutDescription',a.about.description);
    document.getElementById('aboutWordCount').textContent=(a.about.description||'').split(/\s+/).filter(Boolean).length;
  }

  // PAIN POINTS
  var pc=document.getElementById('painCards');pc.innerHTML='';
  (a.pain_points||[]).forEach(function(p){
    var card=document.createElement('div');card.className='pain-card';
    var sh=esc(p.copy_hook);
    card.innerHTML='<div class="pain-rank">Pain Point #'+p.rank+'</div>'
      +'<div class="pain-label">'+esc(p.label)+'</div>'
      +'<div class="pain-language">"'+esc(p.customer_language)+'"</div>'
      +'<div class="pain-hook-row"><div class="pain-copy-hook">Copy hook → <span>'+sh+'</span></div>'
      +'<button class="btn-copy-sm" onclick="copyText(this,\''+sh+'\')">Copy</button></div>';
    pc.appendChild(card);
  });

  // MADE WITH PURPOSE
  document.getElementById('mwpCharLimit').textContent=settings.mwp_desc_chars;
  var mg=document.getElementById('mwpGrid');mg.innerHTML='';
  (a.made_with_purpose||[]).forEach(function(m,i){
    var cc=(m.description||'').length,over=cc>settings.mwp_desc_chars;
    var card=document.createElement('div');card.className='mwp-card';
    var st=esc(m.title),sd=esc(m.description),sp=esc(m.proof_line||'');
    card.innerHTML='<div class="mwp-num">Benefit 0'+(i+1)+'</div>'
      +'<div class="mwp-title">'+st+'</div>'
      +'<div class="mwp-desc">'+sd+'</div>'
      +(sp?'<div class="mwp-proof">'+sp+'</div>':'')
      +'<div class="mwp-footer"><div>'
        +'<div class="mwp-charcount">'+(over?'<span style="color:var(--rust)">':'')+cc+'/'+settings.mwp_desc_chars+' chars'+(over?'</span>':'')+'</div>'
        +(m.wiki_informed?'<div class="badge-wiki">✓ Wiki-informed</div>':'<div class="badge-verify">Verify wiki</div>')
      +'</div>'
      +'<button class="btn-copy-sm" onclick="copyText(this,\''+st+': '+sd+'\')">Copy</button></div>';
    mg.appendChild(card);
  });

  // BENEFITS
  var rb=document.getElementById('reviewBenefitsGrid');rb.innerHTML='';
  (a.benefits||[]).slice(0,3).forEach(function(b){
    var card=document.createElement('div');card.className='benefit-card';
    var sp=esc(b.title+': '+b.proof);
    card.innerHTML='<div class="benefit-num">Benefit 0'+b.rank+'</div><div class="benefit-title">'+esc(b.title)+'</div><div class="benefit-proof">'+esc(b.proof)+(b.pct?' ('+b.pct+'% of reviewers)':'')+'</div><div class="benefit-footer"><button class="btn-copy-sm" onclick="copyText(this,\''+sp+'\')">Copy</button></div>';
    rb.appendChild(card);
  });
  var eb=document.getElementById('extraBenefitsGrid');eb.innerHTML='';
  (a.benefits||[]).slice(3,6).forEach(function(b,i){
    var card=document.createElement('div');card.className='benefit-card';
    var sp=esc(b.title+': '+b.proof);
    card.innerHTML='<div class="benefit-num">Option 0'+(i+4)+'</div><div class="benefit-title">'+esc(b.title)+'</div><div class="benefit-proof">'+esc(b.proof)+(b.pct?' ('+b.pct+'% of reviewers)':'')+'</div><div class="benefit-footer"><button class="btn-copy-sm" onclick="copyText(this,\''+sp+'\')">Copy</button></div>';
    eb.appendChild(card);
  });

  // COPY SNIPPETS
  var cs=document.getElementById('copySnippets');cs.innerHTML='';
  (a.copy_snippets||[]).forEach(function(s){
    var d=document.createElement('div');d.className='copy-snippet';
    var st=esc(s.text.replace(/<[^>]+>/g,''));
    d.innerHTML='<div style="flex:1"><p>'+s.text+'</p><span class="copy-placement">— '+esc(s.placement)+'</span></div>'
      +'<button class="btn-copy" style="border-color:#4a3e2e;color:#8a7a68;" onclick="copyText(this,\''+st+'\')">Copy</button>';
    cs.appendChild(d);
  });

  // REVIEWS
  var vc=document.getElementById('verbatimCards');vc.innerHTML='';
  (a.reviews||[]).forEach(function(v){
    var an=v.original_author&&v.original_author.toLowerCase()!=='verified buyer'?v.original_author:'';
    var c=document.createElement('div');c.className='review-card';
    var st=esc(v.title),sr=esc(v.rephrased_text),sa=esc(an);
    var cv=esc((v.title?v.title+': ':'')+'"'+v.rephrased_text+'"'+(an?' — '+an:''));
    c.innerHTML='<div class="review-card-title">'+st+'</div>'
      +'<div class="review-stars">★★★★★</div>'
      +'<div class="review-text">&#8220;'+sr+'&#8221;</div>'
      +'<div class="review-author-block"><div>'+(an?'<div class="review-author-name">'+sa+'</div>':'')
      +'<div class="review-author-label">Verified Buyer</div>'
      +'<span class="review-theme-tag">'+esc(v.theme)+'</span></div>'
      +'<button class="btn-copy-sm" style="border-color:#2a4a2a;color:#7a9e7a;" onclick="copyText(this,\''+cv+'\')">Copy</button></div>';
    vc.appendChild(c);
  });

  // INGREDIENTS
  document.getElementById('ingTitleLimit').textContent=settings.ing_title_chars;
  document.getElementById('ingDescLimit').textContent=settings.ing_desc_chars;
  var ig=document.getElementById('ingGrid');ig.innerHTML='';
  var ings=a.ingredients||[];
  if(!ings.length){
    for(var i=0;i<3;i++){var ic=document.createElement('div');ic.className='ing-card placeholder';ic.innerHTML='<div class="ing-num">Ingredient 0'+(i+1)+'</div><div class="ing-title">[Ingredient name]</div><div class="ing-desc">Paste the product wiki above and re-run.</div><div class="ing-footer"><div class="badge-verify">Needs wiki</div></div>';ig.appendChild(ic);}
  }else{
    ings.forEach(function(ing,i){
      var tl=(ing.title||'').length,dl=(ing.description||'').length;
      var to=tl>settings.ing_title_chars,dov=dl>settings.ing_desc_chars;
      var card=document.createElement('div');card.className='ing-card';
      var st=esc(ing.title),sd=esc(ing.description);
      card.innerHTML='<div class="ing-num">Ingredient 0'+(i+1)+'</div>'
        +'<div class="ing-title">'+st+'</div>'
        +'<div class="ing-desc">'+sd+'</div>'
        +'<div class="ing-footer"><div>'
          +'<div class="ing-charcount">'+(to?'<span style="color:var(--rust)">':'')+tl+'/'+settings.ing_title_chars+(to?'</span>':'')+' title · '+(dov?'<span style="color:var(--rust)">':'')+dl+'/'+settings.ing_desc_chars+(dov?'</span>':'')+' desc</div>'
          +(ing.wiki_informed?'<div class="badge-wiki">✓ Wiki-informed</div>':'<div class="badge-verify">Verify wiki</div>')
        +'</div>'
        +'<button class="btn-copy-sm" onclick="copyText(this,\''+st+': '+sd+'\')">Copy</button></div>';
      ig.appendChild(card);
    });
  }

  // THEMES
  var tp=document.getElementById('themePills');tp.innerHTML='';
  (a.themes||[]).forEach(function(t){var p=document.createElement('div');p.className='theme-pill';p.innerHTML=esc(t.label)+'<span class="pill-count">'+t.count+'</span>';tp.appendChild(p);});

  // CURATED
  var cu=document.getElementById('curatedSuggestions');cu.innerHTML='';
  (a.curated_subtitles||[]).forEach(function(s){
    var d=document.createElement('div');d.className='curated-suggestion';
    var st=esc(s.title),ss=esc(s.subhead),sc=esc(s.context||'');
    var cv=esc(s.title+' — '+s.subhead);
    d.innerHTML='<div class="curated-row"><div>'
      +'<div class="curated-num">Suggestion '+s.num+'</div>'
      +'<div class="curated-title">'+st+'</div>'
      +'<div class="curated-subhead">'+ss+'</div>'
      +(sc?'<div class="curated-context">'+sc+'</div>':'')
      +'</div><button class="btn-copy-sm" onclick="copyText(this,\''+cv+'\')">Copy</button></div>';
    cu.appendChild(d);
  });

  // FAQS
  var fc=document.getElementById('faqCards');fc.innerHTML='';
  (a.faqs||[]).forEach(function(o){
    var card=document.createElement('div');card.className='faq-card';
    var bid='faq-body-'+o.rank,tid='faq-toggle-'+o.rank;
    var sa=esc(o.suggested_answer||'');
    var cv=esc((o.question||'')+'\n\n'+(o.suggested_answer||''));
    card.innerHTML='<div class="faq-card-header" onclick="toggleFaq('+o.rank+')">'
        +'<span class="faq-rank-badge">#'+o.rank+'</span>'
        +'<div class="faq-question">'+esc(o.question)+'</div>'
        +'<span class="faq-toggle" id="'+tid+'">▾</span>'
      +'</div>'
      +'<div class="faq-card-body" id="'+bid+'">'
        +'<div class="faq-source">From review language:</div>'
        +'<div class="faq-source-quote">&#8220;'+esc(o.source_language)+'&#8221;</div>'
        +(sa?'<div class="faq-suggested-answer"><div class="faq-suggested-label">Suggested answer — edit before publishing</div>'
          +'<div class="faq-answer-row"><div class="faq-suggested-text">'+sa+'</div>'
          +'<button class="btn-copy-sm" onclick="copyText(this,\''+cv+'\')">Copy</button></div></div>':'')
        +'<div class="faq-answer-prompt">Jane must address: <span>'+esc(o.answer_prompt)+'</span></div>'
      +'</div>';
    fc.appendChild(card);
  });

  showResults();
}

function toggleFaq(rank){var b=document.getElementById('faq-body-'+rank),t=document.getElementById('faq-toggle-'+rank);b.classList.toggle('open');t.classList.toggle('open');}

function esc(str){if(!str)return'';return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');}
function setText(id,text){var el=document.getElementById(id);if(el)el.textContent=text||'';}

function copyText(btn,text){
  var clean=String(text).replace(/<[^>]+>/g,'').replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&quot;/g,'"').replace(/&#39;/g,"'");
  navigator.clipboard.writeText(clean).then(function(){var o=btn.textContent;btn.textContent='Copied!';btn.classList.add('copied');setTimeout(function(){btn.textContent=o;btn.classList.remove('copied');},2000);});
}
function copyById(btn,id){var el=document.getElementById(id);if(!el)return;copyText(btn,el.textContent||el.innerText||'');}
function copyAboutFull(btn){
  var o=document.getElementById('aboutPainOpener').textContent||'';
  var b=document.getElementById('aboutMainBenefit').textContent||'';
  var d=document.getElementById('aboutDescription').textContent||'';
  navigator.clipboard.writeText((o+'\n\n'+b+'\n\n'+d).trim()).then(function(){var orig=btn.textContent;btn.textContent='Copied!';setTimeout(function(){btn.textContent=orig;},2000);});
}

function exportTxt(){
  if(!lastAnalysis)return;
  var a=lastAnalysis.analysis,out='PDP INTELLIGENCE REPORT\n'+lastAnalysis.product+'\n'+lastAnalysis.analyzed.toLocaleString()+' of '+lastAnalysis.count.toLocaleString()+' reviews\n';
  if(lastAnalysis.dateRange)out+='Date range: '+lastAnalysis.dateRange+'\n';
  var s=a.sentiment||{positive:0,neutral:0,negative:0},sum=s.positive+s.neutral+s.negative||1;
  out+='\n=== SENTIMENT ===\nPositive: '+Math.round(s.positive/sum*100)+'% | Neutral: '+Math.round(s.neutral/sum*100)+'% | Negative: '+Math.round(s.negative/sum*100)+'%\n';
  out+='\n=== OUTCOME STATISTICS ===\n';
  (a.outcome_stats||[]).forEach(function(s){out+='• '+s.percentage+'% '+s.detail+' ('+s.count+' reviewers)\n';});
  if(a.transformation)out+='\nTransformation: '+a.transformation.stat+'\n';
  out+='\n=== PDP S1 — ABOUT ===\n';
  if(a.about)out+='Pain opener: '+a.about.pain_opener+'\nMain benefit: '+a.about.main_benefit+'\nDescription: '+a.about.description+'\n';
  out+='\n=== PAIN POINTS ===\n';
  (a.pain_points||[]).forEach(function(p){out+='#'+p.rank+' '+p.label+'\n"'+p.customer_language+'"\nHook: '+p.copy_hook+'\n\n';});
  out+='\n=== PDP S2 — MADE WITH PURPOSE ===\n';
  (a.made_with_purpose||[]).forEach(function(m,i){out+=(i+1)+'. '+m.title+': '+m.description+'\nProof: '+m.proof_line+'\n\n';});
  out+='=== PDP S4 — BENEFITS ===\n';
  (a.benefits||[]).forEach(function(b){out+='• '+b.title+': '+b.proof+'\n';});
  out+='\n=== PDP S3 — COPY-READY STATISTICS ===\n';
  (a.copy_snippets||[]).forEach(function(s){out+='• '+s.text.replace(/<[^>]+>/g,'')+' ['+s.placement+']\n';});
  out+='\n=== PDP S4 — REVIEWS ===\n';
  (a.reviews||[]).forEach(function(v){out+=v.title+'\n"'+v.rephrased_text+'"\n— '+v.original_author+'\n\n';});
  out+='\n=== PDP S5 — INGREDIENTS ===\n';
  (a.ingredients||[]).forEach(function(ing,i){out+=(i+1)+'. '+ing.title+': '+ing.description+'\n';});
  out+='\n=== THEMES ===\n';
  (a.themes||[]).forEach(function(t){out+='• '+t.label+' ('+t.count+')\n';});
  out+='\n=== PDP S6 — CURATED COLLECTION ===\n';
  (a.curated_subtitles||[]).forEach(function(s){out+='Option '+s.num+': '+s.title+' — '+s.subhead+'\n('+s.context+')\n\n';});
  out+='\n=== PDP S7 — FAQS ===\n';
  (a.faqs||[]).forEach(function(o){out+='#'+o.rank+' '+o.question+'\nSource: "'+o.source_language+'"\nSuggested answer: '+o.suggested_answer+'\nMust address: '+o.answer_prompt+'\n\n';});
  var blob=new Blob([out],{type:'text/plain'}),url=URL.createObjectURL(blob),link=document.createElement('a');
  link.href=url;link.download=lastAnalysis.product.replace(/\s+/g,'-')+'-pdp-intel.txt';link.click();
}

function showLoading(c){document.getElementById('raLoading').classList.add('active');document.getElementById('loadingCount').textContent=c.toLocaleString();['step1','step2','step3','step4'].forEach(function(s){document.getElementById(s).className='loading-step';});}
function hideLoading(){document.getElementById('raLoading').classList.remove('active');}
function showResults(){document.getElementById('raResults').classList.add('active');}
function hideResults(){document.getElementById('raResults').classList.remove('active');}
function showError(m){var b=document.getElementById('errorBox');b.textContent=m;b.classList.add('active');}
function hideError(){document.getElementById('errorBox').classList.remove('active');}
function stepActive(id){document.getElementById(id).classList.add('active');}
function stepDone(id){document.getElementById(id).classList.remove('active');document.getElementById(id).classList.add('done');}
</script>

{% schema %}
{
  "name": "Review Analyzer",
  "settings": []
}
{% endschema %}
