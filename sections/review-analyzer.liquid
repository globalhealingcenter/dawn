<script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
<script>
var allReviews=[],lastAnalysis=null;
var THRESHOLD=72;
var DEFAULTS={about_words:60,mwp_chars:73,review_chars:200,ing_chars:120,faq_count:15};

function getSettings(){
  return {
    about_words:parseInt(document.getElementById('set_about_words').value)||DEFAULTS.about_words,
    mwp_chars:parseInt(document.getElementById('set_mwp_chars').value)||DEFAULTS.mwp_chars,
    review_chars:parseInt(document.getElementById('set_review_chars').value)||DEFAULTS.review_chars,
    ing_chars:parseInt(document.getElementById('set_ing_chars').value)||DEFAULTS.ing_chars,
    faq_count:parseInt(document.getElementById('set_faq_count').value)||DEFAULTS.faq_count
  };
}

// Nav scroll
document.addEventListener('DOMContentLoaded',function(){
  document.querySelectorAll('.nav-btn[data-target]').forEach(function(btn){
    btn.addEventListener('click',function(){
      var target=document.getElementById(btn.getAttribute('data-target'));
      if(target) target.scrollIntoView({behavior:'smooth',block:'start'});
    });
  });
});

function togglePanel(pId,aId){var p=document.getElementById(pId),a=document.getElementById(aId);p.classList.toggle('open');a.classList.toggle('open');}

document.getElementById('uploadZone').addEventListener('dragover',function(e){e.preventDefault();this.classList.add('drag-over');});
document.getElementById('uploadZone').addEventListener('dragleave',function(){this.classList.remove('drag-over');});
document.getElementById('uploadZone').addEventListener('drop',function(e){e.preventDefault();this.classList.remove('drag-over');if(e.dataTransfer.files[0])processFile(e.dataTransfer.files[0]);});
document.getElementById('csvFile').addEventListener('change',function(e){if(e.target.files[0])processFile(e.target.files[0]);});

function processFile(file){
  Papa.parse(file,{header:true,skipEmptyLines:true,complete:function(r){
    allReviews=r.data;
    var products=getProducts(allReviews),counts=getProductCounts(allReviews);
    var sel=document.getElementById('productSelect');
    sel.innerHTML='<option value="">— choose a product —</option>';
    products.forEach(function(p){var o=document.createElement('option');o.value=p;o.textContent=p+' ('+(counts[p]||0).toLocaleString()+' reviews)';sel.appendChild(o);});
    sel.disabled=false;document.getElementById('analyzeBtn').disabled=false;
    document.getElementById('uploadZone').style.display='none';
    document.getElementById('fileLoaded').style.display='flex';
    document.getElementById('fileName').textContent=file.name;
    document.getElementById('reviewCount').textContent=allReviews.length.toLocaleString();
    document.getElementById('productCount').textContent=products.length.toLocaleString();
  },error:function(){showError("Couldn't parse CSV.");}});
}

function getProductCol(reviews){var keys=['product_title','Product Title','product_name','Product Name','title','name'];for(var i=0;i<keys.length;i++){if(reviews[0]&&reviews[0][keys[i]]!==undefined)return keys[i];}return null;}
function getProducts(reviews){var col=getProductCol(reviews);if(!col)return['All Reviews'];var set=new Set(reviews.map(function(r){return r[col];}).filter(Boolean));return Array.from(set).sort();}
function getProductCounts(reviews){var col=getProductCol(reviews);if(!col)return{};var c={};reviews.forEach(function(r){var p=r[col];if(p)c[p]=(c[p]||0)+1;});return c;}
function getReviewsForProduct(p){if(p==='All Reviews')return allReviews;var col=getProductCol(allReviews);if(!col)return allReviews;return allReviews.filter(function(r){return r[col]===p;});}
function getDateCol(r){var keys=['review creation date','Review Creation Date','created_at','Created At','date','Date','review_date'];for(var i=0;i<keys.length;i++){if(r&&r[keys[i]]!==undefined)return keys[i];}return null;}
function sortByDateDesc(reviews){var dc=getDateCol(reviews[0]);if(!dc)return reviews;return reviews.slice().sort(function(a,b){return new Date(b[dc]||0)-new Date(a[dc]||0);});}
function getDateRange(reviews){var dc=getDateCol(reviews[0]);if(!dc)return null;var dates=reviews.map(function(r){return new Date(r[dc]);}).filter(function(d){return !isNaN(d);});if(!dates.length)return null;dates.sort(function(a,b){return a-b;});var fmt=function(d){return d.toLocaleDateString('en-US',{month:'short',year:'numeric'});};return fmt(dates[0])+' – '+fmt(dates[dates.length-1]);}
function getAuthorCol(r){var keys=['Reviewer Display Name','reviewer display name','display name','Display Name','reviewer_name','Reviewer Name','author','Author'];
function getReviewText(r){var keys=['review_content','Review Content','body','Body','content','Content','review','Review','comment','Comment'];for(var i=0;i<keys.length;i++){if(r[keys[i]]&&r[keys[i]].trim())return r[keys[i]].trim();}return Object.values(r).find(function(v){return v&&v.length>40;})||'';}

async function runAnalysis(){
  var product=document.getElementById('productSelect').value;
  if(!product){showError('Please select a product.');return;}
  var reviews=getReviewsForProduct(product);
  if(!reviews.length){showError('No reviews found.');return;}
  var wiki=document.getElementById('wikiText').value.trim();
  var settings=getSettings();
  hideError();showLoading(reviews.length);hideResults();

  var sorted=sortByDateDesc(reviews);
  var sample=sorted.slice(0,2000);
  var dateRange=getDateRange(sample);
  var authorCol=getAuthorCol(sample[0]);

  var reviewTexts=sample.map(function(r){
    var text=getReviewText(r);
    var author=authorCol&&r[authorCol]?r[authorCol].trim():'';
    var isAnon=!author||author.toLowerCase()==='verified buyer'||author.toLowerCase()==='anonymous'||author.length<2;
    return (isAnon?'[ANON]: ':'['+author+']: ')+text;
  }).filter(function(t){return t.length>20;}).join('\n---\n');

  var wikiSection=wiki?'\n\nPRODUCT WIKI:\n'+wiki.substring(0,4000)+'\n':'';
  stepActive('step1');

  var prompt='You are a conversion copywriter and VoC analyst for Global Healing, a premium supplement brand. Analyze these '+sample.length+' customer reviews for "'+product+'".'+wikiSection+'\n\nReturn ONLY valid JSON. No markdown, no preamble, no explanation.\n\n{\n  "sentiment":{"positive":number,"neutral":number,"negative":number},\n  "pain_points":[{"rank":1,"label":"short name","customer_language":"verbatim phrase","copy_hook":"ready-to-use PDP opener"}],\n  "about_options":[{"num":1,"text":"Complete About description. Opens with pain, leads into main benefit. Max '+settings.about_words+' words. Present tense, active voice."}],\n  "made_with_purpose":[{"num":1,"title":"2-3 word benefit title","description":"Outcome-focused. MUST be under '+settings.mwp_chars+' chars.","wiki_informed":false}],\n  "benefits":[{"rank":1,"title":"benefit title","proof":"customer proof line with outcome and evidence","pct":number}],\n  "outcome_stats":[{"percentage":number,"label":"outcome label","detail":"reported [full outcome]","count":number}],\n  "transformation":{"stat":"X% noticed a difference within [timeframe]","timeframe":"string","percentage":number,"sub":"Based on review language"},\n  "alt_stats":[{"text":"3 in 4 customers [outcome] within [timeframe]","sub":"Based on X% of reviewers who mentioned [outcome]"}],\n  "reviews":[{"num":1,"title":"Compelling title max 8 words","rephrased_text":"Lightly rephrased. Under '+settings.review_chars+' chars. Preserve essence.","original_author":"real name or Verified Buyer","theme":"theme tag","is_named":true_or_false}],\n  "ingredients":[{"num":1,"headline":"Short punchy 1-2 sentence editorial headline. Like: One nutrient. Three bioavailable forms.","subline":"1-2 sentence supporting line. Under '+settings.ing_chars+' chars.","wiki_informed":false}],\n  "curated_collection":[{"num":1,"title":"Section heading","subhead":"1 sentence. Customer journey framing.","context":"Best used when: ..."}],\n  "faqs":[{"rank":1,"question":"Purchase hesitation as a question","source_language":"verbatim phrase from reviews","suggested_answer":"Complete 2-3 sentence answer. Specific and reassuring. Ready to use.","answer_note":"Key point the answer must address"}],\n  "themes":[{"label":"theme","count":number}]\n}\n\nRules:\n- pain_points: exactly 5\n- about_options: exactly 5 distinct options, each a different pain angle\n- made_with_purpose: exactly 5. description MUST be under '+settings.mwp_chars+' chars — count carefully. wiki_informed=true only if wiki provided.\n- benefits: exactly 6 (1-3 primary from reviews, 4-6 options)\n- outcome_stats: 4-6 real percentages\n- transformation: always include\n- alt_stats: 2-3 items\n- reviews: exactly 10. Prioritize reviews with real named authors (is_named=true). For anonymous reviews use original_author="Verified Buyer" and is_named=false. Include a mix but favor named. Rephrase under '+settings.review_chars+' chars.\n- ingredients: exactly 5, editorial and evocative, not ingredient lists\n- curated_collection: exactly 3\n- faqs: exactly '+settings.faq_count+' ranked by purchase-blocking frequency. Lead with hesitations, not safety questions.\n- themes: 6-8\n\nReviews:\n'+reviewTexts;

  stepDone('step1');stepActive('step2');

  try{
    var response=await fetch('https://ecom-claude-proxy.globalhealing.workers.dev',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({model:'claude-sonnet-4-6',max_tokens:8000,messages:[{role:'user',content:prompt}]})
    });
    stepDone('step2');stepActive('step3');
    if(!response.ok){var et=await response.text();throw new Error(et||'API error');}
    var rawText=await response.text();
    stepDone('step3');stepActive('step4');
    var envelope;
    try{envelope=JSON.parse(rawText);}catch(e){envelope=null;}
    var inner=envelope&&envelope.content&&envelope.content[0]&&envelope.content[0].text||rawText;
    var jm=inner.replace(/```json|```/g,'').trim().match(/\{[\s\S]*\}/);
    if(!jm){hideLoading();showError('Could not parse response. Try again.');return;}
    var analysis;
    try{analysis=JSON.parse(jm[0]);}
    catch(e){hideLoading();showError('Parse error. Try again.');return;}
    lastAnalysis={product:product,analysis:analysis,count:reviews.length,analyzed:sample.length,dateRange:dateRange,settings:settings,hasWiki:!!wiki};
    stepDone('step4');
    setTimeout(function(){hideLoading();renderResults(product,reviews.length,sample.length,analysis,dateRange,settings,!!wiki);},400);
  }catch(err){hideLoading();showError('Analysis failed: '+err.message);}
}

function copyText(text){
  var clean=String(text).replace(/<[^>]+>/g,'').replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&quot;/g,'"').replace(/&#39;/g,"'");
  navigator.clipboard.writeText(clean);
}

function makeCopyBtn(text,darkMode){
  var btn=document.createElement('button');
  btn.className=darkMode?'btn-copy-dk':'btn-copy';
  btn.textContent='Copy';
  btn.addEventListener('click',function(){
    copyText(text);
    btn.textContent='Copied!';btn.classList.add('copied');
    setTimeout(function(){btn.textContent='Copy';btn.classList.remove('copied');},2000);
  });
  return btn;
}

function esc(str){if(!str)return'';return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}

function renderResults(product,total,analyzed,a,dateRange,settings,hasWiki){
  document.getElementById('resultsTitle').textContent=product;
  document.getElementById('resultsMeta').innerHTML=analyzed.toLocaleString()+' of '+total.toLocaleString()+' reviews analyzed<br>(most recent first)';
  if(dateRange){document.getElementById('dateRangeBadge').style.display='inline-flex';document.getElementById('dateRangeText').textContent='Reviews: '+dateRange;}

  // S1 ABOUT
  var aboutList=document.getElementById('aboutList');aboutList.innerHTML='';
  (a.about_options||[]).forEach(function(o){
    var wc=(o.text||'').split(/\s+/).filter(Boolean).length;
    var over=wc>settings.about_words;
    var card=document.createElement('div');card.className='choice-card';
    var body=document.createElement('div');body.className='choice-body';
    var num=document.createElement('div');num.className='choice-num';num.textContent='Option '+o.num;
    var txt=document.createElement('div');txt.className='choice-text';txt.textContent=o.text||'';
    var meta=document.createElement('div');meta.className='choice-meta'+(over?' over':'');meta.textContent=wc+' / '+settings.about_words+' words'+(over?' — over limit':'');
    body.appendChild(num);body.appendChild(txt);body.appendChild(meta);
    card.appendChild(body);
    card.appendChild(makeCopyBtn(o.text||''));
    aboutList.appendChild(card);
  });

  // S2 MADE WITH PURPOSE
  var mwpList=document.getElementById('mwpList');mwpList.innerHTML='';
  (a.made_with_purpose||[]).forEach(function(m){
    var cc=(m.description||'').length;
    var over=cc>settings.mwp_chars;
    var card=document.createElement('div');card.className='choice-card';
    var body=document.createElement('div');body.className='choice-body';
    var num=document.createElement('div');num.className='choice-num';num.textContent='Option '+m.num;
    var title=document.createElement('div');title.className='choice-title';title.textContent=m.title||'';
    var desc=document.createElement('div');desc.className='choice-desc';desc.textContent=m.description||'';
    var meta=document.createElement('div');meta.className='choice-meta'+(over?' over':'');meta.textContent=cc+' / '+settings.mwp_chars+' chars'+(over?' — over limit':'');
    body.appendChild(num);body.appendChild(title);body.appendChild(desc);body.appendChild(meta);
    if(m.wiki_informed){var badge=document.createElement('div');badge.className='badge-wiki';badge.textContent='✓ Wiki-informed';body.appendChild(badge);}
    card.appendChild(body);
    card.appendChild(makeCopyBtn((m.title||'')+': '+(m.description||'')));
    mwpList.appendChild(card);
  });

  // KEY BENEFITS
  var rb=document.getElementById('reviewBenefitsGrid');rb.innerHTML='';
  (a.benefits||[]).slice(0,3).forEach(function(b){
    var card=document.createElement('div');card.className='benefit-card';
    var num=document.createElement('div');num.className='benefit-num';num.textContent='Benefit 0'+b.rank;
    var title=document.createElement('div');title.className='benefit-title';title.textContent=b.title||'';
    var proof=document.createElement('div');proof.className='benefit-proof';proof.textContent=(b.proof||'')+(b.pct?' ('+b.pct+'% of reviewers)':'');
    var footer=document.createElement('div');footer.className='benefit-footer';
    footer.appendChild(makeCopyBtn((b.title||'')+': '+(b.proof||'')));
    card.appendChild(num);card.appendChild(title);card.appendChild(proof);card.appendChild(footer);
    rb.appendChild(card);
  });
  var eb=document.getElementById('extraBenefitsGrid');eb.innerHTML='';
  (a.benefits||[]).slice(3,6).forEach(function(b,i){
    var card=document.createElement('div');card.className='benefit-card';
    var num=document.createElement('div');num.className='benefit-num';num.textContent='Option 0'+(i+4);
    var title=document.createElement('div');title.className='benefit-title';title.textContent=b.title||'';
    var proof=document.createElement('div');proof.className='benefit-proof';proof.textContent=(b.proof||'')+(b.pct?' ('+b.pct+'% of reviewers)':'');
    var footer=document.createElement('div');footer.className='benefit-footer';
    footer.appendChild(makeCopyBtn((b.title||'')+': '+(b.proof||'')));
    card.appendChild(num);card.appendChild(title);card.appendChild(proof);card.appendChild(footer);
    eb.appendChild(card);
  });

  // S3 REAL CUSTOMERS
  var grid=document.getElementById('statsGrid');grid.innerHTML='';
  var maxPct=0;
  (a.outcome_stats||[]).forEach(function(s){if(s.percentage>maxPct)maxPct=s.percentage;});
  var strongStats=(a.outcome_stats||[]).filter(function(s){return s.percentage>=THRESHOLD;});
  var numStrong=strongStats.length;
  if(numStrong===0){
    document.getElementById('statsWarnRed').style.display='block';
    document.getElementById('statsWarnRedText').textContent='No outcome stats reach 72%. Jane: exclude the percentage grid from this PDP. Use the transformation timeline and "3 in 4" framing below instead.';
    document.getElementById('statsWarnYellow').style.display='none';
  } else if(numStrong<3){
    document.getElementById('statsWarnYellow').style.display='block';
    document.getElementById('statsWarnYellowText').textContent='Only '+numStrong+' stat'+(numStrong===1?' clears':'s clear')+' 72%. Jane: consider leading with the transformation timeline instead of raw percentages on this PDP.';
    document.getElementById('statsWarnRed').style.display='none';
  } else {
    document.getElementById('statsWarnYellow').style.display='none';
    document.getElementById('statsWarnRed').style.display='none';
  }
  (a.outcome_stats||[]).forEach(function(s){
    var card=document.createElement('div');card.className='stat-card';
    var pct=document.createElement('div');pct.className='stat-pct';pct.textContent=s.percentage+'%';
    var lbl=document.createElement('div');lbl.className='stat-label';lbl.textContent=s.detail||'';
    var det=document.createElement('div');det.className='stat-detail';det.textContent=s.count+' of '+analyzed.toLocaleString()+' reviewers';
    var row=document.createElement('div');row.className='stat-copy-row';
    row.appendChild(makeCopyBtn(s.percentage+'% '+s.detail));
    card.appendChild(pct);card.appendChild(lbl);card.appendChild(det);card.appendChild(row);
    grid.appendChild(card);
  });
  document.getElementById('statsFootnote').textContent='Based on '+analyzed.toLocaleString()+' Yotpo verified purchase reviews (most recent). Results reflect customer-reported outcomes — individual experiences may vary.';

  if((a.alt_stats||[]).length){
    document.getElementById('altStatsWrap').style.display='block';
    var altList=document.getElementById('altStatsList');altList.innerHTML='';
    (a.alt_stats||[]).forEach(function(alt){
      var card=document.createElement('div');card.className='alt-stat-card';
      var inner=document.createElement('div');inner.className='alt-stat-inner';
      var lbl=document.createElement('div');lbl.className='alt-stat-label';lbl.textContent='Alternative framing';
      var txt=document.createElement('div');txt.className='alt-stat-text';txt.textContent=alt.text||'';
      var sub=document.createElement('div');sub.className='alt-stat-sub';sub.textContent=alt.sub||'';
      inner.appendChild(lbl);inner.appendChild(txt);inner.appendChild(sub);
      card.appendChild(inner);
      card.appendChild(makeCopyBtn(alt.text||''));
      altList.appendChild(card);
    });
  }

  if(a.transformation){
    document.getElementById('transformCard').style.display='flex';
    document.getElementById('transformStat').textContent=a.transformation.stat||'';
    document.getElementById('transformSub').textContent=a.transformation.sub||'';
    var tcBtn=document.getElementById('transformCopyBtn');
    tcBtn.replaceWith(makeCopyBtn(a.transformation.stat||''));
  }

  // S4 REVIEWS
  var revList=document.getElementById('reviewsList');revList.innerHTML='';
  (a.reviews||[]).forEach(function(v){
    var cc=(v.rephrased_text||'').length;
    var over=cc>settings.review_chars;
    var card=document.createElement('div');card.className='review-card';
    var body=document.createElement('div');body.className='review-body';
    var num=document.createElement('div');num.className='review-num';num.textContent='Option '+(v.num||'');
    var title=document.createElement('div');title.className='review-title';title.textContent=v.title||'';
    var stars=document.createElement('div');stars.className='review-stars';stars.textContent='★★★★★';
    var text=document.createElement('div');text.className='review-text';text.textContent='\u201c'+(v.rephrased_text||'')+'\u201d';
    var authRow=document.createElement('div');authRow.className='review-author-row';
    var authName=document.createElement('div');authName.className='review-author-name';authName.textContent=v.original_author||'Verified Buyer';
    var authLabel=document.createElement('div');authLabel.className='review-author-label';authLabel.textContent='Verified Buyer';
    var themeTag=document.createElement('span');themeTag.className='review-theme-tag';themeTag.textContent=v.theme||'';
    authRow.appendChild(authName);
    if(v.original_author&&v.original_author!=='Verified Buyer')authRow.appendChild(authLabel);
    authRow.appendChild(themeTag);
    var meta=document.createElement('div');meta.className='review-meta'+(over?' over':'');meta.textContent=cc+' / '+settings.review_chars+' chars'+(over?' — over limit':'');
    body.appendChild(num);body.appendChild(title);body.appendChild(stars);body.appendChild(text);body.appendChild(authRow);body.appendChild(meta);
    var col=document.createElement('div');col.style.cssText='display:flex;flex-direction:column;align-items:flex-end;flex-shrink:0;';
    col.appendChild(makeCopyBtn((v.title?v.title+': ':'')+'\u201c'+(v.rephrased_text||'')+'\u201d — '+(v.original_author||'Verified Buyer'),true));
    card.appendChild(body);card.appendChild(col);
    revList.appendChild(card);
  });

  // S5 INGREDIENTS
  var ingList=document.getElementById('ingredientsList');ingList.innerHTML='';
  (a.ingredients||[]).forEach(function(ing){
    var sc=(ing.subline||'').length;
    var over=sc>settings.ing_chars;
    var card=document.createElement('div');card.className='choice-card';
    var body=document.createElement('div');body.className='choice-body';
    var num=document.createElement('div');num.className='choice-num';num.textContent='Option '+ing.num;
    var hl=document.createElement('div');hl.className='choice-title';hl.style.cssText='font-family:\'DM Serif Display\',serif;font-size:20px;line-height:1.3;';hl.textContent=ing.headline||'';
    var sub=document.createElement('div');sub.className='choice-desc';sub.textContent=ing.subline||'';
    var meta=document.createElement('div');meta.className='choice-meta'+(over?' over':'');meta.textContent=sc+' / '+settings.ing_chars+' chars'+(over?' — over limit':'');
    body.appendChild(num);body.appendChild(hl);body.appendChild(sub);body.appendChild(meta);
    if(ing.wiki_informed){var badge=document.createElement('div');badge.className='badge-wiki';badge.textContent='✓ Wiki-informed';body.appendChild(badge);}
    card.appendChild(body);
    card.appendChild(makeCopyBtn((ing.headline||'')+'\n'+(ing.subline||'')));
    ingList.appendChild(card);
  });

  // S6 CURATED
  var curList=document.getElementById('curatedList');curList.innerHTML='';
  (a.curated_collection||[]).forEach(function(c){
    var card=document.createElement('div');card.className='curated-card';
    var body=document.createElement('div');body.className='curated-body';
    var num=document.createElement('div');num.className='curated-num';num.textContent='Option '+c.num;
    var title=document.createElement('div');title.className='curated-title';title.textContent=c.title||'';
    var sub=document.createElement('div');sub.className='curated-subhead';sub.textContent=c.subhead||'';
    var ctx=document.createElement('div');ctx.className='curated-context';ctx.textContent=c.context||'';
    body.appendChild(num);body.appendChild(title);body.appendChild(sub);body.appendChild(ctx);
    card.appendChild(body);
    card.appendChild(makeCopyBtn((c.title||'')+' — '+(c.subhead||'')));
    curList.appendChild(card);
  });

  // S7 FAQS
  var faqContainer=document.getElementById('faqCards');faqContainer.innerHTML='';
  (a.faqs||[]).forEach(function(o){
    var card=document.createElement('div');card.className='faq-card';
    var bid='faq-body-'+o.rank,tid='faq-tog-'+o.rank;
    var header=document.createElement('div');header.className='faq-header';
    header.addEventListener('click',function(){
      document.getElementById(bid).classList.toggle('open');
      document.getElementById(tid).classList.toggle('open');
    });
    var rank=document.createElement('span');rank.className='faq-rank';rank.textContent='#'+o.rank;
    var q=document.createElement('div');q.className='faq-question';q.textContent=o.question||'';
    var tog=document.createElement('span');tog.className='faq-toggle';tog.id=tid;tog.textContent='▾';
    header.appendChild(rank);header.appendChild(q);header.appendChild(tog);

    var body=document.createElement('div');body.className='faq-body';body.id=bid;
    var srcLbl=document.createElement('div');srcLbl.className='faq-source-label';srcLbl.textContent='From review language:';
    var srcQ=document.createElement('div');srcQ.className='faq-source-quote';srcQ.textContent='\u201c'+(o.source_language||'')+'\u201d';
    var ansWrap=document.createElement('div');ansWrap.className='faq-answer-wrap';
    var ansLbl=document.createElement('div');ansLbl.className='faq-answer-label';ansLbl.textContent='Suggested answer — edit before publishing';
    var ansRow=document.createElement('div');ansRow.className='faq-answer-row';
    var ansTxt=document.createElement('div');ansTxt.className='faq-answer-text';ansTxt.textContent=o.suggested_answer||'';
    ansRow.appendChild(ansTxt);
    ansRow.appendChild(makeCopyBtn((o.question||'')+'\n\n'+(o.suggested_answer||'')));
    ansWrap.appendChild(ansLbl);ansWrap.appendChild(ansRow);
    var note=document.createElement('div');note.className='faq-note';
    var noteSpan=document.createElement('span');noteSpan.textContent=o.answer_note||'';
    note.appendChild(document.createTextNode('Must address: '));note.appendChild(noteSpan);
    body.appendChild(srcLbl);body.appendChild(srcQ);body.appendChild(ansWrap);body.appendChild(note);

    card.appendChild(header);card.appendChild(body);
    faqContainer.appendChild(card);
  });

  // PAIN POINTS
  var painContainer=document.getElementById('painCards');painContainer.innerHTML='';
  (a.pain_points||[]).forEach(function(p){
    var card=document.createElement('div');card.className='pain-card';
    var body=document.createElement('div');body.className='pain-body';
    var rank=document.createElement('div');rank.className='pain-rank';rank.textContent='Pain Point #'+p.rank;
    var lbl=document.createElement('div');lbl.className='pain-label-txt';lbl.textContent=p.label||'';
    var lang=document.createElement('div');lang.className='pain-language';lang.textContent='\u201c'+(p.customer_language||'')+'\u201d';
    body.appendChild(rank);body.appendChild(lbl);body.appendChild(lang);
    card.appendChild(body);
    card.appendChild(makeCopyBtn(p.copy_hook||''));
    painContainer.appendChild(card);
  });

  // SENTIMENT
  var s=a.sentiment||{positive:0,neutral:0,negative:0},sum=s.positive+s.neutral+s.negative||1;
  var pp=Math.round(s.positive/sum*100),np=Math.round(s.neutral/sum*100),ngp=Math.round(s.negative/sum*100);
  document.getElementById('posNum').textContent=pp+'%';
  document.getElementById('neuNum').textContent=np+'%';
  document.getElementById('negNum').textContent=ngp+'%';
  setTimeout(function(){
    document.getElementById('sentimentPos').style.width=pp+'%';
    document.getElementById('sentimentNeu').style.width=np+'%';
    document.getElementById('sentimentNeg').style.width=ngp+'%';
  },100);

  // THEMES
  var tp=document.getElementById('themePills');tp.innerHTML='';
  (a.themes||[]).forEach(function(t){
    var p=document.createElement('div');p.className='theme-pill';
    var lbl=document.createTextNode(t.label||'');
    var cnt=document.createElement('span');cnt.className='pill-count';cnt.textContent=t.count;
    p.appendChild(lbl);p.appendChild(cnt);tp.appendChild(p);
  });

  showResults();
}

function exportTxt(){
  if(!lastAnalysis)return;
  var a=lastAnalysis.analysis,out='PDP INTELLIGENCE REPORT\n'+lastAnalysis.product+'\n'+lastAnalysis.analyzed.toLocaleString()+' of '+lastAnalysis.count.toLocaleString()+' reviews\n';
  if(lastAnalysis.dateRange)out+='Date range: '+lastAnalysis.dateRange+'\n';
  out+='\n=== S1 — ABOUT ===\n';
  (a.about_options||[]).forEach(function(o){out+='Option '+o.num+':\n'+o.text+'\n\n';});
  out+='\n=== S2 — MADE WITH PURPOSE ===\n';
  (a.made_with_purpose||[]).forEach(function(m){out+='Option '+m.num+': '+m.title+'\n'+m.description+'\n\n';});
  out+='\n=== KEY BENEFITS ===\n';
  (a.benefits||[]).forEach(function(b){out+='• '+b.title+': '+b.proof+(b.pct?' ('+b.pct+'%)':'')+'\n';});
  out+='\n=== S3 — OUTCOME STATS ===\n';
  (a.outcome_stats||[]).forEach(function(s){out+='• '+s.percentage+'% '+s.detail+'\n';});
  if(a.transformation)out+='\nTransformation: '+a.transformation.stat+'\n';
  (a.alt_stats||[]).forEach(function(s){out+='Alt: '+s.text+'\n';});
  out+='\n=== S4 — REVIEWS ===\n';
  (a.reviews||[]).forEach(function(v){out+='Option '+v.num+': '+v.title+'\n"'+v.rephrased_text+'"\n— '+(v.original_author||'Verified Buyer')+'\n\n';});
  out+='\n=== S5 — INGREDIENTS ===\n';
  (a.ingredients||[]).forEach(function(ing){out+='Option '+ing.num+':\n'+ing.headline+'\n'+ing.subline+'\n\n';});
  out+='\n=== S6 — CURATE YOUR COLLECTION ===\n';
  (a.curated_collection||[]).forEach(function(c){out+='Option '+c.num+': '+c.title+'\n'+c.subhead+'\n\n';});
  out+='\n=== S7 — FAQS ===\n';
  (a.faqs||[]).forEach(function(o){out+='#'+o.rank+' '+o.question+'\nAnswer: '+o.suggested_answer+'\n\n';});
  out+='\n=== PAIN POINTS ===\n';
  (a.pain_points||[]).forEach(function(p){out+='#'+p.rank+' '+p.label+'\n"'+p.customer_language+'"\n\n';});
  out+='\n=== THEMES ===\n';
  (a.themes||[]).forEach(function(t){out+='• '+t.label+' ('+t.count+')\n';});
  var blob=new Blob([out],{type:'text/plain'}),url=URL.createObjectURL(blob),link=document.createElement('a');
  link.href=url;link.download=lastAnalysis.product.replace(/\s+/g,'-')+'-pdp-intel.txt';link.click();
}

function showLoading(c){document.getElementById('raLoading').classList.add('active');document.getElementById('loadingCount').textContent=c.toLocaleString();['step1','step2','step3','step4'].forEach(function(s){document.getElementById(s).className='loading-step';});}
function hideLoading(){document.getElementById('raLoading').classList.remove('active');}
function showResults(){document.getElementById('raResults').classList.add('active');}
function hideResults(){document.getElementById('raResults').classList.remove('active');}
function showError(m){var b=document.getElementById('errorBox');b.textContent=m;b.classList.add('active');}
function hideError(){document.getElementById('errorBox').classList.remove('active');}
function stepActive(id){document.getElementById(id).classList.add('active');}
function stepDone(id){document.getElementById(id).classList.remove('active');document.getElementById(id).classList.add('done');}
</script>

{% schema %}
{
  "name": "Review Analyzer",
  "settings": []
}
{% endschema %}
