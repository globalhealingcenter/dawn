function findHandle(productName){
  if(PRODUCT_HANDLES[productName])return PRODUCT_HANDLES[productName];
  var clean=productName.replace(/[®™©]/g,'').trim();
  for(var key in PRODUCT_HANDLES){if(key.replace(/[®™©]/g,'').trim()===clean)return PRODUCT_HANDLES[key];}
  return null;
}

async function fetchV1PdpBenefits(productName){
  var handle=findHandle(productName);
  if(!handle)return null;
  var url='https://ecom-claude-proxy.globalhealing.workers.dev/fetch-pdp?handle='+encodeURIComponent(handle);
  try{
    var resp=await fetch(url);
    if(!resp.ok)return null;
    var data=await resp.json();
    if(data.benefits&&data.benefits.length)return data.benefits;
    return null;
  }catch(e){return null;}
}

function buildPrompt(product,count,wikiSection,s,reviewTexts){
  var schema='{"sentiment":{"positive":0,"neutral":0,"negative":0},'
    +'"pain_points":[{"rank":1,"label":"","customer_language":"","copy_hook":"","main_benefit":""}],'
    +'"about_options":[{"num":1,"text":"max 205 chars","pain_point_tag":"2-4 word label","benefit_tag":"2-4 word label","differentiator_tag":"2-4 word label","differentiator_type":"Mechanism|Form|Sourcing|Bioavailability|Combination|Use Case","why_this_differentiates":"2-3 sentence explanation"}],'
    +'"made_with_purpose":[{"num":1,"title":"2-4 words, prefer 3","description":"","wiki_source":"exact quoted sentence from wiki","v1_pdp_source":"matching v1 PDP benefit text if applicable","source_type":"v1_pdp or wiki"}],'
    +'"wiki_v1_alignment":{"has_mismatch":false,"wiki_only_adds":["benefit titles in wiki but not v1"],"v1_only_adds":["benefit titles in v1 but not wiki"],"contradictions":["specific contradiction descriptions"]},'
    +'"benefits":[{"rank":1,"title":"","proof":""}],'
    +'"outcome_stats":[{"percentage":0,"detail":"max 20 chars","count":0}],'
    +'"transformation":{"stat":"X in Y customers [result] within [timeframe]","timeframe":"within X weeks","fraction":"X in Y","percentage":0,"sub":"Based on [timeframe] language in reviews","mention_count":0,"timeframe_keywords":["first night","overnight","by morning"],"outcome_keywords":["relief","worked","felt better"],"sample_quotes":["verbatim quote 1","verbatim quote 2","verbatim quote 3"]},'
    +'"alt_stats":[{"text":"X in Y customers [outcome] within [timeframe]","sub":"[timeframe] · [count] reviewers","mention_count":0,"timeframe_keywords":["first night","overnight"],"outcome_keywords":["relief","worked"],"sample_quotes":["verbatim quote 1","verbatim quote 2","verbatim quote 3"]}],'
    +'"reviews":[{"num":1,"title":"","original_text":"","original_author":"","theme":""}],'
    +'"ingredients":[{"num":1,"headline":"plain text headline max 40 chars","keyword":"word to italicize","subline":"","wiki_source":"exact quoted sentence from wiki that directly supports the headline claim"}],'
    +'"curated_collection":{"has_pairings":false,"options":[{"num":1,"title":"3-4 words","subhead":"max 80 chars naming specific companion products from wiki","context":"","wiki_source":"exact quoted sentence from wiki Recommended Pairings"}]},'
    +'"faqs":[{"rank":1,"question":"","review_context":"why this question came from reviews","suggested_answer":"","wiki_source":"exact quoted wiki sentence used to generate the answer","needs_manual_answer":false,"manual_answer_reason":"","is_what_to_expect":false,"expectation_substantiation":{"onset_quotes":["verbatim review quote"],"effects_quotes":["verbatim review quote"]}}]}';

  return 'Conversion copywriter for Global Healing supplements. Analyze '+count+' published reviews for "'+product+'".'+wikiSection
    +'\nReturn ONLY valid JSON matching this schema:\n'+schema
    +'\nCRITICAL RULES:'
    +'\n- about_options: exactly 5. HARD LIMIT: 205 characters maximum per option. Structure: BENEFIT first (what the customer gets) → acknowledge PAIN (what it solves) → name DIFFERENTIATOR. Product name MUST appear in each option (e.g. "Oxy-Powder…", "Latero-Flora…"). Differentiator hierarchy: Mechanism > Form > Sourcing > Bioavailability > Combination > Use Case. Each of the 5 options should test a DIFFERENT differentiator angle when wiki supports it. why_this_differentiates: 2-3 sentences explaining why this angle is competitor-resistant and wiki-grounded. BANNED WORDS in About text: program, programs, protocol, protocols, reset, journey, lighter, balance, harmony, supports, promotes, boosts, enhances. ZERO health claims. No question marks or casual openers.'
    +'\n- pain_points: exactly 4, ranked by frequency'
    +'\n- made_with_purpose: exactly 5. Options 1-3 (source_type="v1_pdp"): conversion-angle rewrites of v1 PDP benefits. Options 4-5 (source_type="wiki"): NEW benefit angles drawn from the wiki Health Benefits section that the v1 PDP does not already cover. Title: up to 5 words — prioritize specificity and distinctiveness over brevity, write what is best for the angle. desc under '+s.mwp_chars+' chars. wiki_source required all 5 — for wiki-sourced options, wiki_source MUST be the full Health Benefits block: the bold title, the italic descriptor sentence, and all bullet points underneath it, formatted as: "TITLE — DESCRIPTOR\\n• bullet 1\\n• bullet 2\\n• bullet 3". Use the bullets to inform punchier benefit angles. v1_pdp_source only for options 1-3. If no v1 PDP provided, generate all 5 from wiki only and label source_type="wiki" with empty v1_pdp_source. Do NOT fabricate v1_pdp_source quotes.'
    +'\n- wiki_v1_alignment: compare ONLY the wiki Health Benefits section against v1 PDP benefits. CRITICAL: wiki_only_adds must contain ONLY top-level entries from the wiki\'s Health Benefits section that do not appear in v1 PDP. DO NOT include content from: clinical study sections, "Backed by Research" subsections, mechanism explanations, formulation details, Source & Quality sections, certifications, manufacturing notes, or any section other than Health Benefits. v1_only_adds = v1 PDP benefits with no matching Health Benefits theme in the wiki. contradictions = direct conflicts in framing between wiki Health Benefits and v1 PDP. Set has_mismatch=true only if real mismatches exist within Health Benefits scope.'
    +'\n- benefits: EXACTLY 3 review-derived qualitative benefits. NO percentage field. title + proof only.'
    +'\n- outcome_stats: 4-6 items. detail max 20 chars. No disease claims.'
    +'\n- transformation: fraction AND timeframe. mention_count = reviews containing BOTH a timeframe phrase AND an outcome phrase. timeframe_keywords + outcome_keywords each 3-6 phrases. sample_quotes: 3 verbatim quotes containing BOTH elements.'
    +'\n- alt_stats: 2-3 items. Same intersection counting rule.'
    +'\n- reviews: exactly 8. ONLY 4-5 star with strong articulate language. original_text VERBATIM and UNDER 250 chars. Select for THEME VARIETY. Named authors preferred. title is short AI-generated headline.'
    +'\n- ingredients: 5 combined editorial headlines. headline MAX 40 chars (HARD LIMIT, no exceptions). headline must be DIRECTLY supported by wiki_source — wiki_source must be a sentence from the wiki that explicitly backs the headline claim. Do NOT use tangentially-related wiki sentences. If you cannot find a wiki sentence that directly supports a strong headline, write a softer headline the wiki actually supports. No asterisks. keyword = single word to italicize. subline under '+s.ing_chars+' chars.'
    +'\n- curated_collection: Look for a pairings section in the wiki under ANY of these labels: "Recommended Pairings", "Pairings", "Pairs Well With", "Companion Products", "Stack With", "Better Together", "Product Combinations", "Works Well With", "Recommended Companions" — or ANY structured table/list that names specific companion products alongside rationale and use case (e.g. columns like Supplement/Why It Works/Best For, or Product/Reason/For Whom). If ANY such section exists in any form (table, list, or paragraph naming multiple companion products with reasons): set has_pairings=true and generate 3 options. Each option: heading 3-4 words naming the customer state, subhead max '+s.curated_chars+' chars naming the SPECIFIC companion products from the wiki (e.g. "Pair with Latero-Flora and Aloe Vera to support sensitive digestion"). wiki_source = exact quoted text from the wiki pairings section. Only set has_pairings=false if you find absolutely no companion product recommendations anywhere in the wiki. BANNED WORDS: program, programs, protocol, protocols. No disease claims.'
    +'\n- faqs: exactly 8 questions. CRITICAL FAQ RULES: (1) Questions come from review patterns — what customers ask, worry about, hesitate on. (2) Answers come from the WIKI ONLY — never from review language. (3) Product name MUST appear in every answer (e.g. "Oxy-Powder helps…"). (4) FAQ #1 is always a "What to Expect" question with is_what_to_expect=true covering onset timeframe + temporary effects + individual variation + suggested use — all sourced from wiki. expectation_substantiation onset_quotes/effects_quotes are review quotes used as CONTEXT for why we ask, not as answer source. (5) For each FAQ: review_context = brief note on why reviewers prompted this question (used as "Why we\'re asking" display, NOT as answer source). suggested_answer comes from wiki only. wiki_source = exact wiki sentence used. (6) If the wiki does NOT cover a topic, set needs_manual_answer=true, manual_answer_reason="Wiki does not cover [specific gap]", leave suggested_answer and wiki_source empty. Do NOT fabricate answers from review language to fill the gap. (7) Banned words in answers: program, programs, protocol, protocols. (8) All FAQ answers under '+s.faq_chars+' chars. No disease treatment claims.'
    +'\nReviews:\n'+reviewTexts;
}

function buildRewritePrompt(items){
  return 'Rewrite each of the following copy fragments to fit within its character limit while preserving the original meaning, tone, and key information. Return ONLY valid JSON: {"rewrites":[{"id":"id1","new_text":"rewritten text"}, ...]}. Each new_text MUST be at or under its max_chars limit. Do not add disclaimers or commentary. Preserve banned-term restrictions (no health claims, no question marks in About options, no asterisks in ingredient headlines, no use of "program" or "protocol").\n\nFragments to rewrite:\n'+JSON.stringify(items,null,2);
}

async function doFetch(p,maxTok){
  var response=await fetch('https://ecom-claude-proxy.globalhealing.workers.dev',{
    method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({model:'claude-sonnet-4-6',max_tokens:maxTok||20000,messages:[{role:'user',content:p}]})
  });
  if(!response.ok){var et=await response.text();throw new Error(et||'API error');}
  return await response.text();
}

function parseEnvelope(rawText){
  var envelope;try{envelope=JSON.parse(rawText);}catch(e){envelope=null;}
  var inner=envelope&&envelope.content&&envelope.content[0]&&envelope.content[0].text||rawText;
  var jm=inner.replace(/```json|```/g,'').trim().match(/\{[\s\S]*\}/);
  if(!jm)return null;
  try{return JSON.parse(jm[0]);}catch(e){return null;}
}

async function enforceCharLimits(analysis,settings){
  var items=[];
  (analysis.about_options||[]).forEach(function(o,i){
    if((o.text||'').length>settings.about_chars){
      items.push({id:'about_'+i,max_chars:settings.about_chars,current_text:o.text,note:'About option — benefit→pain→differentiator, names the product, no question marks, no health claims, no banned words'});
    }
  });
  (analysis.made_with_purpose||[]).forEach(function(m,i){
    if((m.description||'').length>settings.mwp_chars){
      items.push({id:'mwp_'+i,max_chars:settings.mwp_chars,current_text:m.description,note:'MWP benefit description'});
    }
  });
  (analysis.ingredients||[]).forEach(function(ing,i){
    if((ing.headline||'').length>settings.ing_title_chars){
      items.push({id:'ingTitle_'+i,max_chars:settings.ing_title_chars,current_text:ing.headline,note:'Ingredient headline — must be wiki-grounded, no asterisks'});
    }
    if((ing.subline||'').length>settings.ing_chars){
      items.push({id:'ing_'+i,max_chars:settings.ing_chars,current_text:ing.subline,note:'Ingredient subline'});
    }
  });
  var curOptions=(analysis.curated_collection&&analysis.curated_collection.options)||[];
  curOptions.forEach(function(c,i){
    if((c.subhead||'').length>settings.curated_chars){
      items.push({id:'curated_'+i,max_chars:settings.curated_chars,current_text:c.subhead,note:'Curated subhead — names specific companion products from wiki, no "program" or "protocol"'});
    }
  });
  (analysis.faqs||[]).forEach(function(f,i){
    if(f.suggested_answer&&f.suggested_answer.length>settings.faq_chars){
      items.push({id:'faq_'+i,max_chars:settings.faq_chars,current_text:f.suggested_answer,note:'FAQ answer — names the product, no "program" or "protocol"'});
    }
  });
  (analysis.outcome_stats||[]).forEach(function(s,i){
    if((s.detail||'').length>settings.stat_chars){
      items.push({id:'stat_'+i,max_chars:settings.stat_chars,current_text:s.detail,note:'Stat label — punchy outcome'});
    }
  });

  if(items.length===0)return analysis;

  try{
    var rewritePrompt=buildRewritePrompt(items);
    var rawText=await doFetch(rewritePrompt,4000);
    var parsed=parseEnvelope(rawText);
    if(!parsed||!parsed.rewrites)return analysis;

    parsed.rewrites.forEach(function(rw){
      var parts=rw.id.split('_');
      var kind=parts[0];
      var idx=parseInt(parts[1]);
      if(isNaN(idx))return;
      if(kind==='about'&&analysis.about_options&&analysis.about_options[idx])analysis.about_options[idx].text=rw.new_text;
      else if(kind==='mwp'&&analysis.made_with_purpose&&analysis.made_with_purpose[idx])analysis.made_with_purpose[idx].description=rw.new_text;
      else if(kind==='ingTitle'&&analysis.ingredients&&analysis.ingredients[idx])analysis.ingredients[idx].headline=rw.new_text;
      else if(kind==='ing'&&analysis.ingredients&&analysis.ingredients[idx])analysis.ingredients[idx].subline=rw.new_text;
      else if(kind==='curated'&&analysis.curated_collection&&analysis.curated_collection.options&&analysis.curated_collection.options[idx])analysis.curated_collection.options[idx].subhead=rw.new_text;
      else if(kind==='faq'&&analysis.faqs&&analysis.faqs[idx])analysis.faqs[idx].suggested_answer=rw.new_text;
      else if(kind==='stat'&&analysis.outcome_stats&&analysis.outcome_stats[idx])analysis.outcome_stats[idx].detail=rw.new_text;
    });
  }catch(e){
    console.log('Rewrite pass failed:',e.message);
  }
  return analysis;
}

// CSV verification — for each generated review, check if original_text appears in the source CSV
function verifyReviewsAgainstCsv(analysis,sampleReviews){
  var csvTextBlob=sampleReviews.map(function(r){return getReviewText(r);}).join(' \n ').toLowerCase();
  (analysis.reviews||[]).forEach(function(v){
    if(!v.original_text){v._verified=false;return;}
    // Check if a distinctive 30-char chunk from the review exists in the CSV
    var text=v.original_text.toLowerCase().trim();
    var chunk=text.length>30?text.substring(5,Math.min(50,text.length-5)):text;
    v._verified=csvTextBlob.indexOf(chunk)!==-1;
  });
}

// Build a re-prompt asking Claude to replace unverified reviews with new picks from the verified pool
function buildReviewReplacementPrompt(rejectedReviews,product,reviewTexts,wikiSection,settings){
  var rejectedList=rejectedReviews.map(function(r){return '- "'+r.original_text.substring(0,80)+'..." (rejected: not found in source CSV)';}).join('\n');
  var schema='{"reviews":[{"num":1,"title":"","original_text":"","original_author":"","theme":""}]}';
  return 'You previously selected '+rejectedReviews.length+' reviews that could not be verified against the source CSV. Pick '+rejectedReviews.length+' NEW replacement reviews for "'+product+'" from the review pool below. Return ONLY valid JSON matching this schema:\n'+schema
    +'\n\nREJECTED REVIEWS (do not pick these or anything similar):\n'+rejectedList
    +'\n\nCRITICAL RULES for replacements:'
    +'\n- ONLY select 4-5 star reviews with strong articulate language'
    +'\n- original_text must be VERBATIM from the review pool below — copy character-for-character'
    +'\n- original_text must be UNDER '+settings.review_chars+' chars'
    +'\n- Named authors preferred over [ANON]'
    +'\n- Cover different themes from the rejected ones'
    +'\n- title = short AI-generated headline (5-10 words)'
    +'\n- Number them starting from '+(8-rejectedReviews.length+1)+' to 8'
    +'\n\nReview pool:\n'+reviewTexts;
}

async function replaceUnverifiedReviews(analysis,sampleReviews,product,reviewTexts,wikiSection,settings){
  var MAX_ATTEMPTS=2;
  var attempt=0;
  while(attempt<MAX_ATTEMPTS){
    var unverified=(analysis.reviews||[]).filter(function(v){return v._verified===false;});
    if(unverified.length===0)return analysis;

    // Remove unverified from output
    var verified=(analysis.reviews||[]).filter(function(v){return v._verified===true;});

    try{
      var rejectPrompt=buildReviewReplacementPrompt(unverified,product,reviewTexts,wikiSection,settings);
      var rawText=await doFetch(rejectPrompt,4000);
      var parsed=parseEnvelope(rawText);
      if(!parsed||!parsed.reviews||!parsed.reviews.length)break;

      // Verify the new replacements
      var csvTextBlob=sampleReviews.map(function(r){return getReviewText(r);}).join(' \n ').toLowerCase();
      parsed.reviews.forEach(function(v){
        if(!v.original_text){v._verified=false;return;}
        var text=v.original_text.toLowerCase().trim();
        var chunk=text.length>30?text.substring(5,Math.min(50,text.length-5)):text;
        v._verified=csvTextBlob.indexOf(chunk)!==-1;
      });

      // Combine verified originals + verified replacements
      analysis.reviews=verified.concat(parsed.reviews);
      // Re-number sequentially
      analysis.reviews.forEach(function(r,i){r.num=i+1;});
    }catch(e){
      console.log('Review replacement pass failed:',e.message);
      analysis.reviews=verified; // ship with what's verified
      analysis._replacement_failed_count=unverified.length;
      break;
    }
    attempt++;
  }
  // Final filter — drop any still-unverified after all attempts
  var finalUnverified=(analysis.reviews||[]).filter(function(v){return v._verified===false;});
  analysis._dropped_count=finalUnverified.length;
  analysis.reviews=(analysis.reviews||[]).filter(function(v){return v._verified===true;});
  return analysis;
}

async function runAnalysis(){
  var product=document.getElementById('productSelect').value;
  if(!product){showError('Please select a product.');return;}
  var reviews=getReviewsForProduct(product);
  if(!reviews.length){showError('No published reviews found for '+product+'. Check Yotpo review status.');return;}
  var wiki=document.getElementById('wikiText').value.trim();
  if(!wiki){if(!confirm('Product wiki is empty. Made With Purpose, Ingredients, Curated Collection, and FAQ answers will be unavailable or limited. Continue anyway?')){return;}}
  var settings=getSettings();
  hideError();hideResults();

  var sorted=sortByDateDesc(reviews);
  var sample=sorted.slice(0,SAMPLE_SIZE);
  showLoading(sample.length,reviews.length);
  var dateRange=getDateRange(sample);
  var authorCol=getAuthorCol(sample[0]);

  stepActive('step1');stepDone('step1');stepActive('step2');

  lastV1PdpBenefits=null;
  try{lastV1PdpBenefits=await fetchV1PdpBenefits(product);}catch(e){lastV1PdpBenefits=null;}

  stepDone('step2');stepActive('step3');

  var reviewTexts=sample.map(function(r){
    var text=getReviewText(r);
    var author=authorCol&&r[authorCol]?r[authorCol].trim():'';
    var isAnon=!author||author.toLowerCase()==='verified buyer'||author.toLowerCase()==='anonymous'||author.length<2;
    return (isAnon?'[ANON]: ':'['+author+']: ')+text;
  }).filter(function(t){return t.length>20;}).join('\n---\n');

  var wikiSection=wiki?'\n\nPRODUCT WIKI:\n'+wiki.substring(0,12000)+'\n':'';
  var v1Section='';
  if(lastV1PdpBenefits&&lastV1PdpBenefits.length){
    v1Section='\n\nV1 PDP BENEFITS (currently published, use as foundation for conversion-angle rewrites):\n';
    lastV1PdpBenefits.forEach(function(b,i){v1Section+=(i+1)+'. '+b.title+': '+b.description+'\n';});
  } else {
    v1Section='\n\nV1 PDP BENEFITS: none retrieved. Generate all 5 made_with_purpose options from wiki only. Leave v1_pdp_source empty on every card. Do NOT fabricate v1_pdp_source quotes.';
  }
  wikiSection+=v1Section;
  var prompt=buildPrompt(product,sample.length,wikiSection,settings,reviewTexts);

  try{
    var rawText;
    try{rawText=await doFetch(prompt,20000);}
    catch(e1){
      if(e1.message.indexOf('524')!==-1||e1.message.indexOf('overloaded')!==-1||e1.message.indexOf('529')!==-1){
        document.getElementById('loadingTimer').textContent='Retrying\u2026';
        await new Promise(function(r){setTimeout(r,3000);});
        rawText=await doFetch(prompt,20000);
      } else {throw e1;}
    }
    var analysis=parseEnvelope(rawText);
    if(!analysis){hideLoading();showError('Could not parse response. Try again.');return;}
    stepDone('step3');stepActive('step4');

    analysis=await enforceCharLimits(analysis,settings);
    verifyReviewsAgainstCsv(analysis,sample);
    analysis=await replaceUnverifiedReviews(analysis,sample,product,reviewTexts,wikiSection,settings);

    lastAnalysis={product:product,analysis:analysis,count:reviews.length,analyzed:sample.length,dateRange:dateRange,settings:settings,v1Benefits:lastV1PdpBenefits};
    stepDone('step4');
    setTimeout(function(){hideLoading();renderResults(product,reviews.length,sample.length,analysis,dateRange,settings);},400);
  }catch(err){hideLoading();showError('Analysis failed: '+err.message);}
}

function copyText(text){
  var clean=String(text).replace(/<[^>]+>/g,'').replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&quot;/g,'"').replace(/&#39;/g,"'");
  navigator.clipboard.writeText(clean);
}
function makeCopyBtn(text){
  var btn=document.createElement('button');
  btn.className='btn-copy';btn.textContent='Copy';
  btn.addEventListener('click',function(){copyText(text);btn.textContent='Copied';btn.classList.add('copied');setTimeout(function(){btn.textContent='Copy';btn.classList.remove('copied');},2000);});
  return btn;
}
function isGeneric(text){var lower=(text||'').toLowerCase();return GENERIC_TERMS.some(function(t){return lower.indexOf(t)!==-1;});}
