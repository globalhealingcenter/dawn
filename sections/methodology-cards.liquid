{% stylesheet %}
.methodology-cards {
  padding: 72px 0 80px;
  background-color: #ffffff;
}

.methodology-cards__inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
}

.methodology-cards__heading {
  font-size: clamp(2rem, 3vw, 2.6rem);
  line-height: 1.2;
  color: #1f5939;
  text-align: left;
  margin: 0 0 32px;
}

.methodology-cards__slider {
  overflow: hidden;
  position: relative;
}

.methodology-cards__track {
  display: flex;
}

.methodology-cards__item {
  background-color: #ffffff;
  border: 1px solid #c7d0c8;
  border-right: none;
  height: 100%;
}

.methodology-cards__item:last-child {
  border-right: 1px solid #c7d0c8;
}

.methodology-cards__media {
  width: 100%;
  height: 220px;
  overflow: hidden;
}

.methodology-cards__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.methodology-cards__content {
  padding: 24px 24px 28px;
}

.methodology-cards__title {
  font-size: clamp(1.3rem, 1.8vw, 1.6rem);
  line-height: 1.2;
  color: #174f33;
  margin: 0 0 0.75rem;
  font-weight: 600;
}

.methodology-cards__text {
  font-size: clamp(1rem, 1.4vw, 1.05rem);
  line-height: 1.5;
  color: #2f3b34;
  margin: 0;
  font-weight: 300;
}

.methodology-cards__cta {
  text-align: center;
  margin: 32px 0 0;
}

.methodology-cards__popup-trigger {
  background: none;
  border: none;
  padding: 0;
  font-size: 1rem;
  line-height: 1.4;
  color: #1f5939;
  text-decoration: underline;
  text-underline-offset: 3px;
  cursor: pointer;
}

.methodology-cards__popup-trigger:hover,
.methodology-cards__popup-trigger:focus-visible {
  color: #174f33;
}

@media screen and (min-width: 768px) {
  /* Desktop: 3 static cards side by side */
  .methodology-cards__track {
    display: grid !important;
    grid-template-columns: repeat(3, 1fr);
    transform: none !important;
  }

  .methodology-cards__item {
    width: auto !important;
  }
}

@media screen and (max-width: 767px) {
  .methodology-cards__inner {
    padding: 0;
  }

  .methodology-cards__item {
    border-right: none;
    height: stretch;
  }

  .methodology-cards__slider .slick-list {
    overflow: visible;
    padding: 0 12% 0 12%;
  }

  .methodology-cards__slider .slick-track {
    display: flex;
  }

  .methodology-cards__slider .slick-slide {
    height: inherit;
    margin: 0 10px;
  }

  .methodology-cards__item {
    width: 100%;
  }
}

.methodology-cards-popup {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.65);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.methodology-cards-popup.is-open {
  display: flex;
}

.methodology-cards-popup__dialog {
  position: relative;
  max-width: min(960px, 90vw);
  max-height: 90vh;
  background: #ffffff;
  box-shadow: 0 18px 45px rgba(0, 0, 0, 0.45);
  border-radius: 4px;
  overflow: hidden;
}

.methodology-cards-popup__image {
  display: block;
  width: 100%;
  height: auto;
}

.methodology-cards-popup__close {
  position: absolute;
  top: 10px;
  right: 12px;
  background: rgba(0, 0, 0, 0.58);
  border: none;
  color: #ffffff;
  width: 28px;
  height: 28px;
  border-radius: 999px;
  font-size: 18px;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.methodology-cards-popup__close:hover,
.methodology-cards-popup__close:focus-visible {
  background: rgba(0, 0, 0, 0.8);
}
{% endstylesheet %}

<section class="methodology-cards">
  <div class="methodology-cards__inner">
    <h2 class="methodology-cards__heading font-proxima">
      Our Methodology
    </h2>

    <div class="methodology-cards__slider">
      <div class="methodology-cards__track">
        <article class="methodology-cards__item">
          <div class="methodology-cards__media">
            <img
              class="methodology-cards__image"
              src="{{ 'standard_methodology_ftir.jpg' | asset_url }}"
              alt="FTIR Spectroscopy"
              width="800"
              height="440"
            >
          </div>
          <div class="methodology-cards__content">
            <h3 class="methodology-cards__title font-proxima">
              FTIR Spectroscopy
            </h3>
            <p class="methodology-cards__text font-proxima">
              Using an infrared light, we scan an ingredient’s unique “fingerprint” to confirm a raw ingredient is what it’s
              supposed to be.
            </p>
          </div>
        </article>

        <article class="methodology-cards__item">
          <div class="methodology-cards__media">
            <img
              class="methodology-cards__image"
              src="{{ 'standard_methodology_hptlc.jpg' | asset_url }}"
              alt="HPTLC"
              width="800"
              height="440"
            >
          </div>
          <div class="methodology-cards__content">
            <h3 class="methodology-cards__title font-proxima">
              HPTLC
            </h3>
            <p class="methodology-cards__text font-proxima">
              We separate a plant’s compounds and compare them to a pre‑verified reference, allowing us to rule out
              adulterants or fillers.
            </p>
          </div>
        </article>

        <article class="methodology-cards__item">
          <div class="methodology-cards__media">
            <img
              class="methodology-cards__image"
              src="{{ 'standard_methodology_microscopy.jpg' | asset_url }}"
              alt="Microscopy"
              width="800"
              height="440"
            >
          </div>
          <div class="methodology-cards__content">
            <h3 class="methodology-cards__title font-proxima">
              Microscopy
            </h3>
            <p class="methodology-cards__text font-proxima">
              Using a microscope, we verify characteristics that cannot be identified by chemical analysis, such as cellular
              structure.
            </p>
          </div>
        </article>
      </div>
    </div>

    <div class="methodology-cards__cta">
      <button type="button" class="methodology-cards__popup-trigger font-proxima">
        See the Complete Testing Process
      </button>
    </div>
  </div>
</section>

<div class="methodology-cards-popup" aria-hidden="true">
  <div class="methodology-cards-popup__dialog" role="dialog" aria-modal="true" aria-label="Complete testing process">
    <button type="button" class="methodology-cards-popup__close" aria-label="Close">
      &times;
    </button>
    <img
      class="methodology-cards-popup__image"
      src="{{ 'standard_complete_testing_process.png' | asset_url }}"
      alt="Diagram showing the complete testing process"
      width="960"
      height="540"
    >
  </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css">
<script src="https://code.jquery.com/jquery-3.7.1.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js" defer></script>
<script>
  (function () {
    function initMethodologyCardsSlick() {
      if (typeof window.jQuery === 'undefined') return false;

      var $ = window.jQuery;
      if (!$.fn || !$.fn.slick) return false;

      var $track = $('.methodology-cards__track');
      if (!$track.length) return true;

      function enableSlick() {
        if (window.innerWidth > 767 || $track.hasClass('slick-initialized')) return;

        $track.slick({
          infinite: true,
          arrows: false,
          dots: false,
          slidesToShow: 1,
          slidesToScroll: 1,
          centerMode: true,
          centerPadding: '12%',
          variableWidth: false,
          speed: 450,
          draggable: true,
          swipe: true,
          touchMove: true,
          mobileFirst: true
        });
      }

      function disableSlick() {
        if (window.innerWidth > 767 && $track.hasClass('slick-initialized')) {
          $track.slick('unslick');
        }
      }

      enableSlick();

      if (!$track.data('slick-bound')) {
        window.addEventListener('resize', function () {
          disableSlick();
          enableSlick();
        });
        $track.data('slick-bound', true);
      }

      return true;
    }

    function initMethodologyPopup() {
      var trigger = document.querySelector('.methodology-cards__popup-trigger');
      var popup = document.querySelector('.methodology-cards-popup');
      if (!trigger || !popup) return;

      var dialog = popup.querySelector('.methodology-cards-popup__dialog');
      var closeBtn = popup.querySelector('.methodology-cards-popup__close');

      function openPopup() {
        popup.classList.add('is-open');
        popup.setAttribute('aria-hidden', 'false');
      }

      function closePopup() {
        popup.classList.remove('is-open');
        popup.setAttribute('aria-hidden', 'true');
      }

      trigger.addEventListener('click', function () {
        openPopup();
      });

      popup.addEventListener('click', function (e) {
        if (!dialog.contains(e.target)) {
          closePopup();
        }
      });

      if (closeBtn) {
        closeBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          closePopup();
        });
      }

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' || e.key === 'Esc') {
          closePopup();
        }
      });
    }

    function tryInit(attemptsLeft) {
      if (initMethodologyCardsSlick() || attemptsLeft <= 0) return;
      window.setTimeout(function () {
        tryInit(attemptsLeft - 1);
      }, 200);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        tryInit(20);
        initMethodologyPopup();
      });
    } else {
      tryInit(20);
      initMethodologyPopup();
    }

    window.addEventListener('load', function () {
      tryInit(20);
    });
  })();
</script>

