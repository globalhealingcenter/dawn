{%- style -%}
  .section-{{ section.id }}-padding {
      padding-top: calc({{ section.settings.padding_top }}px * 0.75);
      padding-bottom: calc({{ section.settings.padding_bottom }}px  * 0.75);
  }

  @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
          padding-top: {{ section.settings.padding_top }}px;
          padding-bottom: {{ section.settings.padding_bottom }}px;
      }
  }

  .utility-bar.utility-bar--bottom-border{
      display: none;
  }

  .ghd--hero-carousel {
      background-image: url('{{ 'section-bg-texture.png' | asset_url }}');
      background-repeat: repeat;
      background-color: var(--gh-color-beige, #faf3e7);
  }
{%- endstyle -%}

{{ 'gh-section-home-page.css' | asset_url | stylesheet_tag }}

<div class="gh--home-page section-{{ section.id }}-padding">
  {{ 'gh-hero-carousel.js' | asset_url | script_tag }}

  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when '@app' -%}
        {% render block %}
      {% when 'video-hero' %}
        <section class="sh-hero-video">
          <div class="sh-hero-video--video">
            <div class="sh-hero-video--video--video-container">
              <div>
                <video class="video--desktop" loop="loop" muted="" autoplay="autoplay" playsinline="">
                  <source type="video/mp4" src="{{ block.settings.video }}">
                  Your browser does not support the video tag.
                </video>
                <video class="video--mobile" loop="loop" muted="" autoplay="autoplay" playsinline="">
                  <source type="video/mp4" src="{{ block.settings.video_mobile }}">
                  Your browser does not support the video tag.
                </video>
              </div>
            </div>
          </div>
          <div class="sh-hero-video--content page-width">
            <div>
              <h1>
                Your Body<br>
                <span>is the</span> Medicine
              </h1>
              <div class="flex">
                <a class="gh-font-secondary" href="{{ block.settings.url }}">Learn More</a>
                <h4>
                  Teach Your Body to<br>
                  Heal Itself, <em>Naturally</em>.
                </h4>
              </div>
            </div>
          </div>
        </section>
      {% when 'hero' %}
        <a href="{{ block.settings.url }}">
          {% render 'gh-deferred-image',
            image: block.settings.image_obj,
            image_mobile: block.settings.image_mobile_obj,
            width: 3000,
            width_mobile: 800
          %}
        </a>

      {% when 'logos' %}
        <section class="ghd--logos ghd--bg-white" {{ block.shopify_attributes }}>
          <div class="ghd--flex ghd--logos-track">
            {%- for i in (1..4) -%}
              <div class="ghd--logos-set">
                <div>
                  <img
                    loading="lazy"
                    alt=""
                    src="https://cdn.globalhealing.com/pages/v2/home/logos-miami-herald.v2.svg"
                    data-logo="miami-herald"
                  >
                </div>
                <div>
                  <img
                    loading="lazy"
                    alt=""
                    src="https://cdn.globalhealing.com/pages/v2/home/logos-forbes.v2.svg"
                    data-logo="forbes"
                  >
                </div>
                <div>
                  <img
                    loading="lazy"
                    alt=""
                    src="https://cdn.globalhealing.com/pages/v2/home/logos-chicago-tribune.v2.svg"
                    data-logo="chicago-tribune"
                  >
                </div>
                <div>
                  <img
                    loading="lazy"
                    alt=""
                    src="https://cdn.globalhealing.com/pages/v2/home/logos-huffpost.v2.svg"
                    data-logo="huffpost"
                  >
                </div>
                <div>
                  <img
                    loading="lazy"
                    alt=""
                    src="https://cdn.globalhealing.com/pages/v2/home/logos-mens-journal.v2.svg"
                    data-logo="mens-journal"
                  >
                </div>
                <div>
                  <img
                    loading="lazy"
                    alt=""
                    src="https://cdn.globalhealing.com/pages/v2/home/logos-us-weekly.v2.svg"
                    data-logo="us-weekly"
                  >
                </div>
                <div>
                  <img
                    loading="lazy"
                    alt=""
                    src="https://cdn.globalhealing.com/pages/v2/home/logos-livestrong.v2.svg"
                    data-logo="livestrong"
                  >
                </div>
              </div>
            {%- endfor -%}
          </div>
        </section>
      {% when 'banners' %}
        {% comment %} Hero carousel - Display when today is between start/end, or always when both dates are blank {% endcomment %}
        {% assign section_start = block.settings.banner_start_date | strip %}
        {% assign section_end = block.settings.banner_end_date | strip %}
        {% assign section_in_range = true %}
        {% if section_start != blank or section_end != blank %}
          {% assign now_ts = 'now' | date: '%s' | plus: 0 %}
          {% if section_start != blank %}
            {% assign start_ts = section_start | date: '%s' | plus: 0 %}
            {% if start_ts != 0 and now_ts < start_ts %}{% assign section_in_range = false %}{% endif %}
          {% endif %}
          {% if section_end != blank %}
            {% assign end_ts = section_end | date: '%s' | plus: 0 %}
            {% if end_ts != 0 and now_ts > end_ts %}{% assign section_in_range = false %}{% endif %}
          {% endif %}
        {% endif %}

        {% if section_in_range %}
          {% assign slide_count = 0 %}
          {% for target_order in (1..4) %}
            {% for slot_num in (1..4) %}
              {% assign order_key = 'banner_' | append: slot_num | append: '_order' %}
              {% assign slot_order = block.settings[order_key] | default: slot_num %}
              {% if slot_order == target_order %}
                {% assign visible_key = 'banner_' | append: slot_num | append: '_visible' %}
                {% assign desktop_img_key = 'banner_' | append: slot_num | append: '_desktop_image' %}
                {% assign mobile_img_key = 'banner_' | append: slot_num | append: '_mobile_image' %}
                {% assign desktop_video_key = 'banner_' | append: slot_num | append: '_desktop_video' %}
                {% assign mobile_video_key = 'banner_' | append: slot_num | append: '_mobile_video' %}
                {% assign url_key = 'banner_' | append: slot_num | append: '_url' %}
                {% assign visible = block.settings[visible_key] %}
                {% assign desktop_img = block.settings[desktop_img_key] %}
                {% assign mobile_img = block.settings[mobile_img_key] %}
                {% assign desktop_video = block.settings[desktop_video_key] %}
                {% assign mobile_video = block.settings[mobile_video_key] %}
                {% assign has_media = false %}
                {% if desktop_img != blank or desktop_video != blank %}{% assign has_media = true %}{% endif %}
                {% if mobile_img != blank or mobile_video != blank %}{% assign has_media = true %}{% endif %}
                {% if visible and has_media %}
                  {% assign slide_count = slide_count | plus: 1 %}
                {% endif %}
                {% break %}
              {% endif %}
            {% endfor %}
          {% endfor %}

          <section
            class="ghd--hero-carousel ghd--bg-white"
            {{ block.shopify_attributes }}
            data-block-id="{{ block.id }}"
          >
            {% assign hero_line_1 = block.settings.hero_headline_line_1 | strip %}
            {% assign hero_line_2 = block.settings.hero_headline_line_2 | strip %}
            {% assign hero_review = block.settings.hero_review_text | strip %}
            {% assign hero_show_stars = block.settings.hero_show_stars %}
            {% assign hero_stars = block.settings.hero_star_rating | default: 5 %}
            {% assign show_hero_header = false %}
            {% if hero_line_1 != blank or hero_line_2 != blank or hero_review != blank %}
              {% assign show_hero_header = true %}
            {% endif %}
            {% if show_hero_header %}
              <div class="ghd--hero-carousel__header page-width">
                <div class="ghd--hero-carousel__headline">
                  {% if hero_line_1 != blank %}
                    <span class="ghd--hero-carousel__headline-line-1 font-proxima">{{ hero_line_1 }}</span>
                  {% endif %}
                  {% if hero_line_2 != blank %}
                    <span class="ghd--hero-carousel__headline-line-2 ghd--hero-carousel__headline-highlight font-miller">
                      {{- hero_line_2 -}}
                    </span>
                  {% endif %}
                </div>
                {% if hero_review != blank or hero_show_stars %}
                  <div class="ghd--hero-carousel__reviews">
                    {% if hero_review != blank %}
                      <span class="ghd--hero-carousel__review-text font-proxima">{{ hero_review }}</span>
                    {% endif %}
                    {% if hero_show_stars %}
                      <span class="ghd--hero-carousel__stars" aria-hidden="true">
                        {% for i in (1..5) %}
                          {% if i <= hero_stars %}
                            {% comment %} <svg
                              class="ghd--hero-carousel__star"
                              width="20"
                              height="20"
                              viewBox="0 0 24 24"
                              fill="currentColor"
                              aria-hidden="true"
                            >
                              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                            </svg> {% endcomment %}
                            <svg xmlns="http://www.w3.org/2000/svg" version="1.2" viewBox="0 0 105 99" width="30" height="30">
                              <style>
                                .s0 { fill: #cca72c } 
                              </style>
                              <path fill-rule="evenodd" class="s0" d="m52.75-0.3l12.3 37.86h39.81l-32.21 23.4 12.3 37.85-32.2-23.39-32.21 23.39 12.3-37.85-32.2-23.4h39.81l12.3-37.86z"/>
                            </svg>
                          {% else %}
                            {% comment %} <svg
                              class="ghd--hero-carousel__star ghd--hero-carousel__star--empty"
                              width="20"
                              height="20"
                              viewBox="0 0 24 24"
                              fill="currentColor"
                              aria-hidden="true"
                            >
                              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                            </svg> {% endcomment %}
                            <svg xmlns="http://www.w3.org/2000/svg" version="1.2" viewBox="0 0 105 99" width="30" height="30">
                              <style>
                                .s0 { fill: #cccccc } 
                              </style>
                              <path fill-rule="evenodd" class="s0" d="m52.75-0.3l12.3 37.86h39.81l-32.21 23.4 12.3 37.85-32.2-23.39-32.21 23.39 12.3-37.85-32.2-23.4h39.81l12.3-37.86z"/>
                            </svg>
                          {% endif %}
                        {% endfor %}
                      </span>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            {% endif %}
            <div class="gh-hero-carousel page-width">
              <div class="gh-hero-carousel__track-container" style="aspect-ratio: 1430/475;">
                <div
                  class="gh-hero-carousel__track"
                  role="list"
                  aria-label="Hero banners"
                  data-slide-count="{{ slide_count }}"
                >
                  {% assign slide_idx = 0 %}
                  {% for target_order in (1..4) %}
                    {% for slot_num in (1..4) %}
                      {% assign order_key = 'banner_' | append: slot_num | append: '_order' %}
                      {% assign slot_order = block.settings[order_key] | default: slot_num %}
                      {% if slot_order == target_order %}
                        {% case slot_num %}
                          {% when 1 %}
                            {% assign desktop_img = block.settings.banner_1_desktop_image
                              | default: block.settings.banner_1_image_obj
                            %}
                            {% assign mobile_img = block.settings.banner_1_mobile_image
                              | default: block.settings.banner_1_image_mobile_obj
                            %}
                            {% assign desktop_video = block.settings.banner_1_desktop_video %}
                            {% assign mobile_video = block.settings.banner_1_mobile_video %}
                            {% assign visible = block.settings.banner_1_visible %}
                            {% assign slot_url = block.settings.banner_1_url %}
                          {% when 2 %}
                            {% assign desktop_img = block.settings.banner_2_desktop_image
                              | default: block.settings.banner_2_image_obj
                            %}
                            {% assign mobile_img = block.settings.banner_2_mobile_image %}
                            {% assign desktop_video = block.settings.banner_2_desktop_video %}
                            {% assign mobile_video = block.settings.banner_2_mobile_video %}
                            {% assign visible = block.settings.banner_2_visible %}
                            {% assign slot_url = block.settings.banner_2_url %}
                          {% when 3 %}
                            {% assign desktop_img = block.settings.banner_3_desktop_image
                              | default: block.settings.banner_3_image_obj
                            %}
                            {% assign mobile_img = block.settings.banner_3_mobile_image %}
                            {% assign desktop_video = block.settings.banner_3_desktop_video %}
                            {% assign mobile_video = block.settings.banner_3_mobile_video %}
                            {% assign visible = block.settings.banner_3_visible %}
                            {% assign slot_url = block.settings.banner_3_url %}
                          {% when 4 %}
                            {% assign desktop_img = block.settings.banner_4_desktop_image %}
                            {% assign mobile_img = block.settings.banner_4_mobile_image %}
                            {% assign desktop_video = block.settings.banner_4_desktop_video %}
                            {% assign mobile_video = block.settings.banner_4_mobile_video %}
                            {% assign visible = block.settings.banner_4_visible %}
                            {% assign slot_url = block.settings.banner_4_url %}
                        {% endcase %}
                        {% if visible == null %}{% assign visible = true %}{% endif %}
                        {% assign has_media = false %}
                        {% if desktop_img != blank or desktop_video != blank %}{% assign has_media = true %}{% endif %}
                        {% if mobile_img != blank or mobile_video != blank %}{% assign has_media = true %}{% endif %}
                        {% if visible and has_media %}
                          {% assign is_first = false %}
                          {% if slide_idx == 0 %}{% assign is_first = true %}{% endif %}
                          {% render 'gh-hero-carousel-slide',
                            desktop_image: desktop_img,
                            mobile_image: mobile_img,
                            desktop_video: desktop_video,
                            mobile_video: mobile_video,
                            url: block.settings[url_key],
                            index: slide_idx,
                            is_first: is_first
                          %}
                          {% assign slide_idx = slide_idx | plus: 1 %}
                        {% endif %}
                        {% break %}
                      {% endif %}
                    {% endfor %}
                  {% endfor %}
                </div>
                {% if slide_count > 1 %}
                  <button
                    type="button"
                    class="gh-hero-carousel__btn gh-hero-carousel__btn--prev"
                    aria-label="Previous slide"
                    data-direction="prev"
                  >
                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                      aria-hidden="true"
                    >
                      <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                  <button
                    type="button"
                    class="gh-hero-carousel__btn gh-hero-carousel__btn--next"
                    aria-label="Next slide"
                    data-direction="next"
                  >
                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                      aria-hidden="true"
                    >
                      <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                {% endif %}
              </div>
            </div>
          </section>
        {% endif %}
      {% when 'quality' %}
        <section class="ghd--our-process" {{ block.shopify_attributes }}>
          <div class="page-width ghd--flex">
            <div>
              <h2>{{ block.settings.heading }}</h2>
              <a href="{{ block.settings.link }}">{{ block.settings.link_text }}</a>
            </div>
            <div data-side="right">
              <span>
                <img src="https://cdn.globalhealing.com/pages/v2/home/quality-vegan.svg" alt="" loading="lazy">
                Vegan-Friendly
              </span>
              <span>
                <img src="https://cdn.globalhealing.com/pages/v2/home/quality-gmo-free.svg" alt="" loading="lazy">
                GMO-Free
              </span>
              <span>
                <img src="https://cdn.globalhealing.com/pages/v2/home/quality-gluten-free.svg" alt="" loading="lazy">
                Gluten-Free
              </span>
              <span>
                <img src="https://cdn.globalhealing.com/pages/v2/home/quality-additive-free.svg" alt="" loading="lazy">
                No Additives
              </span>
            </div>
          </div>
        </section>
      {% when 'journey' %}
        <section class="ghd--journey" {{ block.shopify_attributes }}>
          <div class="page-width">
            <div data-type="header">
              <h2 class="text-center">{{ block.settings.heading }}</h2>
            </div>
            <div class="ghd--flex" data-type="cols">
              <div>
                <h3>{{ block.settings.left_col_heading }}</h3>
                {{ block.settings.left_col_text }}
                <p>
                  <a class="button button--gold" href="{{ block.settings.link_1 }}">{{ block.settings.link_1_text }}</a>
                </p>
                <p>
                  <a class="button" href="{{ block.settings.link_2 }}">{{ block.settings.link_2_text }}</a>
                </p>
              </div>
              <div>
                <h4 class="text-center">{{ block.settings.link_list_heading }}</h4>
                <div class="ghd--journey--goals ghd--flex">
                  {% for link in block.settings.link_list.links %}
                    <div>{{ link.title | link_to: link.url }}</div>
                  {% endfor %}
                </div>
              </div>
            </div>
          </div>
        </section>
      {% when 'foundation' %}
        <section class="ghd--foundation" {{ block.shopify_attributes }}>
          <div class="ghd--flex">
            <div data-type="text">
              <h2 class="eyebrow">
                <span>{{ block.settings.pre_heading }}</span>
                {{ block.settings.heading }}
              </h2>
              {{ block.settings.text }}
              <p>
                <a class="button button--gold" href="{{ block.settings.link_1 }}">{{ block.settings.link_1_text }}</a>
              </p>
              <p>
                <a class="button button--gold-outline-white" href="{{ block.settings.link_2 }}">
                  {{- block.settings.link_2_text -}}
                </a>
              </p>
            </div>
            <div data-type="image">
              <!--
                <img src="https://cdn.globalhealing.com/pages/v2/home/foundation.png?w=760" srcset="https://cdn.globalhealing.com/pages/v2/home/foundation.png?w=1520 2x" alt="" loading="lazy">
              -->
              <picture loading="lazy">
                <source
                  media="(min-width: 750px)"
                  srcset="https://cdn.globalhealing.com/pages/v2/home/foundation.png?w=760 1x, https://cdn.globalhealing.com/pages/v2/home/foundation.png?w=1520 2x"
                  c
                >

                <source
                  media="(max-width: 749px)"
                  srcset="https://cdn.globalhealing.com/pages/v2/home/foundation.png?w=760 1x, https://cdn.globalhealing.com/pages/v2/home/foundation.png?w=760"
                >

                <img
                  style="height:auto;"
                  src="https://cdn.globalhealing.com/pages/v2/home/foundation.png?w=760"
                  alt=""
                  width="1520"
                  height="1358"
                  loading="lazy"
                >
              </picture>
            </div>
          </div>
        </section>

      {% when 'new_standard' %}
        {% render 'new-standard-block', block: block, section: section %}

      {% when 'shop_by_health_goals' %}
        {% render 'shop-by-health-goals', block: block, section: section %}

      {% when 'br' %}
        <hr class="page-width" {{ block.shopify_attributes }}>

      {% when 'mission' %}
        <section class="ghd--mission" {{ block.shopify_attributes }}>
          <div class="ghd--flex page-width" data-type="header">
            <div>
              <h2>{{ block.settings.heading }}</h2>
            </div>
            <div>
              {{ block.settings.intro_text }}
            </div>
          </div>
          <div class="page-width ghd--flex" data-type="cols">
            <div>
              <img
                src="https://cdn.globalhealing.com/pages/v2/home/mission-natural.png?w=560"
                srcset="https://cdn.globalhealing.com/pages/v2/home/mission-natural.png?w=560 1x, https://cdn.globalhealing.com/pages/v2/home/mission-natural.png?w=1120 2x"
                alt=""
                loading="lazy"
              >
              <div>
                <h3 class="eyebrow">
                  <span>WE BELIEVE IN</span>
                  NATURAL
                </h3>
                <p>
                  We offer products backed by science and rooted in nature, using only sustainable ingredients to
                  maximize potency and purity.
                </p>
              </div>
            </div>
            <div>
              <img
                src="https://cdn.globalhealing.com/pages/v2/home/mission-innovation.png?w=560"
                srcset="https://cdn.globalhealing.com/pages/v2/home/mission-innovation.png?w=560 1x, https://cdn.globalhealing.com/pages/v2/home/mission-innovation.png?w=1120 2x"
                alt=""
                loading="lazy"
              >
              <div>
                <h3 class="eyebrow">
                  <span>WE BELIEVE IN</span>
                  INNOVATION
                </h3>
                <p>
                  In our state-of-the-art, eco-friendly facility, we develop and formulate innovative products that
                  offer the best supplements in the industry, hands down.
                </p>
              </div>
            </div>
            <div>
              <img
                src="https://cdn.globalhealing.com/pages/v2/home/mission-sustainability.png?w=560"
                srcset="https://cdn.globalhealing.com/pages/v2/home/mission-sustainability.png?w=560 1x, https://cdn.globalhealing.com/pages/v2/home/mission-sustainability.png?w=1120 2x"
                alt=""
                loading="lazy"
              >
              <div>
                <h3 class="eyebrow">
                  <span>WE BELIEVE IN</span>
                  SUSTAINABILITY
                </h3>
                <p>
                  In addition to our sustainably sourced ingredients, we pack and ship our products in the most
                  environmentally-friendly way possible to reduce our carbon footprint.
                </p>
              </div>
            </div>
            <div>
              <img
                src="https://cdn.globalhealing.com/pages/v2/home/mission-giving-back.png?w=560"
                srcset="https://cdn.globalhealing.com/pages/v2/home/mission-giving-back.png?w=560 1x, https://cdn.globalhealing.com/pages/v2/home/mission-giving-back.png?w=1120 2x"
                alt=""
                loading="lazy"
              >
              <div>
                <h3 class="eyebrow">
                  <span>WE BELIEVE IN</span>
                  GIVING BACK
                </h3>
                <p>
                  We give back to local and national organizations that promote sustainable, organic farming initiatives
                  and frequently donate a portion of our sales to like-minded nonprofits.
                </p>
              </div>
            </div>
          </div>
        </section>

      {% when 'autoship' %}
        <section class="ghd--autoship-info" {{ block.shopify_attributes }}>
          <div class="page-width ghd--flex">
            <div data-type="image">
              <!--
                <picture>
                  <source media="(min-width: 650px)" srcset="{{ block.settings.image }}">
                  <source media="(max-width: 649px)" srcset="{{ block.settings.image_mobile }}">
                  <img src="{{ block.settings.image }}" alt="">
                </picture>
              -->
            </div>
            <div data-type="text">
              <h2 class="eyebrow">
                <span>{{ block.settings.pre_heading }}</span>
                {{ block.settings.heading }}
              </h2>
              {{ block.settings.text }}
              <a class="button button--tertiary button--secondary" href="{{ block.settings.link }}">
                {{- block.settings.link_text -}}
              </a>
            </div>
          </div>
        </section>
      {% when 'reviews' %}
        <section class="ghd--reviews" {{ block.shopify_attributes }}>
          <div class="ghd--flex" data-type="cols">
            <div class="text-center">
              <div>
                <img src="https://cdn.globalhealing.com/pages/v2/home/reviews-stars.svg" width="150" alt="">
                <h3 class="eyebrow">
                  Tens of Thousands
                  <span>OF FIVE-STAR REVIEWS</span>
                </h3>

                <h3 class="ghd--reviews--featured-title">Featured Review</h3>
