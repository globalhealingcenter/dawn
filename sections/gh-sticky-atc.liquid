{% schema %}
{
  "name": "Sticky Add To Cart Bar",
  "templates": [
    "product"
  ],
  "presets": [
    {
      "name": "Sticky Add To Cart Bar"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Design Variant"
    },
    {
      "type": "select",
      "id": "color_variant",
      "label": "Colour Theme",
      "options": [
        {
          "value": "light",
          "label": "Light / Cream"
        },
        {
          "value": "dark",
          "label": "Dark / Forest Green"
        }
      ],
      "default": "light"
    },
    {
      "type": "header",
      "content": "Subscription"
    },
    {
      "type": "number",
      "id": "subscribe_discount_pct",
      "label": "Subscribe saving badge %",
      "default": 15,
      "info": "Badge text only. The actual subscription price must come from OrderGroove / the main PDP purchase options."
    },
    {
      "type": "header",
      "content": "Subscription Benefits"
    },
    {
      "type": "checkbox",
      "id": "show_benefits_bar",
      "label": "Show subscription benefits bar",
      "default": true
    },
    {
      "type": "text",
      "id": "benefit_1",
      "label": "Benefit 1",
      "default": "Free Shipping Always"
    },
    {
      "type": "text",
      "id": "benefit_2",
      "label": "Benefit 2",
      "default": "Cancel Anytime"
    },
    {
      "type": "text",
      "id": "benefit_3",
      "label": "Benefit 3",
      "default": "Skip or Pause Easily"
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "header",
      "content": "Sticky Trigger"
    },
    {
      "type": "range",
      "id": "show_after_px",
      "label": "Show after scrolling",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "default": 300,
      "info": "Use 0 if the bar should always be visible."
    }
  ]
}
{% endschema %}