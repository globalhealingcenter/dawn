{% comment %}
  ============================================================
  GH Sticky ATC — PDP v2
  ============================================================

  Features:
  - Product title
  - Rating / review count
  - One-Time / Subscribe toggle
  - SAVE X% badge
  - Dynamic product/variant pricing
  - Dynamic subscription pricing from PDP / OrderGroove
  - Delivery frequency selector
  - Subscription benefits bar
  - Light / Dark design variants
  - Main PDP Add to Cart proxy
  - Scroll-to-top arrow

  IMPORTANT:
  Subscription pricing is NOT calculated in this section.
  The actual subscription price/state should come from the
  main PDP / OrderGroove implementation.
{% endcomment %}


{% assign selected_variant = product.selected_or_first_available_variant %}
{% assign discount_pct = section.settings.subscribe_discount_pct | default: 15 %}
{% assign color_variant = section.settings.color_variant | default: 'light' %}


{% comment %}
  ------------------------------------------------------------
  REVIEWS

  Adjust these metafields if your PDP uses another review app.
  Ideally use the same source that the main PDP review widget uses.
  ------------------------------------------------------------
{% endcomment %}

{% assign review_count = product.metafields.custom.review_count.value %}
{% assign review_average = product.metafields.custom.review_average.value %}

{% if review_count == blank %}
  {% assign review_count = product.metafields.spr.reviews_count %}
{% endif %}

{% if review_average == blank %}
  {% assign review_average = product.metafields.spr.reviews_rating %}
{% endif %}


{% comment %}
  ------------------------------------------------------------
  BENEFITS
  ------------------------------------------------------------
{% endcomment %}

{% assign benefit_1 = section.settings.benefit_1 | default: 'Free Shipping Always' %}
{% assign benefit_2 = section.settings.benefit_2 | default: 'Cancel Anytime' %}
{% assign benefit_3 = section.settings.benefit_3 | default: 'Skip or Pause Easily' %}


<div
  id="gh-sticky-atc-{{ section.id }}"
  class="
    gh-sticky-atc
    gh-sticky-atc--hidden
    {% if section.settings.hide_on_desktop %}
      gh-sticky-atc--desktop-hidden
    {% endif %}
    {% if section.settings.hide_on_mobile %}
      gh-sticky-atc--mobile-hidden
    {% endif %}
  "
  data-gh-sticky="true"
  data-gh-variant="{{ color_variant }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-initial-variant="{{ selected_variant.id }}"
  data-discount-pct="{{ discount_pct }}"
  data-show-after-px="{{ section.settings.show_after_px | default: 300 }}"
>

  {% comment %}
    ==========================================================
    MAIN BAR
    ==========================================================
  {% endcomment %}

  <div class="gh-sticky-atc__bar">

    <div class="gh-sticky-atc__inner">


      {% comment %}
        ------------------------------------------------------
        PRODUCT TITLE + REVIEWS
        ------------------------------------------------------
      {% endcomment %}

      <div class="gh-sticky-atc__product">

        <div class="gh-sticky-atc__name">
          {{ product.title }}
        </div>

        {% if review_count != blank %}

          <div
            class="gh-sticky-atc__reviews"
            {% if review_average != blank %}
              aria-label="{{ review_average }} out of 5 stars, {{ review_count }} reviews"
            {% endif %}
          >

            <span
              class="gh-sticky-stars"
              aria-hidden="true"
            >

              {% assign rating_val = review_average | default: 5 | times: 1.0 %}

              {% for i in (1..5) %}

                {% assign i_float = i | times: 1.0 %}

                {% if i_float <= rating_val %}

                  <svg
                    class="gh-star gh-star--full"
                    viewBox="0 0 20 19"
                    width="18"
                    height="18"
                    aria-hidden="true"
                  >
                    <path
                      fill="currentColor"
                      d="M10 0l2.39 7.36H20l-6.18 4.49 2.36 7.27L10 14.63l-6.18 4.49 2.36-7.27L0 7.36h7.61z"
                    />
                  </svg>

                {% elsif rating_val >= i_float | minus: 0.5 %}

                  <svg
                    class="gh-star gh-star--half"
                    viewBox="0 0 20 19"
                    width="18"
                    height="18"
                    aria-hidden="true"
                  >
                    <defs>
                      <linearGradient id="gh-half-star-{{ section.id }}-{{ i }}">
                        <stop offset="50%" stop-color="currentColor"/>
                        <stop offset="50%" stop-color="#d8d8d8"/>
                      </linearGradient>
                    </defs>

                    <path
                      fill="url(#gh-half-star-{{ section.id }}-{{ i }})"
                      d="M10 0l2.39 7.36H20l-6.18 4.49 2.36 7.27L10 14.63l-6.18 4.49 2.36-7.27L0 7.36h7.61z"
                    />
                  </svg>

                {% else %}

                  <svg
                    class="gh-star gh-star--empty"
                    viewBox="0 0 20 19"
                    width="18"
                    height="18"
                    aria-hidden="true"
                  >
                    <path
                      fill="#d8d8d8"
                      d="M10 0l2.39 7.36H20l-6.18 4.49 2.36 7.27L10 14.63l-6.18 4.49 2.36-7.27L0 7.36h7.61z"
                    />
                  </svg>

                {% endif %}

              {% endfor %}

            </span>

            <span class="gh-sticky-atc__review-count">
              {{ review_count }}
            </span>

          </div>

        {% endif %}

      </div>


      <div
        class="gh-sticky-atc__divider gh-sticky-atc__divider--first"
        aria-hidden="true"
      ></div>


      {% comment %}
        ------------------------------------------------------
        PURCHASE TYPE + DELIVERY
        ------------------------------------------------------
      {% endcomment %}

      <div class="gh-sticky-atc__purchase">

        <div
          class="gh-sticky-toggle"
          role="group"
          aria-label="Purchase type"
        >

          <button
            class="
              gh-sticky-toggle__btn
              gh-sticky-toggle__btn--onetime
            "
            type="button"
            data-gh-toggle="onetime"
            aria-pressed="true"
          >
            <span>One-Time</span>
          </button>


          <button
            class="
              gh-sticky-toggle__btn
              gh-sticky-toggle__btn--subscribe
            "
            type="button"
            data-gh-toggle="subscribe"
            aria-pressed="false"
          >

            <span>Subscribe</span>

            <span class="gh-sticky-toggle__badge">
              SAVE {{ discount_pct }}%
            </span>

          </button>

        </div>


        {% comment %}
          Delivery selector.
          Hidden/disabled until subscription is active.
        {% endcomment %}

        <div
          class="gh-sticky-delivery"
          aria-hidden="true"
        >

          <label
            class="gh-sticky-delivery__label"
            for="gh-sticky-delivery-{{ section.id }}"
          >
            Delivery Type
          </label>

          <div class="gh-sticky-delivery__wrap">

            <select
              id="gh-sticky-delivery-{{ section.id }}"
              class="gh-sticky-delivery__select"
              data-gh-delivery
              aria-label="Delivery frequency"
              disabled
            >

              {% if product.selling_plan_groups.size > 0 %}

                {% for group in product.selling_plan_groups %}

                  {% for plan in group.selling_plans %}

                    <option value="{{ plan.id }}">
                      {{ plan.name }}
                    </option>

                  {% endfor %}

                {% endfor %}

              {% else %}

                <option value="">
                  1 month
                </option>

              {% endif %}

            </select>


            <span
              class="gh-sticky-delivery__arrows"
              aria-hidden="true"
            >

              <svg
                viewBox="0 0 12 7"
                width="10"
                height="6"
              >
                <path
                  d="M1 6L6 1L11 6"
                  stroke="currentColor"
                  stroke-width="1.5"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>

              <svg
                viewBox="0 0 12 7"
                width="10"
                height="6"
              >
                <path
                  d="M1 1L6 6L11 1"
                  stroke="currentColor"
                  stroke-width="1.5"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>

            </span>

          </div>

        </div>

      </div>


      <div
        class="gh-sticky-atc__divider gh-sticky-atc__divider--second"
        aria-hidden="true"
      ></div>


      {% comment %}
        ------------------------------------------------------
        PRICE
        ------------------------------------------------------
      {% endcomment %}

      <div class="gh-sticky-atc__price-block">

        <span
          class="gh-sticky-atc__compare-price"
          data-gh-compare-price
          style="display:none;"
        ></span>

        <span
          class="gh-sticky-atc__price"
          data-gh-price
        >
          {{ selected_variant.price | money }}
        </span>

      </div>


      {% comment %}
        ------------------------------------------------------
        ADD TO CART
        ------------------------------------------------------
      {% endcomment %}

      <button
        class="gh-sticky-atc__btn"
        type="button"
        data-gh-sticky-atc-button
        aria-label="Add {{ product.title | escape }} to cart"
      >

        <span class="gh-sticky-atc__btn-text">
          Add to Cart
        </span>

        <span
          class="gh-sticky-atc__spinner"
          aria-hidden="true"
        >
          <svg
            viewBox="0 0 50 50"
            width="22"
            height="22"
          >
            <circle
              cx="25"
              cy="25"
              r="20"
              fill="none"
              stroke="currentColor"
              stroke-width="4"
            />
          </svg>
        </span>

      </button>


      {% comment %}
        ------------------------------------------------------
        SCROLL TO TOP
        ------------------------------------------------------
      {% endcomment %}

      <button
        class="gh-sticky-atc__scroll-btn"
        type="button"
        data-gh-scroll-top
        aria-label="Back to top"
      >

        <svg
          viewBox="0 0 32 20"
          width="30"
          height="20"
          aria-hidden="true"
        >
          <path
            d="M2 18L16 4L30 18"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>

      </button>

    </div>

  </div>


  {% comment %}
    ==========================================================
    SUBSCRIPTION BENEFITS
    ==========================================================
  {% endcomment %}

  {% if section.settings.show_benefits_bar %}

    <div
      class="gh-sticky-atc__benefits"
      aria-hidden="true"
    >

      <div class="gh-sticky-atc__benefits-inner">

        <span class="gh-sticky-atc__benefit">

          <span
            class="gh-sticky-atc__benefit-star"
            aria-hidden="true"
          >
            ✦
          </span>

          {{ benefit_1 }}

        </span>


        <span
          class="gh-sticky-atc__benefits-separator"
          aria-hidden="true"
        >
          |
        </span>


        <span class="gh-sticky-atc__benefit">

          <span
            class="gh-sticky-atc__benefit-star"
            aria-hidden="true"
          >
            ✦
          </span>

          {{ benefit_2 }}

        </span>


        <span
          class="gh-sticky-atc__benefits-separator"
          aria-hidden="true"
        >
          |
        </span>


        <span class="gh-sticky-atc__benefit">

          <span
            class="gh-sticky-atc__benefit-star"
            aria-hidden="true"
          >
            ✦
          </span>

          {{ benefit_3 }}

        </span>

      </div>

    </div>

  {% endif %}

</div>


{% comment %}
  ============================================================
  VARIANT DATA

  Used as a reliable fallback when theme/OrderGroove price
  elements cannot immediately be read.
  ============================================================
{% endcomment %}

<script
  id="gh-sticky-variants-{{ section.id }}"
  type="application/json"
>
[
  {% for variant in product.variants %}
    {
      "id": {{ variant.id | json }},
      "available": {{ variant.available | json }},
      "price": {{ variant.price | json }},
      "compare_at_price": {{ variant.compare_at_price | default: 0 | json }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
</script>


{% comment %}
  ============================================================
  SELLING PLAN DATA
  ============================================================
{% endcomment %}

<script
  id="gh-sticky-plans-{{ section.id }}"
  type="application/json"
>
[
  {% assign plan_counter = 0 %}

  {% for group in product.selling_plan_groups %}

    {% for plan in group.selling_plans %}

      {% if plan_counter > 0 %},{% endif %}

      {
        "id": {{ plan.id | json }},
        "name": {{ plan.name | json }},
        "group_name": {{ group.name | json }}
      }

      {% assign plan_counter = plan_counter | plus: 1 %}

    {% endfor %}

  {% endfor %}
]
</script>


<style>

  /* ========================================================
     BASE TOKENS
     ======================================================== */

  .gh-sticky-atc {
    --gh-green: #0b4527;
    --gh-green-medium: #294b32;
    --gh-gold: #d9ad24;
    --gh-cream: #f8f4ee;
    --gh-white: #ffffff;

    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;

    z-index: 999;

    font-family: var(
      --font-body-family,
      Arial,
      sans-serif
    );

    box-shadow: 0 -2px 18px rgba(0, 0, 0, 0.08);

    transition:
      transform 0.3s ease,
      opacity 0.3s ease;

    transform: translateY(0);
    opacity: 1;
  }


  .gh-sticky-atc--hidden {
    transform: translateY(110%);
    opacity: 0;
    pointer-events: none;
  }


  /* ========================================================
     LIGHT VARIANT
     ======================================================== */

  .gh-sticky-atc[data-gh-variant="light"] {

    --gh-bar-bg: #ffffff;
    --gh-product-text: #11462a;

    --gh-divider: #d7af29;

    --gh-toggle-bg: #154a2b;
    --gh-toggle-border: #d7af29;

    --gh-toggle-text: #ffffff;
    --gh-subscribe-active-bg: #ddb528;
    --gh-subscribe-active-text: #16482b;

    --gh-badge-bg: #f6edbd;
    --gh-badge-text: #18492c;

    --gh-delivery-label: #c4c4c4;
    --gh-delivery-bg: #154a2b;
    --gh-delivery-text: #ffffff;

    --gh-price-text: #0c4527;
    --gh-compare-text: #8b9890;

    --gh-button-bg: #294c32;
    --gh-button-text: #ffffff;

    --gh-arrow-bg: #17492c;
    --gh-arrow-text: #ffffff;

    --gh-benefit-bg: #063d20;
    --gh-benefit-text: #c9b86f;

    --gh-star-color: #d7aa24;
  }


  /* ========================================================
     DARK VARIANT
     ======================================================== */

  .gh-sticky-atc[data-gh-variant="dark"] {

    --gh-bar-bg: #294b32;
    --gh-product-text: #ffffff;

    --gh-divider: #d7af29;

    --gh-toggle-bg: #154a2b;
    --gh-toggle-border: #d7af29;

    --gh-toggle-text: #ffffff;
    --gh-subscribe-active-bg: #ddb528;
    --gh-subscribe-active-text: #16482b;

    --gh-badge-bg: #f6edbd;
    --gh-badge-text: #18492c;

    --gh-delivery-label: #c8c4b5;
    --gh-delivery-bg: #0c4728;
    --gh-delivery-text: #ffffff;

    --gh-price-text: #ffffff;
    --gh-compare-text: rgba(255,255,255,.55);

    --gh-button-bg: #ffffff;
    --gh-button-text: #25482f;

    --gh-arrow-bg: #ddb528;
    --gh-arrow-text: #17492c;

    --gh-benefit-bg: #063d20;
    --gh-benefit-text: #c9b86f;

    --gh-star-color: #d7aa24;
  }


  /* ========================================================
     MAIN BAR
     ======================================================== */

  .gh-sticky-atc__bar {
    width: 100%;
    background: var(--gh-bar-bg);
  }


  .gh-sticky-atc__inner {
    width: 100%;
    min-height: 142px;

    padding: 26px 56px;

    display: grid;

    grid-template-columns:
      minmax(220px, 280px)
      1px
      minmax(390px, 1fr)
      1px
      minmax(110px, 130px)
      minmax(280px, 340px)
      70px;

    align-items: center;

    column-gap: 54px;

    box-sizing: border-box;
  }


  /* ========================================================
     PRODUCT
     ======================================================== */

  .gh-sticky-atc__product {
    min-width: 0;
  }


  .gh-sticky-atc__name {
    margin: 0 0 8px;

    color: var(--gh-product-text);

    font-family:
      var(--font-heading-family),
      Georgia,
      serif;

    font-size: clamp(24px, 1.8vw, 36px);

    font-weight: 600;

    line-height: 1.1;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }


  .gh-sticky-atc__reviews {
    display: flex;
    align-items: center;
    gap: 10px;

    color: var(--gh-star-color);
  }


  .gh-sticky-stars {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }


  .gh-sticky-atc__review-count {
    color: #929792;

    font-size: 19px;
    font-weight: 500;
  }


  /* ========================================================
     DIVIDERS
     ======================================================== */

  .gh-sticky-atc__divider {
    width: 1px;
    height: 76px;

    background: var(--gh-divider);
  }


  /* ========================================================
     PURCHASE AREA
     ======================================================== */

  .gh-sticky-atc__purchase {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 48px;

    min-width: 0;
  }


  /* ========================================================
     PURCHASE TOGGLE
     ======================================================== */

  .gh-sticky-toggle {
    display: inline-flex;

    align-items: center;

    flex-shrink: 0;

    min-width: 400px;

    padding: 4px;

    background: var(--gh-toggle-bg);

    border: 2px solid var(--gh-toggle-border);

    border-radius: 999px;
  }


  .gh-sticky-toggle__btn {
    min-height: 42px;

    border: 0;
    outline: 0;

    display: inline-flex;
    justify-content: center;
    align-items: center;

    gap: 12px;

    padding: 8px 24px;

    border-radius: 999px;

    background: transparent;

    color: var(--gh-toggle-text);

    font-family: inherit;

    font-size: 17px;

    font-weight: 700;

    line-height: 1;

    cursor: pointer;

    transition:
      background 0.2s ease,
      color 0.2s ease;

    white-space: nowrap;
  }


  .gh-sticky-toggle__btn--onetime {
    flex: 1;
  }


  .gh-sticky-toggle__btn--subscribe {
    flex: 1.35;
  }


  /*
   * One-Time selected:
   * Keep it dark as shown in supplied design.
   */

  .gh-sticky-toggle__btn--onetime[aria-pressed="true"] {
    background: transparent;
    color: #ffffff;
  }


  /*
   * Subscribe selected:
   * Gold active pill.
   */

  .gh-sticky-toggle__btn--subscribe[aria-pressed="true"] {
    background: var(--gh-subscribe-active-bg);
    color: var(--gh-subscribe-active-text);
  }


  .gh-sticky-toggle__badge {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    padding: 4px 12px;

    background: var(--gh-badge-bg);

    color: var(--gh-badge-text);

    border-radius: 999px;

    font-size: 12px;

    font-weight: 800;

    line-height: 1;

    white-space: nowrap;
  }


  /*
   * Hide save badge when One-Time is selected if desired.
   * Requirement/design shows badge as part of Subscribe pill,
   * so we leave it visible.
   */


  /* ========================================================
     DELIVERY
     ======================================================== */

  .gh-sticky-delivery {
    min-width: 140px;

    display: flex;
    flex-direction: column;

    gap: 5px;

    visibility: hidden;

    opacity: 0;

    pointer-events: none;

    transition:
      opacity 0.2s ease,
      visibility 0.2s ease;
  }


  .gh-sticky-atc--subscribed .gh-sticky-delivery {
    visibility: visible;

    opacity: 1;

    pointer-events: auto;
  }


  .gh-sticky-delivery__label {
    padding-left: 12px;

    color: var(--gh-delivery-label);

    font-size: 12px;

    font-weight: 500;

    line-height: 1;

    text-transform: uppercase;
  }


  .gh-sticky-delivery__wrap {
    position: relative;
  }


  .gh-sticky-delivery__select {
    width: 100%;
    height: 50px;

    margin: 0;

    padding: 0 45px 0 16px;

    border: 0;
    outline: 0;

    appearance: none;
    -webkit-appearance: none;

    background: var(--gh-delivery-bg);

    color: var(--gh-delivery-text);

    border-radius: 999px;

    font-family: inherit;

    font-size: 16px;

    font-weight: 700;

    cursor: pointer;
  }


  .gh-sticky-delivery__arrows {
    position: absolute;

    top: 50%;
    right: 16px;

    transform: translateY(-50%);

    display: flex;
    flex-direction: column;

    gap: 2px;

    color: rgba(255,255,255,.7);

    pointer-events: none;
  }


  /* ========================================================
     PRICE
     ======================================================== */

  .gh-sticky-atc__price-block {
    display: flex;

    flex-direction: column;

    justify-content: center;

    align-items: center;

    gap: 3px;

    white-space: nowrap;
  }


  .gh-sticky-atc__compare-price {
    color: var(--gh-compare-text);

    font-size: 14px;

    line-height: 1;

    text-decoration: line-through;
  }


  .gh-sticky-atc__price {
    color: var(--gh-price-text);

    font-size: 24px;

    font-weight: 800;

    line-height: 1;
  }


  /* ========================================================
     ADD TO CART
     ======================================================== */

  .gh-sticky-atc__btn {
    width: 100%;

    min-height: 76px;

    padding: 16px 30px;

    border: 0;

    border-radius: 7px;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: 10px;

    background: var(--gh-button-bg);

    color: var(--gh-button-text);

    font-family:
      var(--font-heading-family),
      Georgia,
      serif;

    font-size: clamp(24px, 1.7vw, 33px);

    font-weight: 600;

    cursor: pointer;

    transition:
      opacity 0.2s ease,
      transform 0.1s ease;
  }


  .gh-sticky-atc__btn:hover {
    opacity: 0.92;
  }


  .gh-sticky-atc__btn:active {
    transform: scale(0.99);
  }


  .gh-sticky-atc__btn[disabled] {
    opacity: 0.5;

    cursor: not-allowed;
  }


  .gh-sticky-atc__spinner {
    display: none;
  }


  .gh-sticky-atc__btn.is-loading .gh-sticky-atc__spinner {
    display: inline-flex;
  }


  .gh-sticky-atc__btn.is-loading .gh-sticky-atc__btn-text {
    opacity: 0.6;
  }


  .gh-sticky-atc__spinner svg {
    animation: ghStickySpin 0.8s linear infinite;
  }


  @keyframes ghStickySpin {

    to {
      transform: rotate(360deg);
    }

  }


  /* ========================================================
     SCROLL TO TOP
     ======================================================== */

  .gh-sticky-atc__scroll-btn {
    width: 70px;
    height: 70px;

    padding: 0;

    border: 0;

    border-radius: 50%;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    background: var(--gh-arrow-bg);

    color: var(--gh-arrow-text);

    cursor: pointer;

    transition:
      opacity 0.2s ease,
      transform 0.15s ease;
  }


  .gh-sticky-atc__scroll-btn:hover {
    opacity: 0.9;
  }


