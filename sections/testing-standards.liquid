      margin: 0 10px;
    }

    .methodology-cards__item {
      width: 100%;
    }
  }

  .methodology-cards-popup {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999;
  }

  .methodology-cards-popup.is-open {
