      height: inherit;
      margin: 0 10px;
    }

    .methodology-cards__item {
      width: 100%;
    }
    .methodology-cards__heading {
      padding: 0 40px;
    }
    .methodology-cards__progress-fill{
      display: block !important;
    }
    .methodology-cards__progress-track{
      display: block;
    }
  }

  .methodology-cards-popup {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999;
  }

  .methodology-cards-popup.is-open {
    display: flex;
  }

  .methodology-cards-popup__dialog {
    position: relative;
    max-width: min(960px, 90vw);
    max-height: 90vh;
    background: #ffffff00;
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.45);
