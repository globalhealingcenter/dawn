{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.75);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .new-standard-banner {
    position: relative;
    width: 100%;
    min-height: 550px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 60px 20px;
    color: #ffffff;
    background-image: url('{{ 'standard_bannerImageStandard.jpg' | asset_url }}');
    background-size: cover;
    background-position: 0 24%;
    overflow: hidden;
  }

  .new-standard-banner::before {
    content: "";
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.45);
    z-index: 1;
  }

  .new-standard-banner__content {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .new-standard-banner__title {
    font-size: clamp(2.5em, 5vw, 5.5em);
    margin-bottom: 0.5rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: #ffffff;
    line-height: clamp(0.9em, 2vw, 1.2em);
  }

  .new-standard-banner__subtitle {
    font-size: clamp(1em, 2vw, 2.5em);
    color: #ffffff;
    margin: 0;
  }

  @media screen and (max-width: 767px) {
    .new-standard-banner {
      min-height: 240px;
      padding: 40px 16px;
      background-position: center;
    }
  }

  .independent-company {
    background-color: #f7f0e5;
  }

  .independent-company__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .independent-company__content {
    flex: 1 1 55%;
  }

  .independent-company__eyebrow {
    font-size: clamp(2.3rem, 3vw, 4rem);
    line-height: 1.3;
    color: #174f33;
    margin-bottom: 0;
  }

  .independent-company__heading {
    font-size: clamp(2.2rem, 3vw, 4rem);
    line-height: 1.25;
    color: #174f33;
    margin: 0 0 1.5rem;
    font-weight: 400;
    width: 90%
  }

  .independent-company__heading em,
  .independent-company__eyebrow em {
    font-style: italic;
  }

  .independent-company__heading strong,
  .independent-company__eyebrow strong {
    font-weight: 700;
  }

  .independent-company__body {
    font-size: clamp(1.6rem, 1.4vw, 1.9rem);
    line-height: clamp(1.3em, 2.2vw, 1.3em);
    color: #2f3b34;
    margin: 0;
    font-weight: 300;
    width: 87%;
  }

  .independent-company__media {
    flex: 1 1 45%;
    display: flex;
    justify-content: center;
  }

  .independent-company__image-wrap {
    width: clamp(260px, 32vw, 100%);
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
  }

  .independent-company__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media screen and (max-width: 767px) {
    .independent-company__inner {
      padding: 56px 20px 48px;
      flex-direction: column;
      text-align: left;
    }

    .independent-company__content {
      order: 1;
    }

    .independent-company__media {
      order: 2;
    }

    .independent-company__image-wrap {
      width: clamp(220px, 70vw, 280px);
    }
  }

  .independent-company-detail {
    background-color: #f7f0e5;
  }

  .independent-company-detail__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 24px 80px;
    border-top: 1px solid #174f33;
  }

  .independent-company-detail__number {
    font-size: clamp(2.5em, 3vw, 4em);
    line-height: clamp(0.9em, 1.5vw, 1.3em);
    color: #174f33;
    font-style: italic;
    margin: 0 0 0.75rem;
  }

  .independent-company-detail__title {
    font-size: clamp(2.5em, 3vw, 4em);
    line-height: clamp(0.9em, 1.5vw, 1.3em);
    color: #174f33;
    margin: 0 0 1.25rem;
    font-weight: 500;
  }

  .independent-company-detail__subtitle {
    font-size: clamp(1.6rem, 1.4vw, 2.4rem);
    line-height: clamp(1.6em, 2.2vw, 2.4em);
    color: #616161;
    margin: 0;
    font-weight: 600;
  }

  .independent-company-detail__body {
    font-size: clamp(1.6rem, 1.4vw, 1.9rem);
    line-height: clamp(1.3em, 2.2vw, 1.3em);
    color: #2f3b34;
    margin: 0;
    font-weight: 300;
    margin-top: 1.5rem;
  }

  @media screen and (max-width: 767px) {
    .independent-company-detail__inner {
      padding: 32px 20px 56px;
      margin: 0 20px;
    }
  }

  .standards-cards {
    background: #0f3e2b url('{{ 'standard_flowerdp.svg' | asset_url }}') center center;
    padding: 0 0 80px;
  }

  .standards-cards__inner {
    max-width: 1200px;
    margin: 220px auto -220px;
    padding: 0 24px;
  }

  .standards-cards__slider {
    overflow: hidden;
    position: relative;
    top: -220px;
  }

  .standards-cards__track {
    display: flex;
  }

  .standards-cards__item {
    background-color: #f7f0e5;
    border-right: 1px solid #0f3e2b;
    height: 100%;
  }

  .standards-cards__media {
    width: 100%;
    height: 220px;
    overflow: hidden;
  }

  .standards-cards__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .standards-cards__content {
    padding: 24px 24px 28px;
  }

  .standards-cards__title {
    font-size: clamp(1.3em, 1.8vw, 1.8em);
    line-height: clamp(1.1em, 2vw, 1.4em);
    color: #174f33;
    margin: 0 0 0.75rem;
    font-weight: 600;
  }

  .standards-cards__text {
    font-size: clamp(1em, 1.4vw, 1.1em);
    line-height: clamp(1em, 2.2vw, 1.2em);
    color: #2f3b34;
    margin: 0;
    font-weight: 300;
  }

  @media screen and (max-width: 767px) {
    .standards-cards {
      padding: 0 0 0;
        background-size: 200%;
    }

    .standards-cards__inner {
      padding: 0;
    }

    .standards-cards__item {
      border-right: none;
      height: stretch;
    }
    .standards-cards__track {
      column-gap: 0;
    }

    .standards-cards__slider .slick-list {
      overflow: visible;
      padding: 0 12% 0 12%;
    }

    .standards-cards__slider .slick-track {
      display: flex;
    }

    .standards-cards__slider .slick-slide {
      height: inherit;
      margin: 0 10px;
    }


    .standards-cards__item {
      width: 100%;
    }
  }

  @media screen and (min-width: 768px) {
    /* Desktop: show three cards in a row, no sliding */
    .standards-cards__track {
      display: grid !important;
      grid-template-columns: repeat(3, 1fr);
      transform: none !important;
    }

    .standards-cards__item {
      width: auto !important;
      flex: 0 1 auto !important;
    }
  }

  .non-negotiables {
    color: #f7f0e5;
    padding: 72px 24px 80px;
  }

  .non-negotiables__inner {
    max-width: 980px;
    margin: 0 auto;
  }

  .non-negotiables__title {
    margin: 0 0 40px;
    text-align: center;
    color: #f7f0e5;
    font-size: clamp(2.8rem, 4.5vw, 4.6rem);
    line-height: clamp(1em, 1.2vw, 1.15em);
    font-weight: 400;
    font-style: normal;
  }

  .non-negotiables__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 48px;
    row-gap: 12px;
  }

  .non-negotiables__column {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .non-negotiables__item {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #f7f0e5;
    font-size: clamp(1.2rem, 2vw, 1.4em);
    line-height: clamp(1.2em, 1.6vw, 1.35em);
    font-weight: 600;
  }

  .non-negotiables__icon {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
    position: relative;
  }

  .non-negotiables__icon::before,
  .non-negotiables__icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 26px;
    height: 1.5px;
    background-color: #f7f0e5;
  }

  .non-negotiables__icon::before {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .non-negotiables__icon::after {
    transform: translate(-50%, -50%) rotate(-45deg);
  }
  .hidden-desktop {
    display: none;
  }
  .hidden-mobile {
    display: flex;
  }
  
  
  @media screen and (max-width: 767px) {
    .non-negotiables {
      padding: 38px 28px 42px;
    }
    
    .non-negotiables__title {
      margin-bottom: 22px;
      text-align: left;
      font-size: clamp(3rem, 4vw, 4em);
      line-height: 1.2;
    }

    .non-negotiables__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 22px;
      row-gap: 12px;
    }

    .non-negotiables__column {
      gap: 10px;
    }

    .non-negotiables__item {
      gap: 10px;
      font-size: 1.05em;
      line-height: 1.5;
    }

    .non-negotiables__icon {
      width: 14px;
      height: 14px;
    }

    .non-negotiables__icon::before,
    .non-negotiables__icon::after {
      width: 12px;
      height: 1px;
    }
    .hidden-desktop {
      display: flex;
    }
    .hidden-mobile {
      display: none;
    }
  }

  .quality-evidence {
    position: relative;
    background-image: linear-gradient(rgba(55, 72, 18, 0.42), rgba(55, 72, 18, 0.42)),
      url('{{ 'standard_Page_Evidence_of_Quality_Background.png' | asset_url }}');
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    color: #ffffff;
    min-height: 310px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 48px 24px;
  }

  .quality-evidence__inner {
    max-width: 930px;
    margin: 0 auto;
  }

  .quality-evidence__title {
    margin: 0 0 20px;
    color: #ffffff;
    font-size: clamp(2.2rem, 3.2vw, 3.4rem);
    line-height: clamp(1.05em, 1.4vw, 1.2em);
    font-weight: 400;
  }

  .quality-evidence__text {
    margin: 0 auto;
    max-width: 760px;
    color: #ffffff;
    font-size: clamp(1.6rem, 2vw, 2.2rem);
    line-height: clamp(1.3em, 1.8vw, 1.45em);
    font-weight: 300;
  }

  @media screen and (max-width: 767px) {
    .quality-evidence {
              min-height: 520px;
        padding: 56px 22px;
        background-position: 0% 0%;
        background: linear-gradient(rgba(55, 72, 18, 0.42), rgba(55, 72, 18, 0.42)), url('{{ 'standard_mobile_shutterstock_2182336037.jpg' | asset_url }}');
        background-size: cover;
        background-repeat: no-repeat;
    }

    .quality-evidence__inner {
      max-width: 100%;
    }

    .quality-evidence__title {
      margin-bottom: 22px;
      font-size: clamp(1.9em, 5vw, 3.2em);
      line-height: 1.15;
    }

    .quality-evidence__text {
      max-width: 100%;
      font-size: clamp(1.2em, 2vw, 2.2em);
      line-height: 1.35;
    }
  }

  .comprehensive-testing {
    position: relative;
    background-color: #fbfaf7;
    overflow: hidden;
    padding: 80px 24px 115px;
  }

  .comprehensive-testing__inner {
    max-width: 1330px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .comprehensive-testing__content {
    max-width: 66%;
    padding: 0 0 0 89px;
  }

  .comprehensive-testing__number {
    margin: 0 0 0.75rem;
    font-size: clamp(2.5em, 3vw, 4em);
    line-height: clamp(0.9em, 1.5vw, 1.3em);
    color: #174f33;
    font-style: italic;
  }

  .comprehensive-testing__title {
    margin: 0 0 1rem;
    font-size: clamp(2.5em, 3vw, 4em);
    line-height: clamp(0.9em, 1.5vw, 1.3em);
    color: #174f33;
    font-weight: 500;
  }

  .comprehensive-testing__subtitle {
    margin: 0 0 1.25rem;
    font-size: clamp(2rem, 1.4vw, 2.4rem);
    line-height: clamp(1.3em, 2.2vw, 2.4em);
    color: #616161;
    font-weight: 600;
  }

  .comprehensive-testing__body {
    max-width: 760px;
    margin: 0;
    font-size: clamp(1.6rem, 1.4vw, 1.9rem);
    line-height: clamp(1.3em, 2.2vw, 1.3em);
    color: #2f3b34;
    font-weight: 300;
  }

  .comprehensive-testing__stats {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    max-width: 940px;
    margin-top: 34px;
    background-color: #f2f2f0;
    padding: 28px 34px;
  }

  .comprehensive-testing__stat {
    text-align: center;
    padding: 0 18px;
  }

  .comprehensive-testing__stat-value {
    margin: 0;
    color: #575757;
    font-size: clamp(1.8rem, 2vw, 1.8em);
    line-height: 1.15;
    font-weight: 700;
  }

  .comprehensive-testing__stat-label {
    margin: 0.25rem 0 0;
    color: #6a6a6a;
    font-size: clamp(1.1em, 2vw, 1.5em);
    line-height: 1.25;
    font-weight: 400;
  }

  .comprehensive-testing__stat-note {
    display: block;
    margin-top: 0.25rem;
    font-size: clamp(0.7em, 1vw, 1.15em);
    line-height: 1.2;
    color: #8b8b8b;
  }

  .comprehensive-testing__image-wrap {
    position: absolute;
    right: 4%;
    bottom: -96px;
    width: min(36vw, 430px);
    z-index: 1;
    pointer-events: none;
    z-index: 2;
  }

  .comprehensive-testing__image {
    width: 100%;
    height: auto;
    display: block;
  }

  @media screen and (max-width: 767px) {
    .comprehensive-testing {
      padding: 36px 0px 0;
    }

    .comprehensive-testing__content {
      max-width: 100%;
      padding: 0 40px;
    }

    .comprehensive-testing__number {
      margin-bottom: 0.5rem;
    }

    .comprehensive-testing__title {
      margin-bottom: 0.75rem;
    }

    .comprehensive-testing__body {
      max-width: 100%;
      line-height: 1.35;
    }

    .comprehensive-testing__stats {
      grid-template-columns: 1fr;
      max-width: 100%;
      margin-top: 24px;
      padding: 30px 40px;
      row-gap: 18px;
    }

    .comprehensive-testing__stat {
      text-align: left;
      padding: 0;
    } 


    .comprehensive-testing__image-wrap {
      right: -100px;
      bottom: 29px;
      width: 42%;
      min-width: 150px;
      transform: rotate(-31deg);
  }
  }

  /* Static Reviews Carousel - infinite touch swipe, transform-based */

.src.static-reviews-carousel {
  position: relative;
  padding: 7rem 2.4rem 7.5rem;
  background:
    linear-gradient(rgba(17, 25, 12, 0.42), rgba(17, 25, 12, 0.42)),
    url('{{ 'standard_shutterstock_643406503.jpg' | asset_url }}') center center / cover no-repeat;
}

.src__inner {
  max-width: 1330px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 3rem;
}

/* Heading */
.src__heading {
  font-size: clamp(2.8rem, 3.4vw, 4.3rem);
  line-height: 1.1;
  color: #f4efe5;
  margin: 0 0 0 6rem;
  font-weight: 400;
}

/* Carousel wrapper - clips overflow */
.src__carousel-outer {
  width: 100%;
  overflow: hidden;
}

/* Track - positioned via JS transform, no native scroll */
.src__track {
  display: flex;
  gap: 2.4rem;
  will-change: transform;
  cursor: grab;
  touch-action: pan-y;
  -webkit-user-select: none;
  user-select: none;
}

.src__track.is-dragging {
  cursor: grabbing;
}

.src__card {
  flex: 0 0 calc((100% - 2 * 2.4rem) / 3);
    min-width: calc((100% - 2 * 2.4rem) / 3);
    background: rgb(0 0 0 / 36%);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    padding: 35px;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
}

.src__stars {
  width: 100%;
  height: 2px;
  background: #b99334;
  margin: 0 0 0.3rem;
}

.src__stars svg,
.src__star {
  display: none;
}

.src__product,
.src__product a {
  font-size: clamp(1.55em, 1.5vw, 2.45em);
  line-height: 1.2;
  font-weight: 700;
  color: #F9F2E8;
  margin: 0;
  text-align: left;
  text-decoration: none;
  border-bottom: 1px solid #ffac00;
  padding-bottom: 10px;
}

.src__text {
  font-size: clamp(1em, 0.86vw, 1.75em);
    line-height: clamp(1.15em, 1vw, 1.6em);
    color: #F9F2E8;
    margin: 0 0 15px;
    text-align: left;
    font-weight: 300;
    opacity: 0.96;
}

.src__meta {
  font-size: clamp(1em, 0.86vw, 1.75em);
    line-height: clamp(1.15em, 1vw, 1.6em);
    color: #f9f2e8;
    margin: 0;
    text-align: left;
    font-weight: 400;
    opacity: 0.96;
}

.src__meta strong {
  display: block;
  margin-bottom: 0.4rem;
  font-weight: 700;
}

.src__meta ul {
  margin: 0;
    padding-left: 22px;
    /* list-style: none; */
    line-height: 1.4;
    font-weight: 300;
}

.src__meta li {
  margin: 0;
}

.src__progress {
  display: block;
  margin-top: 1.8rem;
}

.src__progress-track {
  width: 100%;
  height: 4px;
  background: rgba(249, 242, 232, 0.28);
  border-radius: 999px;
  overflow: hidden;
  width: 40%;
  margin: 60px auto 0;
}

.src__progress-fill {
  width: 0;
  height: 100%;
  background: #ffffffc4;
  border-radius: inherit;
  transition: width 300ms ease;
  display: block;
}

.hide-on-mobile {
  display: none;
}

.hide-on-desktop {
  display: none;
}

@media (max-width: 767px) {
  .src.static-reviews-carousel {
    padding: 3.5rem 0 4rem;
    background-position: 56% center;
  }

  .src__inner {
    gap: 2rem;
  }

  .src__card {
    flex: 0 0 calc((100% - 1.6rem) / 1.12);
    min-width: calc((100% - 1.6rem) / 1.12);
    gap: 0.75rem;
  }

  .src__track {
    gap: 1.6rem;
  }


  .src__heading {
    margin: 0 2rem;
    font-size: clamp(2.1rem, 7vw, 2.8rem);
    line-height: 1.1;
  }

}
{%- endstyle -%}

{% comment %} Hero Banner Section {% endcomment %}
<section class="new-standard-banner section-{{ section.id }}-padding">
  <div class="new-standard-banner__content">
    <h1 class="new-standard-banner__title font-miller">
      A New Standard
    </h1>
    <p class="new-standard-banner__subtitle font-proxima">
      Meticulous Craftsmanship Meets Health First
    </p>
  </div>
</section>

{% comment %} Independent Company Section {% endcomment %}
<section class="independent-company">
  <div class="independent-company__inner">
    <div class="independent-company__content">
      <p class="independent-company__eyebrow font-proxima">
        The industry standard is too low.<sup>1</sup>
      </p>
      <h2 class="independent-company__heading font-proxima">
        As an <strong>independent company</strong>, we hold safety and quality to a <em>higher standard of trust.</em>
      </h2>
      <p class="independent-company__body font-proxima">
        Most supplement companies are owned, at least in part, by an outside investment firm, corporation, or conglomerate
        that monitors and controls spending to ensure maximum profitability. Global Healing has been completely independent
        from day one. That independence gives us the freedom to craft differently. To move deliberately instead of quickly.
        To reject any batch that falls short, even at a loss. To test rigorously and manufacture in-house with care and
        precision. Because we answer to no outside funding, health takes precedence over profit.
      </p>
    </div>
    <div class="independent-company__media">
      <div class="independent-company__image-wrap">
        <img
          class="independent-company__image"
          src="{{ 'standard_dropbottle.jpg' | asset_url }}"
          alt="Supplement bottle with dropper"
          width="900"
          height="900"
        >
      </div>
    </div>
  </div>
</section>

{% comment %} Direct-Sourced Ingredients Section {% endcomment %}
<section class="independent-company-detail">
  <div class="independent-company-detail__inner">
    <p class="independent-company-detail__number font-miller">
      01.
    </p>
    <h3 class="independent-company-detail__title font-proxima">
      Direct-Sourced Ingredients
    </h3>
    <p class="independent-company-detail__subtitle font-proxima">
      We don’t shop by price. We shop by quality.
    </p>
    <p class="independent-company-detail__body font-proxima">
      We search the world for the best, no matter the cost. We work directly with several farms and take every opportunity
      to walk the grounds in person. If we are unable to source an ingredient that meets our standards, we will reformulate
      or pause production for that product. No exceptions.
    </p>
  </div>
</section>

{% comment %} Standards Cards Section {% endcomment %}
<section class="standards-cards">
