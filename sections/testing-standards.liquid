{% comment %} Evidence of Quality Section {% endcomment %}
<section
  class="quality-evidence"
  style="    background-image: url('{{ 'standard_Page_Evidence_of_Quality_Background.png' | asset_url }}');"
>
  <div class="quality-evidence__inner">
    <h2 class="quality-evidence__title gh-font-secondary">Evidence of Quality</h2>
    <p class="quality-evidence__text h3">
      Slight variations in taste, color, aroma, and texture from batch to batch are a sign that you’re getting a 100%
