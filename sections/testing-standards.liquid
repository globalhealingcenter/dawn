{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.75);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  :root {
    --quality-evidence-mobile-bg: url('{{ 'standard_mobile_shutterstock_2182336037.jpg' | asset_url }}');
  }
{%- endstyle -%}

{{ 'testing-standards.css' | asset_url | stylesheet_tag }}
{{ 'slick.css' | asset_url | stylesheet_tag }}

{% comment %} Hero Banner Section {% endcomment %}
<section
  class="new-standard-banner section-{{ section.id }}-padding"
  style="background: url({{ ' banner-new-standard.jpg' | asset_url }});"
>
  <div class="new-standard-banner__content">
    <h1 class="new-standard-banner__title gh-font-primary">A New Standard</h1>
    <p class="new-standard-banner__subtitle gh-font-secondary">
      Meticulous Craftsmanship <br>
      Meets Health First
    </p>
  </div>
</section>

{% comment %} Independent Company Section {% endcomment %}
<section class="independent-company">
  <div class="independent-company__inner">
    <div class="independent-company__content">
      <h2 class="independent-company__eyebrow gh-font-secondary">
        The industry standard is too low.<sup>1</sup> As an <strong>independent company</strong>, we hold safety and
        quality to a
        <em class="gh-font-primary">higher standard of trust.</em>
      </h2>
      <p class="independent-company__body gh-font-secondary">
        Most supplement companies are owned, at least in part, by an outside investment firm, corporation, or
        conglomerate that monitors and controls spending to ensure maximum profitability. Global Healing has been
        completely independent from day one. That independence gives us the freedom to craft differently. To move
        deliberately instead of quickly. To reject any batch that falls short, even at a loss. To test rigorously and
        manufacture in-house with care and precision. Because we answer to no outside funding, health takes precedence
        over profit.
      </p>
    </div>
    <div class="independent-company__media">
      <div class="independent-company__image-wrap">
        <img
          class="independent-company__image"
          src="{{ 'standard_dropbottle.jpg' | asset_url }}"
          alt="Supplement bottle with dropper"
          width="900"
          height="900"
        >
      </div>
    </div>
  </div>
</section>

{% comment %} Direct-Sourced Ingredients Section {% endcomment %}
<section class="independent-company-detail">
  <div class="independent-company-detail__inner">
    <p class="independent-company-detail__number gh-font-primary h1">01.</p>
    <h3 class="independent-company-detail__title h1 gh-font-secondary">Direct-Sourced Ingredients</h3>
    <h3 class="independent-company-detail__subtitle">We don’t shop by price. We shop by quality.</h3>
    <p class="independent-company-detail__body gh-font-secondary">
      We search the world for the best, no matter the cost. We work directly with several farms and take every
      opportunity to walk the grounds in person. If we are unable to source an ingredient that meets our standards, we
      will reformulate or pause production for that product. No exceptions.
    </p>
  </div>
</section>

