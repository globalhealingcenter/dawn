{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.75);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .new-standard-banner {
    position: relative;
    width: 100%;
    min-height: 550px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 60px 20px;
    color: #ffffff;
    background-image: url('{{ 'standard_bannerImageStandard.jpg' | asset_url }}');
    background-size: cover;
    background-position: 0 24%;
    overflow: hidden;
  }

  .new-standard-banner::before {
    content: "";
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.45);
    z-index: 1;
  }

  .new-standard-banner__content {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .new-standard-banner__title {
    font-size: clamp(2.5em, 5vw, 5.5em);
    margin-bottom: 0.5rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: #ffffff;
    line-height: clamp(0.9em, 2vw, 1.2em);
  }

  .new-standard-banner__subtitle {
    font-size: clamp(1em, 2vw, 2.5em);
    color: #ffffff;
    margin: 0;
  }

  @media screen and (max-width: 767px) {
    .new-standard-banner {
      min-height: 240px;
      padding: 40px 16px;
      background-position: center;
    }
  }

  .independent-company {
    background-color: #f7f0e5;
  }

  .independent-company__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .independent-company__content {
    flex: 1 1 55%;
  }

  .independent-company__eyebrow {
    font-size: clamp(2.3rem, 3vw, 4rem);
    line-height: 1.3;
    color: #174f33;
    margin-bottom: 0;
  }

  .independent-company__heading {
    font-size: clamp(2.2rem, 3vw, 4rem);
    line-height: 1.25;
    color: #174f33;
    margin: 0 0 1.5rem;
    font-weight: 400;
    width: 90%
  }

  .independent-company__heading em,
  .independent-company__eyebrow em {
    font-style: italic;
  }

  .independent-company__heading strong,
  .independent-company__eyebrow strong {
    font-weight: 700;
  }

  .independent-company__body {
    font-size: clamp(1.6rem, 1.4vw, 1.9rem);
    line-height: clamp(1.3em, 2.2vw, 1.3em);
    color: #2f3b34;
    margin: 0;
    font-weight: 300;
    width: 87%;
  }

  .independent-company__media {
    flex: 1 1 45%;
    display: flex;
    justify-content: center;
  }

  .independent-company__image-wrap {
    width: clamp(260px, 32vw, 100%);
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
  }

  .independent-company__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media screen and (max-width: 767px) {
    .independent-company__inner {
      padding: 56px 20px 48px;
      flex-direction: column;
      text-align: left;
    }

    .independent-company__content {
      order: 1;
    }

    .independent-company__media {
      order: 2;
    }

    .independent-company__image-wrap {
      width: clamp(220px, 70vw, 280px);
    }
  }

  .independent-company-detail {
    background-color: #f7f0e5;
  }

  .independent-company-detail__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 24px 80px;
    border-top: 1px solid #174f33;
  }

  .independent-company-detail__number {
    font-size: clamp(2.5em, 3vw, 4em);
    line-height: clamp(0.9em, 1.5vw, 1.3em);
    color: #174f33;
    font-style: italic;
    margin: 0 0 0.75rem;
  }

  .independent-company-detail__title {
    font-size: clamp(2.5em, 3vw, 4em);
    line-height: clamp(0.9em, 1.5vw, 1.3em);
    color: #174f33;
    margin: 0 0 1.25rem;
    font-weight: 500;
  }

  .independent-company-detail__subtitle {
    font-size: clamp(1.6rem, 1.4vw, 2.4rem);
    line-height: clamp(1.6em, 2.2vw, 2.4em);
    color: #616161;
    margin: 0;
    font-weight: 600;
  }

  .independent-company-detail__body {
    font-size: clamp(1.6rem, 1.4vw, 1.9rem);
    line-height: clamp(1.3em, 2.2vw, 1.3em);
    color: #2f3b34;
    margin: 0;
    font-weight: 300;
    margin-top: 1.5rem;
  }

  @media screen and (max-width: 767px) {
    .independent-company-detail__inner {
      padding: 32px 20px 56px;
      margin: 0 20px;
    }
  }

  .standards-cards {
    background-color: #0f3e2b;
    padding: 0 0 80px;
  }

  .standards-cards__inner {
    max-width: 1200px;
    margin: 220px auto 0;
    padding: 0 24px;
  }

  .standards-cards__slider {
    overflow: hidden;
    position: relative;
    top: -220px;
  }

  .standards-cards__track {
    display: flex;
  }

  .standards-cards__item {
    background-color: #f7f0e5;
    border-right: 1px solid #0f3e2b;
    height: 100%;
  }

  .standards-cards__media {
    width: 100%;
    height: 220px;
    overflow: hidden;
  }

  .standards-cards__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .standards-cards__content {
    padding: 24px 24px 28px;
  }

  .standards-cards__title {
    font-size: clamp(1.3em, 1.8vw, 1.8em);
    line-height: clamp(1.1em, 2vw, 1.4em);
    color: #174f33;
    margin: 0 0 0.75rem;
    font-weight: 600;
  }

  .standards-cards__text {
    font-size: clamp(1em, 1.4vw, 1.1em);
    line-height: clamp(1em, 2.2vw, 1.2em);
    color: #2f3b34;
    margin: 0;
    font-weight: 300;
  }

  @media screen and (max-width: 767px) {
    .standards-cards {
      padding: 0 0 56px;
    }

    .standards-cards__inner {
      padding: 0;
    }

    .standards-cards__item {
      border-right: none;
      height: stretch;
    }
    .standards-cards__track {
      column-gap: 0;
    }

    .standards-cards__slider .slick-list {
      overflow: visible;
      padding: 0 12% 0 12%;
    }

    .standards-cards__slider .slick-track {
      display: flex;
    }

    .standards-cards__slider .slick-slide {
      height: inherit;
      margin: 0 10px;
    }

    .standards-cards__slider .slick-slide > div {
      height: 100%;
    }

    .standards-cards__item {
      width: 100%;
    }
  }

  @media screen and (min-width: 768px) {
    /* Desktop: show three cards in a row, no sliding */
    .standards-cards__track {
      display: grid !important;
      grid-template-columns: repeat(3, 1fr);
      transform: none !important;
    }

    .standards-cards__item {
      width: auto !important;
      flex: 0 1 auto !important;
    }
  }
{%- endstyle -%}

<section class="new-standard-banner section-{{ section.id }}-padding">
  <div class="new-standard-banner__content">
    <h1 class="new-standard-banner__title font-miller">
      A New Standard
    </h1>
    <p class="new-standard-banner__subtitle font-proxima">
      Meticulous Craftsmanship Meets Health First
    </p>
  </div>
</section>

<section class="independent-company">
  <div class="independent-company__inner">
    <div class="independent-company__content">
      <p class="independent-company__eyebrow font-proxima">
        The industry standard is too low.<sup>1</sup>
      </p>
      <h2 class="independent-company__heading font-proxima">
        As an <strong>independent company</strong>, we hold safety and quality to a <em>higher standard of trust.</em>
      </h2>
      <p class="independent-company__body font-proxima">
        Most supplement companies are owned, at least in part, by an outside investment firm, corporation, or conglomerate
        that monitors and controls spending to ensure maximum profitability. Global Healing has been completely independent
        from day one. That independence gives us the freedom to craft differently. To move deliberately instead of quickly.
        To reject any batch that falls short, even at a loss. To test rigorously and manufacture in-house with care and
        precision. Because we answer to no outside funding, health takes precedence over profit.
      </p>
    </div>
    <div class="independent-company__media">
      <div class="independent-company__image-wrap">
        <img
          class="independent-company__image"
          src="{{ 'standard_dropbottle.jpg' | asset_url }}"
          alt="Supplement bottle with dropper"
        >
      </div>
    </div>
  </div>
</section>

<section class="independent-company-detail">
  <div class="independent-company-detail__inner">
    <p class="independent-company-detail__number font-miller">
      01.
    </p>
    <h3 class="independent-company-detail__title font-proxima">
      Direct-Sourced Ingredients
    </h3>
    <p class="independent-company-detail__subtitle font-proxima">
      We don’t shop by price. We shop by quality.
    </p>
    <p class="independent-company-detail__body font-proxima">
      We search the world for the best, no matter the cost. We work directly with several farms and take every opportunity
      to walk the grounds in person. If we are unable to source an ingredient that meets our standards, we will reformulate
      or pause production for that product. No exceptions.
    </p>
  </div>
</section>

<section class="standards-cards">
  <div class="standards-cards__inner">
    <div class="standards-cards__slider">
      <div class="standards-cards__track">
        <article class="standards-cards__item">
        <div class="standards-cards__media">
          <img
            class="standards-cards__image"
            src="{{ 'standard_Vermont_ZackWoodsHerbFarm_273.jpg' | asset_url }}"
            alt="Vetted suppliers"
          >
        </div>
        <div class="standards-cards__content">
          <h3 class="standards-cards__title font-proxima">
            Vetted Suppliers
          </h3>
          <p class="standards-cards__text font-proxima">
            We begin with a strict vendor qualification process, only choosing those that meet our requirements for
            sustainable growing and ethical working conditions.
          </p>
        </div>
        </article>

        <article class="standards-cards__item">
        <div class="standards-cards__media">
          <img
            src="{{ 'standard_shutterstock_2431328193.jpg' | asset_url }}"
            class="standards-cards__image"
            alt="Traceable ingredients"
          >
          </div>
          <div class="standards-cards__content">
            <h3 class="standards-cards__title font-proxima">
              Traceable Ingredients
            </h3>
            <p class="standards-cards__text font-proxima">
              We can tell you where every single ingredient came from, how it was grown and harvested, what it was tested
              for, and why it’s included in a supplement.
          </p>
        </div>
      </article>
      
      <article class="standards-cards__item">
        <div class="standards-cards__media">
          <img
            class="standards-cards__image"
            src="{{ 'standard_shutterstock_2478143647.jpg' | asset_url }}"
            alt="Verified quality"
          >
        </div>
        <div class="standards-cards__content">
          <h3 class="standards-cards__title font-proxima">
            Verified Quality
          </h3>
          <p class="standards-cards__text font-proxima">
            Our in-house lab holds a library of herbs that we have verified for identity and purity. We test against these
            standards to rule out any misidentifications or adulterants.
          </p>
        </div>
        </article>
      </div>
    </div>
  </div>
</section>
{%- comment -%}
<script src="{{ 'standard_custom.js' | asset_url }}" defer="defer"></script>
{%- endcomment -%}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css">
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof window.jQuery === 'undefined') return;

    var $ = window.jQuery;
    var $track = $('.standards-cards__track');
    if (!$track.length) return;

    function initSlick() {
      if (window.innerWidth > 767 || $track.hasClass('slick-initialized')) return;

      $track.slick({
        infinite: true,
        arrows: false,
        dots: false,
        slidesToShow: 1,
        slidesToScroll: 1,
        centerMode: true,
        centerPadding: '12%',
        variableWidth: false,
        speed: 450,
        draggable: true,
        swipe: true,
        touchMove: true,
      });
    }

    function destroySlick() {
      if (window.innerWidth > 767 && $track.hasClass('slick-initialized')) {
        $track.slick('unslick');
      }
    }

    initSlick();

    window.addEventListener('resize', function () {
      destroySlick();
      initSlick();
    });
  });
</script>
{% schema %}
{
  "name": "Testing Standards",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "Testing Standards",
      "category": "Custom"
    }
  ]
}
{% endschema %}
