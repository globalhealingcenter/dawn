    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .methodology-cards-popup__close:hover,
  .methodology-cards-popup__close:focus-visible {
    background: rgba(0, 0, 0, 0.8);
  }
</style>

<section class="methodology-cards">
  <div class="methodology-cards__inner">
    <h2 class="methodology-cards__heading font-proxima">
      Our Methodology
    </h2>

    <div class="methodology-cards__slider">
      <div class="methodology-cards__track">
        <article class="methodology-cards__item">
          <div class="methodology-cards__media">
            <img
              class="methodology-cards__image"
              src="{{ 'standard_methodology_ftir.jpg' | asset_url }}"
              alt="FTIR Spectroscopy"
              width="800"
              height="440"
            >
          </div>
          <div class="methodology-cards__content">
            <h3 class="methodology-cards__title font-proxima">
              FTIR Spectroscopy
            </h3>
            <p class="methodology-cards__text font-proxima">
              Using an infrared light, we scan an ingredient’s unique “fingerprint” to confirm a raw ingredient is what it’s
              supposed to be.
            </p>
          </div>
        </article>

        <article class="methodology-cards__item">
          <div class="methodology-cards__media">
            <img
              class="methodology-cards__image"
              src "{{ 'standard_methodology_hptlc.jpg' | asset_url }}"
              alt="HPTLC"
              width="800"
              height="440"
            >
          </div>
          <div class="methodology-cards__content">
            <h3 class="methodology-cards__title font-proxima">
              HPTLC
            </h3>
            <p class="methodology-cards__text font-proxima">
              We separate a plant’s compounds and compare them to a pre‑verified reference, allowing us to rule out
              adulterants or fillers.
            </p>
          </div>
        </article>

        <article class="methodology-cards__item">
          <div class="methodology-cards__media">
            <img
              class="methodology-cards__image"
              src="{{ 'standard_methodology_microscopy.jpg' | asset_url }}"
              alt="Microscopy"
              width="800"
              height="440"
            >
          </div>
          <div class="methodology-cards__content">
            <h3 class="methodology-cards__title font-proxima">
              Microscopy
            </h3>
            <p class="methodology-cards__text font-proxima">
              Using a microscope, we verify characteristics that cannot be identified by chemical analysis, such as cellular
              structure.
            </p>
          </div>
        </article>
      </div>
    </div>

    <div class="methodology-cards__cta">
      <button type="button" class="methodology-cards__popup-trigger font-proxima">
        See the Complete Testing Process
      </button>
    </div>
  </div>
</section>

<div class="methodology-cards-popup" aria-hidden="true">
  <div class="methodology-cards-popup__dialog" role="dialog" aria-modal="true" aria-label="Complete testing process">
    <button type="button" class="methodology-cards-popup__close" aria-label="Close">
      &times;
    </button>
    <img
      class="methodology-cards-popup__image"
      src="{{ 'standard_complete_testing_process.png' | asset_url }}"
      alt="Diagram showing the complete testing process"
      width="960"
      height="540"
    >
  </div>
</div>

