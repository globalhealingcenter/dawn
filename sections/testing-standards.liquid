{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.75);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .new-standard-banner {
    position: relative;
    width: 100%;
    min-height: 550px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 60px 20px;
    color: #ffffff;
    background-image: url('{{ 'standard_bannerImageStandard.jpg' | asset_url }}');
    background-size: cover;
    background-position: 0 24%;
    overflow: hidden;
  }

  .new-standard-banner::before {
    content: "";
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.45);
    z-index: 1;
  }

  .new-standard-banner__content {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .new-standard-banner__title {
    font-size: clamp(2.5em, 5vw, 5.5em);
    margin-bottom: 0.5rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: #ffffff;
    line-height: clamp(0.9em, 2vw, 1.2em);
  }

  .new-standard-banner__subtitle {
    font-size: clamp(1em, 2vw, 2.5em);
    color: #ffffff;
    margin: 0;
  }

  @media screen and (max-width: 767px) {
    .new-standard-banner {
      min-height: 240px;
      padding: 40px 16px;
      background-position: center;
    }
  }

  .independent-company {
    background-color: #f7f0e5;
  }

  .independent-company__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .independent-company__content {
    flex: 1 1 55%;
  }

  .independent-company__eyebrow {
    font-size: clamp(2.3rem, 3vw, 4rem);
    line-height: 1.3;
    color: #174f33;
    margin-bottom: 0;
  }

  .independent-company__heading {
    font-size: clamp(2.2rem, 3vw, 4rem);
    line-height: 1.25;
    color: #174f33;
    margin: 0 0 1.5rem;
    font-weight: 400;
    width: 90%
  }

  .independent-company__heading em,
  .independent-company__eyebrow em {
    font-style: italic;
  }

  .independent-company__heading strong,
  .independent-company__eyebrow strong {
    font-weight: 700;
  }

  .independent-company__body {
    font-size: clamp(1.6rem, 1.4vw, 1.9rem);
    line-height: clamp(1.3em, 2.2vw, 1.3em);
    color: #2f3b34;
    margin: 0;
    font-weight: 300;
    width: 87%;
  }

  .independent-company__media {
    flex: 1 1 45%;
    display: flex;
    justify-content: center;
  }

  .independent-company__image-wrap {
    width: clamp(260px, 32vw, 100%);
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
  }

  .independent-company__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media screen and (max-width: 767px) {
    .independent-company__inner {
      padding: 56px 20px 48px;
      flex-direction: column;
      text-align: left;
    }

    .independent-company__content {
      order: 1;
    }

    .independent-company__media {
      order: 2;
    }

    .independent-company__image-wrap {
      width: clamp(220px, 70vw, 280px);
    }
  }

  .independent-company-detail {
    background-color: #f7f0e5;
  }

  .independent-company-detail__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 24px 80px;
    border-top: 1px solid #174f33;
  }

  .independent-company-detail__number {
    font-size: clamp(2.5em, 3vw, 4em);
    line-height: clamp(0.9em, 1.5vw, 1.3em);
    color: #174f33;
    font-style: italic;
    margin: 0 0 0.75rem;
  }

  .independent-company-detail__title {
    font-size: clamp(2.5em, 3vw, 4em);
    line-height: clamp(0.9em, 1.5vw, 1.3em);
    color: #174f33;
    margin: 0 0 1.25rem;
    font-weight: 500;
  }

  .independent-company-detail__subtitle {
    font-size: clamp(1.6rem, 1.4vw, 2.4rem);
    line-height: clamp(1.6em, 2.2vw, 2.4em);
    color: #616161;
    margin: 0;
    font-weight: 600;
  }

  .independent-company-detail__body {
    font-size: clamp(1.6rem, 1.4vw, 1.9rem);
    line-height: clamp(1.3em, 2.2vw, 1.3em);
    color: #2f3b34;
    margin: 0;
    font-weight: 300;
    margin-top: 1.5rem;
  }

  @media screen and (max-width: 767px) {
    .independent-company-detail__inner {
      padding: 32px 20px 56px;
      margin: 0 20px;
    }
  }

  .standards-cards {
    background: #0f3e2b url('{{ 'standard_flowerdp.svg' | asset_url }}') center center;
    padding: 0 0 80px;
  }

  .standards-cards__inner {
    max-width: 1200px;
    margin: 220px auto -220px;
    padding: 0 24px;
  }

  .standards-cards__slider {
    overflow: hidden;
    position: relative;
    top: -220px;
  }

  .standards-cards__track {
    display: flex;
  }

  .standards-cards__item {
    background-color: #f7f0e5;
    border-right: 1px solid #0f3e2b;
    height: 100%;
  }

  .standards-cards__media {
    width: 100%;
    height: 220px;
    overflow: hidden;
  }

  .standards-cards__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .standards-cards__content {
    padding: 24px 24px 28px;
  }

  .standards-cards__title {
    font-size: clamp(1.3em, 1.8vw, 1.8em);
    line-height: clamp(1.1em, 2vw, 1.4em);
    color: #174f33;
    margin: 0 0 0.75rem;
    font-weight: 600;
  }

  .standards-cards__text {
    font-size: clamp(1em, 1.4vw, 1.1em);
    line-height: clamp(1em, 2.2vw, 1.2em);
    color: #2f3b34;
    margin: 0;
    font-weight: 300;
  }

  @media screen and (max-width: 767px) {
    .standards-cards {
      padding: 0 0 0;
        background-size: 200%;
    }

    .standards-cards__inner {
      padding: 0;
    }

    .standards-cards__item {
      border-right: none;
      height: stretch;
    }
    .standards-cards__track {
      column-gap: 0;
    }

    .standards-cards__slider .slick-list {
      overflow: visible;
      padding: 0 12% 0 12%;
    }

    .standards-cards__slider .slick-track {
      display: flex;
    }

    .standards-cards__slider .slick-slide {
      height: inherit;
      margin: 0 10px;
    }


    .standards-cards__item {
      width: 100%;
    }
  }

  @media screen and (min-width: 768px) {
    /* Desktop: show three cards in a row, no sliding */
    .standards-cards__track {
      display: grid !important;
      grid-template-columns: repeat(3, 1fr);
      transform: none !important;
    }

    .standards-cards__item {
      width: auto !important;
      flex: 0 1 auto !important;
    }
  }

  .non-negotiables {
    color: #f7f0e5;
    padding: 72px 24px 80px;
  }

  .non-negotiables__inner {
    max-width: 980px;
    margin: 0 auto;
  }

  .non-negotiables__title {
    margin: 0 0 40px;
    text-align: center;
    color: #f7f0e5;
    font-size: clamp(2.8rem, 4.5vw, 4.6rem);
    line-height: clamp(1em, 1.2vw, 1.15em);
    font-weight: 400;
    font-style: normal;
  }

  .non-negotiables__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 48px;
    row-gap: 12px;
  }

  .non-negotiables__column {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .non-negotiables__item {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #f7f0e5;
    font-size: clamp(1.2rem, 2vw, 1.4em);
    line-height: clamp(1.2em, 1.6vw, 1.35em);
    font-weight: 600;
  }

  .non-negotiables__icon {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
    position: relative;
  }

  .non-negotiables__icon::before,
  .non-negotiables__icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 26px;
    height: 1.5px;
    background-color: #f7f0e5;
  }

  .non-negotiables__icon::before {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .non-negotiables__icon::after {
    transform: translate(-50%, -50%) rotate(-45deg);
  }
  .hidden-desktop {
    display: none;
  }
  .hidden-mobile {
    display: flex;
  }
  
  
  @media screen and (max-width: 767px) {
    .non-negotiables {
      padding: 38px 28px 42px;
    }
    
    .non-negotiables__title {
      margin-bottom: 22px;
      text-align: left;
      font-size: clamp(3rem, 4vw, 4em);
      line-height: 1.2;
    }

    .non-negotiables__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 22px;
      row-gap: 12px;
    }

    .non-negotiables__column {
      gap: 10px;
    }

    .non-negotiables__item {
      gap: 10px;
      font-size: 1.05em;
      line-height: 1.5;
    }

    .non-negotiables__icon {
      width: 14px;
      height: 14px;
    }

    .non-negotiables__icon::before,
    .non-negotiables__icon::after {
      width: 12px;
      height: 1px;
    }
    .hidden-desktop {
      display: flex;
    }
    .hidden-mobile {
      display: none;
    }
  }

