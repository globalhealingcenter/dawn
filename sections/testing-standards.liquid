    max-width: min(960px, 90vw);
    max-height: 90vh;
    background: #ffffff;
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.45);
    border-radius: 4px;
    overflow: hidden;
  }

  .methodology-cards-popup__image {
    display: block;
    width: 100%;
