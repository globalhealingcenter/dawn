{% comment %} Comprehensive Testing Section {% endcomment %}
<section class="comprehensive-testing">
  <div class="comprehensive-testing__inner">
    <div class="comprehensive-testing__content">
      <p class="comprehensive-testing__number font-miller">02.</p>
      <h2 class="comprehensive-testing__title font-proxima">
        Comprehensive Testing
      </h2>
      <p class="comprehensive-testing__subtitle font-proxima">
        We check everyone’s work so that you can trust ours.
      </p>
      <p class="comprehensive-testing__body font-proxima">
        Every shipment of ingredients includes a Certificate of Analysis (COA) that shows the vendor tested for identity,
        purity, safety, and potency (if applicable). But we never rely on that alone. We confirm their accuracy through
        in-house and third-party testing. Any discrepancies suggest that the ingredients were adulterated or contaminated.
        In those cases, we reject the entire batch and seek another source.
      </p>
    </div>

    <div class="comprehensive-testing__stats">
      <div class="comprehensive-testing__stat">
        <p class="comprehensive-testing__stat-value font-proxima">
          Around $1M
        </p>
        <p class="comprehensive-testing__stat-label font-proxima">
          spent on testing per year*
          <span class="comprehensive-testing__stat-note">(based on 2025)</span>
        </p>
      </div>
      <div class="comprehensive-testing__stat">
        <p class="comprehensive-testing__stat-value font-proxima">
          Multiple Rounds
        </p>
        <p class="comprehensive-testing__stat-label font-proxima">
          tested up to six times
        </p>
      </div>
    </div>

    <div class="comprehensive-testing__image-wrap">
      <img
        class="comprehensive-testing__image"
        src="{{ 'standard_shutterstock_2446157489.png' | asset_url }}"
        alt="Petri dishes representing comprehensive testing"
        width="860"
        height="860"
      >
    </div>
  </div>
</section>

{% comment %} What we test for {% endcomment %}

{{ 'static-WeTestFor-carousel.js' | asset_url | script_tag }}
<section
  class="src static-reviews-carousel"
  {% if block %}
    {{- block.shopify_attributes -}}
  {% endif %}
>
  <div class="src__inner">
    <h2 class="src__heading font-proxima">What We Test For</h2>

    <div class="src__carousel-outer">
      <div
        class="src__track"
        role="region"
        aria-label="Customer reviews"
        tabindex="0"
      >
        {% comment %} Test Panel 1 {% endcomment %}
        <div class="src__card" role="listitem">
          <h3 class="src__product font-proxima">Botanical Identification</h3>
          <div class="src__stars" aria-hidden="true"></div>
          <p class="src__text font-proxima">
            Sometimes, we only use a specific part of a plant, like the leaf or root, because it contains the most
            beneficial compounds. If we can’t identify a botanical, or if it contains a part we don’t want, we reject
            the entire batch.
          </p>
          <div class="src__meta font-proxima">
            <strong>Our Methodology:</strong>
            <ul>
              <li>FTIR Spectroscopy</li>
              <li>HPTLC</li>
              <li>Microscopy</li>
            </ul>
          </div>
        </div>

        {% comment %} Test Panel 2 {% endcomment %}
        <div class="src__card" role="listitem">
          <h3 class="src__product font-proxima">Microbes</h3>
          <div class="src__stars" aria-hidden="true"></div>
          <p class="src__text font-proxima">
            To ensure your supplements are safe for daily use, we look for:
          </p>
          <div class="src__meta font-proxima">
            <ul>
              <li>Total Plate Count</li>
              <li>Total Coliform</li>
              <li>Yeast</li>
              <li>Mold</li>
              <li>E. Coli</li>
              <li>Staphylococcus</li>
              <li>Salmonella</li>
            </ul>
          </div>
        </div>

        {% comment %} Test Panel 3 {% endcomment %}
        <div class="src__card" role="listitem">
          <h3 class="src__product font-proxima">Heavy Metals</h3>
          <div class="src__stars" aria-hidden="true"></div>
          <p class="src__text font-proxima">
            Some heavy metals, like iron and zinc, are essential micronutrients. We test for harmful levels of the
            “big four” toxic heavy metals, plus aluminum:
          </p>
          <div class="src__meta font-proxima">
            <ul>
              <li>Arsenic</li>
              <li>Cadmium</li>
              <li>Lead</li>
              <li>Mercury</li>
              <li>Aluminum</li>
            </ul>
          </div>
        </div>

        {% comment %} Test Panel 4 {% endcomment %}
        <div class="src__card" role="listitem">
          <h3 class="src__product font-proxima">Adenosine Triphosphate (ATP)</h3>
          <div class="src__stars" aria-hidden="true"></div>
          <p class="src__text font-proxima">
            We test for ATP, a molecule found in all living cells, after cleaning and sanitizing our equipment to ensure there is no biological residue from plants or humans. It’s not required, but we do it anyway.
          </p>
        </div>

        {% comment %} Test Panel 5 {% endcomment %}
        <div class="src__card" role="listitem">
          <h3 class="src__product font-proxima">Potency </h3>
          <div class="src__stars" aria-hidden="true"></div>
          <p class="src__text font-proxima">
            For products with potency listed on the label (like <a href="https://globalhealing.com/products/vitamin-d">Vitamin D3</a>), we test the finished product to ensure the formula meets our label claim at the time of purchase up to its best-by date.
          </p>
        </div>
      </div>

      <div
        class="src__progress"
        aria-hidden="true"
        role="progressbar"
        aria-valuenow="1"
        aria-valuemin="1"
        aria-valuemax="3"
      >
        <div class="src__progress-track">
          <div class="src__progress-fill" style="display: block;"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .methodology-cards {
    padding: 72px 0 80px;
    background-color: #ffffff;
  }

  .methodology-cards__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .methodology-cards__heading {
    font-size: clamp(2rem, 3vw, 2.6rem);
    line-height: 1.2;
    color: #1f5939;
    text-align: left;
    margin: 0 0 32px;
  }

  .methodology-cards__slider {
    overflow: hidden;
    position: relative;
  }

  .methodology-cards__track {
    display: flex;
  }

  .methodology-cards__item {
    background-color: #ffffff;
    border: 1px solid #c7d0c8;
    border-right: none;
    height: 100%;
  }

  .methodology-cards__item:last-child {
    border-right: 1px solid #c7d0c8;
  }

  .methodology-cards__media {
    width: 100%;
    height: 220px;
    overflow: hidden;
  }

  .methodology-cards__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .methodology-cards__content {
    padding: 24px 24px 28px;
  }

  .methodology-cards__title {
    font-size: clamp(1.3rem, 1.8vw, 1.6rem);
    line-height: 1.2;
    color: #174f33;
    margin: 0 0 0.75rem;
    font-weight: 600;
  }

  .methodology-cards__text {
    font-size: clamp(1rem, 1.4vw, 1.05rem);
    line-height: 1.5;
    color: #2f3b34;
    margin: 0;
    font-weight: 300;
  }

  .methodology-cards__cta {
    text-align: center;
    margin: 32px 0 0;
  }

  .methodology-cards__popup-trigger {
    background: none;
    border: none;
    padding: 0;
    font-size: 1rem;
    line-height: 1.4;
    color: #1f5939;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

