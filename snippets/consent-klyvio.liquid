{%- comment -%}
  ============================================================
  CONSENT-GATED KLAVIYO
  ============================================================
  Blocks Klaviyo scripts until marketing consent is granted
  via Consentmo + Google Consent Mode v2 (gh:consentUpdate).

  After marketing consent:
    - Loads modern klaviyo.js (forms, Customer Hub)
    - Stops blocking static.klaviyo.com / a.klaviyo.com /
      static-tracking.klaviyo.com

  Must load early in <head> (before content_for_header / app embeds).
  ============================================================
{%- endcomment -%}

<script>
(function () {
  'use strict';

  var marketingConsent = false;
  var loaded = false;

  if (window.__GH_CONSENT_STATE__) {
    marketingConsent = !!window.__GH_CONSENT_STATE__.marketing;
  }

  var BLOCKED_DOMAINS = [
    'static.klaviyo.com',
    'static-tracking.klaviyo.com',
    'a.klaviyo.com',
  ];

  var KLAVIYO_JS_SRC = 'https://static.klaviyo.com/onsite/js/YeibUN/klaviyo.js';

  function isKlaviyoScript(src) {
    if (!src) return false;
    for (var i = 0; i < BLOCKED_DOMAINS.length; i++) {
      if (src.indexOf(BLOCKED_DOMAINS[i]) !== -1) return true;
    }
    return false;
  }

  function shouldBlockNode(node) {
    if (!node || node.tagName !== 'SCRIPT') return false;
    if (marketingConsent) return false;
    var src = node.src || node.getAttribute('src') || '';
    return isKlaviyoScript(src);
  }

  var _appendChild = Node.prototype.appendChild;
  var _insertBefore = Node.prototype.insertBefore;

  Node.prototype.appendChild = function (node) {
    if (shouldBlockNode(node)) {
      if (window.__GH_DEBUG_CONSENT__) {
        console.warn('[ConsentKlaviyo] Blocked script:', node.src || node.getAttribute('src'));
      }
      return node;
    }
    return _appendChild.call(this, node);
  };

  Node.prototype.insertBefore = function (node, ref) {
    if (shouldBlockNode(node)) {
      if (window.__GH_DEBUG_CONSENT__) {
        console.warn('[ConsentKlaviyo] Blocked script:', node.src || node.getAttribute('src'));
      }
      return node;
    }
    return _insertBefore.call(this, node, ref);
  };

  function loadKlaviyo() {
    if (loaded) return;
    if (document.querySelector('script[src*="static.klaviyo.com/onsite/js/YeibUN/klaviyo.js"]')) {
      loaded = true;
      return;
    }
    loaded = true;
    var s = document.createElement('script');
    s.async = true;
    s.src = KLAVIYO_JS_SRC;
    s.onerror = function () {
      console.error('[Klaviyo] Failed to load klaviyo.js');
      loaded = false;
    };
    document.head.appendChild(s);
  }

  function applyConsent(consent) {
    if (!consent || !consent.marketing) return;
    marketingConsent = true;
    loadKlaviyo();
  }

  document.addEventListener('gh:consentUpdate', function (event) {
    applyConsent(event.detail || {});
  });

  if (window.__GH_CONSENT_STATE__) {
    applyConsent(window.__GH_CONSENT_STATE__);
  }
})();
</script>
