{% comment %}
    Needs {{ products }} which should be an array of Liquid Shopify Products
    Needs {{ id }} which should be an id for use with the slider
{% endcomment %}

{% assign product_count = 0 %}

<!-- start GH product recommendations -->
<div class="gh-element-product-recommendations--container" id="{{ id }}">
    <div class="gh-element-product-recommendations glide">
        <div class="glide__track" data-glide-el="track">
            <ul class="glide__slides">

                {% for product in products %}
                    {% assign product_count = product_count | plus: 1 %}
                    <li class="glide__slide">
                        <div class="flex flex-column">
                            <div class="center mb2">
                                {{ product.featured_image |  image_url: width: 600 | image_tag }}
                            </div>
                            <div class="flex-auto">
                                <a class="h4 gh-font-primary color-green text-decoration-none mb1" href="/products/{{ product.handle }}">{{ product.title }}</a>
                                <p class="gh-font-secondary bold line-height-4 mb1">{{ product.metafields.globalhealing.product_tagline }}</p>
                                <!--<p>A naturally-occurring trace mineral found in plant foods, boron is your secret to supporting total body wellness on a daily basis.</p>-->
                            </div>
                            <div>
                                <p class="flex-auto price">{{ product.price | money }}</p>
                                <a type="submit" href="https://globalhealing.com/cart/{{ product.variants.first.id }}:1" class="button button--full-width button--primary mb1">Add to cart</a>
                            </div>
                        </div>
                    </li>
                {% endfor %}

            </ul>
        </div>

        <div class="center pt2">
            <div class="glide__arrows py2" data-glide-el="controls">
                <button class="bg-white border-none appearance-none glide__arrow--left" data-glide-dir="<">
                    <img src="https://cdn.globalhealing.com/web/v2/icon/iconmonstr-arrow-left-circle-thin.svg" width="30" height="30" alt="">
                </button>
                <button class="bg-white border-none appearance-none glide__arrow--right" data-glide-dir=">">
                    <img src="https://cdn.globalhealing.com/web/v2/icon/iconmonstr-arrow-right-circle-thin.svg" width="30" height="30" alt="">
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .gh-element-product-recommendations--container {
        padding-top: 5rem;
        padding-bottom: 4rem;
    }

    .gh-element-product-recommendations{
        padding: 2rem 0;
        justify-content: center;
    }

    .gh-element-product-recommendations  h4 {
        font-size: 3rem;
        color: var(--gh-color-green);
        margin-bottom: 1rem;
    }

    .gh-element-product-recommendations  img {
        max-width: 200px;
    }

    .gh-element-product-recommendations .glide__track .glide__slide .price {
        font-weight: 700;
        margin-top: .5em;
        margin-bottom: 1em;
        border: 1px solid var(--gh-color-gray);
        border-width: 1px 0;
        padding: 0.25em 0;
        text-align: left;
    }
    .gh-element-product-recommendations--container .gh-element-product-recommendations .button--primary{
        display: inline-flex;
        justify-content: center;
        align-items: center;
        border: 0;
        padding: 0 3rem;
        cursor: pointer;
        font: inherit;
        font-size: 1.5rem;
        text-decoration: none;
        color: rgb(var(--color-button-text));
        transition: box-shadow var(--duration-short) ease;
        -webkit-appearance: none;
        appearance: none;
        background-color: rgba(var(--color-button), var(--alpha-button-background));
    }
    .gh-element-product-recommendations--container .gh-element-product-recommendations .button--primary{
        color: rgb(var(--color-button-text));
    }


    #{{ id }} ul{
                  padding-left: 0;
                  list-style: none;
              }
</style>
<script>
  {% if product_count < 3 %}
  gh.glide.create('#{{ id }} .glide', {
    type: 'slider',
    startAt: 0,
    peek: 60,
    gap: 60,
    perView: 2,

    breakpoints: {
      800: {
        perView: 2,
        gap: 15,
      },
      450: {
        perView: 1,
        peek: 30,
        gap: 15
      }
    }
  });
  {% else %}
  gh.glide.create('#{{ id }} .glide', {
    type: 'slider',
    startAt: 0,
    peek: 60,
    gap: 20,
    perView: 3,

    breakpoints: {
      800: {
        perView: 2,
        gap: 15,
      },
      450: {
        perView: 1,
        peek: 30,
        gap: 15
      }
    }
  });
  {% endif %}
</script>