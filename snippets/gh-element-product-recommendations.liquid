{% comment %}
    Needs {{ products }} which should be an array of Liquid Shopify Products
{% endcomment %}

<!-- start GH product recommendations -->

    <div class="gh-element-product-recommendations glide">
        <div class="glide__track" data-glide-el="track">
            <ul class="glide__slides">

                {% for product in products %}
                <li class="glide__slide">
                    <div class="flex flex-column px3">
                        <div class="center mb2">
                            <img src="https://cdn.globalhealing.com/products/images/boron/2-fl-oz/default/3000w.png?w=600" class="col-8" alt="">
                        </div>
                        <div class="flex-auto">
                            <a class="left h4 gh-font-primary color-green text-decoration-none mb1" href="/products/{{ product.handle }}">{{ product.title }}</a>
                            <p class="gh-font-secondary left bold line-height-4 mb1">{{ product.metafields.globalhealing.product_tagline }}</p>
                            <p class="left">A naturally-occurring trace mineral found in plant foods, boron is your secret to supporting total body wellness on a daily basis.</p>
                        </div>
                        <div>
                            <p class="flex-auto price">{{ product.price }}</p>
                            <a type="submit" href="https://globalhealing.com/cart/{{ product.variants.first.id }}:1" class="button button--full-width button--primary">Add to cart</a>
                        </div>
                    </div>
                </li>
                {% endfor %}
                
            </ul>
        </div>

        <div class="center pt4">
            <div class="glide__arrows py2" data-glide-el="controls">
                <button class="bg-white border-none appearance-none glide__arrow--left" data-glide-dir="<">
                    <img src="https://cdn.globalhealing.com/web/v2/icon/iconmonstr-arrow-left-circle-thin.svg" width="30" height="30" alt="">
                </button>
                <button class="bg-white border-none appearance-none glide__arrow--right" data-glide-dir=">">
                    <img src="https://cdn.globalhealing.com/web/v2/icon/iconmonstr-arrow-right-circle-thin.svg" width="30" height="30" alt="">
                </button>
            </div>
        </div>
    </div>

<style>
    .gh-element-product-recommendations--section {
        padding-top: 5rem;
        padding-bottom: 4rem;
    }

    .gh-element-product-recommendations{
        padding: 2rem 1rem;
        justify-content: center;
    }

    .gh-element-product-recommendations  h4 {
        font-size: 3rem;
        color: var(--gh-color-green);
        margin-bottom: 1rem;
    }

    .gh-element-product-recommendations .glide__track .glide__slide .price {
        font-weight: 700;
        margin-top: .5em;
        margin-bottom: 1em;
        border: 1px solid var(--gh-color-gray);
        border-width: 1px 0;
        padding: 0.25em 0;
        text-align: left;
    }
</style>