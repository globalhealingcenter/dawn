
{% comment %}
  Global Healing — Termly Consent Bridge

  - No Consentmo dependency
  - Termly controls consent categories
  - BIS remains available independently
  - Customer Hub should require marketing consent
  - Google Consent Mode V2 is handled by Termly
{% endcomment %}

<script id="gh-termly-consent-bridge">
(function () {
  'use strict';

  if (window.__GH_TERMLY_BRIDGE_INSTALLED__) return;
  window.__GH_TERMLY_BRIDGE_INSTALLED__ = true;

  var attached = false;
  var lastSignature = null;
  var retryCount = 0;
  var maxRetries = 80;

  function normalize(consent) {
    var state = consent || {};

    return {
      statistics: state.analytics === true,
      marketing: state.advertising === true,
      functionality: state.performance === true,
      google: state.advertising === true
    };
  }

  function publish(consent) {
    var state = normalize(consent);
    var signature = JSON.stringify(state);

    window.__GH_CONSENT_STATE__ = state;

    if (signature === lastSignature) return;
    lastSignature = signature;

    document.dispatchEvent(
      new CustomEvent('gh:consentUpdate', {
        detail: Object.assign({}, state)
      })
    );
  }

  function syncConsent() {
    if (
      !window.Termly ||
      typeof window.Termly.getConsentState !== 'function'
    ) {
      publish(null);
      return;
    }

    try {
      publish(window.Termly.getConsentState());
    } catch (error) {
      console.warn('[GH Termly] Consent read failed:', error);
      publish(null);
    }
  }

  // Our own record that the visitor made a choice in the banner.
  // Termly's storage and 'consent' event can exist before any click,
  // so neither is a reliable signal on its own.
  var CHOICE_KEY = 'gh_termly_choice_made';
  var INTERACTION_WINDOW_MS = 5000;
  var lastInteraction = 0;

  function markInteraction(event) {
    if (event.isTrusted) lastInteraction = Date.now();
  }

  document.addEventListener('click', markInteraction, true);
  document.addEventListener('keydown', markInteraction, true);

  function isUserAction() {
    return Date.now() - lastInteraction < INTERACTION_WINDOW_MS;
  }

  function hasStoredChoice() {
    try {
      return window.localStorage.getItem(CHOICE_KEY) === '1';
    } catch (error) {
      return false;
    }
  }

  function rememberChoice() {
    try {
      window.localStorage.setItem(CHOICE_KEY, '1');
    } catch (error) {}
  }

  // Push the Termly choice into Shopify's Customer Privacy API so
  // Shopify pixels (Meta, Klaviyo, etc.) follow the visitor's choice.
  // Only records consent after the visitor has used the banner.
  var lastShopifySignature = null;

  function syncShopify(fromUserAction) {
    if (
      !window.Termly ||
      typeof window.Termly.getConsentState !== 'function'
    ) {
      return;
    }

    if (!fromUserAction && !hasStoredChoice()) return;

    var state;
    try {
      state = window.Termly.getConsentState() || {};
    } catch (error) {
      console.warn('[GH Termly] Consent read failed:', error);
      return;
    }

    var consent = {
      analytics: state.analytics === true,
      marketing: state.advertising === true,
      preferences: state.performance === true
    };

    // Sale of data opt-out only comes from the visitor's own action
    if (fromUserAction) {
      consent.sale_of_data = state.do_not_sell !== true;
    }

    var signature = JSON.stringify(consent);
    if (signature === lastShopifySignature) return;

    function apply() {
      lastShopifySignature = signature;
      window.Shopify.customerPrivacy.setTrackingConsent(consent, function (result) {
        if (result && result.error) {
          console.warn('[GH Termly] Shopify consent failed:', result.error);
        }
      });
    }

    if (
      window.Shopify &&
      window.Shopify.customerPrivacy &&
      typeof window.Shopify.customerPrivacy.setTrackingConsent === 'function'
    ) {
      apply();
    } else if (window.Shopify && typeof window.Shopify.loadFeatures === 'function') {
      window.Shopify.loadFeatures(
        [{ name: 'consent-tracking-api', version: '0.1' }],
        function (error) {
          if (error) {
            console.warn('[GH Termly] Shopify consent API failed to load:', error);
            return;
          }
          apply();
        }
      );
    }
  }

  window.GHConsent = {
    getState: function () {
      return Object.assign(
        {},
        window.__GH_CONSENT_STATE__
      );
    },
    refresh: syncConsent
  };

  // Default: no optional consent
  publish(null);

  function attachTermly() {
    if (attached) return true;

    if (
      !window.Termly ||
      typeof window.Termly.on !== 'function'
    ) {
      return false;
    }

    attached = true;

    // Called when Termly finishes initialization.
    window.Termly.on('initialized', function () {
      syncConsent();
      syncShopify(false);
    });

    // Called when visitor changes consent.
    window.Termly.on('consent', function () {
      syncConsent();

      if (isUserAction()) {
        rememberChoice();
        syncShopify(true);
      } else {
        syncShopify(false);
      }
    });

    // Also support previously saved consent.
    syncConsent();
    syncShopify(false);

    return true;
  }

  function retryAttach() {
    if (attachTermly()) return;

    if (++retryCount <= maxRetries) {
      setTimeout(retryAttach, 250);
    } else {
      console.warn(
        '[GH Termly] Termly not detected.'
      );
    }
  }

  window.onGHTermlyLoaded = attachTermly;

  retryAttach();
})();
</script>
