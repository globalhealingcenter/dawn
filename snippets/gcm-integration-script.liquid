{%- comment -%}
  Google Consent Mode v2 (Consentmo) – injected as early as possible in <head>.
  If uninstalling Consentmo, remove this snippet and the render call in theme.liquid.
{%- endcomment -%}

<!-- Google Consent Mode V2 Advanced Mode integration script for Consentmo GDPR Compliance App -->
<script id="consentmo-gcmv2-advanced-mode-integration">
  var __IN_TAPCART_EARLY__ = !!window.Tapcart || /Tapcart/i.test(navigator.userAgent);

  const consentOutOfRegion = {
    analytics: false,
    marketing: false,
    functionality: false,
    adsDataRedaction: true,
    urlPassthrough: false,
  };

  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }

  function dispatchGhConsent(categories) {
    window.__GH_CONSENT_STATE__ = categories;
    if (categories.marketing) window.__GH_MARKETING_CONSENT__ = true;
    document.dispatchEvent(new CustomEvent('gh:consentUpdate', { detail: categories }));
  }

  function isConsentGranted(value) {
    return value === 'granted' || value === true || value === 1 || value === '1';
  }

  function parseConsentCategories(csmSignal) {
    const gcm = csmSignal.integration?.gcm?.isEnabled ? csmSignal.integration.gcm.state : csmSignal.state;
    const cats = csmSignal.categories || {};
    const prefs = csmSignal.preferences || {};

    var marketing = !!(
      cats.marketing ||
      csmSignal.marketing ||
      prefs.marketing ||
      isConsentGranted(gcm?.ad_storage) ||
      isConsentGranted(gcm?.ad_user_data) ||
      isConsentGranted(gcm?.ad_personalization)
    );

    var statistics = !!(
      cats.statistics ||
      csmSignal.statistics ||
      prefs.analytics ||
      isConsentGranted(gcm?.analytics_storage)
    );

    var functionality = !!(
      cats.preferences ||
      cats.functionality ||
      prefs.functionality ||
      isConsentGranted(gcm?.functionality_storage) ||
      isConsentGranted(gcm?.personalization_storage)
    );

    return { marketing: marketing, statistics: statistics, functionality: functionality };
  }

  function dispatchFromShopifyPrivacy(detail) {
    if (!detail) return;
    dispatchGhConsent({
      marketing: !!detail.marketingAllowed,
      statistics: !!(detail.analyticsAllowed || detail.analyticsProcessingAllowed),
      functionality: !!(detail.preferencesAllowed || detail.preferencesProcessingAllowed),
    });
  }

  function syncShopifyPrivacyFromApi() {
    var cp = window.Shopify && window.Shopify.customerPrivacy;
    if (!cp || typeof cp.marketingAllowed !== 'function') return;
    dispatchGhConsent({
      marketing: cp.marketingAllowed(),
      statistics: cp.analyticsProcessingAllowed(),
      functionality: cp.preferencesProcessingAllowed(),
    });
  }

  function bindShopifyPrivacyConsentSync() {
    document.addEventListener('visitorConsentCollected', function (event) {
      dispatchFromShopifyPrivacy(event.detail);
    });
    document.addEventListener('trackingConsentAccepted', function () {
      syncShopifyPrivacyFromApi();
    });
    syncShopifyPrivacyFromApi();
  }

  var GH_CONSENT_DENIED = { marketing: false, statistics: false, functionality: false };

  function handleConsentmoSignal(event) {
    const csmSignal = event.detail || {};
    const consentState = csmSignal.integration?.gcm?.isEnabled
      ? csmSignal.integration.gcm.state
      : csmSignal.state;
    if (consentState) {
      gtag('consent', 'update', consentState);
    }
    if (csmSignal.integration?.gcm?.isEnabled) {
      gtag('set', 'ads_data_redaction', csmSignal.integration.gcm.adsDataRedaction);
      gtag('set', 'url_passthrough', csmSignal.integration.gcm.urlPassthrough);
    }
    var parsed = parseConsentCategories(csmSignal);
    if (window.__GH_DEBUG_CONSENT__) {
      console.info('[GH Consent] consentmoSignal', csmSignal, parsed);
    }
    dispatchGhConsent(parsed);
  }

  function registerConsentmoListeners() {
    document.addEventListener('consentmoSignal', handleConsentmoSignal);
    window.addEventListener('consentmoSignal', handleConsentmoSignal);
    document.addEventListener('consentmoSignal_onLoad', handleConsentmoOnLoad);
    window.addEventListener('consentmoSignal_onLoad', handleConsentmoOnLoad);
  }

  function handleConsentmoOnLoad(eventData) {
    const csmLoadSignal = eventData.detail || { isActive: false };
    if (!csmLoadSignal.isActive) {
      gtag('consent', 'update', {
        ad_storage: consentOutOfRegion.marketing ? 'granted' : 'denied',
        ad_personalization: consentOutOfRegion.marketing ? 'granted' : 'denied',
        ad_user_data: consentOutOfRegion.marketing ? 'granted' : 'denied',
        analytics_storage: consentOutOfRegion.analytics ? 'granted' : 'denied',
        functionality_storage: consentOutOfRegion.functionality ? 'granted' : 'denied',
        personalization_storage: consentOutOfRegion.functionality ? 'granted' : 'denied',
        security_storage: 'granted',
      });
      gtag('set', 'ads_data_redaction', consentOutOfRegion.adsDataRedaction);
      gtag('set', 'url_passthrough', consentOutOfRegion.urlPassthrough);
      dispatchGhConsent({
        marketing: consentOutOfRegion.marketing,
        statistics: consentOutOfRegion.analytics,
        functionality: consentOutOfRegion.functionality,
      });
    } else if (csmLoadSignal.hasConsent) {
      handleConsentmoSignal({ detail: csmLoadSignal });
    } else {
      dispatchGhConsent(GH_CONSENT_DENIED);
    }
  }

  if (__IN_TAPCART_EARLY__) {
    gtag('consent', 'default', {
      ad_storage: 'granted',
      ad_personalization: 'granted',
      ad_user_data: 'granted',
      analytics_storage: 'granted',
      functionality_storage: 'granted',
      personalization_storage: 'granted',
      security_storage: 'granted',
    });
    window.__consentmo_bypass__ = true;
    dispatchGhConsent({ marketing: true, statistics: true, functionality: true });
    console.log('[Consentmo] Tapcart detected – consent widget suppressed.');
  } else {
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_personalization: 'denied',
      ad_user_data: 'denied',
      analytics_storage: 'denied',
      functionality_storage: 'denied',
      personalization_storage: 'denied',
      security_storage: 'granted',
      wait_for_update: 1500,
    });

    dispatchGhConsent(GH_CONSENT_DENIED);
    registerConsentmoListeners();

    if (window.Shopify && window.Shopify.customerPrivacy) {
      bindShopifyPrivacyConsentSync();
    } else {
      document.addEventListener('shopify:consent:loaded', bindShopifyPrivacyConsentSync);
    }
  }
</script>

<!-- Tapcart: hide Consentmo cookie widget UI as a safety net -->
<script>
  if (__IN_TAPCART_EARLY__) {
    var _tcStyle = document.createElement('style');
    _tcStyle.id = 'tapcart-consentmo-hide';
    _tcStyle.textContent =
      '#consentmo-widget, #csmWidget, .consentmo-widget, [id^="consentmo"], [class^="consentmo"], iframe[src*="consentmo"] { display: none !important; visibility: hidden !important; }';
    document.head.appendChild(_tcStyle);
  }
</script>
