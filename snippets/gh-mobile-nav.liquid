{%- comment -%}
GH Mobile Nav (scrollable, mobile-only, inline in header group)
Requires a Navigation menu with handle: mobile-nav
{%- endcomment -%}

{%- assign mq_menu = linklists['mobile-nav'] | default: linklists.mobile-nav -%}
{%- if mq_menu and mq_menu.links.size > 0 -%}
<nav class="gh-mobile-nav mobile-quicklinks mobile-quicklinks--inline"
     role="navigation"
     aria-label="Mobile quick nav">
  <div class="mq-inner">
    <ul class="mq-list" role="list">
      {%- for link in mq_menu.links -%}
        {%- assign is_active = link.active | default: false -%}
        <li class="mq-item">
          <a class="mq-link{% if is_active %} is-active{% endif %}"
             href="{{ link.url }}"
             {% if is_active %}aria-current="page"{% endif %}>
            {{ link.title }}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</nav>
{%- endif -%}
