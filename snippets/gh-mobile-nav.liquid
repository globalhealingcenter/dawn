{%- comment -%}
  GH Mobile Nav — quick links for HOME and PRODUCT pages
{%- endcomment -%}

{%- if request.page_type == 'index' or request.page_type == 'product' -%}

  {%- assign mq_menu = linklists['mobile-quick-links'] -%}
  {%- if mq_menu == nil or mq_menu.links.size == 0 -%}
    {%- assign mq_menu = linklists['gh-mobile-nav'] -%}
  {%- endif -%}
  {%- if mq_menu == nil or mq_menu.links.size == 0 -%}
    {%- assign mq_menu = linklists['mobile-nav'] -%}
  {%- endif -%}

  {%- assign default_active_url = '/pages/autoship' -%} 

  <nav class="gh-mobile-nav mobile-quicklinks mobile-quicklinks--inline"
       role="navigation"
       aria-label="Mobile quick nav"
       data-page-type="{{ request.page_type }}"
       data-default-active-url="{{ default_active_url }}">
    <div class="mq-inner" id="gh-ql">
      {%- if mq_menu and mq_menu.links.size > 0 -%}
        {%- for link in mq_menu.links -%}
          {%- assign force_active = false -%}
          {%- if request.page_type == 'index' and link.url == default_active_url -%}
            {%- assign force_active = true -%}
          {%- endif -%}

          <a href="{{ link.url }}"
             class="mq-link{% if link.active or link.child_active or force_active %} is-active{% endif %}">
            {{ link.title }}
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </nav>

  <style>
    /* ===== GH Mobile Nav (home + product only) ===== */
    @media (max-width: 749px) {
      .mobile-quicklinks,
      .mobile-quicklinks--inline {
        position: static;
        background: var(--gh-color-green, #21472D);
      }

      .mobile-quicklinks .mq-inner {
        display: flex;
        gap: 18px;                 /* more breathing room */
        padding: 10px 14px;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior-x: contain;
        scroll-behavior: auto !important;
      }
      .mobile-quicklinks .mq-inner::-webkit-scrollbar { display: none; }

      .mq-link {
        display: inline-flex;
        align-items: center;
        white-space: nowrap;
        color: #fff;
        text-decoration: none;

        /* nicer tap target */
        padding: 8px 2px;          /* vertical padding helps a lot */
        min-height: 36px;

        /* Typography */
        font-size: 1rem;           /* slightly smaller reads cleaner in a nav */
        line-height: 1.2;
        letter-spacing: 0.04em;
        font-weight: 500;
        opacity: 0.88;             /* makes active stand out */
      }
      .mq-link:hover { opacity: .95; }

      .mq-link.is-active {
        opacity: 1;
        font-weight: 600;
        border-bottom: 3px solid #F9F2E8;
        padding-bottom: 6px;       /* pushes underline away from letters */
      }
    }

    @media (min-width: 750px) {
      .mobile-quicklinks { display: none; }
    }
  </style>

  <script>
    (function () {
      // If Shopify didn't mark anything active (or if you want to ensure it's visible),
      // scroll the active item into view without smooth jank.
      var nav = document.getElementById('gh-ql');
      if (!nav) return;

      var active = nav.querySelector('.mq-link.is-active');
      if (!active) return;

      // ensure active is visible (center-ish)
      var navRect = nav.getBoundingClientRect();
      var aRect = active.getBoundingClientRect();
      var delta = (aRect.left - navRect.left) - (navRect.width / 2 - aRect.width / 2);
      nav.scrollLeft = nav.scrollLeft + delta;
    })();
  </script>

{%- endif -%}
