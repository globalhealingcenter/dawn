    <div class="footer__app-badges" role="navigation" aria-label="Get the Global Healing App">
      <a
        href="https://0vf059r6.tapc.art/?utm_source=website&utm_medium=footer&utm_campaign=app_install"
        target="_blank"
        rel="noopener"
      >
        <img
          src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg"
          alt="Download on the App Store"
