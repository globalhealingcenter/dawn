{{ 'new-standard-block.css' | asset_url | stylesheet_tag }}

{% assign ns_title = block.settings.title | default: 'The New Standard' %}
{% assign ns_tagline = block.settings.tagline | default: 'in Supplements' %}
{% assign ns_description = block.settings.description | default: "Because industry norms aren't enough." %}
{% assign ns_button_text = block.settings.button_text | default: 'See the Full Process' %}
{% assign ns_button_url = block.settings.button_url | default: '/pages/quality-purity' %}
{% assign ns_id = block.id | default: 'static' %}

{% assign accordion_blocks = '' %}
{% for b in section.blocks %}
  {% if b.type == 'accordion_item' %}
    {% if accordion_blocks == '' %}
      {% assign accordion_blocks = b.id %}
    {% else %}
      {% assign accordion_blocks = accordion_blocks | append: ',' | append: b.id %}
    {% endif %}
  {% endif %}
{% endfor %}
{% assign has_any_items = false %}
{% if accordion_blocks != '' %}
  {% assign has_any_items = true %}
{% endif %}

<section class="new-standard-section ns-block-wrapper" id="ns-block-{{ ns_id }}" {{ block.shopify_attributes }}>
  <div class="new-standard-inner">
    <div class="ns-left">
      <h2 class="ns-title font-miller">{{ ns_title }}</h2>
      <p class="ns-tagline font-proxima">{{ ns_tagline }}</p>
      <p class="ns-description font-proxima">{{ ns_description }}</p>
      <a href="{{ ns_button_url }}" class="button hide-on-mobile">{{ ns_button_text }}</a>
    </div>

    <div class="ns-right">
      <div class="ns-accordions">
        {% if has_any_items %}
          {% assign accordion_index = 0 %}

          {% for acc_block in section.blocks %}
            {% if acc_block.type != 'accordion_item' %}{% continue %}{% endif %}
            {% assign accordion_index = accordion_index | plus: 1 %}

            {% assign acc_title = acc_block.settings.accordion_title %}
            {% if acc_title == blank %}{% continue %}{% endif %}

            {% assign is_first = false %}
            {% if accordion_index == 1 %}{% assign is_first = true %}{% endif %}

            <div class="ns-accordion{% if is_first %} ns-accordion--open{% endif %}">
              <button class="ns-accordion__trigger" aria-expanded="{% if is_first %}true{% else %}false{% endif %}">
                <span class="ns-accordion__title">{{ acc_title }}</span>
                <span class="ns-accordion__icon">
                  <img src="{{ 'arrow-up.png' | asset_url }}" width="25" height="25" alt="Arrow Up">
                </span>
              </button>
              <div class="ns-accordion__body">
                <div class="ns-accordion__content">
                  <div class="ns-accordion__icon-wrap ns-accordion__icon-wrap--default svg-display">
                    {%- comment -%} Show first item's SVG as default {%- endcomment -%}
                    {% if acc_block.settings.item_1_svg != blank %}
                      {{ acc_block.settings.item_1_svg }}
                    {% endif %}
                  </div>

                  {%- comment -%} Hidden icon store for JS scroll-swap {%- endcomment -%}
                  <div class="ns-icon-store" style="display:none" aria-hidden="true">
                    {% for i in (1..5) %}
                      {% assign heading_key = 'item_' | append: i | append: '_heading' %}
                      {% assign svg_key = 'item_' | append: i | append: '_svg' %}
                      {% assign item_heading = acc_block.settings[heading_key] %}
                      {% assign item_svg = acc_block.settings[svg_key] %}
                      {% if item_heading != blank %}
                        <div data-icon-for="{{ accordion_index }}-{{ i }}">
                          {% if item_svg != blank %}
                            {{ item_svg }}
                          {% endif %}
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>

                  <div class="ns-accordion__text-wrap">
                    {% for i in (1..5) %}
                      {% assign heading_key = 'item_' | append: i | append: '_heading' %}
                      {% assign content_key = 'item_' | append: i | append: '_content' %}
                      {% assign item_heading = acc_block.settings[heading_key] %}
                      {% assign item_content = acc_block.settings[content_key] %}
                      {% if item_heading != blank %}
                        <strong
                          class="ns-accordion__label font-proxima"
                          data-icon-index="{{ accordion_index }}-{{ i }}"
                        >{{ item_heading }}</strong>
                        <div class="ns-accordion__copy font-proxima">
                          {{ item_content }}
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}

        {% else %}
          {%- comment -%} Fallback static content until accordion_item blocks are added {%- endcomment -%}
          <div class="ns-accordion ns-accordion--open">
            <button class="ns-accordion__trigger" aria-expanded="true">
              <span class="ns-accordion__title">Our Way, In Our Hands</span>
              <span class="ns-accordion__icon">
                <img src="{{ 'arrow-up.png' | asset_url }}" width="25" height="25" alt="Arrow Up">
              </span>
            </button>
            <div class="ns-accordion__body">
              <div class="ns-accordion__content">
                <div class="ns-accordion__icon-wrap ns-accordion__icon-wrap--default svg-display"></div>
                <div class="ns-accordion__text-wrap">
                  <strong class="ns-accordion__label font-proxima">INDEPENDENT</strong>
                  <div class="ns-accordion__copy font-proxima">
                    <p>We're family-owned and operated with no outside investors. We won't compromise our standards—or your trust—in exchange for profits.</p>
                  </div>
                  <strong class="ns-accordion__label font-proxima">In-House from Start to Finish</strong>
                  <div class="ns-accordion__copy font-proxima">
                    <p>Quality should never be outsourced. Our team guides every step of manufacturing, from sourcing to bottling, to ensure precision and integrity.</p>
                  </div>
                  <strong class="ns-accordion__label font-proxima">Manufactured in the USA</strong>
                  <div class="ns-accordion__copy font-proxima">
                    <p>Our supplements are made in Phoenix and Houston, not on the other side of the world. We stand behind our communities, our people, and our products.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="ns-accordion">
            <button class="ns-accordion__trigger" aria-expanded="false">
              <span class="ns-accordion__title">Clean Without Compromise</span>
              <span class="ns-accordion__icon">
                <img src="{{ 'arrow-up.png' | asset_url }}" width="25" height="25" alt="Arrow Up">
              </span>
            </button>
            <div class="ns-accordion__body">
              <div class="ns-accordion__content">
                <div class="ns-accordion__icon-wrap ns-accordion__icon-wrap--default svg-display"></div>
                <div class="ns-accordion__text-wrap">
                  <strong class="ns-accordion__label font-proxima">Purity-Led Sourcing</strong>
                  <div class="ns-accordion__copy font-proxima">
                    <p>We source ingredients for purity, quality, and traceability, prioritizing certified organic and vegan-friendly options as part of our sourcing standards.</p>
                  </div>
                  <strong class="ns-accordion__label font-proxima">Third-Party Tested</strong>
                  <div class="ns-accordion__copy font-proxima">
                    <p>Every ingredient is independently tested across multiple stages for purity, potency, and safety. Anything that falls short is rejected.</p>
                  </div>
                  <strong class="ns-accordion__label font-proxima">Zero Unnecessary Ingredients</strong>
                  <div class="ns-accordion__copy font-proxima">
                    <p>We never use GMOs, gluten, artificial colors, flavors, fillers, processing aids, added sugars, or alcohols in any of our formulas.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="ns-accordion">
            <button class="ns-accordion__trigger" aria-expanded="false">
              <span class="ns-accordion__title">Crafted for Superior Performance</span>
              <span class="ns-accordion__icon">
                <img src="{{ 'arrow-up.png' | asset_url }}" width="25" height="25" alt="Arrow Up">
              </span>
            </button>
            <div class="ns-accordion__body">
              <div class="ns-accordion__content">
                <div class="ns-accordion__icon-wrap ns-accordion__icon-wrap--default svg-display"></div>
                <div class="ns-accordion__text-wrap">
                  <strong class="ns-accordion__label font-proxima">Maximized Bioavailability</strong>
                  <div class="ns-accordion__copy font-proxima">
                    <p>Every formula is designed for optimal absorption with nutrients the body can recognize, use, and respond to effectively.</p>
                  </div>
                  <strong class="ns-accordion__label font-proxima">Advanced Delivery</strong>
                  <div class="ns-accordion__copy font-proxima">
                    <p>We create and apply advanced proprietary methods, including Raw Herbal Extract™ and MicroSomal® Technology, to preserve purity and enhance absorption.</p>
                  </div>
                  <strong class="ns-accordion__label font-proxima">Protected Integrity</strong>
                  <div class="ns-accordion__copy font-proxima">
                    <p>Low-heat, slow processing, non-reactive materials, and careful handling preserve nutrient integrity from start to finish.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        {% endif %}
      </div>
      <a href="{{ ns_button_url }}" class="button hide-on-desktop">{{ ns_button_text }}</a>
    </div>
  </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", function () {
  var section = document.getElementById('ns-block-{{ ns_id }}');
  if (!section) return;

  var accordionContents = section.querySelectorAll(".ns-accordion__content");
  accordionContents.forEach(function (content) {
    var scrollContainer = content.querySelector(".ns-accordion__text-wrap");
    var displayContainer = content.querySelector(".svg-display");
    var iconStore = content.querySelector(".ns-icon-store");
    if (!scrollContainer || !displayContainer) return;

    var internalObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting && iconStore) {
          var index = entry.target.getAttribute("data-icon-index");
          var iconEl = iconStore.querySelector('[data-icon-for="' + index + '"]');
          if (iconEl && iconEl.innerHTML.trim()) {
            displayContainer.innerHTML = iconEl.innerHTML;
          }
        }
      });
    }, {
      root: scrollContainer,
      rootMargin: "0px 0px -50% 0px",
      threshold: 0.1
    });

    scrollContainer.querySelectorAll(".ns-accordion__label").forEach(function (label) {
      internalObserver.observe(label);
    });
  });

  section.querySelectorAll('.ns-accordion__trigger').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var accordion = this.closest('.ns-accordion');
      var isOpen = accordion.classList.contains('ns-accordion--open');

      section.querySelectorAll('.ns-accordion').forEach(function (a) {
        a.classList.remove('ns-accordion--open');
        var trigger = a.querySelector('.ns-accordion__trigger');
        var body = a.querySelector('.ns-accordion__body');
        if (trigger) trigger.setAttribute('aria-expanded', 'false');
        if (body) body.style.display = 'none';
      });

      if (!isOpen) {
        accordion.classList.add('ns-accordion--open');
        btn.setAttribute('aria-expanded', 'true');
        var b = accordion.querySelector('.ns-accordion__body');
        if (b) b.style.display = 'block';
      }
    });
  });

  section.querySelectorAll('.ns-accordion--open .ns-accordion__body').forEach(function (body) {
    body.style.display = 'block';
  });
});
</script>
