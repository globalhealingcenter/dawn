 const accordionContents = document.querySelectorAll(".ns-accordion__content");

  accordionContents.forEach((content) => {
    const scrollContainer = content.querySelector(".ns-accordion__text-wrap");
    const displayContainer = content.querySelector(".svg-display");

    if (!scrollContainer || !displayContainer) return;

    const internalObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const index = entry.target.getAttribute("data-icon-index");
          
          if (iconLibrary[index]) {
            // Direct injection with no delay or opacity logic
            displayContainer.innerHTML = iconLibrary[index];
          }
        }
      });
    }, {
      root: scrollContainer,
      rootMargin: "0px 0px -50% 0px",
      threshold: 0.1 // Low threshold for faster response
    });

    scrollContainer.querySelectorAll(".ns-accordion__label").forEach((label) => {
      internalObserver.observe(label);
    });
  });
});
</script>

<script>
  (function () {
    const container = document.getElementById('ns-block-static');
    if (!container) return;

    container.querySelectorAll('.ns-accordion__trigger').forEach(function (btn) {
      btn.addEventListener('click', function () {
        const accordion = this.closest('.ns-accordion');
        const isOpen = accordion.classList.contains('ns-accordion--open');

        container.querySelectorAll('.ns-accordion').forEach(function (a) {
          a.classList.remove('ns-accordion--open');
          var trigger = a.querySelector('.ns-accordion__trigger');
          var body = a.querySelector('.ns-accordion__body');
          if (trigger) trigger.setAttribute('aria-expanded', 'false');
          if (body) body.style.display = 'none';
        });

        if (!isOpen) {
          accordion.classList.add('ns-accordion--open');
          btn.setAttribute('aria-expanded', 'true');
          var b = accordion.querySelector('.ns-accordion__body');
          if (b) b.style.display = 'block';
        }
      });
    });

    container.querySelectorAll('.ns-accordion--open .ns-accordion__body').forEach(function (body) {
      body.style.display = 'block';
    });
  })();
</script>

