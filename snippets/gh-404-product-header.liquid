
<script>

  let preloaded = false;

  let gh_products = {}
</script>

{% paginate shop.metaobjects.product.values by 250 %}
  {% assign products = shop.metaobjects.product.values %}

  {% if products %}
      {%- for entry in products %}

        {% assign product = entry.product.value %}

      <script>
        gh_products['{{ product.handle }}'] = { 
          name: {{ product.title | json }},
          id: {{ product.id | json }},
          tagline: "{{ product.metafields.globalhealing.product_tagline }}",
          short_description: {{ product.description | json }},
          images: [
            {% for image in product.images %}
              {"src": "{{ image | image_url: width: 600 }}"},
            {% endfor %}
          ]
        }
      </script>

        
      {%- endfor -%}
  {% endif %}
{% endpaginate %}

<script>


  let gh_404 = (() => {

    const url = new URL(window.location);
    let replace_container;
    let new_container;
    let product_header_left;
    let product_header_right_header;
    let product_content_container;
    let localization_form;

    let img = () => {
      let ingredients = document.querySelector('.ghd--block--ingredients');
      let ingredients_img = ingredients.querySelector('[data-type="image"] img');
      let ingredients_inputs = ingredients.querySelectorAll('.ghd--accordion input');

      function setActiveImage(){
        ingredients_inputs.forEach( i => {
          if(!i.checked) return;
          ingredients_img.classList.add('loading');

          ingredients_img.src = i.getAttribute('data-ingredient-image') + '?w=600'
          ingredients_img.setAttribute('srcset', i.getAttribute('data-ingredient-image') + '?w=1200 2x' );

          if(ingredients_img.complete){
            ingredients_img.classList.remove('loading');
          }

          ingredients_img.addEventListener('load', () => {
            ingredients_img.classList.remove('loading');
          })

        })
      }

      ingredients_inputs.forEach( i => {
        i.addEventListener('change', e => {
          if( !i.checked ) return;
          setActiveImage()
        })
      })

      setActiveImage();

      let modal = document.getElementById('dialog-product-supplement-facts-body');
      modal.addEventListener('click', e => {
        let inner = modal.querySelector('.ghd--dialog--inner');
        if( !inner.contains(e.target) ) modal.close();
      })

      document.querySelectorAll('[data-dialog="dialog-product-supplement-facts-body"]').forEach(d => {
        d.addEventListener('click', function(e) {
          if (modal.open) {
            modal.close();
          } else {
            modal.showModal()
          }
        });
      })
    }

    let storage = {
      key: 'gh_404_redirect',
      storeUrl( handle ){
        sessionStorage.setItem(storage.key, `https://globalhealing.com/products/${handle}`);
      },
      redirectUrl(){
        let data = sessionStorage.getItem(storage.key);
        console.log('found storage', data);
        if( !data ) return

        sessionStorage.removeItem(storage.key);
        console.log('redirecting to', data);
        window.location = data;
      }
    }

    let markets = {

      matches: {
        canada: {
          'oxy-powder': 'oxy-powder-canada',
          'calcium-magnesium': 'calcium-magnesium-canada',
          'detoxadine': 'organic-nascent-iodine-canada',
          'turmeric': 'turmeric-canada',
          'vitamin-b12': 'vitamin-b12-canada',
          'vitamin-d': 'vitamin-d-canada'
        }
      },

      goToMatchedProduct(slug){
        let country = '{{ localization.country.name }}'.toLowerCase();
        if( !markets.matches[country] || !markets.matches[country][slug] ) return false;
        window.location = '/products/' + markets.matches[country][slug];
        return true;
      }
    }

    function preLoad()
    {
      if( !url.pathname.includes('products/') ){
        storage.redirectUrl();
        preloaded = true;
      }

      const product_url = url.pathname.replace('/products/', '').replace('/', '');

      const product = gh_products[product_url];
      if( !product ) preloaded = true;

      let matched = markets.goToMatchedProduct(product_url);
      if( matched ) preloaded = true;
    }

    function init()
    {
      if( preloaded ) return;

      replace_container = document.querySelector('.template-404');
      new_container = document.getElementById('content-container-404');
      product_header_left = document.getElementById('gh-product-header--left');
      product_header_right_header = document.getElementById('gh-product-header--right-header');
      product_content_container = document.getElementById('gh-product-content-container-404');
      localization_form = document.getElementById('gh-localization-form');

      const product_url = url.pathname.replace('/products/', '').replace('/', '');
      const product = gh_products[product_url];

      storage.storeUrl(product_url);

      document.title = product.name + ' | Global Healing';
      replace_container.classList.add('hide');

      product_header_left.innerHTML +=
        `<img src="${product.images[0].src}" width='400' alt="" />`;

      product_header_right_header.innerHTML += `
        <div class="product__title"><h1 class='mb2 h2 md-h1'>${product.name}</h1></div>
      `;

      if( product.id )
        product_header_right_header.innerHTML += 
          `<div class="yotpo-widget-instance" data-yotpo-instance-id="465432" data-yotpo-product-id="${product.id}"data-yotpo-section-id="product"></div>`;

      product_header_right_header.innerHTML += `
        <span class="bold color-green">${product.tagline}</span>
        ${product.short_description}
      `;

      localization_form.classList.remove('hide');
      new_container.classList.remove('hide');

      fetch('https://shopify-product-content.globalhealing.workers.dev/?product='+product_url)
        .then( d => d.text())
        .then( h => {
          if( h === 'undefined' ) return;
          product_content_container.innerHTML += '<br>';
          product_content_container.innerHTML += h;
          img();
        })

    }

    return { init, preLoad };

  })();

  {% if template == '404' %}
  gh_404.preLoad();
  {% endif %}
</script>