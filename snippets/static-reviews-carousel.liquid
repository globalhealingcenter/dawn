          <h3 class="src__product font-proxima">Oxy-Powder®</h3>
          <p class="src__text font-proxima">
            "I used to get sick after eating greasy foods. Now I take Oxy-Powder and don’t suffer. When I feel bloated,
            it feels like I’ve done a cleanse. I can’t stand to be without it."
          </p>
          <p class="src__meta font-proxima hide-on-mobile">Nilsa G. | Verified Buyer</p>
          <p class="src__meta font-proxima hide-on-desktop">
            Nilsa G. <br>
            <span>Verified Buyer</span>
          </p>
        </div>

        {% comment %} Add more reviews by duplicating the .src__card block {% endcomment %}
      </div>

      <div
        class="src__progress"
        aria-hidden="true"
        role="progressbar"
        aria-valuenow="1"
        aria-valuemin="1"
        aria-valuemax="4"
      >
        <div class="src__progress-track">
          <div class="src__progress-fill"></div>
        </div>
      </div>
    </div>
  </div>
</section>
