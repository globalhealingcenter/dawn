{% comment %}
  Static Reviews Carousel - no schema, fully code-driven.
  Customize heading and review data below.
{% endcomment %}

<section
  class="src static-reviews-carousel"
  {% if block %}
    {{- block.shopify_attributes -}}
  {% endif %}
>
  <div class="src__inner">
    <h2 class="src__heading font-proxima">Real Stories. <span class="font-miller">Real Healing.</span></h2>

    <div class="src__carousel-outer">
      <div
        class="src__track"
        role="region"
        aria-label="Customer reviews"
        tabindex="0"
      >
        {% comment %} Review 1 {% endcomment %}
        <div class="src__card" role="listitem">
          <div class="src__stars" aria-hidden="true">
            {% for i in (1..5) %}
              <svg class="src__star" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            {% endfor %}
          </div>
          <h3 class="src__product font-proxima">Oxy-Powder</h3>
          <p class="src__text font-proxima">
            "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Aenean quis quam enim."
          </p>
          <p class="src__meta font-proxima hide-on-mobile">Carol A. | Verified Buyer</p>
          <p class="src__meta font-proxima hide-on-desktop">
            Carol A. <br>
            <span>Verified Buyer</span>
          </p>
        </div>

        {% comment %} Review 2 {% endcomment %}
