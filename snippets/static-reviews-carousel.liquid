{% comment %}
  Static Reviews Carousel - no schema, fully code-driven.
  Customize heading and review data below.
{% endcomment %}

<section
  class="src static-reviews-carousel"
  {% if block %}
    {{- block.shopify_attributes -}}
  {% endif %}
>
  <div class="src__inner">
    <h2 class="src__heading font-proxima">Healing That Speaks <span class="font-miller">for Itself.</span></h2>

    <div class="src__carousel-outer">
      <div
        class="src__track"
        role="region"
        aria-label="Customer reviews"
        tabindex="0"
      >
        {% comment %} Review 1 {% endcomment %}
        <div class="src__card" role="listitem">
          <div class="src__stars" aria-hidden="true">
            {% for i in (1..5) %}
              <svg xmlns="http://www.w3.org/2000/svg" version="1.2" viewBox="0 0 105 99" width="105" height="99">
	<style>
		.s0 { fill: #cca72c } 
	</style>
	<path fill-rule="evenodd" class="s0" d="m52.75-0.3l12.3 37.86h39.81l-32.21 23.4 12.3 37.85-32.2-23.39-32.21 23.39 12.3-37.85-32.2-23.4h39.81l12.3-37.86z"/>
</svg>
            {% endfor %}
          </div>
          <h3 class="src__product font-proxima">Ultimate Probiotic</h3>
          <p class="src__text font-proxima">
            "I struggled for years with gut issues. Ultimate Probiotic combined with aloe vera, Ultimate Enzymes, and
            Oxy-Powder changed my life. My gut has never felt better, and I finally feel like my health is back on
            track. I’m truly grateful."
          </p>
          <p class="src__meta font-proxima hide-on-mobile">Léonor N. | Verified Buyer</p>
          <p class="src__meta font-proxima hide-on-desktop">
            Léonor N. <br>
            <span>Verified Buyer</span>
          </p>
        </div>

        {% comment %} Review 2 {% endcomment %}
        <div class="src__card" role="listitem">
          <div class="src__stars" aria-hidden="true">
            {% for i in (1..5) %}
              <svg xmlns="http://www.w3.org/2000/svg" version="1.2" viewBox="0 0 105 99" width="105" height="99">
	<style>
		.s0 { fill: #cca72c } 
	</style>
	<path fill-rule="evenodd" class="s0" d="m52.75-0.3l12.3 37.86h39.81l-32.21 23.4 12.3 37.85-32.2-23.39-32.21 23.39 12.3-37.85-32.2-23.4h39.81l12.3-37.86z"/>
</svg>
            {% endfor %}
          </div>
          <h3 class="src__product font-proxima">Black Seed Oil</h3>
          <p class="src__text font-proxima">
            "I noticed a positive difference very soon after starting Black Seed Oil. I had been suffering from joint
            stiffness in my knees. Since taking it daily, it has drastically reduced."
          </p>
          <p class="src__meta font-proxima hide-on-mobile">Starr R. | Verified Buyer</p>
          <p class="src__meta font-proxima hide-on-desktop">
            Starr R. <br>
            <span>Verified Buyer</span>
          </p>
        </div>

        {% comment %} Review 3 {% endcomment %}
