{% comment %}
  Static Reviews Carousel - editable via theme customizer.
  Uses review_card blocks for unlimited reviews.
{% endcomment %}

{% assign heading = block.settings.heading | default: 'Healing That Speaks' %}
{% assign heading_span = block.settings.heading_span | default: 'for Itself.' %}
{% assign review_blocks = section.blocks | where: 'type', 'review_card' %}

<section
  class="src static-reviews-carousel"
  {% if block %}
    {{- block.shopify_attributes -}}
  {% endif %}
>
  <div class="src__inner">
    <h2 class="src__heading font-proxima">
      {% if heading != blank %}{{ heading }}{% endif %}
      {% if heading_span != blank %}<span class="font-miller">{{ heading_span }}</span>{% endif %}
    </h2>

    <div class="src__carousel-outer">
      <div
        class="src__track"
        role="region"
        aria-label="Customer reviews"
        tabindex="0"
      >
        {% if review_blocks.size > 0 %}
          {% for review_block in review_blocks %}
            {% assign prod = review_block.settings.product_name %}
            {% assign url = review_block.settings.product_url %}
            {% assign text = review_block.settings.review_text %}
            {% assign author = review_block.settings.author %}
            {% assign meta_prod = review_block.settings.meta_product %}
            {% assign star_rating = review_block.settings.star_rating | default: 5 | at_least: 1 | at_most: 5 %}
            {% assign verified_buyer_text = review_block.settings.verified_buyer_text | default: 'Verified Buyer' %}

            {% if prod != blank or text != blank %}
              <div class="src__card" role="listitem" {{ review_block.shopify_attributes }}>
                <div class="src__stars" aria-hidden="true">
                  {% for star in (1..star_rating) %}
                    <svg xmlns="http://www.w3.org/2000/svg" version="1.2" viewBox="0 0 105 99" width="105" height="99">
                      <style>.s0 { fill: #cca72c }</style>
                      <path fill-rule="evenodd" class="s0" d="m52.75-0.3l12.3 37.86h39.81l-32.21 23.4 12.3 37.85-32.2-23.39-32.21 23.39 12.3-37.85-32.2-23.4h39.81l12.3-37.86z"/>
                    </svg>
                  {% endfor %}
                </div>
                {% if prod != blank %}
                  <h3 class="src__product font-proxima">
                    {% if url != blank %}
                      <a href="{{ url }}">{{ prod }}</a>
                    {% else %}
                      {{ prod }}
                    {% endif %}
                  </h3>
                {% endif %}
                {% if text != blank %}
                  <p class="src__text font-proxima">{{ text }}</p>
                {% endif %}
                {% if author != blank %}
                  <p class="src__meta font-proxima hide-on-mobile">
                    {{ author }}
                    {% if verified_buyer_text != blank %} | {{ verified_buyer_text }}{% endif %}
                  </p>
                  <p class="src__meta font-proxima hide-on-desktop">
                    {{ author }}<br>
                    {% if meta_prod != blank %}<span>{{ meta_prod }}</span>{% endif %}
                  </p>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        {% else %}
          {% comment %} Fallback when no review_card blocks exist (e.g. after migration) {% endcomment %}
          <div class="src__card" role="listitem">
            <div class="src__stars" aria-hidden="true">
              {% for star in (1..5) %}
                <svg xmlns="http://www.w3.org/2000/svg" version="1.2" viewBox="0 0 105 99" width="105" height="99">
                  <style>.s0 { fill: #cca72c }</style>
                  <path fill-rule="evenodd" class="s0" d="m52.75-0.3l12.3 37.86h39.81l-32.21 23.4 12.3 37.85-32.2-23.39-32.21 23.39 12.3-37.85-32.2-23.4h39.81l12.3-37.86z"/>
                </svg>
              {% endfor %}
            </div>
            <h3 class="src__product font-proxima"><a href="/collections/all">Add reviews</a></h3>
            <p class="src__text font-proxima">Add "Review card" blocks in the theme customizer to display customer reviews.</p>
          </div>
        {% endif %}
      </div>

      <div
        class="src__progress"
        aria-hidden="true"
        role="progressbar"
        aria-valuenow="1"
        aria-valuemin="1"
        aria-valuemax="4"
      >
        <div class="src__progress-track">
          <div class="src__progress-fill"></div>
        </div>
      </div>
    </div>
  </div>
</section>
