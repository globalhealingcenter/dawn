{{ 'shop-by-health-goals.css' | asset_url | stylesheet_tag }}

{% assign link_blocks = section.blocks | where: 'type', 'health_goal_link' %}
{% assign col1_links = link_blocks | where: 'settings.column', '1' %}
{% assign col2_links = link_blocks | where: 'settings.column', '2' %}

{% assign has_links = false %}
{% if link_blocks.size > 0 %}
  {% assign has_links = true %}
{% endif %}

<section class="health-goals-section" {{ block.shopify_attributes }}>
  <img src="{{ 'section-bg-texture.png' | asset_url }}" alt="Section Background" class="health-goals-section__bg">
  <div class="health-goals__inner">
    <h2 class="health-goals__heading font-proxima">
      {{ block.settings.heading | default: 'Shop by' }}
      <em>{{ block.settings.heading_em | default: 'Health Goals' }}</em>
    </h2>

    <div class="health-goals__grid">
      <div class="health-goals__column">
        {% if has_links %}
          {% for link_block in section.blocks %}
            {% if link_block.type == 'health_goal_link' and link_block.settings.column == '1' %}
              <a
                href="{{ link_block.settings.url | default: '#' }}"
                class="health-goals__link{% if forloop.first %} health-goals__link--active{% endif %}{% if link_block.settings.hide_on_mobile %} mobile--hide{% endif %}"
              >
                {{ link_block.settings.title }}
              </a>
            {% endif %}
          {% endfor %}
        {% else %}

        {% endif %}
      </div>

      <div class="health-goals__divider"></div>

      <div class="health-goals__column">
        {% if has_links %}
          {% for link_block in section.blocks %}
            {% if link_block.type == 'health_goal_link' and link_block.settings.column == '2' %}
              <a
                href="{{ link_block.settings.url | default: '#' }}"
                class="health-goals__link{% if forloop.first %} health-goals__link--active{% endif %}{% if link_block.settings.hide_on_mobile %} mobile--hide{% endif %}"
              >
                {{ link_block.settings.title }}
              </a>
            {% endif %}
          {% endfor %}
        {% else %}

        {% endif %}
      </div>
    </div>

    <div class="health-goals__cta">
      <a
        href="{{ block.settings.cta_url | default: '#' }}"
        class="health-goals__button button btn-secondary"
      >
        {{ block.settings.cta_text | default: 'Shop More Health Goals' }}
      </a>
    </div>
  </div>
</section>
