{{ 'shop-by-health-goals.css' | asset_url | stylesheet_tag }}

<section class="health-goals-section" {{ block.shopify_attributes }}>
  <img src="{{ 'section-bg-texture.png' | asset_url }}" alt="Section Background" class="health-goals-section__bg">
  <div class="health-goals__inner">
    <h2 class="health-goals__heading font-proxima">
      {{ block.settings.heading | default: 'Shop by' }}
      <em>{{ block.settings.heading_em | default: 'Health Goals' }}</em>
    </h2>

    <div class="health-goals__grid">
      <div class="health-goals__column">
        <a href="/collections/gut-digestion" class="health-goals__link health-goals__link--active">Gut & Digestion</a>
        <a href="/collections/longevity-cellular-health" class="health-goals__link">Longevity & Cellular Health</a>
        <a href="/collections/detox-cleansing" class="health-goals__link">Detox & Cleansing</a>
        <a href="/collections/immune-support" class="health-goals__link">Immune Support</a>
      </div>

      <div class="health-goals__divider"></div>

      <div class="health-goals__column health-goals__column">
        <a href="/collections/brain-cognitive-health" class="health-goals__link mobile--hide"
          >Brain & Cognitive Health</a
        >
        <a href="/collections/hormones-thyroid" class="health-goals__link mobile--hide">Hormones & Thyroid</a>
        <a href="/collections/sleep-stress-mood" class="health-goals__link">Stress, Sleep & Mood</a>
        <a href="/collections/energy-performance" class="health-goals__link mobile--hide">Energy & Performance</a>
      </div>
    </div>

    <div class="health-goals__cta">
      <a
        href="{{ block.settings.cta_url | default: '#' }}"
        class="health-goals__button button btn-secondary"
      >
        {{ block.settings.cta_text | default: 'Shop More Health Goals' }}
      </a>
    </div>
  </div>
</section>
