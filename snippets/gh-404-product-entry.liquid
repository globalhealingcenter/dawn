{% assign product = shop.metaobjects.product[handle].product.value %}

<script>
gh_products['{{ product.handle }}'] = { 
  name: "{{ product.title }}",
  id: '{{ product.id }}',
  tagline: "{{ product.metafields.globalhealing.product_tagline }}",
  short_description: {{ product.description | json }},
  images: [
    {% for image in product.images %}
      {"src": "{{ image | image_url: width: 600 }}"},
    {% endfor %}}
  ]
}
</script>