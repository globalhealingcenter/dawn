{%- comment -%}
  ============================================================
  CONSENT-FIRST COOKIE BLOCKER (FULLY UPDATED)
  ============================================================
{%- endcomment -%}

<script>
(function () {
  'use strict';

  // ─── 1. CONSENT STATE ─────────────────────────────────────
  var consentState = {
    analytics: false,
    marketing: false,
    functionality: false,
  };

  if (window.__GH_CONSENT_STATE__) {
    var s = window.__GH_CONSENT_STATE__;
    consentState.analytics     = !!s.statistics;
    consentState.marketing     = !!s.marketing;
    consentState.functionality = !!s.functionality;
  }

  // ─── 2. COOKIE BLOCKLIST (UPDATED) ────────────────────────
  var BLOCKED_COOKIES = {

    // Analytics
    '_ga': 'analytics',
    '_gid': 'analytics',
    '_gat': 'analytics',
    '_gcl_au': 'analytics',
    '_hjSession': 'analytics',
    '_hjSessionUser': 'analytics',

    // Marketing (existing)
    '_fbp': 'marketing',
    '_fbc': 'marketing',
    '_pin_unauth': 'marketing',
    '_pin_3p_session': 'marketing',
    '_attn_': 'marketing',
    '_attn_bopd_': 'marketing',
    '_nb_sp_id': 'marketing',
    '_nb_sp_ses': 'marketing',
    'ttclid': 'marketing',
    '_ttp': 'marketing',
    '_scid': 'marketing',
    '_sctr': 'marketing',
    'irclickid': 'marketing',

    // ✅ NEW — Attentive
    '__attentive_': 'marketing',

    // ✅ NEW — Snapchat
    '_scsrid_r': 'marketing',

    // ✅ NEW — Microsoft/Bing
    '_uetsid': 'marketing',
    '_uetvid': 'marketing',
    'MUID': 'marketing',
    'MR': 'marketing',

    // ✅ NEW — Yahoo
    'A3': 'marketing',

    // ✅ NEW — TikTok
    'ttcsid': 'marketing',

    // ✅ NEW — Misc marketing
    'first_pla_call': 'marketing',

    // Functionality (Shogun / OpenGraph)
    '_shg_session_id': 'functionality',
    '_shg_user_id': 'functionality',
    'og_session_id': 'functionality',
  };

  // ─── 3. COOKIE INTERCEPTOR ────────────────────────────────
  var _originalCookieDescriptor = Object.getOwnPropertyDescriptor(Document.prototype, 'cookie');

  if (_originalCookieDescriptor && _originalCookieDescriptor.set) {
    Object.defineProperty(document, 'cookie', {
      configurable: true,

      get: function () {
        return _originalCookieDescriptor.get.call(document);
      },

      set: function (cookieString) {
        var cookieName = (cookieString || '').split('=')[0].trim();

        var blocked = false;
        var requiredConsent = null;

        for (var prefix in BLOCKED_COOKIES) {
          if (cookieName.indexOf(prefix) === 0) {
            requiredConsent = BLOCKED_COOKIES[prefix];
            if (!consentState[requiredConsent]) blocked = true;
            break;
          }
        }

        if (blocked) {
          if (window.__GH_DEBUG_CONSENT__) {
            console.warn('[ConsentBlocker] Blocked cookie:', cookieName);
          }
          return;
        }

        _originalCookieDescriptor.set.call(document, cookieString);
      }
    });
  }

  // ─── 4. SCRIPT DOMAIN BLOCKLIST (UPDATED) ─────────────────
  var BLOCKED_SCRIPT_DOMAINS = {

    // Analytics
    'static.hotjar.com': 'analytics',
    'script.hotjar.com': 'analytics',
    'static.clarity.ms': 'analytics',

    // Marketing
    'connect.facebook.net': 'marketing',
    'fbcdn.net': 'marketing',
    'analytics.pinterest.com': 'marketing',
    's.pinimg.com': 'marketing',
    'static.klaviyo.com': 'marketing',
    'a.klaviyo.com': 'marketing',
    'cdn.attentivemobile.com': 'marketing',
    'cdn2.attnl.com': 'marketing',
    'attn.tv': 'marketing',
    'static.northbeam.io': 'marketing',
    'd29wdpivwgcmqo.cloudfront.net': 'marketing',
    'intg.snapchat.com': 'marketing',
    'sc-static.net': 'marketing',
    'tr.snapchat.com': 'marketing',
    'ads.tiktok.com': 'marketing',
    'analytics.tiktok.com': 'marketing',

    // ✅ NEW — Microsoft/Bing
    'bat.bing.com': 'marketing',
    'clarity.ms': 'analytics',

    // ✅ NEW — Shogun
    'cdn.getshogun.com': 'functionality',
    'getshogun.com': 'functionality',
  };

  function isDomainBlocked(src) {
    if (!src) return null;
    for (var domain in BLOCKED_SCRIPT_DOMAINS) {
      if (src.indexOf(domain) !== -1) {
        var cat = BLOCKED_SCRIPT_DOMAINS[domain];
        if (!consentState[cat]) return cat;
      }
    }
    return null;
  }

  function shouldBlockNode(node) {
    if (!node || node.tagName !== 'SCRIPT') return false;
    var src = node.src || node.getAttribute('src') || '';
    return isDomainBlocked(src);
  }

  var _appendChild = Node.prototype.appendChild;
  Node.prototype.appendChild = function (node) {
    var blockedBy = shouldBlockNode(node);
    if (blockedBy) return node;
    return _appendChild.call(this, node);
  };

  var _insertBefore = Node.prototype.insertBefore;
  Node.prototype.insertBefore = function (node, ref) {
    var blockedBy = shouldBlockNode(node);
    if (blockedBy) return node;
    return _insertBefore.call(this, node, ref);
  };

  // ─── 5. CONSENT EVENT ─────────────────────────────────────
  document.addEventListener('gh:consentUpdate', function (event) {
    var d = event.detail || {};

    if (d.statistics) consentState.analytics = true;
    if (d.marketing) consentState.marketing = true;
    if (d.functionality) consentState.functionality = true;
  });

  // ─── 6. SHOPIFY PRIVACY API ───────────────────────────────
  function applyShopifyConsentAPI() {
    if (!window.Shopify || !window.Shopify.customerPrivacy) return;

    window.Shopify.customerPrivacy.setTrackingConsent({
      analytics: consentState.analytics,
      marketing: consentState.marketing,
      preferences: consentState.functionality,
      sale_of_data: consentState.marketing,
    });
  }

  if (window.Shopify && window.Shopify.customerPrivacy) {
    applyShopifyConsentAPI();
  } else {
    document.addEventListener('shopify:consent:loaded', applyShopifyConsentAPI);
  }

  document.addEventListener('gh:consentUpdate', applyShopifyConsentAPI);

})();
</script>