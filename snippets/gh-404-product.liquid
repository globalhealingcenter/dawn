<div id='content-container-404' class='pt4 px2 hide'>

	<div class="lg-flex items-center justify-center">
		<div id='gh-product-header--left' class='lg-col-4 p3 center'>

		</div>
		<div id='gh-product-header--right' class='lg-col-5'>
			<div class="pb3">

				<div id='gh-product-header--right-header'></div>

				<button class="button button--full-width disabled mb3">Not Available in Your Region</button>

				<div id='' class='bg-green-light p3'>
					<h4><i class='fa fa-exclamation-circle'></i> Not yet available to ship to your country/region.</h4>

					<h5 class='line-height-4'>
						{% if localization.country.name == 'Canada' %}
						<a href='https://globalhealing.com/collections/canadian-products'>Shop available products</a>
						{% else %}
						<a href='https://globalhealing.com/collections/collections'>Shop available products</a>
						{% endif %}
						or use the country/region dropdown to update your shipping location.
					</h5>

					<div id='gh-localization-form'>{% render 'gh-localization-form' %}</div>
				</div>

				<div id='gh-product-header--right-footer'></div>
			</div>
		</div>
	</div>

</div>

<div id='gh-product-content-container-404' class='pb4 px2'></div>

<script>
	gh_404.init();

	// product tabs
	let all_tabs = document.querySelectorAll('.info-tabs__content > div');
	let all_links = document.querySelectorAll('.info-tabs__links a');

	all_links.forEach( t => {
		t.addEventListener('click', e => {
			e.preventDefault();
			all_links.forEach( c => c.classList.remove('active') );
			all_tabs.forEach( c => c.classList.remove('active') );
			let target = document.querySelector(`.info-tabs__content [data-tab="${t.getAttribute('data-tab')}"]`);
			target.classList.add('active');
			t.classList.add('active');
		})
	})
	// end product-tabs

	// logging: {{ shop.metaobjects.product['calcium-disodium-edta'].product.value.metafields.globalhealing.product_tagline }}
	// {{ request.origin }}
	// {{ template }}
	// {{shop.url | append: share_permalink}}
	// {{ localization.country.name }}  
</script>

