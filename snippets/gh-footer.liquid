<!-- [osano] -->
<style>
    .osano-cm-widget{display: none;}
    .osano-cm-info-dialog__info p {
        font-size: 14px;
    }
</style>

<!-- REMOVE OSANO -->
{%- comment -%}
<script>
	let osano_trigger = document.querySelector('[href="#osano-cookie-drawer"]');
	if( osano_trigger ) {
		osano_trigger.addEventListener('click', e => {
			e.preventDefault();
			Osano.cm.showDrawer('osano-cm-dom-info-dialog-open')
			return false;
		})
	}
</script>
{%- endcomment -%}
<!-- [/osano] -->

<!-- CONSENTMO PREFERENCES -->
<script>
  (function () {
    function openConsentmoPreferences() {
      // Real Consentmo "Preferences" button from your DOM
      var btn =
        document.querySelector('button.cc-settings.isense-cc-settings') ||
        document.querySelector('button.cc-settings') ||
        document.querySelector('button[aria-controls="cookieconsent:settings"]');

      if (btn) {
        console.log('GH consentmo: clicking settings button', btn);
        btn.click();
        return true;
      } else {
        console.log('GH consentmo: settings button NOT found');
        return false;
      }
    }

    document.addEventListener('click', function (e) {
      var link = e.target.closest(
        'a[href="#cookie-preferences"], a[href="/#cookie-preferences"], a[href$="#cookie-preferences"], .js-cookie-preferences'
      );
      if (!link) return;

      e.preventDefault();
      console.log('GH consentmo: footer Cookie Preferences clicked', link);
      openConsentmoPreferences();
      return false;
    });
  })();
</script>



