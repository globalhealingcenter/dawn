<!-- [osano] -->
<style>
    .osano-cm-widget{display: none;}
    .osano-cm-info-dialog__info p {
        font-size: 14px;
    }
</style>

<!-- REMOVE OSANO -->
{%- comment -%}
<script>
	let osano_trigger = document.querySelector('[href="#osano-cookie-drawer"]');
	if( osano_trigger ) {
		osano_trigger.addEventListener('click', e => {
			e.preventDefault();
			Osano.cm.showDrawer('osano-cm-dom-info-dialog-open')
			return false;
		})
	}
</script>
{%- endcomment -%}
<!-- [/osano] -->

<!-- CONSENTMO PREFERENCES -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Footer "Cookie Preferences" link (menu item)
    var prefLinks = document.querySelectorAll(
      'a[href="#cookie-preferences"], a[href="/#cookie-preferences"], .js-cookie-preferences'
    );

    if (!prefLinks.length) {
      return;
    }

    function openConsentmoPreferences() {
      // This is the real Consentmo "Preferences" button
      var btn = document.querySelector(
        'button.cc-settings.isense-cc-settings, button.cc-settings, button.isense-cc-settings'
      );

      if (btn) {
        btn.click();
      } else if (window.Shopify && window.Shopify.designMode) {
        console.warn('Consentmo Preferences button not found.');
      }
    }

    prefLinks.forEach(function (link) {
      link.addEventListener('click', function (e) {
        e.preventDefault();
        openConsentmoPreferences();
        return false;
      });
    });
  });
</script>



