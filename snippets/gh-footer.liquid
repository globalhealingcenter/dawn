<!-- [osano] -->
<style>
    .osano-cm-widget{display: none;}
    .osano-cm-info-dialog__info p {
        font-size: 14px;
    }
</style>

<!-- REMOVE OSANO -->
{%- comment -%}
<script>
	let osano_trigger = document.querySelector('[href="#osano-cookie-drawer"]');
	if( osano_trigger ) {
		osano_trigger.addEventListener('click', e => {
			e.preventDefault();
			Osano.cm.showDrawer('osano-cm-dom-info-dialog-open')
			return false;
		})
	}
</script>
{%- endcomment -%}
<!-- [/osano] -->

<!-- CONSENTMO PREFERENCES -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Footer menu link + any other cookie-preferences links/buttons
    var prefTriggers = document.querySelectorAll(
      'a[href="#cookie-preferences"],' +
      'a[href="/#cookie-preferences"],' +
      'a[href*="/cookie-preferences"],' +
      '.js-cookie-preferences,' +
      '.isense-reopen-widget-button'
    );

    if (!prefTriggers.length) return;

    prefTriggers.forEach(function (el) {
      el.addEventListener('click', function (e) {
        console.log('GH consentmo: Cookie Preferences trigger clicked', el);

        // If Consentmo exposes the documented function, use it
        if (typeof window.showPreferences === 'function') {
          e.preventDefault();
          try {
            window.showPreferences(this);
            console.log('GH consentmo: showPreferences() called');
          } catch (err) {
            console.error('GH consentmo: error calling showPreferences()', err);
          }
        } else {
          // Fallback: let the link/button behave normally (go to the page)
          console.warn('GH consentmo: showPreferences() not available – falling back to normal navigation.');
        }
      });
    });
  });
</script>



