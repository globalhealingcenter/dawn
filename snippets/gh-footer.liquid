<!-- [osano] -->
<style>
    .osano-cm-widget{display: none;}
    .osano-cm-info-dialog__info p {
        font-size: 14px;
    }
</style>

<!-- REMOVE OSANO -->
{%- comment -%}
<script>
	let osano_trigger = document.querySelector('[href="#osano-cookie-drawer"]');
	if( osano_trigger ) {
		osano_trigger.addEventListener('click', e => {
			e.preventDefault();
			Osano.cm.showDrawer('osano-cm-dom-info-dialog-open')
			return false;
		})
	}
</script>
{%- endcomment -%}
<!-- [/osano] -->

<!-- CONSENTMO / Shopify cookie preferences -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    try {
      // Footer "Cookie Preferences" link(s)
      var prefLinks = document.querySelectorAll(
        'a[href="#cookie-preferences"], a[href="/#cookie-preferences"], .js-cookie-preferences'
      );

      if (!prefLinks.length) return;

      prefLinks.forEach(function (link) {
        link.addEventListener('click', function (e) {
          e.preventDefault();
          console.log('GH consentmo: footer Cookie Preferences clicked', link);

          // Primary: Shopify/Consentmo integrated banner
          if (typeof window.privacyBanner !== 'undefined' &&
              typeof window.privacyBanner.showPreferences === 'function') {
            window.privacyBanner.showPreferences();
            return false;
          }

          // Fallback: future-proof if Shopify exposes it here instead
          if (window.Shopify &&
              Shopify.customerPrivacy &&
              typeof Shopify.customerPrivacy.showPreferences === 'function') {
            Shopify.customerPrivacy.showPreferences();
            return false;
          }

          console.warn('GH consentmo: privacyBanner.showPreferences() not available');
        });
      });
    } catch (err) {
      console.error('GH consentmo: error wiring Cookie Preferences link', err);
    }
  });
</script>



<!-- gh_dawn_forms -->
