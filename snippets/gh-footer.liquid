		// initiate ordergroove custom functionality
		if( typeof og === 'object'){
			gh.shopify.ordergroove.init({{ product.selected_or_first_available_variant.id }});
		}
	</script>

{% endif %}

<!-- [osano] -->
<style>
    .osano-cm-widget{display: none;}
    .osano-cm-info-dialog__info p {
        font-size: 14px;
    }
</style>
<script>
	let osano_trigger = document.querySelector('[href="#osano-cookie-drawer"]');
	if( osano_trigger ) {
		osano_trigger.addEventListener('click', e => {
			e.preventDefault();
			Osano.cm.showDrawer('osano-cm-dom-info-dialog-open')
			return false;
		})
	}
</script>
<!-- [/osano] -->

<!-- [yotpo] -->
<script>
  // fix for yotpo number format for review counts
  document.addEventListener('DOMContentLoaded', function() {
    var reviewCounts = document.querySelectorAll('.yotpo-bottom-line-scroll-panel .yotpo-sr-bottom-line-text--right-panel');
    reviewCounts.forEach(function(el) {
      var text = el.textContent;
      var match = text.match(/(\d{4,})/);
      if (match) {
        var formatted = match[1].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        el.textContent = text.replace(match[1], formatted);
      }
    });
  });
</script>

<!-- gh_dawn_forms -->
<script>
  if( typeof gh_dawn_form !== 'undefined' )
    document.querySelectorAll('.gh_dawn_form').forEach( f => gh_dawn_form.init(f) );
</script>

