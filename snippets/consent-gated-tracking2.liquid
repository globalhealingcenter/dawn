{%- comment -%}
  ============================================================
  CONSENT-GATED COOKIE BLOCKER + MARKETING TAG LOADER
  ============================================================
  Blocks NAMED non-essential cookies/scripts until the user
  grants consent via Consentmo + Google Consent Mode v2.

  Consent categories:
    • essential      – always allowed (cart, checkout, session)
    • analytics      – Hotjar, GA, Clarity
    • marketing      – GTM, Google Ads, Klaviyo, Snapchat,
                       PostPilot, Impact Radius, Attentive,
                       TikTok, Bing, Pinterest, Facebook
    • functionality  – Rebuy, Shogun

  CHANGE LOG:
    - Unknown/unlisted cookies are now ALLOWED by default
      (fail-open), instead of being blocked as 'marketing'.
      Only cookies explicitly listed in CATEGORIZED_COOKIES
      are gated behind consent.
    - Unknown cookies are still logged to console (always on,
      not just in debug mode) so they stay visible. Check
      console for [ConsentBlocker] Auto-allowed unknown cookie
      entries periodically, especially after installing new
      apps, and add anything tracking-related to
      CATEGORIZED_COOKIES.
    - Added 'og_auth' to ESSENTIAL_COOKIES (Ordergroove auth
      cookie, required for subscription manager to load).

  Loaded only after gh:consentUpdate
  (dispatched from gcm-integration-script.liquid).
  ============================================================
{%- endcomment -%}

<script>
(function () {
  'use strict';

  // ═══════════════════════════════════════════════════════════
  // 1. CONSENT STATE
  // ═══════════════════════════════════════════════════════════
  var consentState = {
    analytics: false,
    marketing: false,
    functionality: false,
  };

  if (window.__GH_CONSENT_STATE__) {
    var s = window.__GH_CONSENT_STATE__;
    consentState.analytics     = !!s.statistics;
    consentState.marketing     = !!s.marketing;
    consentState.functionality = !!s.functionality;
  }

  // ═══════════════════════════════════════════════════════════
  // 2. ESSENTIAL COOKIE ALLOWLIST
  // ═══════════════════════════════════════════════════════════
  var ESSENTIAL_COOKIES = [
    'cart',
    'cart_sig',
    'cart_ts',
    'cart_currency',
    'checkout_token',
    'checkout',
    'checkout_session_token',
    'checkout_session_lookup',
    'dynamic_checkout_shown_on_cart',
    'keep_alive',
    'secure_customer_sig',
    'shopify_pay_redirect',
    'storefront_digest',
    '_shopify_s',
    '_shopify_y',
    '_shopify_sa_t',
    '_shopify_sa_p',
    '_orig_referrer',
    '_tracking_consent',
    '_cmp_a',
    '_secure_session_id',
    '_master_udr',
    'localization',
    'session',
    'cookie_consent',
    'consentmo_consent',
    'consentmo_',
    'og_auth',
    'og_session_id',
    'og_user_id',
    'og_',
  ];

  // Known non-essential cookies → explicit category.
  // Only cookies listed here (or in ESSENTIAL_COOKIES above)
  // are gated behind consent. Anything else is auto-allowed
  // (see getCookieCategory fallback below) but logged.
  var CATEGORIZED_COOKIES = {
    '_ga':              'analytics',
    '_gid':             'analytics',
    '_gat':             'analytics',
    '_gcl_au':          'analytics',
    '_hjSession':       'analytics',
    '_hjSessionUser':   'analytics',
    '_hj':              'analytics',
    '_clck':            'analytics',
    '_clsk':            'analytics',

    '_fbp':             'marketing',
    '_fbc':             'marketing',
    '_pin_unauth':      'marketing',
    '_pin_3p_session':  'marketing',
    '_derived_epik':    'marketing',
    '_attn_':           'marketing',
    '_attn_bopd_':      'marketing',
    '__attentive_':     'marketing',
    '_nb_sp_id':        'marketing',
    '_nb_sp_ses':       'marketing',
    'ttclid':           'marketing',
    'ttcsid':           'marketing',
    '_ttp':             'marketing',
    '_scid':            'marketing',
    '_sctr':            'marketing',
    '_scsrid_r':        'marketing',
    'irclickid':        'marketing',
    '_uetsid':          'marketing',
    '_uetvid':          'marketing',
    'MUID':             'marketing',
    'MR':               'marketing',
    'A3':               'marketing',
    'first_pla_call':   'marketing',
    '_rdt_uuid':        'marketing',
    '_kla_id':          'marketing',
    '__kla_id':         'marketing',

    '_shg_session_id':  'functionality',
    '_shg_user_id':     'functionality',
    'rebuy-':           'functionality',
  };

  function isEssential(name) {
    for (var i = 0; i < ESSENTIAL_COOKIES.length; i++) {
      if (name === ESSENTIAL_COOKIES[i] || name.indexOf(ESSENTIAL_COOKIES[i]) === 0) {
        return true;
      }
    }
    return false;
  }

  function getCookieCategory(name) {
    if (isEssential(name)) return 'essential';

    for (var prefix in CATEGORIZED_COOKIES) {
      if (name === prefix || name.indexOf(prefix) === 0) {
        return CATEGORIZED_COOKIES[prefix];
      }
    }

    // Unknown cookie → ALLOW by default (fail-open).
    // Still logged below so unlisted cookies stay visible;
    // review console output periodically and move anything
    // tracking-related into CATEGORIZED_COOKIES above.
    if (window.console && window.console.info) {
      console.info('[ConsentBlocker] Auto-allowed unknown cookie:', name);
    }
    return 'essential';
  }

  // ═══════════════════════════════════════════════════════════
  // 3. COOKIE INTERCEPTOR + PENDING QUEUE
  // ═══════════════════════════════════════════════════════════
  var pendingCookies = [];
  var _cookieDesc = Object.getOwnPropertyDescriptor(Document.prototype, 'cookie');

  if (_cookieDesc && _cookieDesc.set) {
    Object.defineProperty(document, 'cookie', {
      configurable: true,

      get: function () {
        return _cookieDesc.get.call(document);
      },

      set: function (cookieString) {
        var name = (cookieString || '').split('=')[0].trim();
        var category = getCookieCategory(name);

        if (category === 'essential') {
          _cookieDesc.set.call(document, cookieString);
          return;
        }

        if (!consentState[category]) {
          pendingCookies.push({ str: cookieString, category: category });
          if (window.__GH_DEBUG_CONSENT__) {
            console.warn('[ConsentBlocker] Blocked cookie:', name, '(' + category + ')');
          }
          return;
        }

        _cookieDesc.set.call(document, cookieString);
      },
    });
  }

  function replayPendingCookies() {
    if (!_cookieDesc || !_cookieDesc.set) return;
    var remaining = [];
    for (var i = 0; i < pendingCookies.length; i++) {
      var entry = pendingCookies[i];
      if (consentState[entry.category]) {
        _cookieDesc.set.call(document, entry.str);
      } else {
        remaining.push(entry);
      }
    }
    pendingCookies = remaining;
  }

  // ═══════════════════════════════════════════════════════════
  // 4. SCRIPT DOMAIN BLOCKLIST (single Node.prototype override)
  // ═══════════════════════════════════════════════════════════
  var BLOCKED_SCRIPT_DOMAINS = {
    // Analytics
    'static.hotjar.com':          'analytics',
    'script.hotjar.com':          'analytics',
    'static.clarity.ms':          'analytics',
    'clarity.ms':                 'analytics',

    // Marketing — Google
    'googletagmanager.com':       'marketing',

    // Marketing — Facebook / Meta
    'connect.facebook.net':       'marketing',
    'fbcdn.net':                  'marketing',

    // Marketing — Pinterest
    'analytics.pinterest.com':    'marketing',
    's.pinimg.com':               'marketing',

    // Marketing — Klaviyo
    'static.klaviyo.com':         'marketing',
    'a.klaviyo.com':              'marketing',

    // Marketing — Attentive
    'cdn.attentivemobile.com':    'marketing',
    'cdn2.attnl.com':             'marketing',
    'attn.tv':                    'marketing',

    // Marketing — Northbeam
    'static.northbeam.io':        'marketing',
    'd29wdpivwgcmqo.cloudfront.net': 'marketing',

    // Marketing — Snapchat
    'intg.snapchat.com':          'marketing',
    'sc-static.net':              'marketing',
    'tr.snapchat.com':            'marketing',

    // Marketing — TikTok
    'ads.tiktok.com':             'marketing',
    'analytics.tiktok.com':       'marketing',

    // Marketing — Microsoft / Bing
    'bat.bing.com':               'marketing',

    // Marketing — PostPilot
    'xp2023-pix.s3.amazonaws.com': 'marketing',

    // Functionality — Shogun
    'cdn.getshogun.com':          'functionality',
    'getshogun.com':              'functionality',
  };

  function getBlockedCategory(src) {
    if (!src) return null;
    for (var domain in BLOCKED_SCRIPT_DOMAINS) {
      if (src.indexOf(domain) !== -1) {
        var cat = BLOCKED_SCRIPT_DOMAINS[domain];
        if (!consentState[cat]) return cat;
      }
    }
    return null;
  }

  function shouldBlockNode(node) {
    if (!node || node.tagName !== 'SCRIPT') return null;
    var src = node.src || node.getAttribute('src') || '';
    return getBlockedCategory(src);
  }

  var _appendChild  = Node.prototype.appendChild;
  var _insertBefore = Node.prototype.insertBefore;

  Node.prototype.appendChild = function (node) {
    if (shouldBlockNode(node)) {
      if (window.__GH_DEBUG_CONSENT__) {
        console.warn('[ConsentBlocker] Blocked script:', node.src || node.getAttribute('src'));
      }
      return node;
    }
    return _appendChild.call(this, node);
  };

  Node.prototype.insertBefore = function (node, ref) {
    if (shouldBlockNode(node)) {
      if (window.__GH_DEBUG_CONSENT__) {
        console.warn('[ConsentBlocker] Blocked script:', node.src || node.getAttribute('src'));
      }
      return node;
    }
    return _insertBefore.call(this, node, ref);
  };

  // ═══════════════════════════════════════════════════════════
  // 5. TAG / SCRIPT LOADERS
  // ═══════════════════════════════════════════════════════════
  var loaded = {
    gtm: false,
    googleAds: false,
    postPilot: false,
    klaviyo: false,
    hotjar: false,
    rebuy: false,
    snapchat: false,
  };

  var GTM_CONTAINER_ID  = 'GTM-N233MFC3';
  var GOOGLE_ADS_ID     = 'AW-683425101';
  var SNAPCHAT_PIXEL_ID = '18cb733b-7c2e-4e14-92c5-2fc11903c39a';

  function loadScript(src, attrs) {
    if (document.querySelector('script[src="' + src + '"]')) return;
    var s   = document.createElement('script');
    s.src   = src;
    s.async = true;
    if (attrs) {
      Object.keys(attrs).forEach(function (key) {
        s.setAttribute(key, attrs[key]);
      });
    }
    document.head.appendChild(s);
  }

  // ── Google Ads ────────────────────────────────────────────
  function loadGoogleAds() {
    if (loaded.googleAds || document.querySelector('script[src*="gtag/js?id=' + GOOGLE_ADS_ID + '"]')) return;
    loaded.googleAds = true;
    loadScript('https://www.googletagmanager.com/gtag/js?id=' + GOOGLE_ADS_ID, null);
    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
    window.gtag('js', new Date());
    window.gtag('config', GOOGLE_ADS_ID);
  }

  // ── GTM ───────────────────────────────────────────────────
  function loadGTM() {
    if (loaded.gtm || document.querySelector('script[src*="googletagmanager.com/gtm.js"]')) return;
    loaded.gtm = true;

    (function (w, d, s, l, i) {
      w[l] = w[l] || [];
      w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      var f  = d.getElementsByTagName(s)[0],
          j  = d.createElement(s),
          dl = l !== 'dataLayer' ? '&l=' + l : '';
      j.async = true;
      j.src   = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
      f.parentNode.insertBefore(j, f);
    })(window, document, 'script', 'dataLayer', GTM_CONTAINER_ID);

    (function appendGtmNoscript() {
      if (document.getElementById('gtm-noscript-iframe')) return;
      var noscript = document.createElement('noscript');
      noscript.id  = 'gtm-noscript-iframe';
      var iframe   = document.createElement('iframe');
      iframe.src   = 'https://www.googletagmanager.com/ns.html?id=' + GTM_CONTAINER_ID;
      iframe.height = 0;
      iframe.width  = 0;
      iframe.style.display    = 'none';
      iframe.style.visibility = 'hidden';
      noscript.appendChild(iframe);
      if (document.body) {
        document.body.insertBefore(noscript, document.body.firstChild);
      } else {
        document.addEventListener('DOMContentLoaded', function () {
          document.body.insertBefore(noscript, document.body.firstChild);
        });
      }
    })();
  }

  // ── PostPilot ─────────────────────────────────────────────
  function loadPostPilot() {
    if (loaded.postPilot || document.querySelector('script[src*="xp2023-pix.s3.amazonaws.com"]')) return;
    loaded.postPilot = true;
    loadScript('https://xp2023-pix.s3.amazonaws.com/px_4W5x6.js', null);
  }

  // ── Impact Radius Cookie ──────────────────────────────────
  function loadImpactRadiusCookie() {
    var cookieName = 'irclickid';
    var paramValue = new URLSearchParams(window.location.search).get(cookieName);
    if (!paramValue) return;
    var expirationTime = 2592000 * 1000;
    var date = new Date();
    date.setTime(date.getTime() + expirationTime);
    document.cookie =
      cookieName + '=' + paramValue +
      '; expires=' + date.toUTCString() +
      '; path=/; domain=.' + location.hostname.replace(/^www\./i, '');
  }

  // ── Klaviyo ───────────────────────────────────────────────
  function loadKlaviyo() {
    if (loaded.klaviyo) return;
    loaded.klaviyo = true;
    loadScript('https://a.klaviyo.com/media/js/onsite/onsite.js', null);
    var check = setInterval(function () {
      if (!window.klaviyo) return;
      clearInterval(check);
      var klaviyo = window.klaviyo || [];
      klaviyo.init({ account: 'YeibUN', platform: 'shopify' });
      klaviyo.enable('backinstock', {
        trigger: {
          product_page_text: 'Notify Me When Available',
          product_page_class: 'button',
          product_page_text_align: 'center',
          product_page_margin: '0px',
          alternate_anchor: 'out-of-stock-form-signup',
          replace_anchor: false,
        },
        modal: {
          headline: '{product_name}',
          body_content: 'Register to receive a notification when this item comes back in stock.',
          email_field_label: 'Email',
          button_label: 'Notify me when available',
          subscription_success_label: "You're in! We'll let you know when it's back.",
          footer_content: '',
          drop_background_color: '#000',
          background_color: '#fff',
          text_color: '#222',
          button_text_color: '#fff',
          button_background_color: '#21472D',
          close_button_color: '#ccc',
          error_background_color: '#fcd6d7',
          error_text_color: '#C72E2F',
          success_background_color: '#d3efcd',
          success_text_color: '#21472D',
        },
      });
    }, 100);
    setTimeout(function () { clearInterval(check); }, 10000);
  }

  // ── Hotjar ────────────────────────────────────────────────
  function loadHotjar() {
    if (loaded.hotjar || window.hj) return;
    loaded.hotjar = true;
    (function (h, o, t, j, a, r) {
      h.hj = h.hj || function () { (h.hj.q = h.hj.q || []).push(arguments); };
      h._hjSettings = { hjid: 6443824, hjsv: 6 };
      a = o.getElementsByTagName('head')[0];
      r = o.createElement('script');
      r.async = 1;
      r.src = t + h._hjSettings.hjid + j + h._hjSettings.hjsv;
      a.appendChild(r);
    })(window, document, 'https://static.hotjar.com/c/hotjar-', '.js?sv=');
  }

  // ── Rebuy ─────────────────────────────────────────────────
  function loadRebuy() {
    if (loaded.rebuy || document.querySelector('script[src*="cdn.rebuyengine.com/onsite/js/rebuy.js"]')) return;
    loaded.rebuy = true;
    loadScript('https://cdn.rebuyengine.com/onsite/js/rebuy.js?shop={{ shop.permanent_domain }}', null);
  }

  // ── Snapchat ──────────────────────────────────────────────
  function loadSnapchatPixel() {
    if (loaded.snapchat || document.querySelector('script[src*="shopify-scevent-init"]')) return;
    loaded.snapchat = true;
    loadScript(
      'https://intg.snapchat.com/shopify/shopify-scevent-init.js?id=' +
        SNAPCHAT_PIXEL_ID +
        '&shop={{ shop.permanent_domain }}',
      null
    );
  }

  // ═══════════════════════════════════════════════════════════
  // 6. APPLY CONSENT (loads scripts + replays cookies)
  // ═══════════════════════════════════════════════════════════
  function applyConsent(consent) {
    if (!consent) return;

    if (consent.marketing) {
      consentState.marketing = true;
      loadGoogleAds();
      loadGTM();
      loadPostPilot();
      loadImpactRadiusCookie();
      loadKlaviyo();
      loadSnapchatPixel();
    }

    if (consent.statistics) {
      consentState.analytics = true;
      loadHotjar();
    }

    if (consent.functionality) {
      consentState.functionality = true;
    }

    if (consent.marketing || consent.functionality) {
      loadRebuy();
    }

    replayPendingCookies();
  }

  // ═══════════════════════════════════════════════════════════
  // 7. SHOPIFY CUSTOMER PRIVACY API
  // ═══════════════════════════════════════════════════════════
  function applyShopifyConsentAPI() {
    if (!window.Shopify || !window.Shopify.customerPrivacy) return;
    window.Shopify.customerPrivacy.setTrackingConsent({
      analytics:    consentState.analytics,
      marketing:    consentState.marketing,
      preferences:  consentState.functionality,
      sale_of_data: consentState.marketing,
    });
  }

  // ═══════════════════════════════════════════════════════════
  // 8. EVENT LISTENERS
  // ═══════════════════════════════════════════════════════════
  document.addEventListener('gh:consentUpdate', function (event) {
    applyConsent(event.detail || {});
    applyShopifyConsentAPI();
  });

  if (window.Shopify && window.Shopify.customerPrivacy) {
    applyShopifyConsentAPI();
  } else {
    document.addEventListener('shopify:consent:loaded', applyShopifyConsentAPI);
  }

  // ═══════════════════════════════════════════════════════════
  // 9. REHYDRATE RETURNING VISITOR CONSENT
  // ═══════════════════════════════════════════════════════════
  if (window.__GH_CONSENT_STATE__) {
    applyConsent(window.__GH_CONSENT_STATE__);
  }

})();
</script>