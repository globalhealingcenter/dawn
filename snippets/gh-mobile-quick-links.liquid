{%- comment -%}
  Mobile quick links (scrollable, sticky under header)
  Requires a Navigation menu with handle: mobile-quick-links
{%- endcomment -%}

{%- assign mq_menu = linklists['mobile-quick-links'] | default: linklists.mobile-quick-links -%}
{%- if mq_menu and mq_menu.links.size > 0 -%}
<nav class="mobile-quicklinks" role="navigation" aria-label="Quick links">
  <div class="mq-inner">
    <ul class="mq-list" role="list">
      {%- for link in mq_menu.links -%}
        {%- assign is_active = link.active | default: false -%}
        <li class="mq-item">
          <a
            class="mq-link{% if is_active %} is-active{% endif %}"
            href="{{ link.url }}"
            {% if is_active %}aria-current="page"{% endif %}
          >
            {{ link.title }}
          </a>
        </li>
      {%- endfor -%}
    </ul>

    <!-- edge fades -->
    <div class="mq-fade mq-fade--left" aria-hidden="true"></div>
    <div class="mq-fade mq-fade--right" aria-hidden="true"></div>
  </div>
</nav>
{%- endif -%}

<style>

/* ========= Mobile Quick Links ========= */
@media (max-width: 749px) {
  :root {
    --mq-header-offset: 56px;
  }

  .mobile-quicklinks,
  .mobile-quicklinks--inline {
    position: static;
    top: auto;
    background: var(--gh-color-green, #21472D); /* green banner background */
    border: 0;
    z-index: auto;
  }

  .mobile-quicklinks .mq-inner {
    position: relative;
    padding: 6px 12px;
  }

  .mq-list {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mq-list::-webkit-scrollbar { display: none; }

  .mq-item { flex: 0 0 auto; scroll-snap-align: start; }

  .mq-link {
    display: inline-block;
    padding: 0;
    border: 0;
    background: transparent;
    font-size: 12px;              /* font size */
    font-weight: 500;
    color: #fff;                  /* white text */
    text-decoration: none;        /* no underline */
    white-space: nowrap;
    line-height: 1.4;
  }

  .mq-link:hover {
    opacity: 0.85; /* subtle hover effect */
  }

  .mq-link.is-active {
    font-weight: 600;
    border-bottom: 2px solid #fff; /* underline active in white */
    padding-bottom: 2px;
  }

  .mq-fade { display: none; }
}

/* ========= Hide on desktop ========= */
@media (min-width: 750px) {
  .mobile-quicklinks { display: none; }
}


</style>

<script>
(function () {
  // Adjust selectors if your classes differ
  var nav = document.querySelector('.gh-mobile-nav .mq-inner') ||
            document.querySelector('.mobile-quicklinks .mq-inner');
  if (!nav) return;

  var KEY = 'gh-mobile-nav:scrollLeft';

  // --- Restore previous scroll position (if any) ---
  var saved = sessionStorage.getItem(KEY);
  if (saved !== null) nav.scrollLeft = parseInt(saved, 10);

  // --- Persist while user scrolls / taps a link ---
  function save() { sessionStorage.setItem(KEY, nav.scrollLeft); }
  nav.addEventListener('scroll', save, { passive: true });
  nav.addEventListener('click', function (e) {
    var a = e.target.closest('a');
    if (a) save();
  });

  // Handle bfcache restores (Safari/Firefox)
  window.addEventListener('pageshow', function (e) {
    if (e.persisted) {
      var s = sessionStorage.getItem(KEY);
      if (s !== null) nav.scrollLeft = parseInt(s, 10);
    }
  });

  // --- Optional: ensure the active item is visible/centered on load ---
  var links = nav.querySelectorAll('a[href]');
  var here  = location.pathname.replace(/\/+$/, '');
  var active = null;

  links.forEach(function (a) {
    var path = new URL(a.getAttribute('href'), location.origin).pathname.replace(/\/+$/, '');
    if (path === here) active = a;
  });

  if (!saved && active) {
    // only center if no saved scroll position to respect user’s last place
    active.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'auto' });
  }
})();
</script>
