{%- comment -%}
  Mobile quick links (scrollable, sticky under header)
  Requires a Navigation menu with handle: mobile-quick-links
{%- endcomment -%}

{%- assign mq_menu = linklists['mobile-quick-links'] | default: linklists.mobile-quick-links -%}
{%- if mq_menu and mq_menu.links.size > 0 -%}
<nav class="mobile-quicklinks" role="navigation" aria-label="Quick links">
  <div class="mq-inner">
    <ul class="mq-list" role="list">
      {%- for link in mq_menu.links -%}
        {%- assign is_active = link.active | default: false -%}
        <li class="mq-item">
          <a
            class="mq-link{% if is_active %} is-active{% endif %}"
            href="{{ link.url }}"
            {% if is_active %}aria-current="page"{% endif %}
          >
            {{ link.title }}
          </a>
        </li>
      {%- endfor -%}
    </ul>

    <!-- edge fades -->
    <div class="mq-fade mq-fade--left" aria-hidden="true"></div>
    <div class="mq-fade mq-fade--right" aria-hidden="true"></div>
  </div>
</nav>
{%- endif -%}

<style>

/* ========= Mobile Quick Links ========= */
@media (max-width: 749px) {
  :root {
    --mq-header-offset: 56px;
  }

  .mobile-quicklinks,
  .mobile-quicklinks--inline {
    position: static;
    top: auto;
    background: var(--gh-color-green, #21472D); /* green banner background */
    border: 0;
    z-index: auto;
  }

  .mobile-quicklinks .mq-inner {
    position: relative;
    padding: 6px 12px;
  }

  .mq-list {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mq-list::-webkit-scrollbar { display: none; }

  .mq-item { flex: 0 0 auto; scroll-snap-align: start; }

  .mq-link {
    display: inline-block;
    padding: 0;
    border: 0;
    background: transparent;
    font-size: 12px;              /* font size */
    font-weight: 500;
    color: #fff;                  /* white text */
    text-decoration: none;        /* no underline */
    white-space: nowrap;
    line-height: 1.4;
  }

  .mq-link:hover {
    opacity: 0.85; /* subtle hover effect */
  }

  .mq-link.is-active {
    font-weight: 600;
    border-bottom: 2px solid #fff; /* underline active in white */
    padding-bottom: 2px;
  }

  .mq-fade { display: none; }
}

/* ========= Hide on desktop ========= */
@media (min-width: 750px) {
  .mobile-quicklinks { display: none; }
}


</style>

<script>
(function () {
  // --- Helpers ---
  function norm(path) { return (new URL(path, location.origin).pathname).replace(/\/+$/,'') || '/'; }

  function findNav() {
    // Adjust selector if your structure differs
    return document.querySelector('.gh-mobile-nav .mq-inner') ||
           document.querySelector('.mobile-quicklinks .mq-inner') ||
           null;
  }

  function centerLink(nav, link) {
    if (!nav || !link) return;
    var prev = nav.style.scrollBehavior;
    nav.style.scrollBehavior = 'auto'; // jump immediately
    var left = link.offsetLeft - (nav.clientWidth - link.clientWidth) / 2;
    nav.scrollLeft = Math.max(0, left);
    nav.style.scrollBehavior = prev || '';
  }

  var KEY_LAST = 'gh:mqnav:lastClicked';

  // 1) Record which tab was clicked
  document.addEventListener('click', function (e) {
    var a = e.target.closest('.gh-mobile-nav a, .mobile-quicklinks a');
    if (!a) return;
    try { sessionStorage.setItem(KEY_LAST, norm(a.href)); } catch (_) {}
  }, true);

  // 2) On load, center last clicked tab; if none, center the active tab
  function init() {
    var nav = findNav();
    if (!nav) return;

    var targetPath = sessionStorage.getItem(KEY_LAST) || norm(location.pathname);
    var links = nav.querySelectorAll('a[href]');
    var target = null;

    links.forEach(function (a) {
      if (!target && norm(a.href) === targetPath) target = a;
    });

    // Center over several frames to win against late reflows
    var tries = 0;
    (function tick(){
      centerLink(nav, target);
      if (++tries < 8) requestAnimationFrame(tick);
    })();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  // Handle bfcache restores
  window.addEventListener('pageshow', function (e) {
    if (e.persisted) init();
  });

  // If your header renders late (sections), observe and run once when nav appears
  var mo = new MutationObserver(function(){
    var nav = findNav();
    if (nav) { init(); mo.disconnect(); }
  });
  mo.observe(document.documentElement, { childList: true, subtree: true });
})();
</script>
