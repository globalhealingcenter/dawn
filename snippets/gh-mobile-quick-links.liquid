{%- comment -%}
  Mobile quick links (scrollable, sticky under header)
  Tries these handles in order: mobile-quick-links, gh-mobile-nav, mobile-nav
{%- endcomment -%}

{%- assign mq_menu = linklists['mobile-quick-links'] -%}
{%- if mq_menu == nil or mq_menu.links.size == 0 -%}
  {%- assign mq_menu = linklists['gh-mobile-nav'] -%}
{%- endif -%}
{%- if mq_menu == nil or mq_menu.links.size == 0 -%}
  {%- assign mq_menu = linklists['mobile-nav'] -%}
{%- endif -%}

<nav class="gh-mobile-nav mobile-quicklinks mobile-quicklinks--inline" role="navigation" aria-label="Mobile quick nav">
  <div class="mq-inner" id="gh-ql">
    {%- if mq_menu and mq_menu.links.size > 0 -%}
      {%- for link in mq_menu.links -%}
        <a href="{{ link.url }}" class="mq-link{% if link.active or link.child_active %} is-active{% endif %}">
          {{ link.title }}
        </a>
      {%- endfor -%}
    {%- else -%}
      <!-- No menu found for: mobile-quick-links / gh-mobile-nav / mobile-nav -->
    {%- endif -%}
  </div>
</nav>

<style>
/* ========= Mobile Quick Links ========= */
@media (max-width: 749px) {
  .mobile-quicklinks,
  .mobile-quicklinks--inline {
    position: static;
    background: var(--gh-color-green, #21472D);
  }
  .mobile-quicklinks .mq-inner {
    display: flex;                 /* lay out links in a row */
    gap: 20px;                     /* space between links */
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: none;
    padding: 6px 12px;
  }
  .mobile-quicklinks .mq-inner::-webkit-scrollbar { display: none; }

  .mq-link {
    display: inline-block;
    font-size: 12px;
    font-weight: 500;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
    line-height: 1.4;
  }
  .mq-link:hover { opacity: .85; }
  .mq-link.is-active {
    font-weight: 600;
    border-bottom: 2px solid #fff;
    padding-bottom: 2px;
  }
}

/* ========= Hide on desktop ========= */
@media (min-width: 750px) {
  .mobile-quicklinks { display: none; }
}
</style>

<script>
/* Center the active item on load (simple + reliable). Remove older scroll scripts. */
(function(){
  function lane(){ return document.getElementById('gh-ql'); }
  function centerActive(){
    var s = lane(); if (!s) return;
    var a = s.querySelector('.is-active');
    if (!a) return;
    var left = a.offsetLeft - (s.clientWidth - a.clientWidth)/2;
    s.style.scrollBehavior = 'auto';
    s.scrollLeft = Math.max(0, left);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', centerActive, { once:true });
  } else {
    centerActive();
  }
  window.addEventListener('pageshow', function(e){ if (e.persisted) centerActive(); });
})();
</script>
