{%- comment -%}
  Mobile quick links (scrollable, sticky under header)
  Requires a Navigation menu with handle: mobile-quick-links
{%- endcomment -%}

{%- assign mq_menu = linklists['mobile-quick-links'] | default: linklists.mobile-quick-links -%}
{%- if mq_menu and mq_menu.links.size > 0 -%}
<nav class="mobile-quicklinks" role="navigation" aria-label="Quick links">
  <div class="mq-inner">
    <ul class="mq-list" role="list">
      {%- for link in mq_menu.links -%}
        {%- assign is_active = link.active | default: false -%}
        <li class="mq-item">
          <a
            class="mq-link{% if is_active %} is-active{% endif %}"
            href="{{ link.url }}"
            {% if is_active %}aria-current="page"{% endif %}
          >
            {{ link.title }}
          </a>
        </li>
      {%- endfor -%}
    </ul>

    <!-- edge fades -->
    <div class="mq-fade mq-fade--left" aria-hidden="true"></div>
    <div class="mq-fade mq-fade--right" aria-hidden="true"></div>
  </div>
</nav>
{%- endif -%}

<style>

/* ========= Mobile Quick Links ========= */
@media (max-width: 749px) {
  :root {
    --mq-header-offset: 56px;
    --mq-bg: var(--gh-color-cream, #F9F2E8);
    --mq-pill-text: var(--gh-color-green-dark, #00260f);
    --mq-pill-text-active: var(--gh-color-green, #21472D);
  }

  /* default sticky mode (if used outside header) */
  .mobile-quicklinks {
    position: sticky;
    top: var(--mq-header-offset);
    z-index: 40;
    background: transparent;
    border: 0;
  }

  /* inline mode (if rendered inside header) */
  .mobile-quicklinks--inline {
    position: static;
    top: auto;
    background: transparent;
    border: 0;
    z-index: auto;
  }

  /* wrapper */
  .mobile-quicklinks .mq-inner {
    position: relative;
    padding: 6px 12px; /* tighter spacing like Honest */
  }

  /* horizontal list */
  .mq-list {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    list-style: none; /* remove bullets */
    margin: 0;
    padding: 0;
  }
  .mq-list::-webkit-scrollbar { display: none; }

  .mq-item { flex: 0 0 auto; scroll-snap-align: start; }

