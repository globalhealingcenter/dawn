{%- comment -%}
  Mobile quick links (scrollable, sticky under header)
  Requires a Navigation menu with handle: mobile-quick-links
{%- endcomment -%}

{%- assign mq_menu = linklists['mobile-quick-links'] | default: linklists.mobile-quick-links -%}
{%- if mq_menu and mq_menu.links.size > 0 -%}
<nav class="mobile-quicklinks" role="navigation" aria-label="Quick links">
  <div class="mq-inner">
    <ul class="mq-list" role="list">
      {%- for link in mq_menu.links -%}
        {%- assign is_active = link.active | default: false -%}
        <li class="mq-item">
          <a
            class="mq-link{% if is_active %} is-active{% endif %}"
            href="{{ link.url }}"
            {% if is_active %}aria-current="page"{% endif %}
          >
            {{ link.title }}
          </a>
        </li>
      {%- endfor -%}
    </ul>

    <!-- edge fades -->
    <div class="mq-fade mq-fade--left" aria-hidden="true"></div>
    <div class="mq-fade mq-fade--right" aria-hidden="true"></div>
  </div>
</nav>
{%- endif -%}

<style>

/* ========= Mobile Quick Links ========= */
@media (max-width: 749px) {
  :root {
    --mq-header-offset: 56px;
  }

  .mobile-quicklinks,
  .mobile-quicklinks--inline {
    position: static;
    top: auto;
    background: var(--gh-color-green, #21472D); /* green banner background */
    border: 0;
    z-index: auto;
  }

  .mobile-quicklinks .mq-inner {
    position: relative;
    padding: 6px 12px;
  }

  .mq-list {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mq-list::-webkit-scrollbar { display: none; }

  .mq-item { flex: 0 0 auto; scroll-snap-align: start; }

  .mq-link {
    display: inline-block;
    padding: 0;
    border: 0;
    background: transparent;
    font-size: 12px;              /* font size */
    font-weight: 500;
    color: #fff;                  /* white text */
    text-decoration: none;        /* no underline */
    white-space: nowrap;
    line-height: 1.4;
  }

  .mq-link:hover {
    opacity: 0.85; /* subtle hover effect */
  }

  .mq-link.is-active {
    font-weight: 600;
    border-bottom: 2px solid #fff; /* underline active in white */
    padding-bottom: 2px;
  }

  .mq-fade { display: none; }
}

/* ========= Hide on desktop ========= */
@media (min-width: 750px) {
  .mobile-quicklinks { display: none; }
}


</style>

<script>
(function () {
  var KEY = 'gh:mqnav:lastIndex';
  var RESTORE_MS = 1600;   // keep re-centering for this long
  var TICK_MS    = 40;

  // ---- helpers ----
  function findScroller() {
    // your classes first
    var s = document.querySelector('.gh-mobile-nav .mq-inner') ||
            document.querySelector('.mobile-quicklinks .mq-inner');
    if (s) return s;

    // fallbacks: first horizontally scrollable row with links near the header
    var candidates = document.querySelectorAll(
      'header nav, header [role="navigation"], nav, .mq-inner, .mobile-quicklinks, .gh-mobile-nav'
    );
    for (var i = 0; i < candidates.length; i++) {
      var el = candidates[i];
      var cs = getComputedStyle(el);
      if (el.querySelectorAll('a[href]').length >= 3 &&
          el.scrollWidth > el.clientWidth &&
          (cs.overflowX === 'auto' || cs.overflowX === 'scroll' || cs.overflowX === 'overlay')) {
        return el;
      }
      var inner = el.querySelector(':scope > .mq-inner, :scope > .scroller, :scope > ul, :scope > div');
      if (inner) {
        var cs2 = getComputedStyle(inner);
        if (inner.querySelectorAll('a[href]').length >= 3 &&
            inner.scrollWidth > inner.clientWidth &&
            (cs2.overflowX === 'auto' || cs2.overflowX === 'scroll' || cs2.overflowX === 'overlay')) {
          return inner;
        }
      }
    }
    return null;
  }

  function getLinks(s){ return Array.from(s.querySelectorAll('a[href]')).filter(a => a.offsetParent !== null); }
  function indexOf(s, a){ return getLinks(s).indexOf(a); }

  function centerLink(s, a){
    if (!s || !a) return;
    var prevSnap = s.style.scrollSnapType;
    var prevBeh  = s.style.scrollBehavior;
    s.style.scrollSnapType = 'none';
    s.style.scrollBehavior = 'auto';
    var x = a.offsetLeft - (s.clientWidth - a.clientWidth)/2;
    s.scrollLeft = Math.max(0, x);
    s.style.scrollSnapType = prevSnap || '';
    s.style.scrollBehavior = prevBeh  || '';
  }

  // ---- save index early (before navigation) ----
  function saveIndexFromEvent(e){
    var a = e.target && e.target.closest('a[href]');
    if (!a) return;
    var scroller = a.closest('.mq-inner') || findScroller();
    if (!scroller) return;
    var idx = indexOf(scroller, a);
    if (idx >= 0) { try { sessionStorage.setItem(KEY, String(idx)); } catch(_){} }
  }
  document.addEventListener('pointerdown', saveIndexFromEvent, true);
  document.addEventListener('touchstart',  saveIndexFromEvent, true);  // iOS Safari
  document.addEventListener('mousedown',   saveIndexFromEvent, true);  // desktop

  // ---- restore on next page ----
  function restore(){
    var s = findScroller();
    if (!s) return;

    var idxStr = sessionStorage.getItem(KEY);
    var links  = getLinks(s);
    var target = null;

    if (idxStr != null) {
      var idx = parseInt(idxStr, 10);
      if (!isNaN(idx) && idx >= 0 && idx < links.length) target = links[idx];
    }
    // fallback: match current page path
    if (!target) {
      var here = location.pathname.replace(/\/+$/,'');
      target = links.find(a => new URL(a.href, location.origin).pathname.replace(/\/+$/,'') === here) || links[0];
    }

    var start = performance.now();
    (function loop(){
      centerLink(s, target);
      if (performance.now() - start < RESTORE_MS) setTimeout(loop, TICK_MS);
    })();
  }

  function start(){
    var s = findScroller();
    if (s) restore();
    else {
      var mo = new MutationObserver(function(){
        var s2 = findScroller(); if (s2) { restore(); mo.disconnect(); }
      });
      mo.observe(document.documentElement, { childList: true, subtree: true });
    }
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
  else start();

  window.addEventListener('pageshow', function(e){ if (e.persisted) start(); });
})();
</script>
