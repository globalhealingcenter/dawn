{%- comment -%}
  Mobile quick links (scrollable, sticky under header)
  Requires a Navigation menu with handle: mobile-quick-links
{%- endcomment -%}

{%- assign mq_menu = linklists['mobile-quick-links'] | default: linklists.mobile-quick-links -%}
{%- if mq_menu and mq_menu.links.size > 0 -%}
<nav class="mobile-quicklinks" role="navigation" aria-label="Quick links">
  <div class="mq-inner">
    <ul class="mq-list" role="list">
      {%- for link in mq_menu.links -%}
        {%- assign is_active = link.active | default: false -%}
        <li class="mq-item">
          <a
            class="mq-link{% if is_active %} is-active{% endif %}"
            href="{{ link.url }}"
            {% if is_active %}aria-current="page"{% endif %}
          >
            {{ link.title }}
          </a>
        </li>
      {%- endfor -%}
    </ul>

    <!-- edge fades -->
    <div class="mq-fade mq-fade--left" aria-hidden="true"></div>
    <div class="mq-fade mq-fade--right" aria-hidden="true"></div>
  </div>
</nav>
{%- endif -%}

<style>

/* ========= Mobile Quick Links ========= */
@media (max-width: 749px) {
  :root {
    --mq-header-offset: 56px;
  }

  .mobile-quicklinks,
  .mobile-quicklinks--inline {
    position: static;
    top: auto;
    background: var(--gh-color-green, #21472D); /* green banner background */
    border: 0;
    z-index: auto;
  }

  .mobile-quicklinks .mq-inner {
    position: relative;
    padding: 6px 12px;
  }

  .mq-list {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mq-list::-webkit-scrollbar { display: none; }

  .mq-item { flex: 0 0 auto; scroll-snap-align: start; }

  .mq-link {
    display: inline-block;
    padding: 0;
    border: 0;
    background: transparent;
    font-size: 12px;              /* font size */
    font-weight: 500;
    color: #fff;                  /* white text */
    text-decoration: none;        /* no underline */
    white-space: nowrap;
    line-height: 1.4;
  }

  .mq-link:hover {
    opacity: 0.85; /* subtle hover effect */
  }

  .mq-link.is-active {
    font-weight: 600;
    border-bottom: 2px solid #fff; /* underline active in white */
    padding-bottom: 2px;
  }

  .mq-fade { display: none; }
}

/* ========= Hide on desktop ========= */
@media (min-width: 750px) {
  .mobile-quicklinks { display: none; }
}


</style>

<script>
(function () {
  // ---- Robust finder: grabs the horizontally scrollable quicklinks row
  function findNav() {
    // Try common structures first
    var nav =
      document.querySelector('.gh-mobile-nav .mq-inner') ||
      document.querySelector('.mobile-quicklinks .mq-inner');

    if (nav) return nav;

    // Fallback: find the first horizontally scrollable row near the header
    var candidates = document.querySelectorAll(
      'nav .mq-inner, .mq-inner, nav[aria-label*="quick"], nav[role="navigation"]'
    );
    for (var i = 0; i < candidates.length; i++) {
      var el = candidates[i];
      var cs = getComputedStyle(el);
      if (el.scrollWidth > el.clientWidth && (cs.overflowX === 'auto' || cs.overflowX === 'scroll')) {
        return el;
      }
    }
    return null;
  }

  function normalizePath(p) { return (p || '').replace(/\/+$/, '') || '/'; }

  function init(nav) {
    if (!nav) return;

    // Key per host + pathname root (so US/UK stores don't collide)
    var root = '/' + normalizePath(location.pathname).split('/')[1];
    var KEY  = 'gh:mqnav:scrollLeft:' + location.host + root;

    // Restore saved scroll
    var saved = localStorage.getItem(KEY);
    if (saved !== null) {
      var left = parseInt(saved, 10) || 0;
      // Multiple passes to beat late layout reflows
      requestAnimationFrame(function(){ nav.scrollLeft = left; });
      window.addEventListener('load', function(){ nav.scrollLeft = left; });
      setTimeout(function(){ nav.scrollLeft = left; }, 60);
    }

    // Save on scroll / clicks / before unload
    var save = function(){ localStorage.setItem(KEY, nav.scrollLeft); };
    nav.addEventListener('scroll', save, { passive: true });
    nav.addEventListener('click', function (e) {
      if (e.target.closest('a')) save();
    }, true);
    window.addEventListener('beforeunload', save);
    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'hidden') save();
    });

    // Center active link if no saved position yet
    if (saved === null) {
      var here = normalizePath(location.pathname);
      var links = nav.querySelectorAll('a[href]');
      var active = nav.querySelector('.is-active, .active, [aria-current="page"]');
      if (!active) {
        for (var i = 0; i < links.length; i++) {
          var url = new URL(links[i].getAttribute('href'), location.origin);
          if (normalizePath(url.pathname) === here) { active = links[i]; break; }
        }
      }
      if (active && typeof active.scrollIntoView === 'function') {
        active.scrollIntoView({ block: 'nearest', inline: 'center' });
      }
    }
  }

  function start() {
    var nav = findNav();
    if (nav) return init(nav);

    // If sections render late, observe the DOM
    var mo = new MutationObserver(function () {
      var n = findNav();
      if (n) { init(n); mo.disconnect(); }
    });
    mo.observe(document.documentElement, { childList: true, subtree: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start);
  } else {
    start();
  }

  // Safari/Firefox bfcache restore
  window.addEventListener('pageshow', function (e) {
    if (!e.persisted) return;
    var nav = findNav();
    if (!nav) return;
    var root = '/' + location.pathname.replace(/\/+$/, '').split('/')[1];
    var KEY  = 'gh:mqnav:scrollLeft:' + location.host + root;
    var saved = localStorage.getItem(KEY);
    if (saved !== null) nav.scrollLeft = parseInt(saved, 10) || 0;
  });
})();
</script>
