{%- comment -%}
  Mobile quick links (scrollable, sticky under header)
  Requires a Navigation menu with handle: mobile-quick-links
{%- endcomment -%}

{%- assign mq_menu = linklists['mobile-quick-links'] | default: linklists.mobile-quick-links -%}
{%- if mq_menu and mq_menu.links.size > 0 -%}
<nav class="mobile-quicklinks" role="navigation" aria-label="Quick links">
  <div class="mq-inner">
    <ul class="mq-list" role="list">
      {%- for link in mq_menu.links -%}
        {%- assign is_active = link.active | default: false -%}
        <li class="mq-item">
          <a
            class="mq-link{% if is_active %} is-active{% endif %}"
            href="{{ link.url }}"
            {% if is_active %}aria-current="page"{% endif %}
          >
            {{ link.title }}
          </a>
        </li>
      {%- endfor -%}
    </ul>

    <!-- edge fades -->
    <div class="mq-fade mq-fade--left" aria-hidden="true"></div>
    <div class="mq-fade mq-fade--right" aria-hidden="true"></div>
  </div>
</nav>
{%- endif -%}

<style>

/* ========= Mobile Quick Links ========= */
@media (max-width: 749px) {
  :root {
    --mq-header-offset: 56px;
  }

  .mobile-quicklinks,
  .mobile-quicklinks--inline {
    position: static;
    top: auto;
    background: var(--gh-color-green, #21472D); /* green banner background */
    border: 0;
    z-index: auto;
  }

  .mobile-quicklinks .mq-inner {
    position: relative;
    padding: 6px 12px;
  }

  .mq-list {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mq-list::-webkit-scrollbar { display: none; }

  .mq-item { flex: 0 0 auto; scroll-snap-align: start; }

  .mq-link {
    display: inline-block;
    padding: 0;
    border: 0;
    background: transparent;
    font-size: 12px;              /* font size */
    font-weight: 500;
    color: #fff;                  /* white text */
    text-decoration: none;        /* no underline */
    white-space: nowrap;
    line-height: 1.4;
  }

  .mq-link:hover {
    opacity: 0.85; /* subtle hover effect */
  }

  .mq-link.is-active {
    font-weight: 600;
    border-bottom: 2px solid #fff; /* underline active in white */
    padding-bottom: 2px;
  }

  .mq-fade { display: none; }
}

/* ========= Hide on desktop ========= */
@media (min-width: 750px) {
  .mobile-quicklinks { display: none; }
}


</style>

<script>
(function () {
  var KEY = 'gh:quicklinks:lastIndex';

  /* Find the horizontal quicklinks scroller without relying on exact classes */
  function findScroller() {
    // Prefer known classes if present
    var s = document.querySelector('.gh-mobile-nav .mq-inner')
         || document.querySelector('.mobile-quicklinks .mq-inner');
    if (s) return s;

    // Fallback: scan header/nav for a horizontally scrollable row with links
    var candidates = document.querySelectorAll(
      'header nav, header [role="navigation"], nav, .mq-inner, .mobile-quicklinks, .gh-mobile-nav'
    );
    for (var i = 0; i < candidates.length; i++) {
      var el = candidates[i];
      var cs = getComputedStyle(el);
      if (
        el.querySelectorAll('a[href]').length >= 3 &&
        el.scrollWidth > el.clientWidth &&
        (cs.overflowX === 'auto' || cs.overflowX === 'scroll' || cs.overflowX === 'overlay')
      ) {
        return el;
      }
      // Sometimes the inner scroller is a child
      var inner = el.querySelector(':scope > .mq-inner, :scope > .scroller, :scope > div, :scope > ul');
      if (inner) {
        var cs2 = getComputedStyle(inner);
        if (
          inner.querySelectorAll('a[href]').length >= 3 &&
          inner.scrollWidth > inner.clientWidth &&
          (cs2.overflowX === 'auto' || cs2.overflowX === 'scroll' || cs2.overflowX === 'overlay')
        ) {
          return inner;
        }
      }
    }
    return null;
  }

  function listLinks(scroller) {
    return Array.prototype.filter.call(
      scroller.querySelectorAll('a[href]'),
      function (a) { return a.offsetParent !== null; } // visible only
    );
  }

  function indexOfLink(scroller, link) {
    var links = listLinks(scroller);
    return links.indexOf(link);
  }

  function centerByIndex(scroller, idx) {
    var links = listLinks(scroller);
    if (idx < 0 || idx >= links.length) return;
    var a = links[idx];
    var left = a.offsetLeft - (scroller.clientWidth - a.clientWidth) / 2;
    scroller.style.scrollBehavior = 'auto';         // avoid smooth snap
    scroller.scrollLeft = Math.max(0, left);
  }

  function wire(scroller) {
    if (!scroller.__wired) {
      scroller.__wired = true;

      // Save index on any link click inside the scroller
      scroller.addEventListener('click', function (e) {
        var a = e.target.closest('a[href]');
        if (!a || !scroller.contains(a)) return;
        try { sessionStorage.setItem(KEY, String(indexOfLink(scroller, a))); } catch (_) {}
      }, true);
    }

    // Restore: center last clicked index; if none, center active
    var idx = parseInt(sessionStorage.getItem(KEY), 10);
    var tries = 0;
    (function tick() {
      if (!isNaN(idx)) {
        centerByIndex(scroller, idx);
      } else {
        var active = scroller.querySelector('a[aria-current="page"], a.active, a.is-active');
        if (active) centerByIndex(scroller, indexOfLink(scroller, active));
      }
      // run a few frames to beat late header/layout scripts
      if (++tries < 10) requestAnimationFrame(tick);
    })();
  }

  function start() {
    var s = findScroller();
    if (s) return wire(s);

    // If header/nav mounts late, observe and run once found
    var mo = new MutationObserver(function () {
      var s2 = findScroller();
      if (s2) { wire(s2); mo.disconnect(); }
    });
    mo.observe(document.documentElement, { childList: true, subtree: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start);
  } else {
    start();
  }

  // bfcache restores
  window.addEventListener('pageshow', function (e) {
    if (e.persisted) start();
  });
})();
</script>
