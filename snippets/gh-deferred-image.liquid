{% comment %}

{image} image: url to image to render
{image} image_mobile: url to image to render for mobile

{% endcomment %}

{% assign aspect_ratio = image.width | append: '/' | append: image.height %}
{% if image_mobile %}
    {% assign aspect_ratio = image_mobile.width | append: '/' | append: image_mobile.height %}
{% endif %}


{% assign handle = image | handleize %}
{% assign id = 'gdi-' |  append: handle %}
{% assign css_id = '#' | append: id %}

<span id='{{ id }}'>
    <span class="gh-deferred-image isDesktop">
        <span class='gh-deferred-image-placeholder'>
            <img src='' alt='' class='block'>
        </span>
    </span>
</span>

<style>
    .gh-deferred-image {
        display: flex;
        background: linear-gradient(-45deg, #fff, var(--gh-color-green-light), #fff, var(--gh-color-green-light));
        background-size: 400% 400%;
        animation: gradient 2s ease infinite;
    }
    
    @keyframes gradient {
        0% {
            background-position: 0% 50%;
        }
        50% {
            background-position: 100% 50%;
        }
        100% {
            background-position: 0% 50%;
        }
    }

    {{ css_id }} .gh-deferred-image-placeholder {
        aspect-ratio: {{ aspect_ratio }};
        flex-grow: 1;
        display: block;
    }

    {{ css_id }} .gh-deferred-image.isDesktop .gh-deferred-image-placeholder{
        aspect-ratio: {{ image.width }} / {{ image.height }};
    }

    {% if aspect_ratio_mobile %}
    {{ css_id }} .gh-deferred-image.isMobile .gh-deferred-image-placeholder{
        aspect-ratio: {{ aspect_ratio_mobile }};
    }
    {% endif %}

    .gh-deferred-image.loaded,
    .gh-deferred-image.loaded .gh-deferred-image-placeholder{
        background: none;
        animation: none;
        display: inline;
        aspect-ratio: initial;
        background: initial;
        flex-grow: initial;
    }
</style>
<script>
  {
    let src = '{{ image | image_url: width: 1300 }}';
    let placeholder = document.querySelector('{{ css_id }} .gh-deferred-image');

    {% if image_mobile %}
    const isMobile = window.matchMedia("(max-width: 749px)");
    if (isMobile.matches) {
      src = '{{ image_mobile | image_url: width: 1300 }}';
      placeholder.classList.add('isMobile');
      placeholder.classList.remove('isDesktop');
    }
    {% endif %}

    let img = new Image();
    img.src = src;
    img.onload = function() {
        placeholder.classList.add('loaded');
        placeholder.querySelector('img').src = src;
    }
  }
</script>