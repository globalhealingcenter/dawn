{% comment %}

{image} image: url to image to render
{image} image_mobile: url to image to render for mobile
{string} width: width to render 1x image at
{string} width_mobile: width to render 1x mobile at

{% endcomment %}

{% assign handle = image | handleize %}
{% assign id = 'gdi-' |  append: handle %}
{% assign css_id = '#' | append: id %}

<span id='{{ id }}'>
    <span class="gh-deferred-image isDesktop">
        <span class='gh-deferred-image-placeholder'>

            {% if image_mobile %}
                <picture class='block'>
                    <source class='desktop-version' media="(min-width: 750px)" srcset="">
                    <source class='mobile-version' media="(max-width: 749px)" srcset="">
                    <img class='block' src="" alt="">
                </picture>
            {% else %}
                <img src='' alt='' class='block'>
            {% endif %}

        </span>
    </span>
</span>

<style>
    .gh-deferred-image {
        display: flex;
        background: linear-gradient(-45deg, #fff, var(--gh-color-green-light), #fff, var(--gh-color-green-light));
        background-size: 400% 400%;
        animation: gradient 2s ease infinite;
    }
    
    @keyframes gradient {
        0% {
            background-position: 0% 50%;
        }
        50% {
            background-position: 100% 50%;
        }
        100% {
            background-position: 0% 50%;
        }
    }

    {{ css_id }} .gh-deferred-image-placeholder {
        aspect-ratio: {{ image.width }} / {{ image.height }};
        flex-grow: 1;
        display: block;
    }

    {{ css_id }} .gh-deferred-image.isDesktop .gh-deferred-image-placeholder{
        aspect-ratio: {{ image.width }} / {{ image.height }};
    }

    {% if image_mobile %}
    {{ css_id }} .gh-deferred-image.isMobile .gh-deferred-image-placeholder{
        aspect-ratio: {{ image_mobile.width }} / {{ image_mobile.height }};
    }
    {% endif %}

    .gh-deferred-image.loaded,
    .gh-deferred-image.loaded .gh-deferred-image-placeholder{
        background: none;
        animation: none;
        display: inline;
        aspect-ratio: initial;
        background: initial;
        flex-grow: initial;
    }
</style>
<script>
  {
    let src = '{{ image | image_url: width: width }}';
    let placeholder = document.querySelector('{{ css_id }} .gh-deferred-image');

    let desktopOnLoad = function(desktop_src) {
      placeholder.classList.add('loaded');
      placeholder.querySelector('img').src = desktop_src;
    }

    let mobileOnLoad = function(desktop_src, mobile_src) {
      placeholder.classList.add('loaded');
      placeholder.querySelector('img').src = desktop_src;
      placeholder.querySelector('.mobile-version').src = mobile_src;
      placeholder.querySelector('.desktop-version').src = desktop_src;
    }

    let img = new Image();

    {% if image_mobile %}

        const isMobile = window.matchMedia("(max-width: 749px)");
        let preloadURL = src;
        let mobile_src = '{{ image_mobile | image_url: width: width_mobile }}';

        if (isMobile.matches) {
          preloadURL = mobile_src;
          placeholder.classList.add('isMobile');
          placeholder.classList.remove('isDesktop');
        }

        img.src = preloadURL;
        img.onload = function() {
          mobileOnLoad(src, mobile_src);
        }

    {% else %}

        img.src = src;
        img.onload = function() {
          desktopOnLoad(src);
        }

    {% endif %}

  }
</script>