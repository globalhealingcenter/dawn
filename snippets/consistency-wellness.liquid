<section
  class="cw consistency-wellness"
  {% if block %}
    {{ block.shopify_attributes -}}
  {% endif %}
>
  {%- comment -%} Video background - change URL in code if needed {%- endcomment -%}
  <div class="cw__video-wrap">
    <video class="cw__video cw__video--desktop" loop muted autoplay playsinline>
