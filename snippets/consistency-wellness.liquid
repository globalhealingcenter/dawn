<section
  class="cw consistency-wellness"
  {% if block %}
    {{ block.shopify_attributes }}
  {% endif %}
>
  {% assign video_desktop = block.settings.video_url %}
  {% if video_desktop == blank %}
    {% assign video_desktop = 'consistency-made-easier.mp4' | asset_url %}
  {% endif %}
  {% assign video_mobile = block.settings.video_url_mobile %}
  {% if video_mobile == blank %}
    {% assign video_mobile = video_desktop %}
  {% endif %}

  <div class="cw__video-wrap">
    <video class="cw__video cw__video--desktop" loop muted autoplay playsinline>
      <source type="video/mp4" src="{{ video_desktop }}">
      Your browser does not support the video tag.
    </video>
    <video class="cw__video cw__video--mobile" loop muted autoplay playsinline>
      <source type="video/mp4" src="{{ video_mobile }}">
      Your browser does not support the video tag.
    </video>
    <div class="cw__overlay"></div>
  </div>

  <div class="cw__content">
    <div class="cw__header">
      <h2 class="cw__heading font-proxima">
        {{ block.settings.heading | default: 'Consistency' }}
        <span class="cw__heading-span font-miller">{{ block.settings.heading_em | default: 'Made Easier' }}</span>
      </h2>
      <p class="cw__tagline font-proxima">
        {{ block.settings.tagline | default: 'Turn Wellness into an Automatic Habit' }}
      </p>
    </div>

    <div class="cw__cards-outer">
      <div class="cw__cards" role="region" aria-label="Wellness feature cards">
        {%- comment -%} Card 1 - Subscribe & Save {%- endcomment -%}
        <div class="cw__card">
          {% if block.settings.card_1_svg != blank %}
            <div class="cw__card-icon">{{ block.settings.card_1_svg }}</div>
          {% endif %}
          <h3 class="cw__card-heading font-proxima">
            {{ block.settings.card_1_heading | default: 'Subscribe & Save' }}
          </h3>
          <div class="cw__card-text font-proxima">{{ block.settings.card_1_text }}</div>
          <a
            href="{{ block.settings.card_1_link_url | default: '/pages/autoship' }}"
            class="cw__card-link font-proxima"
          >
            {{- block.settings.card_1_link_text | default: 'Learn More' -}}
          </a>
        </div>
        {%- comment -%} Card 2 - Live Healthy Rewards {%- endcomment -%}
        <div class="cw__card">
          {% if block.settings.card_2_svg != blank %}
            <div class="cw__card-icon">{{ block.settings.card_2_svg }}</div>
          {% endif %}
          <h3 class="cw__card-heading font-proxima">
            {{ block.settings.card_2_heading | default: 'Live Healthy Rewards' }}
          </h3>
          <div class="cw__card-text font-proxima">{{ block.settings.card_2_text }}</div>
          <a
            href="{{ block.settings.card_2_link_url | default: '/pages/live-healthy-rewards-program' }}"
            class="cw__card-link font-proxima"
          >
            {{- block.settings.card_2_link_text | default: 'Learn More' -}}
          </a>
        </div>
        {%- comment -%} Card 3 - Free U.S. Shipping {%- endcomment -%}
        <div class="cw__card">
          {% if block.settings.card_3_svg != blank %}
            <div class="cw__card-icon">{{ block.settings.card_3_svg }}</div>
          {% endif %}
          <h3 class="cw__card-heading font-proxima">
            {{ block.settings.card_3_heading | default: 'Free U.S. Shipping' }}
          </h3>
          <div class="cw__card-text font-proxima">{{ block.settings.card_3_text }}</div>
          <a
            href="{{ block.settings.card_3_link_url | default: '/pages/shipping' }}"
            class="cw__card-link font-proxima"
          >
            {{- block.settings.card_3_link_text | default: 'Learn More' -}}
          </a>
        </div>
        {%- comment -%} Card 4 - Satisfaction Guarantee {%- endcomment -%}
        <div class="cw__card">
          {% if block.settings.card_4_svg != blank %}
            <div class="cw__card-icon">{{ block.settings.card_4_svg }}</div>
          {% endif %}
          <h3 class="cw__card-heading font-proxima">
            {{ block.settings.card_4_heading | default: 'Satisfaction Guarantee' }}
          </h3>
          <div class="cw__card-text font-proxima">{{ block.settings.card_4_text }}</div>
          <a
            href="{{ block.settings.card_4_link_url | default: '/pages/guarantee' }}"
            class="cw__card-link font-proxima"
          >
            {{- block.settings.card_4_link_text | default: 'Learn More' -}}
          </a>
        </div>
      </div>
      <div
        class="cw__progress"
        aria-hidden="true"
        role="progressbar"
        aria-valuenow="1"
        aria-valuemin="1"
        aria-valuemax="4"
      >
        <div class="cw__progress-track">
          <div class="cw__progress-fill"></div>
        </div>
      </div>
    </div>
  </div>
</section>
