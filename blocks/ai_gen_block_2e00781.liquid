{% doc %}
  @prompt
    Create a 3-column bundle section for a landing page.
    
    Each column represents a bundle tier with fixed quantities.
    
    Per column:
    – Editable title and subtitle
    – Exactly 3 products, each selectable using the Shopify product picker
    – For each product, store and use selected_or_first_available_variant.id when adding to cart
    – Show a fixed quantity per product (editor-controlled, read-only for customers)
    
    Pricing (display only):
    – Editable original price text (strikethrough)
    – Editable sale price text
    – Editable “Save $X” text
    – Do not calculate prices dynamically
    
    Discounts:
    – Optional per-column discount code display (read-only)
    – Optional single discount code input for the section
    – When applying a discount, use /discount/CODE?redirect=current_page so the user stays on the landing page
    
    Add to cart:
    – One “Add to cart” button per column
    – On click, add all 3 products with their variant IDs and quantities using /cart/add.js
    – Do not redirect after adding to cart
    – Show a subtle success state on the button
    
    Styling:
    – 3-column layout
    – Visually highlight the middle column with an optional “Best Value” badge
    – Stack columns vertically on mobile
    
    Important:
    – Do not require manual variant ID entry
    – Do not use product.id for cart actions
    – Use variant IDs only
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bundle-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 60px 20px;
    background-color: {{ block.settings.section_background }};
  }

  .ai-bundle-container-{{ ai_gen_id }} {
    max-width: 1300px;
    margin: 0 auto;
  }

  .ai-bundle-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    margin-top: 40px;
  }

  .ai-bundle-column-{{ ai_gen_id }} {
    background-color: {{ block.settings.column_background }};
    border: 1px solid {{ block.settings.column_border_color }};
    border-radius: 8px;
    padding: 30px 20px;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .ai-bundle-column-{{ ai_gen_id }}.ai-bundle-column--featured-{{ ai_gen_id }} {
    border: 2px solid {{ block.settings.featured_border_color }};
    transform: scale(1.05);
  }

  .ai-bundle-badge-{{ ai_gen_id }} {
    position: absolute;
    top: -15px;
    left: 50%;
    transform: translateX(-50%);
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 20px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 600;
  }

  .ai-bundle-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 20px;
  }

  .ai-bundle-title-{{ ai_gen_id }} {
    font-size: 24px;
    font-weight: 700;
    margin: 0 0 8px;
    color: {{ block.settings.text_color }};
  }

  .ai-bundle-subtitle-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    margin: 0;
  }

  .ai-bundle-products-{{ ai_gen_id }} {
    flex-grow: 1;
    margin-bottom: 20px;
  }

  .ai-bundle-product-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid {{ block.settings.column_border_color }};
  }

  .ai-bundle-product-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-bundle-product-image-{{ ai_gen_id }} {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
    border-radius: 4px;
    overflow: hidden;
  }

  .ai-bundle-product-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-bundle-product-info-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-bundle-product-title-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    margin: 0 0 4px;
    color: {{ block.settings.text_color }};
  }

  .ai-bundle-product-qty-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
  }

  .ai-bundle-pricing-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 20px;
  }

  .ai-bundle-original-price-{{ ai_gen_id }} {
    font-size: 18px;
    text-decoration: line-through;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
    margin: 0 0 4px;
  }

  .ai-bundle-sale-price-{{ ai_gen_id }} {
    font-size: 32px;
    font-weight: 700;
    color: {{ block.settings.price_color }};
    margin: 0 0 4px;
  }

  .ai-bundle-savings-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.savings_color }};
    font-weight: 600;
    margin: 0;
  }

  .ai-bundle-discount-code-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 16px;
    padding: 10px;
    background-color: {{ block.settings.discount_code_background }};
    border-radius: 4px;
  }

  .ai-bundle-discount-label-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
    margin: 0 0 4px;
  }

  .ai-bundle-discount-value-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
    font-family: monospace;
    margin: 0;
  }

  .ai-bundle-button-{{ ai_gen_id }} {
    width: 100%;
    padding: 16px 24px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: 4px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-bundle-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-bundle-button-{{ ai_gen_id }}.ai-bundle-button--success-{{ ai_gen_id }} {
    background-color: {{ block.settings.success_background }};
  }

  .ai-bundle-button-{{ ai_gen_id }}:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .ai-bundle-discount-input-wrapper-{{ ai_gen_id }} {
    margin-top: 40px;
    text-align: center;
  }

  .ai-bundle-discount-input-label-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
    margin-bottom: 8px;
    display: block;
  }

  .ai-bundle-discount-input-field-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    max-width: 400px;
    margin: 0 auto;
  }

  .ai-bundle-discount-input-{{ ai_gen_id }} {
    flex-grow: 1;
    padding: 12px 16px;
    border: 1px solid {{ block.settings.column_border_color }};
    border-radius: 4px;
    font-size: 14px;
  }

  .ai-bundle-discount-apply-{{ ai_gen_id }} {
    padding: 12px 24px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }

  .ai-bundle-discount-apply-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  @media screen and (max-width: 989px) {
    .ai-bundle-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-bundle-column-{{ ai_gen_id }}.ai-bundle-column--featured-{{ ai_gen_id }} {
      transform: scale(1);
    }
  }
{% endstyle %}

<bundle-section-{{ ai_gen_id }} class="ai-bundle-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-bundle-container-{{ ai_gen_id }}">
    <div class="ai-bundle-grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign title_key = 'column_' | append: i | append: '_title'
          assign subtitle_key = 'column_' | append: i | append: '_subtitle'
          assign product_1_key = 'column_' | append: i | append: '_product_1'
          assign product_2_key = 'column_' | append: i | append: '_product_2'
          assign product_3_key = 'column_' | append: i | append: '_product_3'
          assign qty_1_key = 'column_' | append: i | append: '_qty_1'
          assign qty_2_key = 'column_' | append: i | append: '_qty_2'
          assign qty_3_key = 'column_' | append: i | append: '_qty_3'
          assign original_price_key = 'column_' | append: i | append: '_original_price'
          assign sale_price_key = 'column_' | append: i | append: '_sale_price'
          assign savings_key = 'column_' | append: i | append: '_savings'
          assign discount_code_key = 'column_' | append: i | append: '_discount_code'
          assign featured_key = 'column_' | append: i | append: '_featured'

          assign column_title = block.settings[title_key]
          assign column_subtitle = block.settings[subtitle_key]
          assign product_1 = block.settings[product_1_key]
          assign product_2 = block.settings[product_2_key]
          assign product_3 = block.settings[product_3_key]
          assign qty_1 = block.settings[qty_1_key]
          assign qty_2 = block.settings[qty_2_key]
          assign qty_3 = block.settings[qty_3_key]
          assign original_price = block.settings[original_price_key]
          assign sale_price = block.settings[sale_price_key]
          assign savings = block.settings[savings_key]
          assign discount_code = block.settings[discount_code_key]
          assign is_featured = block.settings[featured_key]
        %}

        <div class="ai-bundle-column-{{ ai_gen_id }} {% if is_featured %}ai-bundle-column--featured-{{ ai_gen_id }}{% endif %}">
          {% if is_featured and block.settings.badge_text != blank %}
            <div class="ai-bundle-badge-{{ ai_gen_id }}">{{ block.settings.badge_text }}</div>
          {% endif %}

          <div class="ai-bundle-header-{{ ai_gen_id }}">
            {% if column_title != blank %}
              <h3 class="ai-bundle-title-{{ ai_gen_id }}">{{ column_title }}</h3>
            {% endif %}
            {% if column_subtitle != blank %}
              <p class="ai-bundle-subtitle-{{ ai_gen_id }}">{{ column_subtitle }}</p>
            {% endif %}
          </div>

          <div class="ai-bundle-products-{{ ai_gen_id }}">
            {% if product_1 %}
              <div class="ai-bundle-product-{{ ai_gen_id }}">
                <div class="ai-bundle-product-image-{{ ai_gen_id }}">
                  {% if product_1.featured_image %}
                    <img
                      src="{{ product_1.featured_image | image_url: width: 120 }}"
                      alt="{{ product_1.featured_image.alt | escape }}"
                      loading="lazy"
                      width="120"
                      height="120"
                    >
                  {% endif %}
                </div>
                <div class="ai-bundle-product-info-{{ ai_gen_id }}">
                  <p class="ai-bundle-product-title-{{ ai_gen_id }}">{{ product_1.title }}</p>
                  <p class="ai-bundle-product-qty-{{ ai_gen_id }}">Quantity: {{ qty_1 }}</p>
                </div>
              </div>
            {% endif %}

            {% if product_2 %}
              <div class="ai-bundle-product-{{ ai_gen_id }}">
                <div class="ai-bundle-product-image-{{ ai_gen_id }}">
                  {% if product_2.featured_image %}
                    <img
                      src="{{ product_2.featured_image | image_url: width: 120 }}"
                      alt="{{ product_2.featured_image.alt | escape }}"
                      loading="lazy"
                      width="120"
                      height="120"
                    >
                  {% endif %}
                </div>
                <div class="ai-bundle-product-info-{{ ai_gen_id }}">
                  <p class="ai-bundle-product-title-{{ ai_gen_id }}">{{ product_2.title }}</p>
                  <p class="ai-bundle-product-qty-{{ ai_gen_id }}">Quantity: {{ qty_2 }}</p>
                </div>
              </div>
            {% endif %}

            {% if product_3 %}
              <div class="ai-bundle-product-{{ ai_gen_id }}">
                <div class="ai-bundle-product-image-{{ ai_gen_id }}">
                  {% if product_3.featured_image %}
                    <img
                      src="{{ product_3.featured_image | image_url: width: 120 }}"
                      alt="{{ product_3.featured_image.alt | escape }}"
                      loading="lazy"
                      width="120"
                      height="120"
                    >
                  {% endif %}
                </div>
                <div class="ai-bundle-product-info-{{ ai_gen_id }}">
                  <p class="ai-bundle-product-title-{{ ai_gen_id }}">{{ product_3.title }}</p>
                  <p class="ai-bundle-product-qty-{{ ai_gen_id }}">Quantity: {{ qty_3 }}</p>
                </div>
              </div>
            {% endif %}
          </div>

          <div class="ai-bundle-pricing-{{ ai_gen_id }}">
            {% if original_price != blank %}
              <p class="ai-bundle-original-price-{{ ai_gen_id }}">{{ original_price }}</p>
            {% endif %}
            {% if sale_price != blank %}
              <p class="ai-bundle-sale-price-{{ ai_gen_id }}">{{ sale_price }}</p>
            {% endif %}
            {% if savings != blank %}
              <p class="ai-bundle-savings-{{ ai_gen_id }}">{{ savings }}</p>
            {% endif %}
          </div>

          {% if discount_code != blank %}
            <div class="ai-bundle-discount-code-{{ ai_gen_id }}">
              <p class="ai-bundle-discount-label-{{ ai_gen_id }}">Discount code</p>
              <p class="ai-bundle-discount-value-{{ ai_gen_id }}">{{ discount_code }}</p>
            </div>
          {% endif %}

          <button
            class="ai-bundle-button-{{ ai_gen_id }}"
            data-column="{{ i }}"
            data-product-1-id="{% if product_1 %}{{ product_1.selected_or_first_available_variant.id }}{% endif %}"
            data-product-2-id="{% if product_2 %}{{ product_2.selected_or_first_available_variant.id }}{% endif %}"
            data-product-3-id="{% if product_3 %}{{ product_3.selected_or_first_available_variant.id }}{% endif %}"
            data-qty-1="{{ qty_1 }}"
            data-qty-2="{{ qty_2 }}"
            data-qty-3="{{ qty_3 }}"
          >
            Add to cart
          </button>
        </div>
      {% endfor %}
    </div>

    {% if block.settings.show_discount_input %}
      <div class="ai-bundle-discount-input-wrapper-{{ ai_gen_id }}">
        <label class="ai-bundle-discount-input-label-{{ ai_gen_id }}">
          {{ block.settings.discount_input_label }}
        </label>
        <div class="ai-bundle-discount-input-field-{{ ai_gen_id }}">
          <input
            type="text"
            class="ai-bundle-discount-input-{{ ai_gen_id }}"
            placeholder="{{ block.settings.discount_input_placeholder }}"
            id="ai-bundle-discount-input-{{ ai_gen_id }}"
          >
          <button class="ai-bundle-discount-apply-{{ ai_gen_id }}" id="ai-bundle-discount-apply-{{ ai_gen_id }}">
            Apply
          </button>
        </div>
      </div>
    {% endif %}
  </div>
</bundle-section-{{ ai_gen_id }}>

<script>
  (function() {
    class BundleSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.buttons = this.querySelectorAll('.ai-bundle-button-{{ ai_gen_id }}');
        this.discountApplyBtn = this.querySelector('#ai-bundle-discount-apply-{{ ai_gen_id }}');
        this.discountInput = this.querySelector('#ai-bundle-discount-input-{{ ai_gen_id }}');
        
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.buttons.forEach((button) => {
          button.addEventListener('click', (e) => this.handleAddToCart(e));
        });

        if (this.discountApplyBtn) {
          this.discountApplyBtn.addEventListener('click', () => this.handleDiscountApply());
        }
      }

      async handleAddToCart(event) {
        const button = event.target;
        const product1Id = button.dataset.product1Id;
        const product2Id = button.dataset.product2Id;
        const product3Id = button.dataset.product3Id;
        const qty1 = parseInt(button.dataset.qty1);
        const qty2 = parseInt(button.dataset.qty2);
        const qty3 = parseInt(button.dataset.qty3);

        const items = [];
        
        if (product1Id) {
          items.push({ id: product1Id, quantity: qty1 });
        }
        if (product2Id) {
          items.push({ id: product2Id, quantity: qty2 });
        }
        if (product3Id) {
          items.push({ id: product3Id, quantity: qty3 });
        }

        if (items.length === 0) {
          return;
        }

        button.disabled = true;
        const originalText = button.textContent;

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ items }),
          });

          if (response.ok) {
            button.textContent = 'Added!';
            button.classList.add('ai-bundle-button--success-{{ ai_gen_id }}');
            
            setTimeout(() => {
              button.textContent = originalText;
              button.classList.remove('ai-bundle-button--success-{{ ai_gen_id }}');
              button.disabled = false;
            }, 2000);

            document.dispatchEvent(new CustomEvent('cart:refresh'));
          } else {
            throw new Error('Failed to add to cart');
          }
        } catch (error) {
          button.textContent = 'Error - Try again';
          setTimeout(() => {
            button.textContent = originalText;
            button.disabled = false;
          }, 2000);
        }
      }

      handleDiscountApply() {
        const code = this.discountInput.value.trim();
        if (code) {
          const currentPath = window.location.pathname + window.location.search;
          window.location.href = `/discount/${code}?redirect=${encodeURIComponent(currentPath)}`;
        }
      }
    }

    customElements.define('bundle-section-{{ ai_gen_id }}', BundleSection{{ ai_gen_id }});
  })();
</script>

