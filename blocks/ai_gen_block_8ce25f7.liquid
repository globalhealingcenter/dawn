{% doc %}
  @prompt
    Create a content section with a single-column, vertically stacked layout.
    
    Structure:
    
    A rectangular image at the top
    
    A title directly beneath the image
    
    A paragraph beneath the title
    
    Layout and behavior requirements:
    
    Everything must be stacked in one column (not side by side)
    
    The image must not be cropped or forced into a square
    
    Preserve the image’s original aspect ratio
    
    Image should scale responsively (max-width: 100%, height: auto)
    
    No fixed height or aspect-ratio constraints
    
    Use the theme’s existing fonts and color styles
    
    Spacing should look consistent with other content sections
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-content-column-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
  }

  .ai-content-column__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: {{ block.settings.spacing_image_title }}px;
  }

  .ai-content-column__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-content-column__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-content-column__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: auto;
    max-width: 500px;
  }

  .ai-content-column__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-content-column__title-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.spacing_title_paragraph }}px;
    color: {{ block.settings.title_color }};
    text-align: {{ block.settings.text_alignment }};
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.3;
  }

  .ai-content-column__paragraph-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.paragraph_color }};
    text-align: {{ block.settings.text_alignment }};
    font-size: {{ block.settings.paragraph_size }}px;
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-content-column-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px {{ block.settings.padding_bottom | times: 0.7 }}px;
    }

    .ai-content-column__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.85 }}px;
    }

    .ai-content-column__paragraph-{{ ai_gen_id }} {
      font-size: {{ block.settings.paragraph_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-content-column-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-content-column__image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.image %}
      <img
        src="{{ block.settings.image | image_url: width: 2000 }}"
        alt="{{ block.settings.image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
        class="ai-content-column__image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-content-column__image-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-content-column__empty-state-{{ ai_gen_id }}">
          Add an image
        </div>
      </div>
    {% endif %}
  </div>

  {% if block.settings.title != blank %}
    <h2 class="ai-content-column__title-{{ ai_gen_id }}">
      {{ block.settings.title }}
    </h2>
  {% endif %}

  {% if block.settings.paragraph != blank %}
    <div class="ai-content-column__paragraph-{{ ai_gen_id }}">
      {{ block.settings.paragraph }}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Content column",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "Add a title"
    },
    {
      "type": "richtext",
      "id": "paragraph",
      "label": "Paragraph",
      "default": "<p>Add a paragraph of text to provide more details about your content.</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#545454"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 28
    },
    {
      "type": "color",
      "id": "paragraph_color",
      "label": "Paragraph color",
      "default": "#545454"
    },
    {
      "type": "range",
      "id": "paragraph_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Paragraph size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "spacing_image_title",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Image to title",
      "default": 24
    },
    {
      "type": "range",
      "id": "spacing_title_paragraph",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Title to paragraph",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 20
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "Maximum width",
      "default": 800
    }
  ],
  "presets": [
    {
      "name": "Content column"
    }
  ]
}
{% endschema %}
