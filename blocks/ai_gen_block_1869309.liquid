    {
      "type": "range",
      "id": "main_title_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Main title size",
      "default": 32
    },
    {
      "type": "range",
      "id": "main_subtitle_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Main subtitle size",
      "default": 16
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "label": "Maximum width",
      "default": 1300
    },
    {
      "type": "header",
      "content": "Column 1"
    },
    {
      "type": "text",
      "id": "column_1_title",
      "label": "Title",
      "default": "Starter Bundle"
    },
    {
      "type": "text",
      "id": "column_1_subtitle",
      "label": "Subtitle",
      "default": "Perfect for beginners"
    },
    {
      "type": "product",
      "id": "column_1_product_1",
      "label": "Product 1"
    },
    {
      "type": "range",
