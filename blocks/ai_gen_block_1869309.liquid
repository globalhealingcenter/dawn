    },
    {
      "type": "product",
      "id": "column_1_product_2",
      "label": "Product 2"
    },
    {
      "type": "range",
      "id": "column_1_qty_2",
      "min": 1,
      "max": 10,
      "step": 1,
      "label": "Product 2 quantity",
      "default": 1
    },
    {
      "type": "product",
      "id": "column_1_product_3",
      "label": "Product 3"
    },
    {
      "type": "range",
      "id": "column_1_qty_3",
      "min": 1,
      "max": 10,
      "step": 1,
      "label": "Product 3 quantity",
      "default": 1
    },
    {
      "type": "text",
      "id": "column_1_original_price",
      "label": "Original price",
      "default": "$150.00"
    },
    {
      "type": "text",
      "id": "column_1_sale_price",
      "label": "Sale price",
      "default": "$120.00"
    },
    {
      "type": "text",
      "id": "column_1_savings",
      "label": "Savings",
      "default": "$30.00"
