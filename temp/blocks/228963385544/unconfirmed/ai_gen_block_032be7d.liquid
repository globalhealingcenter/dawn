{% doc %}
  @prompt
    Create a promotional bundle comparison layout with 3 columns.
    
    Each column represents a curated Global Healing bundle using Paratrex I, Paratrex II, and Toxin Binder, with different fixed quantities per column.
    
    The block should be presentation-focused and not rely on dynamic discount calculations. Prices and per-unit values should be editable text fields.
    
    Include settings for selecting products, setting quantities, customizing headings, prices, and call-to-action labels.
    
    Add all products to cart with one button click per column.
    
    Stack on mobile and visually highlight the middle column as the recommended option.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bundle-comparison-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
  }

  .ai-bundle-comparison__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-bundle-comparison__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 32px;
  }

  .ai-bundle-comparison__column-{{ ai_gen_id }} {
    background-color: {{ block.settings.column_bg_color }};
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.2s ease;
  }

  .ai-bundle-comparison__column-{{ ai_gen_id }}--featured {
    background-color: {{ block.settings.featured_bg_color }};
    border-color: {{ block.settings.featured_border_color }};
    border-width: {{ block.settings.featured_border_thickness }}px;
    transform: scale(1.05);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .ai-bundle-comparison__badge-{{ ai_gen_id }} {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background-color: {{ block.settings.badge_bg_color }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-bundle-comparison__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 8px;
    text-align: center;
  }

  .ai-bundle-comparison__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 24px;
    text-align: center;
  }

  .ai-bundle-comparison__products-{{ ai_gen_id }} {
    flex-grow: 1;
    margin-bottom: 24px;
  }

  .ai-bundle-comparison__product-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid {{ block.settings.divider_color }};
  }

  .ai-bundle-comparison__product-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-bundle-comparison__product-image-{{ ai_gen_id }} {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
  }

  .ai-bundle-comparison__product-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-bundle-comparison__product-info-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-bundle-comparison__product-title-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 4px;
  }

  .ai-bundle-comparison__product-qty-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.product_qty_color }};
  }

  .ai-bundle-comparison__pricing-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 24px;
    padding: 20px 0;
    border-top: 2px solid {{ block.settings.divider_color }};
    border-bottom: 2px solid {{ block.settings.divider_color }};
  }

  .ai-bundle-comparison__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    font-weight: 700;
    color: {{ block.settings.price_color }};
    margin: 0 0 8px;
  }

  .ai-bundle-comparison__per-unit-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.per_unit_color }};
    margin: 0;
  }

  .ai-bundle-comparison__savings-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.savings_color }};
    font-weight: 600;
    margin: 8px 0 0;
  }

  .ai-bundle-comparison__button-{{ ai_gen_id }} {
    width: 100%;
    padding: 16px 24px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .ai-bundle-comparison__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-bundle-comparison__button-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-bundle-comparison__column-{{ ai_gen_id }}--featured .ai-bundle-comparison__button-{{ ai_gen_id }} {
    background-color: {{ block.settings.featured_button_bg_color }};
    color: {{ block.settings.featured_button_text_color }};
  }

  .ai-bundle-comparison__column-{{ ai_gen_id }}--featured .ai-bundle-comparison__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.featured_button_hover_bg_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-bundle-comparison__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .ai-bundle-comparison__column-{{ ai_gen_id }}--featured {
      transform: scale(1);
      order: -1;
    }
  }
{% endstyle %}

<bundle-comparison-{{ ai_gen_id }} class="ai-bundle-comparison-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-bundle-comparison__container-{{ ai_gen_id }}">
    <div class="ai-bundle-comparison__grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign heading_key = 'bundle_' | append: i | append: '_heading'
          assign subheading_key = 'bundle_' | append: i | append: '_subheading'
          assign product_1_key = 'bundle_' | append: i | append: '_product_1'
          assign qty_1_key = 'bundle_' | append: i | append: '_qty_1'
          assign product_2_key = 'bundle_' | append: i | append: '_product_2'
          assign qty_2_key = 'bundle_' | append: i | append: '_qty_2'
          assign product_3_key = 'bundle_' | append: i | append: '_product_3'
          assign qty_3_key = 'bundle_' | append: i | append: '_qty_3'
          assign price_key = 'bundle_' | append: i | append: '_price'
          assign per_unit_key = 'bundle_' | append: i | append: '_per_unit'
          assign savings_key = 'bundle_' | append: i | append: '_savings'
          assign button_key = 'bundle_' | append: i | append: '_button_text'
          assign featured_key = 'bundle_' | append: i | append: '_featured'

          assign heading = block.settings[heading_key]
          assign subheading = block.settings[subheading_key]
          assign product_1 = block.settings[product_1_key]
          assign qty_1 = block.settings[qty_1_key]
          assign product_2 = block.settings[product_2_key]
          assign qty_2 = block.settings[qty_2_key]
          assign product_3 = block.settings[product_3_key]
          assign qty_3 = block.settings[qty_3_key]
          assign price = block.settings[price_key]
          assign per_unit = block.settings[per_unit_key]
          assign savings = block.settings[savings_key]
          assign button_text = block.settings[button_key]
          assign is_featured = block.settings[featured_key]
        %}

        <div class="ai-bundle-comparison__column-{{ ai_gen_id }} {% if is_featured %}ai-bundle-comparison__column-{{ ai_gen_id }}--featured{% endif %}">
          {% if is_featured and block.settings.badge_text != blank %}
            <div class="ai-bundle-comparison__badge-{{ ai_gen_id }}">
              {{ block.settings.badge_text }}
            </div>
          {% endif %}

          {% if heading != blank %}
            <h3 class="ai-bundle-comparison__heading-{{ ai_gen_id }}">{{ heading }}</h3>
          {% endif %}

          {% if subheading != blank %}
            <p class="ai-bundle-comparison__subheading-{{ ai_gen_id }}">{{ subheading }}</p>
          {% endif %}

          <div class="ai-bundle-comparison__products-{{ ai_gen_id }}">
            {% if product_1 != blank %}
              <div class="ai-bundle-comparison__product-{{ ai_gen_id }}">
                <div class="ai-bundle-comparison__product-image-{{ ai_gen_id }}">
                  {% if product_1.featured_image %}
                    <img
                      src="{{ product_1.featured_image | image_url: width: 120 }}"
                      alt="{{ product_1.featured_image.alt | escape }}"
                      loading="lazy"
                      width="60"
                      height="60"
                    >
                  {% endif %}
                </div>
                <div class="ai-bundle-comparison__product-info-{{ ai_gen_id }}">
                  <div class="ai-bundle-comparison__product-title-{{ ai_gen_id }}">
                    {{ product_1.title }}
                  </div>
                  <div class="ai-bundle-comparison__product-qty-{{ ai_gen_id }}">
                    Quantity: {{ qty_1 }}
                  </div>
                </div>
              </div>
            {% endif %}

            {% if product_2 != blank %}
              <div class="ai-bundle-comparison__product-{{ ai_gen_id }}">
                <div class="ai-bundle-comparison__product-image-{{ ai_gen_id }}">
                  {% if product_2.featured_image %}
                    <img
                      src="{{ product_2.featured_image | image_url: width: 120 }}"
                      alt="{{ product_2.featured_image.alt | escape }}"
                      loading="lazy"
                      width="60"
                      height="60"
                    >
                  {% endif %}
                </div>
                <div class="ai-bundle-comparison__product-info-{{ ai_gen_id }}">
                  <div class="ai-bundle-comparison__product-title-{{ ai_gen_id }}">
                    {{ product_2.title }}
                  </div>
                  <div class="ai-bundle-comparison__product-qty-{{ ai_gen_id }}">
                    Quantity: {{ qty_2 }}
                  </div>
                </div>
              </div>
            {% endif %}

            {% if product_3 != blank %}
              <div class="ai-bundle-comparison__product-{{ ai_gen_id }}">
                <div class="ai-bundle-comparison__product-image-{{ ai_gen_id }}">
                  {% if product_3.featured_image %}
                    <img
                      src="{{ product_3.featured_image | image_url: width: 120 }}"
                      alt="{{ product_3.featured_image.alt | escape }}"
                      loading="lazy"
                      width="60"
                      height="60"
                    >
                  {% endif %}
                </div>
                <div class="ai-bundle-comparison__product-info-{{ ai_gen_id }}">
                  <div class="ai-bundle-comparison__product-title-{{ ai_gen_id }}">
                    {{ product_3.title }}
                  </div>
                  <div class="ai-bundle-comparison__product-qty-{{ ai_gen_id }}">
                    Quantity: {{ qty_3 }}
                  </div>
                </div>
              </div>
            {% endif %}
          </div>

          <div class="ai-bundle-comparison__pricing-{{ ai_gen_id }}">
            {% if price != blank %}
              <div class="ai-bundle-comparison__price-{{ ai_gen_id }}">{{ price }}</div>
            {% endif %}
            {% if per_unit != blank %}
              <div class="ai-bundle-comparison__per-unit-{{ ai_gen_id }}">{{ per_unit }}</div>
            {% endif %}
            {% if savings != blank %}
              <div class="ai-bundle-comparison__savings-{{ ai_gen_id }}">{{ savings }}</div>
            {% endif %}
          </div>

          <button
            class="ai-bundle-comparison__button-{{ ai_gen_id }}"
            data-bundle="{{ i }}"
            data-product-1="{{ product_1.selected_or_first_available_variant.id }}"
            data-qty-1="{{ qty_1 }}"
            data-product-2="{{ product_2.selected_or_first_available_variant.id }}"
            data-qty-2="{{ qty_2 }}"
            data-product-3="{{ product_3.selected_or_first_available_variant.id }}"
            data-qty-3="{{ qty_3 }}"
          >
            {{ button_text }}
          </button>
        </div>
      {% endfor %}
    </div>
  </div>
</bundle-comparison-{{ ai_gen_id }}>

<script>
  (function() {
    class BundleComparison{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.buttons = this.querySelectorAll('.ai-bundle-comparison__button-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.buttons.forEach((button) => {
          button.addEventListener('click', this.handleAddToCart.bind(this));
        });
      }

      async handleAddToCart(event) {
        const button = event.currentTarget;
        const originalText = button.textContent;

        button.disabled = true;
        button.textContent = 'Adding...';

        const items = [];

        for (let i = 1; i <= 3; i++) {
          const variantId = button.dataset[`product${i}`];
          const qty = parseInt(button.dataset[`qty${i}`]);

          if (variantId && variantId !== '' && qty > 0) {
            items.push({
              id: variantId,
              quantity: qty
            });
          }
        }

        if (items.length === 0) {
          button.disabled = false;
          button.textContent = originalText;
          return;
        }

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ items })
          });

          if (response.ok) {
            button.textContent = 'Added!';
            setTimeout(() => {
              button.textContent = originalText;
              button.disabled = false;
            }, 2000);

            if (window.location.pathname !== '/cart') {
              window.location.href = '/cart';
            } else {
              window.location.reload();
            }
          } else {
            throw new Error('Failed to add to cart');
          }
        } catch (error) {
          button.textContent = 'Error - Try again';
          setTimeout(() => {
            button.textContent = originalText;
            button.disabled = false;
          }, 2000);
        }
      }
    }

    customElements.define('bundle-comparison-{{ ai_gen_id }}', BundleComparison{{ ai_gen_id }});
  })();
</script>

