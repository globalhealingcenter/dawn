{% doc %}
  @prompt
    Create a promotional bundle comparison section with 3 columns for a Global Healing landing page.
    
    Each column represents a curated bundle using the same products (Paratrex I, Paratrex II, and Toxin Binder) with different fixed quantities per bundle.
    
    Each column should include:
    – An editable heading and subheading
    – A list of included products with fixed quantities (not editable by the customer)
    – A displayed original retail price with a strikethrough
    – A prominently displayed sale price beneath the original price
    – An optional discount code display field (read-only, not customer editable)
    – A single “Add to cart” button that adds all products in that column to the cart
    
    The add-to-cart action should keep the customer on the current page and should not redirect to the homepage or cart page.
    
    Pricing values should be controlled through editor settings and displayed as static text rather than dynamically calculated.
    
    Stack columns vertically on mobile, and visually highlight the middle bundle as the most popular option.
    
    Generate all required HTML, CSS, and JavaScript within the section file.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bundle-comparison-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
  }

  .ai-bundle-comparison__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-bundle-comparison__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 32px;
  }

  .ai-bundle-comparison__column-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: 2px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-bundle-comparison__column-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }

  .ai-bundle-comparison__column--featured-{{ ai_gen_id }} {
    border-color: {{ block.settings.featured_border_color }};
    border-width: 3px;
    transform: scale(1.05);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .ai-bundle-comparison__column--featured-{{ ai_gen_id }}:hover {
    transform: scale(1.05) translateY(-4px);
  }

  .ai-bundle-comparison__badge-{{ ai_gen_id }} {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-bundle-comparison__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0 0 8px 0;
    text-align: center;
  }

  .ai-bundle-comparison__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 24px 0;
    text-align: center;
  }

  .ai-bundle-comparison__products-{{ ai_gen_id }} {
    flex-grow: 1;
    margin-bottom: 24px;
  }

  .ai-bundle-comparison__product-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid {{ block.settings.divider_color }};
  }

  .ai-bundle-comparison__product-item-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-bundle-comparison__product-quantity-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.quantity_color }};
    min-width: 24px;
    text-align: center;
  }

  .ai-bundle-comparison__product-name-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.product_name_color }};
    flex-grow: 1;
  }

  .ai-bundle-comparison__pricing-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 20px;
  }

  .ai-bundle-comparison__original-price-{{ ai_gen_id }} {
    font-size: 18px;
    color: {{ block.settings.original_price_color }};
    text-decoration: line-through;
    margin-bottom: 4px;
  }

  .ai-bundle-comparison__sale-price-{{ ai_gen_id }} {
    font-size: 32px;
    font-weight: 700;
    color: {{ block.settings.sale_price_color }};
    margin-bottom: 12px;
  }

  .ai-bundle-comparison__discount-code-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.discount_code_background }};
    color: {{ block.settings.discount_code_text }};
    padding: 8px 16px;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 600;
    font-family: monospace;
    border: 1px dashed {{ block.settings.discount_code_border }};
    margin-bottom: 16px;
  }

  .ai-bundle-comparison__button-{{ ai_gen_id }} {
    width: 100%;
    padding: 16px 24px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-bundle-comparison__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-bundle-comparison__button-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-bundle-comparison__loading-{{ ai_gen_id }} {
    display: none;
    font-size: 14px;
    color: {{ block.settings.subheading_color }};
    text-align: center;
    margin-top: 8px;
  }

  .ai-bundle-comparison__loading-{{ ai_gen_id }}.active {
    display: block;
  }

  @media screen and (max-width: 989px) {
    .ai-bundle-comparison__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .ai-bundle-comparison__column--featured-{{ ai_gen_id }} {
      transform: scale(1);
      order: -1;
    }

    .ai-bundle-comparison__column--featured-{{ ai_gen_id }}:hover {
      transform: translateY(-4px);
    }
  }
{% endstyle %}

<bundle-comparison-{{ ai_gen_id }} class="ai-bundle-comparison-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-bundle-comparison__container-{{ ai_gen_id }}">
    <div class="ai-bundle-comparison__grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign heading_key = 'bundle_' | append: i | append: '_heading'
          assign subheading_key = 'bundle_' | append: i | append: '_subheading'
          assign product_1_name_key = 'bundle_' | append: i | append: '_product_1_name'
          assign product_1_qty_key = 'bundle_' | append: i | append: '_product_1_qty'
          assign product_1_id_key = 'bundle_' | append: i | append: '_product_1_id'
          assign product_2_name_key = 'bundle_' | append: i | append: '_product_2_name'
          assign product_2_qty_key = 'bundle_' | append: i | append: '_product_2_qty'
          assign product_2_id_key = 'bundle_' | append: i | append: '_product_2_id'
          assign product_3_name_key = 'bundle_' | append: i | append: '_product_3_name'
          assign product_3_qty_key = 'bundle_' | append: i | append: '_product_3_qty'
          assign product_3_id_key = 'bundle_' | append: i | append: '_product_3_id'
          assign original_price_key = 'bundle_' | append: i | append: '_original_price'
          assign sale_price_key = 'bundle_' | append: i | append: '_sale_price'
          assign discount_code_key = 'bundle_' | append: i | append: '_discount_code'
          assign is_featured_key = 'bundle_' | append: i | append: '_featured'

          assign heading = block.settings[heading_key]
          assign subheading = block.settings[subheading_key]
          assign product_1_name = block.settings[product_1_name_key]
          assign product_1_qty = block.settings[product_1_qty_key]
          assign product_1_id = block.settings[product_1_id_key]
          assign product_2_name = block.settings[product_2_name_key]
          assign product_2_qty = block.settings[product_2_qty_key]
          assign product_2_id = block.settings[product_2_id_key]
          assign product_3_name = block.settings[product_3_name_key]
          assign product_3_qty = block.settings[product_3_qty_key]
          assign product_3_id = block.settings[product_3_id_key]
          assign original_price = block.settings[original_price_key]
          assign sale_price = block.settings[sale_price_key]
          assign discount_code = block.settings[discount_code_key]
          assign is_featured = block.settings[is_featured_key]
        %}

        <div class="ai-bundle-comparison__column-{{ ai_gen_id }} {% if is_featured %}ai-bundle-comparison__column--featured-{{ ai_gen_id }}{% endif %}">
          {% if is_featured and block.settings.show_featured_badge %}
            <div class="ai-bundle-comparison__badge-{{ ai_gen_id }}">
              {{ block.settings.featured_badge_text }}
            </div>
          {% endif %}

          <h3 class="ai-bundle-comparison__heading-{{ ai_gen_id }}">{{ heading }}</h3>
          {% if subheading != blank %}
            <p class="ai-bundle-comparison__subheading-{{ ai_gen_id }}">{{ subheading }}</p>
          {% endif %}

          <div class="ai-bundle-comparison__products-{{ ai_gen_id }}">
            {% if product_1_name != blank %}
              <div class="ai-bundle-comparison__product-item-{{ ai_gen_id }}">
                <span class="ai-bundle-comparison__product-quantity-{{ ai_gen_id }}">{{ product_1_qty }}×</span>
                <span class="ai-bundle-comparison__product-name-{{ ai_gen_id }}">{{ product_1_name }}</span>
              </div>
            {% endif %}

            {% if product_2_name != blank %}
              <div class="ai-bundle-comparison__product-item-{{ ai_gen_id }}">
                <span class="ai-bundle-comparison__product-quantity-{{ ai_gen_id }}">{{ product_2_qty }}×</span>
                <span class="ai-bundle-comparison__product-name-{{ ai_gen_id }}">{{ product_2_name }}</span>
              </div>
            {% endif %}

            {% if product_3_name != blank %}
              <div class="ai-bundle-comparison__product-item-{{ ai_gen_id }}">
                <span class="ai-bundle-comparison__product-quantity-{{ ai_gen_id }}">{{ product_3_qty }}×</span>
                <span class="ai-bundle-comparison__product-name-{{ ai_gen_id }}">{{ product_3_name }}</span>
              </div>
            {% endif %}
          </div>

          <div class="ai-bundle-comparison__pricing-{{ ai_gen_id }}">
            {% if original_price != blank %}
              <div class="ai-bundle-comparison__original-price-{{ ai_gen_id }}">{{ original_price }}</div>
            {% endif %}
            {% if sale_price != blank %}
              <div class="ai-bundle-comparison__sale-price-{{ ai_gen_id }}">{{ sale_price }}</div>
            {% endif %}
            {% if discount_code != blank %}
              <div class="ai-bundle-comparison__discount-code-{{ ai_gen_id }}">{{ discount_code }}</div>
            {% endif %}
          </div>

          <button
            class="ai-bundle-comparison__button-{{ ai_gen_id }}"
            data-bundle-index="{{ i }}"
            data-product-1-id="{{ product_1_id }}"
            data-product-1-qty="{{ product_1_qty }}"
            data-product-2-id="{{ product_2_id }}"
            data-product-2-qty="{{ product_2_qty }}"
            data-product-3-id="{{ product_3_id }}"
            data-product-3-qty="{{ product_3_qty }}"
          >
            {{ block.settings.add_to_cart_label }}
          </button>
          <div class="ai-bundle-comparison__loading-{{ ai_gen_id }}" data-loading-{{ i }}>Adding to cart...</div>
        </div>
      {% endfor %}
    </div>
  </div>
</bundle-comparison-{{ ai_gen_id }}>

<script>
  (function() {
    class BundleComparison{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.buttons = this.querySelectorAll('.ai-bundle-comparison__button-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.buttons.forEach((button) => {
          button.addEventListener('click', (e) => this.handleAddToCart(e));
        });
      }

      async handleAddToCart(event) {
        const button = event.target;
        const bundleIndex = button.dataset.bundleIndex;
        const loadingIndicator = this.querySelector(`[data-loading-${bundleIndex}]`);
        const originalText = button.textContent;

        const items = [];

        for (let i = 1; i <= 3; i++) {
          const productId = button.dataset[`product${i}Id`];
          const quantity = parseInt(button.dataset[`product${i}Qty`]);

          if (productId && quantity > 0) {
            items.push({
              id: productId,
              quantity: quantity
            });
          }
        }

        if (items.length === 0) {
          alert('No products configured for this bundle');
          return;
        }

        button.disabled = true;
        loadingIndicator.classList.add('active');

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ items: items })
          });

          if (!response.ok) {
            throw new Error('Failed to add to cart');
          }

          const data = await response.json();

          document.dispatchEvent(new CustomEvent('cart:refresh'));

          if (window.theme && window.theme.cart) {
            window.theme.cart.refresh();
          }

          button.textContent = '✓ Added to cart';
          setTimeout(() => {
            button.textContent = originalText;
            button.disabled = false;
          }, 2000);

        } catch (error) {
          console.error('Error adding to cart:', error);
          alert('There was an error adding items to your cart. Please try again.');
          button.disabled = false;
        } finally {
          loadingIndicator.classList.remove('active');
        }
      }
    }

    customElements.define('bundle-comparison-{{ ai_gen_id }}', BundleComparison{{ ai_gen_id }});
  })();
</script>

